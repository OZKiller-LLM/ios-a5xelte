-         if (panfrost_should_linear_convert(ctx, prsrc, transfer)) {
+         if (panfrost_should_linear_convert(ctx, prsrc, transfer) &&
+             panfrost_linear_fits(dev, prsrc,
+                                  pan_resource(trans->staging.rsrc)->bo)) {
 
             panfrost_bo_unreference(prsrc->bo);
 
