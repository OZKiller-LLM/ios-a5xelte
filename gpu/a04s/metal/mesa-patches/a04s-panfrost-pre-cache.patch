+
+static void
+a04s_pre_key(struct disk_cache *cache, const struct panfrost_uncompiled_shader *so,
+             unsigned gpu_id, cache_key key)
+{
+   uint8_t data[sizeof(A04S_PRE_TAG) + sizeof(so->nir_sha1) + sizeof(gpu_id)];
+   memcpy(data, A04S_PRE_TAG, sizeof(A04S_PRE_TAG));
+   memcpy(data + sizeof(A04S_PRE_TAG), so->nir_sha1, sizeof(so->nir_sha1));
+   memcpy(data + sizeof(A04S_PRE_TAG) + sizeof(so->nir_sha1), &gpu_id,
+          sizeof(gpu_id));
+   disk_cache_compute_key(cache, data, sizeof(data), key);
+}
+
+/* The shell that stands in for the preprocessed NIR: no variables, no code,
+ * the preprocessed shader's shader_info. */
+static nir_shader *
+a04s_pre_shell(struct panfrost_uncompiled_shader *so, shader_info *info,
+               const nir_shader_compiler_options *options)
+{
+   info->name = NULL;
+   info->label = NULL;
+   return nir_shader_create(so, info->stage, options, info);
+}
+
+/* A shader the pre-cache has: so->nir becomes the shell, the serialized NIR is
+ * kept, and the NIR as given is freed. False (nothing changed) otherwise. */
+static bool
+a04s_pre_load(struct disk_cache *cache, const cache_key key,
+              struct panfrost_uncompiled_shader *so)
+{
+   size_t size = 0;
+   void *buf = disk_cache_get(cache, key, &size);
+   if (!buf)
+      return false;
+
+   struct blob_reader r;
+   blob_reader_init(&r, buf, size);
+   const bool magic = blob_read_uint32(&r) == A04S_PRE_MAGIC;
+   const uint32_t noperspective = blob_read_uint32(&r);
+   const uint8_t fragcolor = blob_read_uint8(&r);
+   shader_info info;
+   blob_copy_bytes(&r, &info, sizeof(info));
+   const uint64_t nir_size = blob_read_uint64(&r);
+   const void *nir_bytes = NULL;
+   if (magic && !r.overrun && nir_size && nir_size <= (uint64_t)(r.end - r.current))
+      nir_bytes = blob_read_bytes(&r, nir_size);
+   if (!nir_bytes || r.overrun || r.current != r.end ||
+       info.stage != so->nir->info.stage) {
+      free(buf);
+      return false;
+   }
+
+   void *kept = ralloc_size(so, nir_size);
+   if (!kept) {
+      free(buf);
+      return false;
+   }
+   memcpy(kept, nir_bytes, nir_size);
+   free(buf);
+
+   nir_shader *shell = a04s_pre_shell(so, &info, so->nir->options);
+   ralloc_free((void *)so->nir);
+   so->nir = shell;
+   so->noperspective_varyings = noperspective;
+   so->fragcolor_lowered = fragcolor;
+   so->a04s_nir_blob = kept;
+   so->a04s_nir_blob_size = nir_size;
+   p_atomic_inc(&a04s_pre_hits);
+   p_atomic_add(&a04s_pre_kept, nir_size);
+   a04s_pre_say("hit", so, nir_size);
+   return true;
+}
+
+/* A shader just preprocessed: serialized, stored in the pre-cache (when there
+ * is a disk cache), kept as bytes, and so->nir becomes the shell. Out of
+ * memory, so->nir stays as it is. */
+static void
+a04s_pre_pack(struct disk_cache *cache, const cache_key key,
+              struct panfrost_uncompiled_shader *so)
+{
+   nir_shader *nir = (nir_shader *)so->nir;
+   struct blob full;
+   blob_init(&full);
+   nir_serialize(&full, nir, false);
+   void *kept = full.out_of_memory ? NULL : ralloc_size(so, full.size);
+   if (!kept) {
+      blob_finish(&full);
+      return;
+   }
+   memcpy(kept, full.data, full.size);
+
+   shader_info info = nir->info;
+   info.name = NULL;
+   info.label = NULL;
+   if (cache) {
+      struct blob e;
+      blob_init(&e);
+      blob_write_uint32(&e, A04S_PRE_MAGIC);
+      blob_write_uint32(&e, so->noperspective_varyings);
+      blob_write_uint8(&e, so->fragcolor_lowered);
+      blob_write_bytes(&e, &info, sizeof(info));
+      blob_write_uint64(&e, full.size);
+      blob_write_bytes(&e, full.data, full.size);
+      if (!e.out_of_memory)
+         disk_cache_put(cache, key, e.data, e.size, NULL);
+      blob_finish(&e);
+   }
+
+   so->nir = a04s_pre_shell(so, &info, nir->options);
+   so->a04s_nir_blob = kept;
+   so->a04s_nir_blob_size = full.size;
+   ralloc_free(nir);
+   p_atomic_inc(&a04s_pre_stores);
+   p_atomic_add(&a04s_pre_kept, full.size);
+   a04s_pre_say("stored", so, full.size);
+   blob_finish(&full);
+}
+
+/* The preprocessed NIR, read back to compile a variant; the caller frees it. */
+static nir_shader *
+a04s_pre_unpack(const struct panfrost_uncompiled_shader *so)
+{
+   struct blob_reader r;
+   blob_reader_init(&r, so->a04s_nir_blob, so->a04s_nir_blob_size);
+   nir_shader *nir = nir_deserialize(NULL, so->nir->options, &r);
+   if (!nir || r.overrun) {
+      /* bytes this process wrote; only an allocation can fail here */
+      fprintf(stderr, "panfrost: a04s: the preprocessed NIR (%zu bytes) could "
+                      "not be read back to compile a variant\n",
+              so->a04s_nir_blob_size);
+      abort();
+   }
+   p_atomic_inc(&a04s_pre_unpacks);
+   a04s_pre_say("unpacked", so, so->a04s_nir_blob_size);
+   return nir;
+}
 
