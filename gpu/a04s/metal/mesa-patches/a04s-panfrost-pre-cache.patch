+
+static bool
+a04s_pre_env(const char *name, bool otherwise)
+{
+   const char *v = getenv(name);
+   return v && *v ? v[0] != '0' : otherwise;
+}
+
+static bool
+a04s_pre_on(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = a04s_pre_env("A04S_PAN_PRE", true);
+   return on;
+}
+
+static void
+a04s_pre_say(const char *what, const struct panfrost_uncompiled_shader *so,
+             size_t bytes)
+{
+   static int on = -1;
+   if (on < 0)
+      on = a04s_pre_env("A04S_PAN_PRE_LOG", false);
+   if (on) {
+      char hex[41];
