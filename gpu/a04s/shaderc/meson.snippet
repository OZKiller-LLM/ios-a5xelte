
# Galaxy A04s (gpu/a04s/shaderc): offline Bifrost shaders for the Mali-G52, arch 7.
a04s_shaderc = executable(
  'a04s_shaderc',
  files('a04s_shaderc.c'),
  c_args : [c_msvc_compat_args, no_override_init_args, '-DPAN_ARCH=7'],
  gnu_symbol_visibility : 'hidden',
  include_directories : [inc_include, inc_src, inc_panfrost],
  dependencies : [libpanfrost_dep],
  build_by_default : false,
)
