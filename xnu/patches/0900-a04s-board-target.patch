diff --git a/bsd/dev/a04s_emmc_guard.h b/bsd/dev/a04s_emmc_guard.h
new file mode 100644
index 0000000..61653da
--- /dev/null
+++ b/bsd/dev/a04s_emmc_guard.h
@@ -0,0 +1,40 @@
+/*
+ * Galaxy A04s: the only eMMC sectors a kernel may ever write. The IMEI and key partitions
+ * all sit below userdata, and the card's own write protection does not cover efs.
+ * The caller provides uint64_t and bool.
+ */
+#ifndef A04S_EMMC_GUARD_H
+#define A04S_EMMC_GUARD_H
+
+#define A04S_USERDATA_FIRST   16599040ull
+#define A04S_USERDATA_SECTORS 227672064ull
+
+static inline bool
+a04s_write_allowed(uint64_t lba, uint64_t sectors)
+{
+	uint64_t end = A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS;
+	return sectors != 0 && lba >= A04S_USERDATA_FIRST && lba < end && sectors <= end - lba;
+}
+
+/* efs, sec_efs, cpefs, keystorage, keyrefuge and keydata, as this phone's table has them. */
+static inline bool
+a04s_guard_self_test(void)
+{
+	static const uint64_t protected_ranges[][2] = {
+		{ 8192, 40960 }, { 49152, 40960 }, { 98304, 16384 },
+		{ 245760, 1024 }, { 619520, 32768 }, { 652288, 32768 },
+	};
+	for (unsigned i = 0; i < sizeof(protected_ranges) / sizeof(protected_ranges[0]); i++) {
+		uint64_t first = protected_ranges[i][0], count = protected_ranges[i][1];
+		if (a04s_write_allowed(first, 1) || a04s_write_allowed(first + count - 1, 1) ||
+		    a04s_write_allowed(first, count)) {
+			return false;
+		}
+	}
+	return !a04s_write_allowed(A04S_USERDATA_FIRST - 1, 1) &&
+	       a04s_write_allowed(A04S_USERDATA_FIRST, 1) &&
+	       a04s_write_allowed(A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS - 1, 1) &&
+	       !a04s_write_allowed(A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS, 1);
+}
+
+#endif /* A04S_EMMC_GUARD_H */
