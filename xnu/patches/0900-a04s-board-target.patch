+static bool a04s_mounted, a04s_read_only;
+
+/*
+ * After a write the card stays busy while it programs, at times for its own housekeeping too.
+ * A sector command sent then failed at once, and a failed page-in kills the process with
+ * SIGBUS: backboardd and SpringBoard, 2026-11-03. So wait for the card, and send a failed
+ * sector again. A read changes nothing, and a write puts the same data in the same place,
+ * through the same guard.
+ */
+#define A04S_CARD_WAIT_MS 2000u
+#define A04S_SECTOR_TRIES 4u
+
+/*
+ * The PIO loop has to drain the FIFO as the card fills it. Preempted mid-sector, it left the
+ * card clock stopped until the host timeout (RINT 0x424: HTO, 9 of 64 words read). A sector
+ * takes microseconds, so no other thread runs during one.
+ */
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+
+static uint64_t a04s_busy_waits, a04s_retries;
+static uint32_t a04s_read_errors, a04s_write_errors;
+/* pexpert/arm/pe_serial.c draws kprintf past the console mute while this is set. */
+int a04s_console_urgent;
+
+static bool
+a04s_card_idle(void)
+{
+	if (!(emmc_rd(EMMC_STATUS) & (1u << 9))) {
+		return true;
+	}
+	a04s_busy_waits++;
+	uint64_t start = mach_absolute_time();
+	while (emmc_rd(EMMC_STATUS) & (1u << 9)) {
+		uint64_t waited = mach_absolute_time() - start;
+		if (waited > A04S_TICKS_PER_S / 1000u * A04S_CARD_WAIT_MS) {
+			return false;
+		}
+		/* Spin for the first millisecond, then let other threads run. */
+		if (waited > A04S_TICKS_PER_S / 1000u) {
+			IOSleep(1);
+		}
+	}
+	return true;
+}
