+static void
+a04s_heartbeat(__unused void *arg, __unused wait_result_t wr)
+{
+	for (unsigned int seconds = 5;; seconds += 5) {
+		IOSleep(5000);
+		kprintf("A04S HB %u S READS %llu\n", seconds, a04s_reads);
+		kprintf("WRITES %llu REFUSED %u\n", a04s_writes, a04s_writes_refused);
+		kprintf("EMMC BUSY %llu RETRY %llu RERR %u WERR %u\n", a04s_busy_waits, a04s_retries,
+		    a04s_read_errors, a04s_write_errors);
+		kprintf("SVC %llu LAST %d ABORTS %llu\n", a04s_svc_count, a04s_last_svc, a04s_user_aborts);
+		extern void a04s_acpm_report(void);
+		a04s_acpm_report();
+		extern void a04s_input_report(void);
+		a04s_input_report();
+		a04s_print_faults();
+	}
+}
+
+/* What PID 1's threads are doing. It may block on proc_find, but the heartbeat carries on. */
+static void
+a04s_sampler(__unused void *arg, __unused wait_result_t wr)
+{
+	for (unsigned int sample = 0;; sample++) {
+		IOSleep(7000);
+		proc_t init = proc_find(1);
+		if (init == NULL) {
+			kprintf("SAMPLE %u NO PID 1\n", sample);
+			continue;
+		}
+		task_t task = proc_task(init);
+		kprintf("SAMPLE %u\n", sample);
+		if (task != NULL) {
+			a04s_sample_task(task);
+		}
+		(void)proc_rele(init);
+	}
+}
