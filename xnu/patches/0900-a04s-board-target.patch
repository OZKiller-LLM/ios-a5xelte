+/* sweet_hid_key numbering. */
+#define KEY_POWER               0
+#define KEY_VOLUP               1
+#define KEY_VOLDOWN             2
+#define KEY_COUNT               3
+#define KEY_POLL_MS             15
+#define KEY_LINES               64              /* key lines shown; after that only the counters move */
+#define KEY_FLAP_WINDOW         67              /* polls, about a second */
+#define KEY_FLAP_LIMIT          10              /* changes in one window that drop a key */
+#define KEY_PMIC_EVERY          3               /* polls a side-key read: every 45 ms */
+#define KEY_PMIC_FAILS          8               /* ACPM failures in a row that stop the side key */
+
+static const char *const key_names[KEY_COUNT] = { "POWER", "VOLUP", "VOLDOWN" };
+static vm_offset_t alive_pins;
+static uint32_t key_idle;                       /* raw levels at start, a bit a key */
+static uint32_t key_dropped;                    /* keys that flipped too often */
+static volatile uint32_t key_down;              /* debounced state, a bit a key */
+static volatile uint32_t key_events, key_errors;
+static volatile uint32_t key_raw, key_polls;     /* last raw levels, polls so far */
+static volatile uint8_t key_status1;
+static int key_last_error;
