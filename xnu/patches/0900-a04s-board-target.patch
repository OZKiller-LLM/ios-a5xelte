+ * Stage 5c: prove the read path against answers taken from Android, then root on the iOS
+ * volume in userdata. Unless A04S_EMMC_WRITES is on, CMD17 is the only data command in
+ * this build. Before the mount it reads the two partition tables and the start of recovery.
+ */
+#define A04S_CRC_SECTORS 32768u /* 16 MiB of recovery, compared with the backup */
+#define A04S_TICKS_PER_S 26000000ull
+
+extern uint64_t mach_absolute_time(void);
+extern void IOSleep(unsigned int milliseconds);
