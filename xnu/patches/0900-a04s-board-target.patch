 static uint32_t
 emmc_le32(const uint8_t *p)
@@ -326,6 +374,218 @@ emmc_crc32(uint32_t crc, const uint8_t *data, size_t len)
 	return crc;
 }
 
+#if defined(ARM64_BOARD_CONFIG_A04S)
+/*
+ * Stage 5c: prove the read path against answers taken from Android, then root on the iOS
+ * volume in userdata. Unless A04S_EMMC_WRITES is on, CMD17 is the only data command in
+ * this build. Before the mount it reads the two partition tables and the start of recovery.
+ */
+#define A04S_CRC_SECTORS 32768u /* 16 MiB of recovery, compared with the backup */
+#define A04S_TICKS_PER_S 26000000ull
+
+extern uint64_t mach_absolute_time(void);
+extern void IOSleep(unsigned int milliseconds);
+
+static const char *a04s_step = "HOST";
+static int a04s_error = -1;
+static uint32_t a04s_header_crc, a04s_entries_crc, a04s_used, a04s_entries;
+static uint32_t a04s_alternate, a04s_recovery_crc, a04s_kbps;
+static bool a04s_mounted, a04s_read_only;
+
+static int
+a04s_read_test(void)
+{
+	uint8_t sector[512];
+	uint64_t recovery_first = 0, recovery_sectors = 0;
+	bool userdata_as_expected = false;
+
+	a04s_step = "GPT HEADER";
+	int error = emmc_read_sector(1, sector);
+	if (error) {
+		return error;
+	}
+	uint32_t header_size = emmc_le32(sector + 12);
+	if (memcmp(sector, "EFI PART", 8) || header_size < 92 || header_size > 512 ||
+	    emmc_le64(sector + 24) != 1) {
+		return ENXIO;
+	}
+	uint32_t stored_crc = emmc_le32(sector + 16);
+	uint64_t alternate = emmc_le64(sector + 32);
+	uint64_t entry_lba = emmc_le64(sector + 72);
+	uint32_t count = emmc_le32(sector + 80);
+	uint32_t entry_size = emmc_le32(sector + 84);
+	uint32_t stored_entries_crc = emmc_le32(sector + 88);
+	memset(sector + 16, 0, 4);
+	a04s_header_crc = emmc_crc32(~0u, sector, header_size) ^ ~0u;
+	if (a04s_header_crc != stored_crc) {
+		return EIO;
+	}
+	if (entry_lba < 2 || entry_lba > 1024 || count == 0 || count > 128 ||
+	    (count & 3u) || entry_size != 128 || alternate < 2 || alternate > UINT32_MAX) {
+		return ENXIO;
+	}
+
+	a04s_step = "GPT ENTRIES";
+	uint32_t crc = ~0u;
+	for (uint32_t s = 0; s < count / 4; s++) {
+		error = emmc_read_sector((uint32_t)entry_lba + s, sector);
+		if (error) {
+			return error;
+		}
+		crc = emmc_crc32(crc, sector, 512);
+		for (uint32_t j = 0; j < 4; j++) {
+			const uint8_t *p = sector + j * 128;
+			char name[16] = { 0 };
+			bool used = false;
+			for (unsigned k = 0; k < 16; k++) {
+				used = used || p[k];
+			}
+			if (!used) {
+				continue;
+			}
+			a04s_used++;
+			for (unsigned k = 0; k < sizeof(name) - 1 && p[56 + k * 2]; k++) {
+				name[k] = (char)p[56 + k * 2];
+			}
+			uint64_t first = emmc_le64(p + 32);
+			uint64_t last = emmc_le64(p + 40);
+			if (first > last) {
+				return EINVAL;
+			}
+			kprintf("P%u %s %llu %llu\n", s * 4 + j + 1, name, first, last - first + 1);
+			if (!strcmp(name, "recovery")) {
+				recovery_first = first;
+				recovery_sectors = last - first + 1;
+			}
+			if (!strcmp(name, "userdata")) {
+				userdata_as_expected = first == A04S_USERDATA_FIRST &&
+				    last - first + 1 == A04S_USERDATA_SECTORS;
+			}
+		}
+	}
+	a04s_entries = count;
+	a04s_entries_crc = crc ^ ~0u;
+	if (a04s_entries_crc != stored_entries_crc) {
+		return EIO;
+	}
+	/* The block device's fixed window assumes this layout, so it has to hold. */
+	if (!userdata_as_expected) {
+		return ENXIO;
+	}
+
+	/* The last sector on the card, so a pass covers the whole address range. */
+	a04s_step = "GPT BACKUP";
+	error = emmc_read_sector((uint32_t)alternate, sector);
+	if (error) {
+		return error;
+	}
+	if (memcmp(sector, "EFI PART", 8)) {
+		return ENXIO;
+	}
+	a04s_alternate = (uint32_t)alternate;
+
+	a04s_step = "RECOVERY";
+	if (recovery_sectors < A04S_CRC_SECTORS ||
+	    recovery_first + A04S_CRC_SECTORS > alternate) {
+		return ENXIO;
+	}
+	uint64_t ticks = 0;
+	crc = ~0u;
+	for (uint32_t s = 0; s < A04S_CRC_SECTORS; s++) {
+		uint64_t start = mach_absolute_time();
+		error = emmc_read_sector((uint32_t)recovery_first + s, sector);
+		ticks += mach_absolute_time() - start;
+		if (error) {
+			return error;
+		}
+		crc = emmc_crc32(crc, sector, 512);
+		if ((s & 8191u) == 0) {
+			kprintf("RECOVERY %u/%u\n", s, A04S_CRC_SECTORS);
+		}
+	}
+	a04s_recovery_crc = crc ^ ~0u;
+	a04s_kbps = ticks ? (uint32_t)(A04S_CRC_SECTORS / 2 * A04S_TICKS_PER_S / ticks) : 0;
+	a04s_step = "DONE";
+	return 0;
+}
+
+static void
+a04s_report(void)
+{
+	if (a04s_error) {
+		kprintf("STOPPED AT %s ERROR %d\n", a04s_step, a04s_error);
+	} else {
+		kprintf("ALL READS DONE\n");
+	}
+	kprintf("MOUNTED %s\n", !a04s_mounted ? "NO" : a04s_read_only ? "READ ONLY" : "WRITABLE");
+	kprintf("WRITES REFUSED %u\n", a04s_writes_refused);
+	kprintf("GPT %08X %08X\n", a04s_header_crc, a04s_entries_crc);
+	kprintf("USED %u OF %u\n", a04s_used, a04s_entries);
+	kprintf("BACKUP %u\n", a04s_alternate);
+	kprintf("REC %08X %u KB/S\n", a04s_recovery_crc, a04s_kbps);
+}
+
+/* Report and never return. Short lines, repeated, stay readable after the console wraps. */
+void a04s_stop(int error);
+void
+a04s_stop(int error)
+{
+	a04s_error = error;
+	for (volatile unsigned int seconds = 0;; seconds += 5) {
+		kprintf("A04S 5C STOPPED, %u S\n", seconds);
+		a04s_report();
+		IOSleep(5000);
+	}
+}
+
+/*
+ * No debugger, and the screen is the only output: every 5 s, say that the kernel is alive
+ * and what PID 1 is doing. It only reads counters and saved thread state.
+ */
+extern void sweet_sample_task(const char *name, int pid, task_t task);
+extern uint64_t a04s_svc_count, a04s_user_aborts, a04s_last_abort_addr, a04s_last_abort_pc;
+extern int a04s_last_svc;
+
+static void
+a04s_heartbeat(__unused void *arg, __unused wait_result_t wr)
+{
+	for (unsigned int seconds = 5;; seconds += 5) {
+		IOSleep(5000);
+		kprintf("A04S HB %u S READS %llu REFUSED %u\n", seconds, a04s_reads, a04s_writes_refused);
+		kprintf("SVC %llu LAST %d ABORTS %llu\n", a04s_svc_count, a04s_last_svc, a04s_user_aborts);
+		kprintf("ABORT AT %llx PC %llx\n", a04s_last_abort_addr, a04s_last_abort_pc);
+		proc_t init = proc_find(1);
+		if (init == NULL) {
+			kprintf("NO PID 1\n");
+			continue;
+		}
+		task_t task = proc_task(init);
+		if (task != NULL) {
+			sweet_sample_task("pid1", 1, task);
+		}
+		(void)proc_rele(init);
+	}
+}
+
+/* Runs straight after the root mount, before any process exists. */
+void a04s_root_mounted(void);
+void
+a04s_root_mounted(void)
+{
+	vnode_t root = vfs_rootvnode();
+	thread_t thread;
+	a04s_mounted = true;
+	if (root != NULLVP) {
+		a04s_read_only = vfs_isrdonly(vnode_mount(root)) != 0;
+		(void)vnode_put(root);
+	}
+	kprintf("A04S 5C ROOT MOUNTED\n");
+	a04s_report();
+	if (kernel_thread_start(a04s_heartbeat, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#else
