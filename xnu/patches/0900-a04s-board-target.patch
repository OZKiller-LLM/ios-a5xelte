+		kprintf("A04S GUARD %s, WRITES %s\n", guard_ok ? "OK" : "FAILED", emmc_writable ? "ON" : "OFF");
+#endif
+		a04s_step = "VOLUME";
+		int error = emmc_read_sector(A04S_USERDATA_FIRST + 2u, sector);
+		if (error) {
+			return error;
+		}
+		/* HFSX volume header. */
+		if (sector[0] != 'H' || sector[1] != 'X') {
+			return ENXIO;
+		}
