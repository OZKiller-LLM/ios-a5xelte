+void a04s_gpu_report(void);
+void
+a04s_gpu_report(void)
+{
+	tmu_read();
+	if (tmu.why) {
+		kprintf("TMU SKIPPED %s G %x Q %x\n", tmu.why, tmu.gate, tmu.qch);
+	} else {
+		kprintf("TMU L0 %d L1 %d G3D %d MAX %d C CAL %d CTL %x ST %x N %u\n", tmu.t[0], tmu.t[1], tmu.t[2],
+		    tmu.max_g3d, tmu.cal, tmu.ctrl, tmu.status, tmu.reads);
+		kprintf("TMU RAW %08x %08x TRIM %08x %08x %08x %08x\n", tmu.cur[0], tmu.cur[1], tmu.trim0,
+		    tmu.trim[0], tmu.trim[1], tmu.trim[2]);
+	}
+	uint32_t raw0, raw1;
+	unsigned mhz0 = cpu_pll_mhz(cpucl0_va, &raw0), mhz1 = cpu_pll_mhz(cpucl1_va, &raw1);
+	kprintf("THERM %s HOT %d MAX %d BATT %d N %u CH %u CPU L %u MHZ (%08x MUX %x) B %u MHZ (%08x MUX %x)\n",
+	    level_names[therm.level], therm.hottest, therm.max_seen, therm.batt_dc, therm.samples, therm.changes,
+	    mhz0, raw0, cpucl0_va ? io_rd(cpucl0_va, CPUCL0_MUX_PLL) : 0, mhz1, raw1,
+	    cpucl1_va ? io_rd(cpucl1_va, CPUCL1_MUX_PLL) : 0);
+	if (g3d_va && a04s_gpu_path_ok()) {
+		uint32_t pll = io_rd(g3d_va, G3D_PLL_CON3);
+		uint32_t m = (pll >> 16) & 0x3ffu, p = (pll >> 8) & 0x3fu, s = pll & 7u;
+		uint64_t mhz = p ? OSC_HZ * m / ((uint64_t)p << s) / 1000000u : 0;
+		kprintf("G3D PLL %08x M %u P %u S %u = %llu MHZ%s USER %x BUSD %x BUSP %x\n", pll, m, p, s, mhz,
+		    (pll & (1u << 31)) ? "" : " (OFF)", io_rd(g3d_va, G3D_SWITCH_USER), io_rd(g3d_va, G3D_MUX_BUSD),
+		    io_rd(g3d_va, G3D_DIV_BUSP));
+		kprintf("G3D TOP MUX %x DIV %x DATA %x/%x CORE %x/%x\n", top_va ? io_rd(top_va, TOP_MUX_G3D_SWITCH) : 0,
+		    top_va ? io_rd(top_va, TOP_DIV_G3D_SWITCH) : 0, io_rd(g3d_va, G3D_GATE_LHS_D),
+		    io_rd(g3d_va, G3D_QCH_LHS_D), core_va ? io_rd(core_va, CORE_GATE_LHM_D_G3D) : 0,
+		    core_va ? io_rd(core_va, CORE_QCH_LHM_D_G3D) : 0);
+	} else {
+		kprintf("G3D PLL SKIPPED\n");
+	}
+	kprintf("GPUJOB %s %s T %d RST %d PWR %x/%x/%x MHZ %u US %u OUT %llx\n", job.state, job.why, job.temp,
+	    job.reset, job.l2, job.sc, job.tl, job.mhz, job.us, job.output);
+	if (job.reset >= 0) {
+		kprintf("GPUJOB IRQ %x MMU %x GPU %x JS %x HEAD %x EXC %x ASF %x@%x GF %x@%x\n", job.jirq, job.mirq,
+		    job.girq, job.js_status, job.head, job.exc, job.as_fault, job.as_addr, job.gpu_fault, job.gpu_faddr);
+		kprintf("GPUJOB CFG %x %x %x %x BEFORE ST %x %x/%x/%x\n", job.cfg[0], job.cfg[1], job.cfg[2],
+		    job.cfg[3], job.before_status, job.before_l2, job.before_sc, job.before_tl);
+	}
+	kprintf("GPUFRAG %s %s %ux%u GOOD %u/%u US %u CORNERS %x %x %x %x\n", frag.state, frag.why, FRAG_W, FRAG_H,
+	    frag.good, FRAG_W * FRAG_H, frag.r.us, frag.corner[0], frag.corner[1], frag.corner[2], frag.corner[3]);
+	if (frag.r.tried) {
+		kprintf("GPUFRAG IRQ %x MMU %x GPU %x JS %x HEAD %x EXC %x ASF %x@%x GF %x@%x BAD %x@%u\n",
+		    frag.r.jirq, frag.r.mirq, frag.r.girq, frag.r.js_status, frag.r.head, frag.r.exc, frag.r.as_fault,
+		    frag.r.as_addr, frag.r.gpu_fault, frag.r.gpu_faddr, frag.first_bad, frag.first_bad_at);
+	}
+	kprintf("GPUPANEL %s %s %ux%u STRIDE %u PA %llx BLOCKS %u GOOD %u/%u US %u CHECK %u MS\n", panel.state,
+	    panel.why, panel.w, panel.h, panel.stride, panel.pa, panel.blocks, panel.good, panel.total, panel.r.us,
+	    panel.check_ms);
+	kprintf("GPUBLIT %s %s VARIANT %x GOOD %u/%u US %u AT %x %x %x %x\n", blit.state, blit.why, blit.variant,
+	    blit.good, blit.total, blit.r.us, blit.samples[0], blit.samples[1], blit.samples[2], blit.samples[3]);
+	if (blit.r.tried) {
+		kprintf("GPUBLIT IRQ %x MMU %x GPU %x JS %x HEAD %x EXC %x FP %llx ASF %x@%x GF %x@%x\n", blit.r.jirq,
+		    blit.r.mirq, blit.r.girq, blit.r.js_status, blit.r.head, blit.r.exc, blit.r.fault_ptr,
+		    blit.r.as_fault, blit.r.as_addr, blit.r.gpu_fault, blit.r.gpu_faddr);
+	}
+	for (unsigned v = 0; v < blit.var_count; v++) {
+		kprintf("GPUBLITV %u %s US %u EXC %x AT %x %x %x %x C %x\n", v, blit.var_ran[v] ? "RAN" : "FAULT", blit.var_us[v],
+		    blit.var_exc[v], blit.var_samples[v][0], blit.var_samples[v][1], blit.var_samples[v][2],
+		    blit.var_samples[v][3], blit.var_samples[v][4]);
+	}
+	kprintf("GPUSCALE %s FRAMES %u FAILS %u US LAST %u AVG %u MAX %u REMAPS %u SLOTS %u:%u %u:%u\n",
+	    present_broken ? "OFF (FAULT)" : present_ready ? "ON" : "NOT READY", present_frames, present_fails,
+	    present_last_us, present_frames ? (uint32_t)(present_total_us / present_frames) : 0, present_max_us,
+	    present_remaps, slots[0].id, slots[0].pages, slots[1].id, slots[1].pages);
+	if (present_fails) {
+		kprintf("GPUSCALE FAULT IRQ %x MMU %x GPU %x JS %x EXC %x ASF %x@%x GF %x@%x\n", present_fault.jirq,
+		    present_fault.mirq, present_fault.girq, present_fault.js_status, present_fault.exc,
+		    present_fault.as_fault, present_fault.as_addr, present_fault.gpu_fault, present_fault.gpu_faddr);
+	}
+	kprintf("GPUSHADER %s %s GOOD %u/%u US %u AT %x %x %x %x %x WANT %x %x %x %x %x\n", shade.state, shade.why,
+	    shade.good, shade.total, shade.r.us, shade.samples[0], shade.samples[1], shade.samples[2], shade.samples[3],
+	    shade.samples[4], shade.want[0], shade.want[1], shade.want[2], shade.want[3], shade.want[4]);
+	if (shade.r.tried) {
+		kprintf("GPUSHADER IRQ %x MMU %x GPU %x JS %x HEAD %x EXC %x FP %llx ASF %x@%x GF %x@%x\n", shade.r.jirq,
+		    shade.r.mirq, shade.r.girq, shade.r.js_status, shade.r.head, shade.r.exc, shade.r.fault_ptr,
+		    shade.r.as_fault, shade.r.as_addr, shade.r.gpu_fault, shade.r.gpu_faddr);
+	}
+	if (panel.r.tried) {
+		kprintf("GPUPANEL IRQ %x MMU %x GPU %x JS %x HEAD %x EXC %x ASF %x@%x GF %x@%x AT %x %x %x %x %x\n",
+		    panel.r.jirq, panel.r.mirq, panel.r.girq, panel.r.js_status, panel.r.head, panel.r.exc, panel.r.as_fault,
+		    panel.r.as_addr, panel.r.gpu_fault, panel.r.gpu_faddr, panel.samples[0], panel.samples[1],
+		    panel.samples[2], panel.samples[3], panel.samples[4]);
+	}
