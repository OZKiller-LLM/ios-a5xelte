+	} else {
+		kprintf("GPU ID %08x L2F %x ST %x SC %x L2 %x\n", gpu.id, gpu.l2_features, gpu.status,
+		    gpu.shaders, gpu.l2);
+	}
+	extern void a04s_gpu_report(void);
+	a04s_gpu_report();
+	extern void a04s_power_report(void);
