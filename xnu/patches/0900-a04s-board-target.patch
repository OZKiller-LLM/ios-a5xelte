+	}
+	if (tmu.t[2] > tmu.max_g3d) {
+		tmu.max_g3d = tmu.t[2];
+	}
+	tmu.reads++;
+	tmu.why = NULL;
+}
+
+/* The G52's temperature, if it can be trusted: NO_TEMP otherwise. */
+int a04s_gpu_temp(void);
+int
+a04s_gpu_temp(void)
+{
+	tmu_read();
+	if (tmu.why || tmu.t[2] == TMU_NO_TEMP || tmu.t[2] < -20 || tmu.t[2] > 125) {
+		return TMU_NO_TEMP;
+	}
+	return tmu.t[2];
+}
+
+/* Whether GPU work may run now: the monitor is running, its readings are trusted, and it is NORMAL. */
+bool a04s_gpu_allowed(void);
+bool
+a04s_gpu_allowed(void)
+{
+	return therm.level == LEVEL_NORMAL;
+}
+
+static void
+therm_sample(void)
+{
+	tmu_read();
+	int lo = 1000, hi = TMU_NO_TEMP;
+	bool sane = tmu.why == NULL;
+	for (unsigned i = 0; sane && i < 3; i++) {
+		int t = tmu.t[i];
+		if (t == TMU_NO_TEMP || t < -20 || t > 125) {
+			sane = false;
+			break;
+		}
+		lo = t < lo ? t : lo;
+		hi = t > hi ? t : hi;
+	}
+	therm.samples++;
+	if (therm.samples % 2u == 1u) {
+		a04s_adc_sample();
+	}
+	therm.batt_dc = a04s_batt_temp_dc();
+	if (therm.batt_dc >= BATT_HOT_DC && !therm.batt_warned) {
+		therm.batt_warned = true;
+		kprintf("A04S BATTERY HOT %d.%d C\n", therm.batt_dc / 10, therm.batt_dc % 10);
+	} else if (therm.batt_dc < BATT_HOT_DC - 30) {
+		therm.batt_warned = false;
+	}
+	if (!therm.trusted) {
+		therm.good = (sane && lo >= 10 && hi <= 80 && hi - lo <= 25) ? therm.good + 1 : 0;
+		therm.trusted = therm.good >= THERM_TRUST_READS;
+	}
+	int level;
+	if (!therm.trusted || !sane) {
+		level = LEVEL_UNTRUSTED;
+	} else {
+		therm.hottest = hi;
+		if (hi > therm.max_seen) {
+			therm.max_seen = hi;
+		}
+		level = hi >= THERM_CRITICAL ? LEVEL_CRITICAL : hi >= THERM_HOT ? LEVEL_HOT :
+		    hi >= THERM_WARM ? LEVEL_WARM : LEVEL_NORMAL;
+		if (therm.batt_warned && level < LEVEL_HOT) {
+			level = LEVEL_HOT;       /* the battery at 50 C or more */
+		}
+	}
+	if (level != therm.level) {
+		therm.changes++;
+		kprintf("A04S THERMAL %s %d C (L0 %d L1 %d G3D %d) BATT %d\n", level_names[level], hi,
+		    tmu.t[0], tmu.t[1], tmu.t[2], therm.batt_dc);
+		therm.level = level;
+	}
+}
+
+static void
+a04s_therm_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		therm_sample();
+		IOSleep(1000);
+	}
+}
+
+/* A CPU cluster's PLL in MHz (FOUT = 26 MHz x M / (P x 2^S)), from PLL_CON3; 0 if not readable. */
+static unsigned
+cpu_pll_mhz(vm_offset_t cmu, uint32_t *raw)
+{
+	if (!cmu) {
+		*raw = 0;
+		return 0;
+	}
+	uint32_t pll = io_rd(cmu, CPU_PLL_CON3);
+	*raw = pll;
+	uint32_t m = (pll >> 16) & 0x3ffu, p = (pll >> 8) & 0x3fu, s = pll & 7u;
+	return p ? (unsigned)(OSC_HZ * m / ((uint64_t)p << s) / 1000000u) : 0;
+}
+
+static bool
+gpu_wait(uint32_t off, uint32_t mask, uint32_t want, unsigned max_us)
+{
+	for (unsigned us = 0; us <= max_us; us += 10) {
+		if ((io_rd(gpu_va, off) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static bool
+gpu_power(uint32_t on, uint32_t ready, uint32_t mask, uint32_t *got)
+{
+	gpu_wr(on, mask);
+	bool ok = gpu_wait(ready, mask, mask, 20000);
+	*got = io_rd(gpu_va, ready);
+	return ok;
+}
+
+static void
+gpu_cores_off(void)
+{
+	gpu_wr(TILER_PWROFF, io_rd(gpu_va, TILER_READY));
+	gpu_wr(SHADER_PWROFF, io_rd(gpu_va, SHADER_READY));
+	(void)gpu_wait(SHADER_READY, 0xffffffffu, 0, 20000);
+	gpu_wr(L2_PWROFF, io_rd(gpu_va, L2_READY));
+}
+
+static void
+gpu_zero(vm_offset_t va, size_t bytes)
+{
+	volatile uint64_t *q = (volatile uint64_t *)va;
+	for (size_t i = 0; i < bytes / 8; i++) {
+		q[i] = 0;
+	}
+}
+
+/* Level 0..2 tables chain to one level-3 table; its first GPU_DATA_PAGES entries are the data pages. */
+static void
+gpu_tables(void)
+{
+	gpu_zero(mem_va, GPU_MEM_BYTES);
+	volatile uint64_t *l0 = (volatile uint64_t *)mem_va;
+	volatile uint64_t *l1 = (volatile uint64_t *)(mem_va + 0x1000);
+	volatile uint64_t *l2 = (volatile uint64_t *)(mem_va + 0x2000);
+	volatile uint64_t *l3 = (volatile uint64_t *)(mem_va + 0x3000);
+	l0[0] = (GPU_MEM_PA + 0x1000) | 3;
+	l1[0] = (GPU_MEM_PA + 0x2000) | 3;
+	l2[(GPU_VA >> 21) & 0x1ff] = (GPU_MEM_PA + 0x3000) | 3;
+	for (unsigned i = 0; i < GPU_DATA_PAGES; i++) {
+		/* Mali-LPAE leaf: read/write, outer shareable, attribute 0 (non-cached). */
+		l3[i] = (GPU_MEM_PA + GPU_DATA_OFF + i * 0x1000ull) | 0x2c1;
+	}
+	/* 7c-4b: the panel's 2 MiB blocks, the same leaf attributes, only once panel_probe() accepted it. */
+	for (unsigned i = 0; i < panel.blocks; i++) {
+		l2[((PANEL_VA >> 21) & 0x1ff) + i] = (panel.pa + i * BLOCK_2M) | 0x2c1;
+	}
+	/* 7c-4d: each slot's four level-3 tables, empty until a surface is mapped into it. */
+	for (unsigned sl = 0; sl < SLOT_COUNT; sl++) {
+		for (unsigned t = 0; t < SLOT_TABLES; t++) {
+			l2[((SLOT_VA(sl) >> 21) & 0x1ff) + t] = (GPU_MEM_PA + SLOT_L3_OFF(sl) + t * 0x1000ull) | 3;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+gpu_skip(const char *why)
+{
+	job.state = "SKIP";
+	job.why = why;
+	kprintf("A04S GPU JOB SKIP %s\n", why);
+}
+
+static void
+gpu_fail(const char *why)
+{
+	job.state = "FAIL";
+	job.why = why;
+	kprintf("A04S GPU JOB FAIL %s\n", why);
+}
+
+/*
+ * One FRAGMENT job on JS0 that clears a w x h RGBA8 render target at GPU VA rt_va (w and h whole
+ * 16-pixel tiles). The descriptors are built in the data pages; the cores must be on, AS0
+ * programmed and the page tables in place. True if the job completed with no fault.
+ */
+static bool
+frag_job(uint64_t rt_va, uint32_t w, uint32_t h, uint32_t stride, uint32_t color, uint32_t affinity,
+    struct frag_result *r, uint64_t frame_dcds, uint32_t frame_modes, uint32_t swizzle)
+{
+	vm_offset_t base = mem_va + GPU_DATA_OFF;
+	gpu_zero(base + FRAG_JOB_OFF, FRAG_RT_OFF - FRAG_JOB_OFF);
+
+	/* Job header: 64-bit, FRAGMENT, index 1. Payload at +32: tile bounds, framebuffer pointer. */
+	volatile uint32_t *hdr = (volatile uint32_t *)(base + FRAG_JOB_OFF);
+	hdr[4] = 1u | (JOB_FRAGMENT << 1) | (1u << 16);
+	hdr[8] = 0;                                                     /* min tile x, y */
+	hdr[9] = ((h / 16u - 1u) << 16) | (w / 16u - 1u);               /* max tile x, y */
+	/* MFBD (bit 0), no ZS/CRC extension, render target count - 1 = 0, 64-byte aligned. */
+	*(volatile uint64_t *)(base + FRAG_JOB_OFF + 40) = (GPU_VA + FRAG_FBD_OFF) | 1u;
+
+	/* pan_samples.c, single-sampled: position 0 and the origin at (128, 128). */
+	volatile uint32_t *sp = (volatile uint32_t *)(base + FRAG_SAMPLES_OFF);
+	sp[0] = 0x00800080u;
+	sp[32] = 0x00800080u;
+
+	/* Framebuffer Parameters (v7.xml), words 0-15; words 16-31 are padding. */
+	volatile uint32_t *fb = (volatile uint32_t *)(base + FRAG_FBD_OFF);
+	fb[0] = frame_modes;                                            /* pre 0, pre 1, post (3 bits each) */
+	*(volatile uint64_t *)(base + FRAG_FBD_OFF + 16) = GPU_VA + FRAG_SAMPLES_OFF;   /* word 4 */
+	*(volatile uint64_t *)(base + FRAG_FBD_OFF + 24) = frame_dcds;  /* word 6: Frame Shader DCDs */
+	fb[8] = ((h - 1u) << 16) | (w - 1u);                            /* width - 1, height - 1 */
+	fb[9] = 0;                                                      /* bound min x, y */
+	fb[10] = ((h - 1u) << 16) | (w - 1u);                           /* bound max x, y */
+	fb[11] = (2u << 6) |            /* tie-break MINUS_180_IN_0_OUT, as Panfrost */
+	    (8u << 9) |                 /* effective tile size log2(16 x 16) */
+	    (1u << 24);                 /* colour buffer allocation 1 KiB (16 x 16 x 4, shr 10) */
+	fb[12] = 1u << 16;              /* Z internal format D24, Panfrost's default without ZS */
+	fb[13] = 0;                     /* Z clear 0.0 */
+	/* words 14-15: tiler 0, a clear-only batch (pan_jm.c makes one only for draws) */
+
+	/* Render Target (v7.xml) at +128. */
+	volatile uint32_t *rt = (volatile uint32_t *)(base + FRAG_RT_DESC_OFF);
+	rt[0] = 1u << 26;               /* internal format R8G8B8A8, buffer offset 0 */
+	rt[1] = 1u |                    /* write enable */
+	    (19u << 3) |                /* writeback format R8G8B8A8 */
+	    (2u << 8) |                 /* block format linear */
+	    (1u << 15) |                /* dithering, as Panfrost */
+	    (swizzle << 16) |           /* R, G, B, A; or B, G, R, A for a BGRA source */
+	    (1u << 31);                 /* clean pixel write: the tile is cleared */
+	*(volatile uint64_t *)(base + FRAG_RT_DESC_OFF + 32) = rt_va;  /* word 8 */
+	rt[10] = stride;                /* row stride */
+	rt[11] = 0;                     /* surface stride */
+	for (unsigned i = 12; i < 16; i++) {
+		rt[i] = color;          /* clear colour */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint32_t slot = JS(0);
+	uint64_t va = GPU_VA + FRAG_JOB_OFF;
+	gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(slot + JS_HEAD_NEXT_LO, (uint32_t)va);
+	gpu_wr(slot + JS_HEAD_NEXT_HI, (uint32_t)(va >> 32));
+	gpu_wr(slot + JS_AFFINITY_NEXT_LO, affinity);
+	gpu_wr(slot + JS_AFFINITY_NEXT_HI, 0);
+	gpu_wr(slot + JS_CONFIG_NEXT, (8u << 16) | (3u << 8) | (3u << 12));
+	r->tried = true;
+	uint64_t start = mach_absolute_time();
+	gpu_wr(slot + JS_COMMAND_NEXT, 1);                              /* START */
+	for (unsigned i = 0; i < 20000; i++) {
+		r->jirq = io_rd(gpu_va, JOB_IRQ_RAWSTAT);
+		r->mirq = io_rd(gpu_va, MMU_IRQ_RAWSTAT);
+		r->girq = io_rd(gpu_va, GPU_IRQ_RAWSTAT);
+		if ((r->jirq & ((1u << 0) | (1u << 16))) || r->mirq ||
+		    (r->girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT))) {
+			break;
+		}
+		delay(10);
+	}
+	r->us = (uint32_t)us_since(start);
+	r->js_status = io_rd(gpu_va, slot + JS_STATUS);
+	r->head = io_rd(gpu_va, slot + JS_HEAD_LO);
+	r->as_fault = io_rd(gpu_va, AS0 + AS_FAULTSTATUS);
+	r->as_addr = io_rd(gpu_va, AS0 + AS_FAULTADDR_LO);
+	r->gpu_fault = io_rd(gpu_va, GPU_FAULT_STATUS);
+	r->gpu_faddr = io_rd(gpu_va, GPU_FAULT_ADDR);
+	r->exc = hdr[0];
+	r->fault_ptr = *(volatile uint64_t *)(base + FRAG_JOB_OFF + 8);
+	if ((r->js_status & 0xffu) == JS_ACTIVE) {
+		gpu_wr(slot + JS_COMMAND, JS_HARD_STOP);
+		(void)gpu_wait(slot + JS_STATUS, 0xffu, 0, 10000);
+	}
+	gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+	return (r->jirq & 1u) && !(r->jirq & (1u << 16)) && !r->mirq &&
+	       !(r->girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT));
+}
+
+static const char *
+frag_failure(const struct frag_result *r)
+{
+	return r->jirq || r->mirq || r->girq ? "FAULT" : "TIMEOUT";
+}
+
+/* 7c-4a: FRAG_W x FRAG_H pixels in the private pages. */
+static bool
+gpu_fragment_clear(uint32_t affinity)
+{
+	unsigned want = 1;
+	(void)PE_parse_boot_argn("a04sfrag", &want, sizeof(want));
+	if (want != 1) {
+		frag.why = "a04sfrag=0";
+		return false;
+	}
+	if (!a04s_gpu_allowed()) {
+		frag.state = "SKIP";
+		frag.why = therm.level == LEVEL_OFF ? "THERMAL OFF" : level_names[therm.level];
+		return false;
+	}
+	volatile uint32_t *px = (volatile uint32_t *)(mem_va + GPU_DATA_OFF + FRAG_RT_OFF);
+	for (unsigned i = 0; i < FRAG_W * FRAG_H; i++) {
+		px[i] = FRAG_FILL;
+	}
+	bool ran = frag_job(GPU_VA + FRAG_RT_OFF, FRAG_W, FRAG_H, FRAG_W * 4u, FRAG_COLOR, affinity, &frag.r, 0, 0, SWIZZLE_RGBA);
+	frag.good = 0;
+	frag.first_bad_at = 0xffffffffu;
+	for (unsigned i = 0; i < FRAG_W * FRAG_H; i++) {
+		uint32_t v = px[i];
+		if (v == FRAG_COLOR) {
+			frag.good++;
+		} else if (frag.first_bad_at == 0xffffffffu) {
+			frag.first_bad_at = i;
+			frag.first_bad = v;
+		}
+	}
+	frag.corner[0] = px[0];
+	frag.corner[1] = px[FRAG_W - 1u];
+	frag.corner[2] = px[(FRAG_H - 1u) * FRAG_W];
+	frag.corner[3] = px[FRAG_W * FRAG_H - 1u];
+	if (ran && frag.good == FRAG_W * FRAG_H) {
+		frag.state = "OK";
+		frag.why = "THE MALI-G52 CLEARED A RENDER TARGET";
+		kprintf("A04S GPU FRAGMENT OK %u/%u pixels in %u us\n", frag.good, FRAG_W * FRAG_H, frag.r.us);
+		return true;
+	}
+	frag.state = "FAIL";
+	frag.why = !ran ? frag_failure(&frag.r) : "PIXELS";
+	kprintf("A04S GPU FRAGMENT FAIL %s %u/%u EXC %x\n", frag.why, frag.good, FRAG_W * FRAG_H, frag.r.exc);
+	return false;
+}
+
+/*
+ * 7c-4b, before the page tables are built: the board's scan-out buffer (the one SweetFramebuffer
+ * uses), accepted for the GPU only in whole tiles, with a sane stride, inside the reserved region.
+ */
+static void
+panel_probe(void)
+{
+	unsigned want = 1;
+	(void)PE_parse_boot_argn("a04spanel", &want, sizeof(want));
+	if (want != 1) {
+		panel.why = "a04spanel=0";
+		return;
+	}
+	panel.pa = A5XELTE_FB_PA;
+	panel.w = A5XELTE_FB_WIDTH;
+	panel.h = A5XELTE_FB_HEIGHT;
+	panel.stride = A5XELTE_FB_STRIDE;
+	panel.state = "SKIP";
+	uint64_t bytes = (uint64_t)panel.stride * panel.h;
+	if (panel.pa != PANEL_PA) {
+		panel.why = "NOT THE BOOT BUFFER";
+	} else if (panel.w == 0 || panel.h == 0 || panel.w % 16u || panel.h % 16u || panel.w > 4096u || panel.h > 4096u) {
+		panel.why = "SIZE";
+	} else if (panel.stride < panel.w * 4u || panel.stride % 16u) {
+		panel.why = "STRIDE";
+	} else if (bytes > PANEL_MAX_BLOCKS * BLOCK_2M) {
+		panel.why = "TOO LARGE";
+	} else {
+		panel.blocks = (uint32_t)((bytes + BLOCK_2M - 1u) / BLOCK_2M);
+		panel.state = "READY";
+		panel.why = "MAPPED";
+	}
+}
+
+/* 7c-4b: the whole panel cleared green, held PANEL_HOLD_MS, read back. */
+static bool
+gpu_panel_clear(uint32_t affinity)
+{
+	if (panel.blocks == 0) {
+		return false;           /* panel_probe() said why */
+	}
+	if (!a04s_gpu_allowed()) {
+		panel.state = "SKIP";
+		panel.why = therm.level == LEVEL_OFF ? "THERMAL OFF" : level_names[therm.level];
+		return false;
+	}
+	uint64_t hold;
+	nanoseconds_to_absolutetime((uint64_t)PANEL_HOLD_MS * 1000000ull, &hold);
+	sweet_fb_hold_until = mach_absolute_time() + hold;
+	bool ran = frag_job(PANEL_VA, panel.w, panel.h, panel.stride, PANEL_COLOR, affinity, &panel.r, 0, 0, SWIZZLE_RGBA);
+	vm_offset_t pix = ml_io_map((vm_offset_t)panel.pa, (vm_size_t)panel.stride * panel.h);
+	if (pix) {
+		uint64_t start = mach_absolute_time();
+		panel.total = panel.w * panel.h;
+		panel.good = 0;
+		for (uint32_t y = 0; y < panel.h; y++) {
+			volatile uint32_t *row = (volatile uint32_t *)(pix + (vm_offset_t)y * panel.stride);
+			for (uint32_t x = 0; x < panel.w; x++) {
+				if (row[x] == PANEL_COLOR) {
+					panel.good++;
+				}
+			}
+		}
+		panel.check_ms = (uint32_t)(us_since(start) / 1000u);
+		const uint32_t at[5][2] = { { 0, 0 }, { panel.w - 1u, 0 }, { 0, panel.h - 1u },
+			                    { panel.w - 1u, panel.h - 1u }, { panel.w / 2u, panel.h / 2u } };
+		for (unsigned i = 0; i < 5; i++) {
+			panel.samples[i] = *(volatile uint32_t *)(pix + (vm_offset_t)at[i][1] * panel.stride + at[i][0] * 4u);
+		}
+	}
+	/* The console keeps printing over the panel, so a few rows of text may differ: 90% is a pass. */
+	if (ran && pix && (uint64_t)panel.good * 10u >= (uint64_t)panel.total * 9u) {
+		panel.state = "OK";
+		panel.why = "THE MALI-G52 DREW THE SCREEN";
+		kprintf("A04S GPU PANEL OK %u/%u pixels in %u us\n", panel.good, panel.total, panel.r.us);
+		return true;
+	}
+	panel.state = "FAIL";
+	panel.why = !ran ? frag_failure(&panel.r) : !pix ? "NO MAPPING" : "PIXELS";
+	kprintf("A04S GPU PANEL FAIL %s %u/%u EXC %x\n", panel.why, panel.good, panel.total, panel.r.exc);
+	return false;
+}
+
+static inline void
+put64(vm_offset_t at, uint64_t v)
+{
+	*(volatile uint64_t *)at = v;
+}
+
+/* IEEE-754 single bits of a small whole number, so no floating point runs in the kernel. */
+static uint32_t
+f32_bits(uint32_t v)
+{
+	if (v == 0) {
+		return 0;
+	}
+	unsigned e = 31u - (unsigned)__builtin_clz(v);
+	uint32_t mant = e <= 23u ? (v << (23u - e)) & 0x7fffffu : (v >> (e - 23u)) & 0x7fffffu;
+	return ((127u + e) << 23) | mant;
+}
+
+static bool
+channel_near(uint32_t got, uint32_t want, unsigned shift)
+{
+	uint32_t g = (got >> shift) & 0xffu, w = (want >> shift) & 0xffu;
+	return g + 2u >= w && g <= w + 2u;
+}
+
+/* The gradient's pixel at (x, y): R x/720, G y/1600, B 0.5, A 1, in the RGBA8 bytes it writes. */
+static uint32_t
+gradient_want(uint32_t x, uint32_t y)
+{
+	uint32_t r = (x * 255u + panel.w / 2u) / panel.w;
+	uint32_t g = (y * 255u + panel.h / 2u) / panel.h;
+	return 0xff000000u | (128u << 16) | (g << 8) | r;
+}
+
+/* The thread storage, viewport and panel rectangle every frame shader here uses. */
+static void
+frame_setup(void)
+{
+	vm_offset_t base = mem_va + GPU_DATA_OFF;
+	/* Thread storage: no TLS, no workgroup memory (as the S7's Local Storage word 1 = 31). */
+	gpu_zero(base + SH_TSD_OFF, SH_END_OFF - SH_TSD_OFF);
+	*(volatile uint32_t *)(base + SH_TSD_OFF + 4) = 31u;
+
+	/* Viewport: infinite bounds, depth 0..1, scissor the whole panel. */
+	volatile uint32_t *vp = (volatile uint32_t *)(base + SH_VIEWPORT_OFF);
+	vp[0] = 0xff800000u;
+	vp[1] = 0xff800000u;
+	vp[2] = 0x7f800000u;
+	vp[3] = 0x7f800000u;
+	vp[4] = 0;
+	vp[5] = 0x3f800000u;
+	vp[6] = 0;
+	vp[7] = ((panel.h - 1u) << 16) | (panel.w - 1u);
+
+	/* The rectangle (x, y, z, w) at the four corners. */
+	volatile uint32_t *rect = (volatile uint32_t *)(base + SH_RECT_OFF);
+	const uint32_t xs[4] = { 0, panel.w, 0, panel.w }, ys[4] = { 0, 0, panel.h, panel.h };
+	for (unsigned i = 0; i < 4; i++) {
+		rect[4 * i + 0] = f32_bits(xs[i]);
+		rect[4 * i + 1] = f32_bits(ys[i]);
+		rect[4 * i + 2] = 0;
+		rect[4 * i + 3] = 0x3f800000u;
+	}
+}
+
+/* 7c-4c: Mesa's gradient as the panel's pre-frame shader, held SH_HOLD_MS, checked pixel by pixel. */
+static void
+gpu_shader_gradient(uint32_t affinity)
+{
+	unsigned want = 1;
+	(void)PE_parse_boot_argn("a04sshader", &want, sizeof(want));
+	if (want != 1) {
+		shade.why = "a04sshader=0";
+		return;
+	}
+	if (!a04s_gpu_allowed()) {
+		shade.state = "SKIP";
+		shade.why = therm.level == LEVEL_OFF ? "THERMAL OFF" : level_names[therm.level];
+		return;
+	}
+	vm_offset_t base = mem_va + GPU_DATA_OFF;
+	gpu_zero(base + SH_CODE_OFF, SH_TSD_OFF - SH_CODE_OFF);
+	volatile uint8_t *code = (volatile uint8_t *)(base + SH_CODE_OFF);
+	for (unsigned i = 0; i < sizeof(a04s_sh_gradient); i++) {
+		code[i] = a04s_sh_gradient[i];
+	}
+
+	/* Draw (v7.xml), pre-frame 0: 64-bit, four components a vertex; tiles stay dirty (written). */
+	vm_offset_t dcd = base + SH_DCD_OFF;
+	*(volatile uint32_t *)dcd = 3u;
+	put64(dcd + 16, GPU_VA + SH_RECT_OFF);          /* word 4: position */
+	put64(dcd + 56, GPU_VA + SH_RSD_OFF);           /* word 14: renderer state */
+	put64(dcd + 96, GPU_VA + SH_VIEWPORT_OFF);      /* word 24: viewport */
+	put64(dcd + 112, GPU_VA + SH_TSD_OFF);          /* word 28: thread storage */
+
+	/* Renderer State (v7.xml), as pan_shader_prepare_rsd() and pan_preload_emit_rsd() fill it. */
+	volatile uint32_t *rsd = (volatile uint32_t *)(base + SH_RSD_OFF);
+	put64(base + SH_RSD_OFF, GPU_VA + SH_CODE_OFF); /* shader; no samplers, textures or varyings */
+	rsd[4] = (2u << 8) |            /* depth source: fixed function */
+	    (2u << 12) |                /* 32 registers a thread */
+	    (1u << 19) |                /* allow forward pixel kill */
+	    (1u << 20) |                /* allow being killed; pixel kill and ZS update force early (0) */
+	    RSD_WAIT_6_7;               /* Mesa: wait_6 = wait_7 = 1 */
+	rsd[8] = 0xffffu | (7u << 24);  /* sample mask, depth function ALWAYS */
+	rsd[9] = 0xffffu;               /* stencil masks, stencil off */
+	rsd[10] = 0x024fff00u;          /* stencil front: ALWAYS, REPLACE x3, mask 0xff */
+	rsd[11] = 0x024fff00u;          /* stencil back, the same */
+	rsd[12] = (1u << 7) | (1u << 11);       /* preload coverage (r60) and fragment position (r59) */
+
+	/* Blend for render target 0, right after the renderer state (pan_preload_emit_blend). */
+	volatile uint32_t *blend = rsd + 16;
+	blend[0] = (1u << 9) | (1u << 11);      /* enable, round to the framebuffer's precision */
+	blend[1] = 0xf0122122u;         /* RGB and alpha: A = src, B = src, C = zero; colour mask 0xf */
+	blend[2] = 1u | (3u << 3);      /* opaque; fixed function, four components, RT 0 */
+	blend[3] = (237u << 12) | (1u << 24);   /* memory format RGBA8_TB, RGBA order; registers F32 */
+
+	frame_setup();
+
+	uint64_t hold;
+	nanoseconds_to_absolutetime((uint64_t)SH_HOLD_MS * 1000000ull, &hold);
+	sweet_fb_hold_until = mach_absolute_time() + hold;
+	bool ran = frag_job(PANEL_VA, panel.w, panel.h, panel.stride, SH_CLEAR, affinity, &shade.r,
+	    GPU_VA + SH_DCD_OFF, FRAME_MODE_ALWAYS, SWIZZLE_RGBA);
+	vm_offset_t pix = ml_io_map((vm_offset_t)panel.pa, (vm_size_t)panel.stride * panel.h);
+	if (pix) {
+		shade.total = panel.w * panel.h;
+		shade.good = 0;
+		for (uint32_t y = 0; y < panel.h; y++) {
+			volatile uint32_t *row = (volatile uint32_t *)(pix + (vm_offset_t)y * panel.stride);
+			for (uint32_t x = 0; x < panel.w; x++) {
+				uint32_t v = row[x], w = gradient_want(x, y);
+				if (channel_near(v, w, 0) && channel_near(v, w, 8) && channel_near(v, w, 16) &&
+				    channel_near(v, w, 24)) {
+					shade.good++;
+				}
+			}
+		}
+		const uint32_t at[5][2] = { { 0, 0 }, { panel.w - 1u, 0 }, { 0, panel.h - 1u },
+			                    { panel.w - 1u, panel.h - 1u }, { panel.w / 2u, panel.h / 2u } };
+		for (unsigned i = 0; i < 5; i++) {
+			shade.samples[i] = *(volatile uint32_t *)(pix + (vm_offset_t)at[i][1] * panel.stride + at[i][0] * 4u);
+			shade.want[i] = gradient_want(at[i][0], at[i][1]);
+		}
+	}
+	if (ran && pix && (uint64_t)shade.good * 10u >= (uint64_t)shade.total * 9u) {
+		shade.state = "OK";
+		shade.why = "THE MALI-G52 RAN A SHADER";
+		kprintf("A04S GPU SHADER OK %u/%u pixels in %u us\n", shade.good, shade.total, shade.r.us);
+	} else {
+		shade.state = "FAIL";
+		shade.why = !ran ? frag_failure(&shade.r) : !pix ? "NO MAPPING" : "PIXELS";
+		kprintf("A04S GPU SHADER FAIL %s %u/%u EXC %x\n", shade.why, shade.good, shade.total, shade.r.exc);
+	}
+}
+
+/*
+ * 7c-4d: the blit shader's Draw for a w x h BGRA source at GPU VA src (stride bytes a row), scaled to
+ * the whole panel. frame_setup() must have run. Called from the GPU thread at boot, then only from
+ * SweetFramebuffer's present path, which its vsync timer serialises.
+ */
+static void
+blit_setup(uint64_t src, uint32_t w, uint32_t h, uint32_t stride, uint32_t variant)
+{
+	vm_offset_t base = mem_va + GPU_DATA_OFF;
+	gpu_zero(base + BL_TEX_OFF, BL_CODE_OFF - BL_TEX_OFF);
+
+	/* Texture (v7.xml) and its one surface. */
+	volatile uint32_t *tex = (volatile uint32_t *)(base + BL_TEX_OFF);
+	tex[0] = 2u |                   /* type: texture */
+	    (2u << 4) |                 /* dimension 2D; coordinates as the sampler says */
+	    ((variant & BLV_RGBA ? (187u << 12) : TEX_FMT_BGRA8) << 10);
+	tex[1] = ((h - 1u) << 16) | (w - 1u);
+	tex[2] = SWIZZLE_RGBA |         /* identity */
+	    (2u << 12);                 /* linear; one level */
+	put64(base + BL_TEX_OFF + 16, GPU_VA + BL_SURF_OFF);    /* word 4: surfaces */
+	put64(base + BL_SURF_OFF, src);
+	*(volatile uint32_t *)(base + BL_SURF_OFF + 8) = stride;
+	*(volatile uint32_t *)(base + BL_SURF_OFF + 12) = stride * h;
+
+	/* Sampler (v7.xml): clamp to edge, bilinear, unnormalised coordinates (pan_preload_emit_sampler). */
+	*(volatile uint32_t *)(base + BL_SAMPLER_OFF) = 1u | (9u << 8) | (9u << 12) | (9u << 16) |
+	    (1u << 21) |                /* round to nearest even */
+	    (1u << 26) |                /* clamp integer array indices; seamless cube off */
+	    (variant & BLV_NORM ? 1u << 25 : 0) |   /* normalised coordinates (off: texels) */
+	    (variant & BLV_NEAREST ? (1u << 27) | (1u << 28) : 0);  /* nearest (off: bilinear) */
+
+	/* Varying 0: RGB32F from attribute buffer 0, no offset (Bifrost). */
+	*(volatile uint32_t *)(base + BL_ATTR_OFF) = ATTR_FMT_RGB32F << 10;
+	/* Attribute buffer 0: the source corners, 16 bytes a vertex; buffer 1 empty, to end prefetching. */
+	put64(base + BL_ABUF_OFF, (GPU_VA + BL_COORDS_OFF) | 1u);         /* type 1D */
+	*(volatile uint32_t *)(base + BL_ABUF_OFF + 8) = 16u;
+	*(volatile uint32_t *)(base + BL_ABUF_OFF + 12) = 64u;
+	*(volatile uint32_t *)(base + BL_ABUF_OFF + 16) = 1u;
+	volatile uint32_t *coords = (volatile uint32_t *)(base + BL_COORDS_OFF);
+	uint32_t uw = variant & BLV_NORM ? 1u : w, vh = variant & BLV_NORM ? 1u : h;
+	const uint32_t us[4] = { 0, uw, 0, uw }, vs[4] = { 0, 0, vh, vh };
+	for (unsigned i = 0; i < 4; i++) {
+		coords[4 * i + 0] = f32_bits(us[i]);
+		coords[4 * i + 1] = f32_bits(vs[i]);
+		coords[4 * i + 2] = 0;
+		coords[4 * i + 3] = 0x3f800000u;
+	}
+
+	/* Draw, pre-frame 0. */
+	vm_offset_t dcd = base + BL_DCD_OFF;
+	*(volatile uint32_t *)dcd = 3u;
+	put64(dcd + 16, GPU_VA + SH_RECT_OFF);          /* word 4: position, the panel's corners */
+	put64(dcd + 32, GPU_VA + BL_TEX_OFF);           /* word 8: textures */
+	put64(dcd + 40, GPU_VA + BL_SAMPLER_OFF);       /* word 10: samplers */
+	put64(dcd + 56, GPU_VA + BL_RSD_OFF);           /* word 14: renderer state */
+	put64(dcd + 80, GPU_VA + BL_ABUF_OFF);          /* word 20: varying buffers */
+	put64(dcd + 88, GPU_VA + BL_ATTR_OFF);          /* word 22: varyings */
+	put64(dcd + 96, GPU_VA + SH_VIEWPORT_OFF);      /* word 24: viewport */
+	put64(dcd + 112, GPU_VA + SH_TSD_OFF);          /* word 28: thread storage */
+
+	/* Renderer State: as the gradient's, with one sampler, one texture, one varying, and message
+	 * preload 1 = VAR_TEX (varying 0, texture 0, F32, zero LOD) from the compiler's info. */
+	volatile uint32_t *rsd = (volatile uint32_t *)(base + BL_RSD_OFF);
+	put64(base + BL_RSD_OFF, GPU_VA + BL_CODE_OFF);
+	rsd[2] = 1u | (1u << 16);       /* samplers, textures */
+	rsd[3] = 1u << 16;              /* varyings */
+	rsd[4] = (2u << 8) | (2u << 12) | (1u << 19) | (1u << 20) | RSD_WAIT_6_7;
+	rsd[8] = 0xffffu | (7u << 24);
+	rsd[9] = 0xffffu;
+	rsd[10] = 0x024fff00u;
+	rsd[11] = 0x024fff00u;
+	if (variant & BLV_GRADIENT) {
+		rsd[12] = (1u << 7) | (1u << 11);       /* the gradient: coverage and fragment position */
+		rsd[15] = 0;
+	} else {
+		rsd[12] = 1u << 7;      /* preload coverage (r60) only */
+		rsd[15] = 2u | (1u << 15);      /* message preload 1: VAR_TEX, zero LOD */
+	}
+	volatile uint32_t *blend = rsd + 16;
+	blend[0] = (1u << 9) | (1u << 11);
+	blend[1] = 0xf0122122u;
+	blend[2] = 1u | (3u << 3);
+	blend[3] = (237u << 12) | (1u << 24);
+
+	volatile uint8_t *code = (volatile uint8_t *)(base + BL_CODE_OFF);
+	const unsigned char *bin = variant & BLV_GRADIENT ? a04s_sh_gradient : a04s_sh_blit;
+	for (unsigned i = 0; i < sizeof(a04s_sh_blit); i++) {
+		code[i] = bin[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* The test image's colour at (x, y) of 64 x 64, as BGRA memory words: red, green / blue, white. */
+static uint32_t
+blit_test_color(uint32_t x, uint32_t y)
+{
+	if (y < BL_TEST_H / 2u) {
+		return x < BL_TEST_W / 2u ? 0xffff0000u : 0xff00ff00u;
+	}
+	return x < BL_TEST_W / 2u ? 0xff0000ffu : 0xffffffffu;
+}
+
+/* 7c-4d boot test: the 64 x 64 image (in the private render target's pages) scaled to the panel. */
+static bool
+gpu_blit_test(uint32_t affinity)
+{
+	unsigned want = 1;
+	(void)PE_parse_boot_argn("a04sblit", &want, sizeof(want));
+	if (want != 1) {
+		blit.why = "a04sblit=0";
+		return false;
+	}
+	if (!a04s_gpu_allowed()) {
+		blit.state = "SKIP";
+		blit.why = therm.level == LEVEL_OFF ? "THERMAL OFF" : level_names[therm.level];
+		return false;
+	}
+	volatile uint32_t *img = (volatile uint32_t *)(mem_va + GPU_DATA_OFF + FRAG_RT_OFF);
+	for (uint32_t y = 0; y < BL_TEST_H; y++) {
+		for (uint32_t x = 0; x < BL_TEST_W; x++) {
+			img[y * BL_TEST_W + x] = blit_test_color(x, y);
+		}
+	}
+	frame_setup();
+	vm_offset_t pix = ml_io_map((vm_offset_t)panel.pa, (vm_size_t)panel.stride * panel.h);
+	if (!pix) {
+		blit.state = "FAIL";
+		blit.why = "NO MAPPING";
+		return false;
+	}
+	const uint32_t at[5][2] = { { panel.w / 4u, panel.h / 4u }, { 3u * panel.w / 4u, panel.h / 4u },
+		                    { panel.w / 4u, 3u * panel.h / 4u }, { 3u * panel.w / 4u, 3u * panel.h / 4u },
+		                    { panel.w / 2u, panel.h / 2u } };
+	const uint32_t quad_want[4] = { 0xffff0000u, 0xff00ff00u, 0xff0000ffu, 0xffffffffu };
+	const uint32_t variants[BL_VARIANTS] = { 0, BLV_NEAREST, BLV_RGBA, BLV_NORM, BLV_GRADIENT };
+	uint64_t hold;
+	nanoseconds_to_absolutetime((uint64_t)SH_HOLD_MS * 1000000ull, &hold);
+	sweet_fb_hold_until = mach_absolute_time() + hold;
+	for (unsigned v = 0; v < BL_VARIANTS; v++) {
+		struct frag_result vr = { 0 };
+		blit_setup(GPU_VA + FRAG_RT_OFF, BL_TEST_W, BL_TEST_H, BL_TEST_W * 4u, variants[v]);
+		blit.var_ran[v] = frag_job(PANEL_VA, panel.w, panel.h, panel.stride, BL_CLEAR, affinity, &vr,
+		    GPU_VA + BL_DCD_OFF, FRAME_MODE_ALWAYS, SWIZZLE_BGRA);
+		blit.var_exc[v] = vr.exc;
+		blit.var_us[v] = vr.us;
+		bool match = blit.var_ran[v] && !(variants[v] & BLV_GRADIENT);
+		for (unsigned i = 0; i < 5; i++) {
+			blit.var_samples[v][i] = *(volatile uint32_t *)(pix + (vm_offset_t)at[i][1] * panel.stride + at[i][0] * 4u);
+			if (i < 4 && blit.var_samples[v][i] != quad_want[i]) {
+				match = false;
+			}
+		}
+		blit.var_count = v + 1u;
+		kprintf("A04S GPU BLIT VARIANT %x %s %x %x %x %x %x\n", variants[v], blit.var_ran[v] ? "RAN" : "FAULT",
+		    blit.var_samples[v][0], blit.var_samples[v][1], blit.var_samples[v][2], blit.var_samples[v][3],
+		    blit.var_samples[v][4]);
+		if (!blit.var_ran[v]) {
+			break;          /* a fault: no further variants this boot */
+		}
+		if (match && blit.variant == 0xffffffffu) {
+			blit.variant = variants[v];
+		}
+	}
+	if (blit.variant == 0xffffffffu) {
+		blit.state = "FAIL";
+		blit.why = "NO VARIANT";
+		kprintf("A04S GPU BLIT FAIL: no variant drew the test image\n");
+		return false;
+	}
+	blit_setup(GPU_VA + FRAG_RT_OFF, BL_TEST_W, BL_TEST_H, BL_TEST_W * 4u, blit.variant);
+	sweet_fb_hold_until = mach_absolute_time() + hold;
+	bool ran = frag_job(PANEL_VA, panel.w, panel.h, panel.stride, BL_CLEAR, affinity, &blit.r,
+	    GPU_VA + BL_DCD_OFF, FRAME_MODE_ALWAYS, SWIZZLE_BGRA);
+	{
+		/* Each quadrant's inner part: away from the bilinear seam in the middle (and the edges). */
+		blit.good = 0;
+		blit.total = 0;
+		for (uint32_t y = 0; y < panel.h; y++) {
+			uint32_t sy = y * BL_TEST_H / panel.h;
+			if (y < 64u || y + 64u >= panel.h || (y + 80u > panel.h / 2u && y < panel.h / 2u + 80u)) {
+				continue;
+			}
+			volatile uint32_t *row = (volatile uint32_t *)(pix + (vm_offset_t)y * panel.stride);
+			for (uint32_t x = 0; x < panel.w; x++) {
+				if (x < 32u || x + 32u >= panel.w || (x + 40u > panel.w / 2u && x < panel.w / 2u + 40u)) {
+					continue;
+				}
+				blit.total++;
+				if (row[x] == blit_test_color(x * BL_TEST_W / panel.w, sy)) {
+					blit.good++;
+				}
+			}
+		}
+		for (unsigned i = 0; i < 4; i++) {
+			blit.samples[i] = *(volatile uint32_t *)(pix + (vm_offset_t)at[i][1] * panel.stride + at[i][0] * 4u);
+		}
+	}
+	if (ran && blit.total && (uint64_t)blit.good * 10u >= (uint64_t)blit.total * 9u) {
+		blit.state = "OK";
+		blit.why = "THE MALI-G52 SCALED AN IMAGE";
+		kprintf("A04S GPU BLIT OK %u/%u pixels in %u us\n", blit.good, blit.total, blit.r.us);
+		return true;
+	}
+	blit.state = "FAIL";
+	blit.why = !ran ? frag_failure(&blit.r) : "PIXELS";
+	kprintf("A04S GPU BLIT FAIL %s %u/%u EXC %x\n", blit.why, blit.good, blit.total, blit.r.exc);
+	return false;
+}
+
+static bool
+gpu_as_update(void)
+{
+	uint64_t transtab = GPU_MEM_PA | 7u;
+	gpu_wr(AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	gpu_wr(AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	gpu_wr(AS0 + AS_MEMATTR_LO, 0x888d88u);
+	gpu_wr(AS0 + AS_MEMATTR_HI, 0);
+	gpu_wr(AS0 + AS_TRANSCFG_LO, 0);
+	gpu_wr(AS0 + AS_TRANSCFG_HI, 0);
+	gpu_wr(AS0 + AS_COMMAND, 1);                            /* UPDATE: new tables, TLB flushed */
+	return gpu_wait(AS0 + AS_STATUS, 1u, 0, 100000);
+}
+
+/*
+ * For SweetFramebuffer (sweetfb_gpu=1), its HEROLTE interface: a slot already holding surface id
+ * with this first page, or -1. Only after the boot tests passed, and never after a fault.
+ */
+int a04s_gpu_present_slot(uint32_t id, uint64_t first_pa);
+int
+a04s_gpu_present_slot(uint32_t id, uint64_t first_pa)
+{
+	if (!present_ready || present_broken) {
+		return -1;
+	}
+	for (unsigned i = 0; i < SLOT_COUNT; i++) {
+		if (slots[i].pages && slots[i].id == id && slots[i].first_pa == first_pa) {
+			slots[i].used = ++present_seq;
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+/* Map a surface's n 4 KiB pages into the least recently used slot. */
+int a04s_gpu_present_map(uint32_t id, const uint64_t *pages, unsigned n);
+int
+a04s_gpu_present_map(uint32_t id, const uint64_t *pages, unsigned n)
+{
+	if (!present_ready || present_broken || n == 0 || n > SLOT_PAGES) {
+		return -1;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		/* Only RAM above XNU's own image and below the second bank's end (iomem). */
+		if (pages[i] == 0 || (pages[i] & 0xfffu) || pages[i] < 0x92000000ull || pages[i] >= 0x900000000ull) {
+			return -1;
+		}
+	}
+	unsigned v = 0;
+	for (unsigned i = 1; i < SLOT_COUNT; i++) {
+		if (slots[i].used < slots[v].used) {
+			v = i;
+		}
+	}
+	if (!lck_mtx_try_lock(&a04s_gpu_mtx)) {
+		present_busy++;
+		return -1;
+	}
+	volatile uint64_t *l3 = (volatile uint64_t *)(mem_va + SLOT_L3_OFF(v));
+	for (unsigned i = 0; i < SLOT_PAGES; i++) {
+		l3[i] = i < n ? (pages[i] | 0x2c1) : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool updated = gpu_as_update();
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	if (!updated) {
+		present_broken = true;
+		kprintf("A04S GPU PRESENT OFF: MMU update timed out\n");
+		return -1;
+	}
+	slots[v].id = id;
+	slots[v].first_pa = pages[0];
+	slots[v].pages = n;
+	slots[v].maps++;
+	slots[v].used = ++present_seq;
+	present_remaps++;
+	return (int)v;
+}
+
+/* Scale w x h pixels at byte off in slot s (stride bytes a row) to the whole panel. */
+bool a04s_gpu_present_draw(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h);
+bool
+a04s_gpu_present_draw(int s, uint32_t off, uint32_t stride, uint32_t w, uint32_t h)
+{
+	if (!present_ready || present_broken || s < 0 || (unsigned)s >= SLOT_COUNT || w == 0 || h == 0 ||
+	    w > 4096u || h > 4096u || stride < w * 4u || (uint64_t)off + (uint64_t)stride * h >
+	    (uint64_t)slots[s].pages * 0x1000u || !a04s_gpu_allowed()) {
+		return false;
+	}
+	if (!lck_mtx_try_lock(&a04s_gpu_mtx)) {
+		present_busy++;         /* a user job is running: this frame takes the CPU copy */
+		return false;
+	}
+	if (sched_hw_busy != 0) {
+		lck_mtx_unlock(&a04s_gpu_mtx);
+		present_busy++;         /* v64: the scheduler has user jobs on the slots */
+		return false;
+	}
+	blit_setup(SLOT_VA((unsigned)s) + off, w, h, stride, blit.variant);
+	struct frag_result r = { 0 };
+	bool ok = frag_job(PANEL_VA, panel.w, panel.h, panel.stride, SH_CLEAR, gpu_affinity, &r,
+	    GPU_VA + BL_DCD_OFF, FRAME_MODE_ALWAYS, SWIZZLE_BGRA);
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	if (!ok) {
+		present_fails++;
+		present_fault = r;
+		present_broken = true;
+		kprintf("A04S GPU PRESENT OFF: frame %u, IRQ %x MMU %x GPU %x EXC %x\n", present_frames, r.jirq, r.mirq,
+		    r.girq, r.exc);
+		return false;
+	}
+	present_frames++;
+	present_last_us = r.us;
+	present_total_us += r.us;
+	if (r.us > present_max_us) {
+		present_max_us = r.us;
+	}
+	return true;
+}
+
+/*
+ * 7c-5a: the kernel half of user GPU jobs (the IOKit service and user client are 7c-5b). User jobs
+ * run in their own address space, AS1, so they can't reach the panel, the private block or the
+ * present slots: those are mapped in AS0 only. AS1's tables sit in the window above XNU's RAM,
+ * after the private block: L0, L1 and L2 at UPT_PA, then up to 512 level-3 tables, enough for the
+ * whole 1 GiB user range (GPU VA 0x40000000-0x80000000, handed out in 64 KiB chunks). A page may
+ * be mapped only if it is XNU's RAM (0x92000000-0xbc000000 or 0x880000000-0x8eba00000, the loader's
+ * two windows as the ADT gives them) or the self-test's own buffer, so a user mapping can never
+ * cover the GPU's tables, the private block or the panel.
+ *
+ * Jobs run one at a time under a04s_gpu_mtx, polled for at most 1 s and then hard-stopped, and
+ * each first checks the thermal limit. After a fault in AS1, AS1 is updated again so the next job
+ * starts clean; AS0 is not touched. The present path only tries the lock: while a user job runs,
+ * that frame takes the CPU copy.
+ *
+ * a04sgpu_selftest=1, after the boot tests: a WRITE_VALUE (ZERO) job in AS1 on a buffer mapped in
+ * AS1 (must work), the same job aimed at AS0's private GPU VA (must fault in AS1, and the private
+ * page must keep its marker: the isolation test), then 7c-4a's private clear in AS0 (must still work).
+ *
+ * v47: a faulting AS1 job is ended as Panfrost and kbase do (user_recover_locked()), and the
+ * self-test runs a second WRITE_VALUE in AS1 after the fault, so a pass also shows AS1 is usable
+ * again after a bad job. If the recovery itself fails, AS1 stays out of service until a reboot.
+ *
+ * v50 (7c-5b): the HeroGPU user client (iokit/Kernel/arm/HeroGPU.cpp) opens and closes through
+ * a04s_gpu_user_open()/a04s_gpu_user_close(). The first open brings AS1 and the cores up; the last
+ * close, once every user buffer's VA is back, powers the cores off again, unless the present path
+ * (sweetfb_gpu=1) is using them. Jobs the thermal limit refused are counted (HOT).
+ */
+/*
+ * v65 (7c-7b): one GPU address space per client. AS0 stays the kernel's (the present path, the boot
+ * tests); clients get AS1-AS7, as many as AS_PRESENT has. backboardd always gets AS1 (the display AS,
+ * never shared with another process); every other client gets a free AS of AS2-AS7, and once those
+ * are all taken the extras share the last one. An AS is free again only when its last client has gone,
+ * every buffer mapped in it is unmapped and no job of it is queued or running, so a new client never
+ * inherits a mapping. Each AS has its own 1 GiB of GPU VA (0x40000000-0x80000000, its own allocator)
+ * and its own L0, L1 and L2 tables at UPT_PA + (as - 1) * 0x3000; the L3 tables come from one pool of
+ * 744 pages after them (up to the self-test's buffer), and an AS gives its L3 tables back when it is
+ * released. A fault, or a job past its time, ends only the jobs of that AS; the other slot's job, in
+ * another AS, runs on. A recovery that fails puts only that AS out of service for the rest of the boot.
+ * user_page_ok() is unchanged: every page any AS maps is still checked to be XNU's RAM.
+ */
+#define AS_N(as)                (AS0 + 0x40u * (as))
+#define AS1                     AS_N(1u)                /* the boot self-test's */
+#define AS_TRANSTAB_UNMAPPED    0u                      /* ADRMODE 0: every access faults */
+#define AS_FAULT_BITS(as)       ((1u << (as)) | (1u << (16u + (as))))   /* the AS's page fault and bus fault */
+#define AS1_FAULT_BITS          AS_FAULT_BITS(1u)
+#define USER_STOP_US            100000u
+#define GPU_AS_PRESENT          0x018u
+#define USER_AS_LAST            7u                      /* AS1-AS7 for clients */
+#define USER_AS_DISPLAY         1u                      /* backboardd's */
+#define UPT_PA                  0xbc100000ull
+#define UPT_TOP_BYTES           0x3000u                 /* one AS's L0, L1 and L2 */
+#define UPT_POOL_OFF            0x18000u                /* after AS1-AS7's top tables (0x15000) */
+#define UPT_BYTES               0x300000u               /* up to the self-test's buffer */
+#define UPT_POOL_MAX            ((UPT_BYTES - UPT_POOL_OFF) / 0x1000u)  /* 744 L3 tables, shared */
+#define UTEST_PA                0xbc400000ull           /* the self-test's buffer */
+#define UTEST_BYTES             0x10000u
+#define UTEST_PAGES             16u
+#define USER_VA_BASE            0x40000000ull
+#define USER_VA_END             0x80000000ull
+#define USER_CHUNK              0x10000ull
+#define USER_CHUNKS             16384u                  /* (USER_VA_END - USER_VA_BASE) / USER_CHUNK */
+#define USER_JOB_POLLS          100000u                 /* 10 us each: 1 s */
+#define UTEST_MARKER            0x1234567887654321ull
+#if UPT_PA < GPU_MEM_PA + GPU_MEM_BYTES || UTEST_PA != UPT_PA + UPT_BYTES || UTEST_PA + UTEST_BYTES > RAM_WINDOW_END
+#error "the ASes' tables and the self-test buffer must sit in the window, clear of the private block and of each other"
+#endif
+#if UPT_POOL_OFF < USER_AS_LAST * UPT_TOP_BYTES
+#error "the L3 pool must start after every AS's top tables"
+#endif
+#if UTEST_PAGES * 0x1000u != UTEST_BYTES
+#error "UTEST_PAGES must cover UTEST_BYTES"
+#endif
+
+static vm_offset_t upt_va, utest_va;
+static unsigned user_clients, user_chunks, user_opens, user_hot;  /* with a04s_gpu_mtx; totals over the ASes */
+
+/*
+ * v51: a GPU test's verdict line is kept and repeated in every heartbeat ("GPUNOTE ..."), so any
+ * later photo of the console shows it. Slot 0: a client's "A04S GPU TEST PASS/FAIL ..." line
+ * (HeroGPU's Log call); slot 1: HeroGPU's own "HEROGPU SELFTEST ..." outcome. The first line in
+ * each slot is kept for the rest of the boot. Bytes outside printable ASCII become '?'. No lock:
+ * the slot is claimed once, and the heartbeat reads the text only after its length is published.
+ */
+#define GPU_NOTE_MAX    160u
+static struct {
+	char text[GPU_NOTE_MAX];
+	uint32_t len;
+	uint32_t claimed;
+} gpu_notes[2];
+static const char *const gpu_note_prefix[2] = { "A04S GPU TEST ", "HEROGPU SELFTEST" };
+
+void a04s_gpu_note(unsigned slot, const char *s, size_t n);
+void
+a04s_gpu_note(unsigned slot, const char *s, size_t n)
+{
+	if (slot >= 2u || s == NULL) {
+		return;
+	}
+	size_t pn = strlen(gpu_note_prefix[slot]);
+	if (n < pn || memcmp(s, gpu_note_prefix[slot], pn) != 0) {
+		return;
+	}
+	uint32_t unclaimed = 0;
+	if (!__atomic_compare_exchange_n(&gpu_notes[slot].claimed, &unclaimed, 1u, false, __ATOMIC_ACQ_REL,
+	    __ATOMIC_RELAXED)) {
+		return;
+	}
+	uint32_t k = 0;
+	for (size_t i = 0; i < n && k < GPU_NOTE_MAX - 1u; i++) {
+		char c = s[i];
+		if (c == '\0' || c == '\n') {
+			break;
+		}
+		gpu_notes[slot].text[k++] = (c >= 0x20 && c < 0x7f) ? c : '?';
+	}
+	gpu_notes[slot].text[k] = '\0';
+	__atomic_store_n(&gpu_notes[slot].len, k, __ATOMIC_RELEASE);
+}
+static bool user_ready;
+static uint32_t user_affinity;
+static uint32_t user_as_present;                /* v65: AS_PRESENT, read at bring-up */
+static struct user_as {
+	uint64_t used[USER_CHUNKS / 64u];       /* this AS's GPU VA, in 64 KiB chunks */
+	uint16_t l3_of[512];                    /* L2 slot -> pool table + 1 */
+	uint32_t chunks, clients, opens, l3, faults, recovers;
+	uint32_t jobs;                          /* queued or running (atomic) */
+	bool live;                              /* its tables are set up */
+	bool broken;                            /* a recovery failed: out of service until reboot */
+} uas[USER_AS_LAST + 1u];                       /* with a04s_gpu_mtx; [0] unused */
+static uint64_t upt_pool[(UPT_POOL_MAX + 63u) / 64u];
+static unsigned upt_pool_used;
+static void uas_release_locked(unsigned as);
+static void user_maybe_off_locked(void);
+static struct {
+	const char *state;                      /* OFF, RUNNING, OK, FAIL */
+	const char *why;
+	uint32_t wv_status, wv_us, iso_status, iso_fault, iso_addr;
+	uint64_t wv_output, iso_output;
+	uint32_t jobs, faults, l3;
+	uint32_t wv2_status, stop_status, mmu_after, recovers, recover_fails;
+	uint64_t wv2_output;
+	bool as0_ok;
+	bool broken;                            /* a recovery failed: AS1 out of service until reboot */
+	struct frag_result as0;
+} uj = { .state = "OFF", .why = "a04sgpu_selftest=0" };
+
+/* Whether a physical page may be mapped for user jobs. */
+static bool
+user_page_ok(uint64_t pa)
+{
+	if (pa == 0 || (pa & 0xfffu)) {
+		return false;
+	}
+	return (pa >= 0x92000000ull && pa < 0xbc000000ull) || (pa >= 0x880000000ull && pa < 0x8eba00000ull) ||
+	       (pa >= UTEST_PA && pa < UTEST_PA + UTEST_BYTES);
+}
+
+static vm_offset_t
+uas_top_va(unsigned as)
+{
+	return upt_va + (vm_offset_t)(as - 1u) * UPT_TOP_BYTES;
+}
+
+static uint64_t
+uas_top_pa(unsigned as)
+{
+	return UPT_PA + (uint64_t)(as - 1u) * UPT_TOP_BYTES;
+}
+
+/* AS as from its tables; also flushes its TLB. For an AS with no job on the GPU. With a04s_gpu_mtx held. */
+static bool
+user_as_update(unsigned as)
+{
+	uint32_t r = AS_N(as);
+	uint64_t transtab = uas_top_pa(as) | 7u;                /* ADRMODE_TABLE | READ_INNER */
+	gpu_wr(r + AS_TRANSTAB_LO, (uint32_t)transtab);
+	gpu_wr(r + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	gpu_wr(r + AS_MEMATTR_LO, 0x888d88u);
+	gpu_wr(r + AS_MEMATTR_HI, 0);
+	gpu_wr(r + AS_TRANSCFG_LO, 0);                          /* ADRMODE_LEGACY, as AS0 */
+	gpu_wr(r + AS_TRANSCFG_HI, 0);
+	gpu_wr(r + AS_COMMAND, 1);                              /* UPDATE */
+	return gpu_wait(r + AS_STATUS, 1u, 0, 100000);
+}
+
+/* AS as out of service: no tables, so every access faults (and stalled accesses end). With the lock. */
+static bool
+user_as_off(unsigned as)
+{
+	uint32_t r = AS_N(as);
+	gpu_wr(r + AS_TRANSTAB_LO, AS_TRANSTAB_UNMAPPED);
+	gpu_wr(r + AS_TRANSTAB_HI, 0);
+	gpu_wr(r + AS_COMMAND, 1);                              /* UPDATE */
+	return gpu_wait(r + AS_STATUS, 1u, 0, USER_STOP_US);
+}
+
+/*
+ * v64: page-table changes while the scheduler has jobs of this AS on the GPU. UPDATE re-reads the whole
+ * address space and is for an idle one; with jobs running, lock the user range and FLUSH_PT, which
+ * flushes the MMU's caches for that range and unlocks it. 0x40000000 | 29 is the naturally aligned 1 GiB
+ * user range (the size field is log2(bytes) - 1). With a04s_gpu_mtx held.
+ */
+#define AS_LOCKADDR_LO          0x10u
+#define AS_LOCKADDR_HI          0x14u
+#define AS_CMD_LOCK             2u
+#define AS_CMD_FLUSH_PT         4u
+static bool
+user_as_flush_locked(unsigned as)
+{
+	uint32_t r = AS_N(as);
+	if (!gpu_wait(r + AS_STATUS, 1u, 0, 100000)) {
+		return false;
+	}
+	gpu_wr(r + AS_LOCKADDR_LO, (uint32_t)USER_VA_BASE | 29u);
+	gpu_wr(r + AS_LOCKADDR_HI, 0);
+	gpu_wr(r + AS_COMMAND, AS_CMD_LOCK);
+	if (!gpu_wait(r + AS_STATUS, 1u, 0, 100000)) {
+		return false;
+	}
+	gpu_wr(r + AS_COMMAND, AS_CMD_FLUSH_PT);
+	return gpu_wait(r + AS_STATUS, 1u, 0, 100000);
+}
+
+/* The cores on and the table block mapped; each AS's tables come with its first client. With the lock. */
+static bool
+user_up_locked(void)
+{
+	if (user_ready) {
+		return true;
+	}
+	if (!gpu_va || !mem_va) {
+		uj.why = "NO GPU";
+		return false;
+	}
+	user_as_present = io_rd(gpu_va, GPU_AS_PRESENT);
+	if (!(user_as_present & 2u)) {
+		uj.why = "NO AS1";
+		return false;
+	}
+	if (!upt_va) {
+		upt_va = ml_io_map((vm_offset_t)UPT_PA, UPT_BYTES);
+	}
+	if (!upt_va) {
+		uj.why = "NO MAPPING";
+		return false;
+	}
+	uint32_t core0 = io_rd(gpu_va, SHADER_PRESENT) & 1u, got = 0;
+	if (!core0 || !gpu_power(L2_PWRON, L2_READY, io_rd(gpu_va, L2_PRESENT), &got) ||
+	    !gpu_power(SHADER_PWRON, SHADER_READY, core0, &got) ||
+	    !gpu_power(TILER_PWRON, TILER_READY, io_rd(gpu_va, TILER_PRESENT), &got)) {
+		uj.why = "POWER";
+		return false;
+	}
+	user_affinity = core0;
+	user_ready = true;
+	return true;
+}
+
+static int
+upt_pool_get(void)
+{
+	for (unsigned i = 0; i < UPT_POOL_MAX; i++) {
+		if (!(upt_pool[i / 64u] & (1ull << (i % 64u)))) {
+			upt_pool[i / 64u] |= 1ull << (i % 64u);
+			upt_pool_used++;
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static void
+upt_pool_put(unsigned i)
+{
+	if (i < UPT_POOL_MAX && (upt_pool[i / 64u] & (1ull << (i % 64u)))) {
+		upt_pool[i / 64u] &= ~(1ull << (i % 64u));
+		upt_pool_used--;
+	}
+}
+
+/* AS as's top tables (empty below L2) and the AS itself, for its first client. With the lock. */
+static bool
+uas_live_locked(unsigned as)
+{
+	struct user_as *u = &uas[as];
+	if (u->live) {
+		return !u->broken;
+	}
+	if (u->broken || !user_ready) {
+		return false;
+	}
+	vm_offset_t top = uas_top_va(as);
+	uint64_t pa = uas_top_pa(as);
+	gpu_zero(top, UPT_TOP_BYTES);
+	volatile uint64_t *l0 = (volatile uint64_t *)top;
+	volatile uint64_t *l1 = (volatile uint64_t *)(top + 0x1000);
+	l0[0] = (pa + 0x1000) | 3;
+	l1[(USER_VA_BASE >> 30) & 0x1ffu] = (pa + 0x2000) | 3;    /* the whole user range: one L2 table */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bzero(u->used, sizeof(u->used));
+	bzero(u->l3_of, sizeof(u->l3_of));
+	u->chunks = 0;
+	u->l3 = 0;
+	if (!user_as_update(as)) {
+		u->broken = true;
+		(void)user_as_off(as);
+		kprintf("A04S GPU USER AS%u: UPDATE timed out, out of service\n", as);
+		return false;
+	}
+	u->live = true;
+	return true;
+}
+
+/* An AS nobody uses any more: out of service, its L3 tables back in the pool. With the lock. */
+static void
+uas_release_locked(unsigned as)
+{
+	struct user_as *u = &uas[as];
+	if (as == 0 || as > USER_AS_LAST || !u->live || u->clients != 0 || u->chunks != 0 ||
+	    __atomic_load_n(&u->jobs, __ATOMIC_ACQUIRE) != 0 || (sched_hw_as & (1u << as))) {
+		return;
+	}
+	(void)user_as_off(as);
+	for (unsigned i = 0; i < 512u; i++) {
+		if (u->l3_of[i] != 0) {
+			upt_pool_put(u->l3_of[i] - 1u);
+			u->l3_of[i] = 0;
+		}
+	}
+	u->l3 = 0;
+	u->live = false;
+}
+
+/* n consecutive 64 KiB chunks of AS as's GPU VA, or 0. With a04s_gpu_mtx held. */
+static uint64_t
+user_va_alloc_locked(unsigned as, uint64_t bytes)
+{
+	struct user_as *u = &uas[as];
+	unsigned n = (unsigned)((bytes + USER_CHUNK - 1u) / USER_CHUNK);
+	if (n == 0 || n > USER_CHUNKS) {
+		return 0;
+	}
+	unsigned run = 0;
+	for (unsigned c = 0; c < USER_CHUNKS; c++) {
+		if (u->used[c / 64u] & (1ull << (c % 64u))) {
+			run = 0;
+		} else if (++run == n) {
+			unsigned first = c + 1u - n;
+			for (unsigned k = first; k <= c; k++) {
+				u->used[k / 64u] |= 1ull << (k % 64u);
+			}
+			u->chunks += n;
+			user_chunks += n;
+			return USER_VA_BASE + first * USER_CHUNK;
+		}
+	}
+	return 0;
+}
+
+static void
+user_va_free_locked(unsigned as, uint64_t va, unsigned pages)
+{
+	struct user_as *u = &uas[as];
+	if (va < USER_VA_BASE || va >= USER_VA_END || pages == 0) {
+		return;
+	}
+	unsigned first = (unsigned)((va - USER_VA_BASE) / USER_CHUNK);
+	unsigned count = (unsigned)(((uint64_t)pages * 0x1000u + USER_CHUNK - 1u) / USER_CHUNK);
+	for (unsigned k = first; k < first + count && k < USER_CHUNKS; k++) {
+		if (u->used[k / 64u] & (1ull << (k % 64u))) {
+			u->used[k / 64u] &= ~(1ull << (k % 64u));
+			u->chunks--;
+			user_chunks--;
+		}
+	}
+}
+
+/* AS as's PTEs for n 4 KiB pages at va (pages NULL: unmap), every page checked first. With the lock. */
+static bool
+user_set_locked(unsigned as, uint64_t va, const uint64_t *pages, unsigned n)
+{
+	struct user_as *u = &uas[as];
+	if (!u->live) {
+		return pages == NULL;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		uint64_t a = va + (uint64_t)i * 0x1000u;
+		if (a < USER_VA_BASE || a >= USER_VA_END || (pages != NULL && !user_page_ok(pages[i]))) {
+			return false;
+		}
+	}
+	volatile uint64_t *l2 = (volatile uint64_t *)(uas_top_va(as) + 0x2000);
+	for (unsigned i = 0; i < n; i++) {
+		uint64_t a = va + (uint64_t)i * 0x1000u;
+		unsigned l2i = (unsigned)((a >> 21) & 0x1ffu);
+		if (u->l3_of[l2i] == 0) {
+			if (pages == NULL) {
+				continue;
+			}
+			int t = upt_pool_get();
+			if (t < 0) {
+				return false;
+			}
+			uint32_t off = UPT_POOL_OFF + (uint32_t)t * 0x1000u;
+			gpu_zero(upt_va + off, 0x1000);
+			u->l3_of[l2i] = (uint16_t)(t + 1);
+			u->l3++;
+			l2[l2i] = (UPT_PA + off) | 3;
+		}
+		volatile uint64_t *l3 = (volatile uint64_t *)(upt_va + UPT_POOL_OFF + (u->l3_of[l2i] - 1u) * 0x1000u);
+		l3[(a >> 12) & 0x1ffu] = pages != NULL ? (pages[i] | 0x2c1) : 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (u->broken) {
+		return pages == NULL;                  /* out of service: never put its tables back */
+	}
+	return (sched_hw_as & (1u << as)) ? user_as_flush_locked(as) : user_as_update(as);
+}
+
+/*
+ * v47: end jobs that faulted or would not finish. The faulting access keeps the AS stalled, so a hard
+ * stop alone doesn't end it, and clearing the fault with the same tables in place only lets it fault
+ * again. So: hard-stop the slots, take the AS out of service (no tables, which ends the stalled
+ * accesses), clear its fault, wait for the slots to leave ACTIVE, clear again, and only then put its
+ * tables back. v65: per AS, and only the slots in `slots` (a bit per slot); other ASes and slots are not
+ * touched. True if the slots are idle and the AS has no fault left; otherwise the AS stays out of
+ * service. With a04s_gpu_mtx held.
+ */
+static bool
+user_recover_locked(unsigned as, uint32_t slots)
+{
+	for (unsigned js = 0; js < 2u; js++) {
+		if (slots & (1u << js)) {
+			gpu_wr(JS(js) + JS_COMMAND, JS_HARD_STOP);
+		}
+	}
+	bool as_done = user_as_off(as);
+	gpu_wr(MMU_IRQ_CLEAR, AS_FAULT_BITS(as));
+	bool stopped = true;
+	for (unsigned js = 0; js < 2u; js++) {
+		if (!(slots & (1u << js))) {
+			continue;
+		}
+		bool idle = false;
+		for (unsigned us = 0; us <= USER_STOP_US; us += 10) {
+			if ((io_rd(gpu_va, JS(js) + JS_STATUS) & 0xffu) != JS_ACTIVE) {
+				idle = true;
+				break;
+			}
+			delay(10);
+		}
+		uj.stop_status = io_rd(gpu_va, JS(js) + JS_STATUS);
+		stopped = stopped && idle;
+		gpu_wr(JOB_IRQ_CLEAR, (1u << js) | (1u << (16u + js)));
+	}
+	gpu_wr(MMU_IRQ_CLEAR, AS_FAULT_BITS(as));
+	bool back = stopped && as_done && user_as_update(as);
+	uj.mmu_after = io_rd(gpu_va, MMU_IRQ_RAWSTAT) & AS_FAULT_BITS(as);
+	if (back && uj.mmu_after == 0) {
+		uj.recovers++;
+		uas[as].recovers++;
+		return true;
+	}
+	uj.recover_fails++;
+	uas[as].broken = true;
+	(void)user_as_off(as);
+	if (as == 1u) {
+		uj.broken = true;
+	}
+	kprintf("A04S GPU USER AS%u STUCK: STOP %x MMU %x, AS%u OUT OF SERVICE\n", as, uj.stop_status, uj.mmu_after, as);
+	return false;
+}
+
+/* One job chain at GPU VA jc on slot js, in AS as, polled. 0 if it finished cleanly, else the slot's
+ * status, or 0xffffffff on a timeout. The boot self-test and a04sgpu_sched=0. With a04s_gpu_mtx held. */
+static uint32_t
+user_run_locked(unsigned as, unsigned js, uint64_t jc, uint32_t *fault, uint32_t *faddr, uint64_t *us)
+{
+	uint32_t slot = JS(js);
+	uint32_t done = 1u << js, failed = 1u << (16u + js);
+	gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(slot + JS_HEAD_NEXT_LO, (uint32_t)jc);
+	gpu_wr(slot + JS_HEAD_NEXT_HI, (uint32_t)(jc >> 32));
+	gpu_wr(slot + JS_AFFINITY_NEXT_LO, user_affinity);
+	gpu_wr(slot + JS_AFFINITY_NEXT_HI, 0);
+	/* Thread priority 8, clean and invalidate the GPU caches at start and end, address space as. */
+	gpu_wr(slot + JS_CONFIG_NEXT, (8u << 16) | (3u << 8) | (3u << 12) | as);
+	uint64_t start = mach_absolute_time();
+	gpu_wr(slot + JS_COMMAND_NEXT, 1);                      /* START */
+	uint32_t jirq = 0, mirq = 0, girq = 0;
+	for (unsigned i = 0; i < USER_JOB_POLLS; i++) {
+		jirq = io_rd(gpu_va, JOB_IRQ_RAWSTAT);
+		mirq = io_rd(gpu_va, MMU_IRQ_RAWSTAT);
+		girq = io_rd(gpu_va, GPU_IRQ_RAWSTAT);
+		if ((jirq & (done | failed)) || mirq || (girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT))) {
+			break;
+		}
+		delay(10);
+	}
+	*us = us_since(start);
+	uint32_t st = io_rd(gpu_va, slot + JS_STATUS);
+	/* AS_FAULTSTATUS and FAULTADDR keep the last fault until the next one: only this job's own fault counts. */
+	bool as_fault = (mirq & AS_FAULT_BITS(as)) != 0;
+	*fault = as_fault ? io_rd(gpu_va, AS_N(as) + AS_FAULTSTATUS) : 0;
+	*faddr = as_fault ? io_rd(gpu_va, AS_N(as) + AS_FAULTADDR_LO) : 0;
+	bool answered = (jirq & (done | failed)) || mirq || (girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT));
+	if ((st & 0xffu) == JS_ACTIVE || mirq) {
+		(void)user_recover_locked(as, 1u << js);
+	}
+	gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+	if ((jirq & done) && !(jirq & failed) && !mirq && !(girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT))) {
+		return 0;
+	}
+	if (!answered) {
+		return 0xffffffffu;
+	}
+	return st ? st : 0xfffffffdu;
+}
+
+/*
+ * v64 (7c-7a): the GPU scheduler (port/7c-7-design.md). Every user job goes through one kernel thread
+ * that owns the two job slots: JS0 (fragment) and JS1 (vertex, tiler, compute) each have a software
+ * queue, in submit order, and a queue's first job starts once every fence it depends on is signalled.
+ * Both slots run at once, one chain each (JS_*_NEXT is not chained behind a running job yet). While
+ * jobs are on the GPU the thread polls JOB/MMU/GPU_IRQ_RAWSTAT about every 100 us, sleeping in between
+ * (assert_wait_timeout, not delay()) and holding no client lock; with nothing queued it sleeps until a
+ * submit wakes it. A job still running after 500 ms, or an MMU fault, ends the jobs on the GPU of that
+ * job's address space through user_recover_locked() and fails their fences (v65; a GPU fault, not tied
+ * to an AS, ends them all); if the recovery fails, that AS is out of service and its queued jobs fail. The thermal limit is checked as
+ * each job starts.
+ *
+ * Fences are refcounted and signalled once, with a status: 0 clean, else the slot's status,
+ * 0xffffffff timeout, 0xfffffffe the thermal limit, 0xfffffffd a fault with no slot status,
+ * 0xfffffffc refused (AS1 down, scheduler off, no memory). Jobs only ever depend on fences of jobs
+ * queued before them, so the oldest unfinished job can always start: no deadlock.
+ *
+ * The old synchronous Submit (selector 4) queues a job and waits for its fence. HeroGPU's syncobjs,
+ * BO references and the Panfrost-shaped selectors sit on top (iokit/Kernel/arm/HeroGPU.cpp). Lock
+ * order: a04s_gpu_mtx, then sched_mtx; retire callbacks run with neither. Boot-arg a04sgpu_sched=0
+ * puts back v63's path (one job at a time under the GPU lock).
+ */
+#define SCHED_POLL_US           100u
+#define SCHED_IRQ_POLL_US       10000u          /* v66: with interrupts, a look every 10 ms anyway */
+#define SCHED_IRQ_STORM         20000u          /* interrupts before the thread runs: a stuck line */
+#define A04S_GPU_INTID_FIRST    157u            /* GPU (SPI 125), JOB (SPI 126), MMU (SPI 127) */
+#define A04S_GPU_INTID_LAST     159u
+#define GPU_IRQ_STATUS          0x02cu
+#define JOB_IRQ_STATUS          0x100cu
+#define MMU_IRQ_STATUS          0x200cu
+#define SCHED_JOB_IRQS          0x00030003u     /* JS0 and JS1, done and failed */
+#define SCHED_MMU_IRQS          0x00fe00feu     /* AS1-AS7, page and bus faults */
+#define SCHED_IDLE_POLL_US      1000u
+#define SCHED_TIMEOUT_US        500000u
+#define SCHED_LOG_MAX           40u
+#define FENCE_OK                0u
+#define FENCE_TIMEOUT           0xffffffffu
+#define FENCE_HOT               0xfffffffeu
+#define FENCE_FAULT             0xfffffffdu
+#define FENCE_REFUSED           0xfffffffcu
+#define A04S_NO_DEADLINE        (~0ull)
+
+struct a04s_fence {
+	uint32_t refs;
+	uint32_t done;                  /* set once, with sched_mtx, after status and us */
+	uint32_t status;
+	uint32_t pad;
+	uint64_t us;
+};
+
+struct a04s_job {
+	struct a04s_job *next;
+	struct a04s_fence *fence;       /* one reference */
+	struct a04s_fence **deps;       /* one reference each */
+	unsigned ndeps;
+	unsigned js;
+	uint64_t jc;
+	uint64_t start;
+	void (*retire)(void *ctx);
+	void *ctx;
+	int pid;
+	unsigned as;                    /* v65: the client's address space */
+};
+
+extern int proc_selfpid(void);
+static LCK_MTX_DECLARE(sched_mtx, &a04s_gpu_grp);
+static struct {
+	struct a04s_job *head, *tail;
+	uint32_t len;
+} sched_q[2];
+static struct a04s_job *sched_run[2];          /* with a04s_gpu_mtx and sched_mtx */
+static int sched_mode = -1;                     /* a04sgpu_sched: 1 on (the default), 0 v63's path */
+static uint32_t sched_thread_on;                /* 0 not yet, 1 running, 2 couldn't start */
+static uint32_t sched_wake, fence_wake;         /* wait events */
+static struct {
+	uint32_t queued, done, failed, timeouts, faults, recovers, hot, refused, waits, maxq, logged;
+	uint32_t max_us, last_status, last_fault, last_addr;
+	int last_pid;
+	uint64_t total_us;
+} sst;
+
+bool a04s_gpu_sched_on(void);
+bool
+a04s_gpu_sched_on(void)
+{
+	if (sched_mode < 0) {
+		int on = 1;
+		(void)PE_parse_boot_argn("a04sgpu_sched", &on, sizeof(on));
+		sched_mode = on != 0 ? 1 : 0;
+	}
+	return sched_mode == 1;
+}
+
+struct a04s_fence *a04s_fence_create(bool signaled);
+struct a04s_fence *
+a04s_fence_create(bool signaled)
+{
+	struct a04s_fence *f = kalloc_data(sizeof(struct a04s_fence), Z_WAITOK | Z_ZERO);
+	if (f != NULL) {
+		f->refs = 1;
+		f->done = signaled ? 1u : 0u;
+	}
+	return f;
+}
+
+void a04s_fence_retain(struct a04s_fence *f);
+void
+a04s_fence_retain(struct a04s_fence *f)
+{
+	if (f != NULL) {
+		__atomic_add_fetch(&f->refs, 1u, __ATOMIC_RELAXED);
+	}
+}
+
+void a04s_fence_release(struct a04s_fence *f);
+void
+a04s_fence_release(struct a04s_fence *f)
+{
+	if (f != NULL && __atomic_sub_fetch(&f->refs, 1u, __ATOMIC_ACQ_REL) == 0) {
+		kfree_data(f, sizeof(struct a04s_fence));
+	}
+}
+
+/* A relative timeout in ns as an absolute deadline: 0 or less is now, INT64_MAX is forever (A04S_NO_DEADLINE). */
+uint64_t a04s_gpu_deadline(int64_t ns);
+uint64_t
+a04s_gpu_deadline(int64_t ns)
+{
+	if (ns == 0x7fffffffffffffffLL) {
+		return A04S_NO_DEADLINE;
+	}
+	uint64_t abs = 0;
+	if (ns > 0) {
+		nanoseconds_to_absolutetime((uint64_t)ns, &abs);
+	}
+	uint64_t d = mach_absolute_time() + abs;
+	return d == A04S_NO_DEADLINE ? d - 1u : d;
+}
+
+/*
+ * Wait until all (or any) of n fences are signalled, or the absolute deadline (A04S_NO_DEADLINE: none).
+ * NULL entries count as not signalled. 0, ETIMEDOUT or EINTR (the thread was aborted). *first: the
+ * first signalled index. Interruptible, so a dying process gets out.
+ */
+int a04s_fence_wait(struct a04s_fence *const *f, unsigned n, bool all, uint64_t deadline, unsigned *first);
+int
+a04s_fence_wait(struct a04s_fence *const *f, unsigned n, bool all, uint64_t deadline, unsigned *first)
+{
+	int ret = 0;
+	lck_mtx_lock(&sched_mtx);
+	for (;;) {
+		unsigned done = 0, k1 = n;
+		for (unsigned i = 0; i < n; i++) {
+			if (f[i] != NULL && __atomic_load_n(&f[i]->done, __ATOMIC_ACQUIRE) != 0) {
+				done++;
+				if (k1 == n) {
+					k1 = i;
+				}
+			}
+		}
+		if (n == 0 || (all ? done == n : done != 0)) {
+			if (first != NULL) {
+				*first = k1 == n ? 0 : k1;
+			}
+			break;
+		}
+		if (deadline != A04S_NO_DEADLINE && mach_absolute_time() >= deadline) {
+			ret = ETIMEDOUT;
+			break;
+		}
+		sst.waits++;
+		wait_result_t wr = deadline == A04S_NO_DEADLINE ?
+		    lck_mtx_sleep(&sched_mtx, LCK_SLEEP_DEFAULT, (event_t)&fence_wake, THREAD_ABORTSAFE) :
+		    lck_mtx_sleep_deadline(&sched_mtx, LCK_SLEEP_DEFAULT, (event_t)&fence_wake, THREAD_ABORTSAFE, deadline);
+		if (wr == THREAD_INTERRUPTED) {
+			ret = EINTR;
+			break;
+		}
+	}
+	lck_mtx_unlock(&sched_mtx);
+	return ret;
+}
+
+/* With sched_mtx held. */
+static void
+fence_signal_locked(struct a04s_fence *f, uint32_t status, uint64_t us)
+{
+	f->status = status;
+	f->us = us;
+	__atomic_store_n(&f->done, 1u, __ATOMIC_RELEASE);
+	thread_wakeup((event_t)&fence_wake);
+}
+
+/* A job has ended (or was refused): signal its fence, put it on the retire list. With sched_mtx. */
+static void
+sched_end_locked(struct a04s_job *j, uint32_t status, uint64_t us, struct a04s_job **retire)
+{
+	fence_signal_locked(j->fence, status, us);
+	if (status == FENCE_OK) {
+		sst.done++;
+		sst.total_us += us;
+		if (us > sst.max_us) {
+			sst.max_us = (uint32_t)us;
+		}
+	} else {
+		sst.failed++;
+		sst.last_status = status;
+		sst.last_pid = j->pid;
+	}
+	j->next = *retire;
+	*retire = j;
+}
+
+/* Fail every queued job (AS1 is out of service). With sched_mtx. */
+static void
+sched_fail_queued_locked(struct a04s_job **retire)
+{
+	for (unsigned js = 0; js < 2u; js++) {
+		while (sched_q[js].head != NULL) {
+			struct a04s_job *j = sched_q[js].head;
+			sched_q[js].head = j->next;
+			sched_q[js].len--;
+			sst.refused++;
+			sched_end_locked(j, FENCE_REFUSED, 0, retire);
+		}
+		sched_q[js].tail = NULL;
+	}
+}
+
+/* Retire callbacks and frees, with no lock held. */
+static void
+sched_retire(struct a04s_job *list)
+{
+	while (list != NULL) {
+		struct a04s_job *j = list;
+		list = j->next;
+		if (j->retire != NULL) {
+			j->retire(j->ctx);
+		}
+		for (unsigned i = 0; i < j->ndeps; i++) {
+			a04s_fence_release(j->deps[i]);
+		}
+		if (j->deps != NULL) {
+			kfree_type(struct a04s_fence *, j->ndeps, j->deps);
+		}
+		a04s_fence_release(j->fence);
+		unsigned as = j->as;
+		kfree_type(struct a04s_job, j);
+		/* v65: the AS's last job gone (and its client too): it may be released, and the cores go off. */
+		if (__atomic_sub_fetch(&uas[as].jobs, 1u, __ATOMIC_ACQ_REL) == 0 &&
+		    __atomic_load_n(&uas[as].clients, __ATOMIC_RELAXED) == 0) {
+			lck_mtx_lock(&a04s_gpu_mtx);
+			uas_release_locked(as);
+			user_maybe_off_locked();
+			lck_mtx_unlock(&a04s_gpu_mtx);
+		}
+	}
+}
+
+static void
+sched_hw_as_recalc(void)
+{
+	uint32_t m = 0;
+	for (unsigned js = 0; js < 2u; js++) {
+		if (sched_run[js] != NULL) {
+			m |= 1u << sched_run[js]->as;
+		}
+	}
+	sched_hw_as = m;
+}
+
+/*
+ * v65: a fault, or a job past its time, in address space as: hard-stop the slots running that AS's jobs,
+ * recover the AS (user_recover_locked()) and fail those jobs. A job of another AS on the other slot runs
+ * on. With a04s_gpu_mtx and sched_mtx.
+ */
+static void
+sched_end_as_locked(unsigned as, bool fault, struct a04s_job **retire)
+{
+	uint32_t slots = 0, st[2] = { 0, 0 };
+	for (unsigned js = 0; js < 2u; js++) {
+		if (sched_run[js] != NULL && sched_run[js]->as == as) {
+			slots |= 1u << js;
+			st[js] = io_rd(gpu_va, JS(js) + JS_STATUS);
+		}
+	}
+	if (slots == 0) {
+		return;
+	}
+	uint32_t asf = fault ? io_rd(gpu_va, AS_N(as) + AS_FAULTSTATUS) : 0;
+	uint32_t asa = fault ? io_rd(gpu_va, AS_N(as) + AS_FAULTADDR_LO) : 0;
+	(void)user_recover_locked(as, slots);
+	for (unsigned js = 0; js < 2u; js++) {
+		if (!(slots & (1u << js))) {
+			continue;
+		}
+		struct a04s_job *j = sched_run[js];
+		uint64_t us = us_since(j->start);
+		bool late = us > SCHED_TIMEOUT_US;
+		sched_run[js] = NULL;
+		sched_hw_busy &= ~(1u << js);
+		uj.jobs++;
+		sst.recovers++;
+		if (fault) {
+			uj.faults++;
+			uas[as].faults++;
+			sst.faults++;
+		} else if (late) {
+			sst.timeouts++;
+		}
+		uint32_t status = !fault && late ? FENCE_TIMEOUT :
+		    (st[js] != 0 && (st[js] & 0xffu) != JS_ACTIVE) ? st[js] : FENCE_FAULT;
+		sst.last_fault = asf;
+		sst.last_addr = asa;
+		if (sst.logged < SCHED_LOG_MAX) {
+			sst.logged++;
+			kprintf("A04S GPU SCHED %s: AS%u JS%u pid %d jc %llx status %x fault %x@%x after %llu us\n",
+			    fault ? "FAULT" : late ? "TIMEOUT" : "STOPPED", as, js, j->pid, j->jc, st[js], asf, asa, us);
+		}
+		sched_end_locked(j, status, us, retire);
+	}
+	sched_hw_as_recalc();
+}
+
+/*
+ * The slots' state: finished jobs end; an MMU fault ends the jobs of the AS that faulted, a GPU fault
+ * (not tied to an AS) those of every AS on the GPU, a late job those of its own AS. With both locks.
+ */
+static void
+sched_poll_locked(struct a04s_job **retire)
+{
+	if (sched_hw_busy == 0) {
+		return;
+	}
+	uint32_t jirq = io_rd(gpu_va, JOB_IRQ_RAWSTAT);
+	uint32_t mirq = io_rd(gpu_va, MMU_IRQ_RAWSTAT);
+	uint32_t girq = io_rd(gpu_va, GPU_IRQ_RAWSTAT);
+	bool gpu_fault = (girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT)) != 0;
+	uint32_t fault_as = 0, late_as = 0;                    /* a bit per AS */
+	for (unsigned as = 1u; as <= USER_AS_LAST; as++) {
+		if ((mirq & AS_FAULT_BITS(as)) || (gpu_fault && (sched_hw_as & (1u << as)))) {
+			fault_as |= 1u << as;
+		}
+	}
+	for (unsigned js = 0; js < 2u; js++) {
+		struct a04s_job *j = sched_run[js];
+		if (j == NULL || (fault_as & (1u << j->as))) {
+			continue;
+		}
+		uint32_t done = 1u << js, failed = 1u << (16u + js);
+		uint64_t us = us_since(j->start);
+		if (jirq & (done | failed)) {
+			uint32_t st = 0;
+			if (jirq & failed) {
+				st = io_rd(gpu_va, JS(js) + JS_STATUS);
+				if (st == 0) {
+					st = FENCE_FAULT;
+				}
+			}
+			gpu_wr(JOB_IRQ_CLEAR, done | failed);
+			if ((io_rd(gpu_va, JS(js) + JS_STATUS) & 0xffu) == JS_ACTIVE) {
+				late_as |= 1u << j->as;       /* failed but still active: recover below */
+				continue;
+			}
+			sched_run[js] = NULL;
+			sched_hw_busy &= ~(1u << js);
+			uj.jobs++;
+			sched_end_locked(j, st, us, retire);
+		} else if (us > SCHED_TIMEOUT_US) {
+			late_as |= 1u << j->as;
+		}
+	}
+	sched_hw_as_recalc();
+	for (unsigned as = 1u; as <= USER_AS_LAST; as++) {
+		if (fault_as & (1u << as)) {
+			sched_end_as_locked(as, true, retire);
+		} else if (late_as & (1u << as)) {
+			sched_end_as_locked(as, false, retire);
+		}
+	}
+	/* A fault bit no job on the GPU owns (an AS whose job already ended): clear it. */
+	uint32_t owned = 0;
+	for (unsigned js = 0; js < 2u; js++) {
+		if (sched_run[js] != NULL) {
+			owned |= AS_FAULT_BITS(sched_run[js]->as);
+		}
+	}
+	uint32_t stray = io_rd(gpu_va, MMU_IRQ_RAWSTAT) & ~owned;
+	if (stray != 0) {
+		gpu_wr(MMU_IRQ_CLEAR, stray);
+	}
+	if (gpu_fault) {
+		gpu_wr(GPU_IRQ_CLEAR, IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT);
+	}
+}
+
+/* Start each idle slot's first queued job whose fences are all signalled. With both locks. */
+static void
+sched_start_locked(struct a04s_job **retire)
+{
+	for (unsigned js = 0; js < 2u; js++) {
+		while (sched_run[js] == NULL && sched_q[js].head != NULL) {
+			struct a04s_job *j = sched_q[js].head;
+			bool ready = true;
+			for (unsigned i = 0; i < j->ndeps && ready; i++) {
+				ready = j->deps[i] == NULL || __atomic_load_n(&j->deps[i]->done, __ATOMIC_ACQUIRE) != 0;
+			}
+			if (!ready) {
+				break;
+			}
+			sched_q[js].head = j->next;
+			if (sched_q[js].head == NULL) {
+				sched_q[js].tail = NULL;
+			}
+			sched_q[js].len--;
+			j->next = NULL;
+			if (!user_ready || !uas[j->as].live || uas[j->as].broken) {
+				sst.refused++;
+				sched_end_locked(j, FENCE_REFUSED, 0, retire);
+				continue;
+			}
+			if (!a04s_gpu_allowed()) {
+				user_hot++;
+				sst.hot++;
+				sched_end_locked(j, FENCE_HOT, 0, retire);
+				continue;
+			}
+			uint32_t slot = JS(js);
+			gpu_wr(JOB_IRQ_CLEAR, (1u << js) | (1u << (16u + js)));
+			if (sched_hw_busy == 0) {
+				gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+				gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+			}
+			gpu_wr(slot + JS_HEAD_NEXT_LO, (uint32_t)j->jc);
+			gpu_wr(slot + JS_HEAD_NEXT_HI, (uint32_t)(j->jc >> 32));
+			gpu_wr(slot + JS_AFFINITY_NEXT_LO, user_affinity);
+			gpu_wr(slot + JS_AFFINITY_NEXT_HI, 0);
+			/* As user_run_locked(): thread priority 8, clean and invalidate the caches at start and end, the job's AS. */
+			gpu_wr(slot + JS_CONFIG_NEXT, (8u << 16) | (3u << 8) | (3u << 12) | j->as);
+			j->start = mach_absolute_time();
+			gpu_wr(slot + JS_COMMAND_NEXT, 1);                    /* START */
+			sched_run[js] = j;
+			sched_hw_busy |= 1u << js;
+			sched_hw_as |= 1u << j->as;
+		}
+	}
+}
+
+/*
+ * v66 (7c-7c): the GPU's interrupts instead of polling every 100 us. The three SPIs (GPU 157, JOB 158,
+ * MMU 159) are routed to the boot CPU by pe_fiq.c's a04s_gic_gpu_spi(), and sleh_irq() offers them
+ * here. The handler only masks the GPU's interrupt sources (they are level interrupts: the line stays
+ * up until the scheduler clears RAWSTAT) and wakes the scheduler thread, which does everything else as
+ * before. The thread unmasks JOB (JS0/JS1 done or failed), MMU (AS1-AS7 faults) and GPU (fault) only
+ * while it has jobs on the GPU, after setting up its wait, so an interrupt from then on wakes it; it
+ * still looks every 10 ms, which also keeps the 500 ms timeout. With the scheduler idle the sources
+ * stay masked, so the present path and the boot tests never interrupt. A stuck line (20000 interrupts
+ * before the thread runs) turns the three SPIs off and goes back to polling. a04sgpu_irq=0: polling.
+ */
+extern int a04s_gic_gpu_spi(uint32_t intid, int on);   /* pexpert/arm/pe_fiq.c */
+static uint32_t sched_irq_mode;                         /* 0 polling, 1 interrupts, 2 off after a storm */
+static uint32_t sched_irq_burst, sched_irqs, sched_irq_spurious, sched_irq_logged, sched_irq_wakes;
+
+/* The interrupt handler, from sleh_irq() (interrupts off): true if it was the GPU's. */
+bool a04s_gpu_irq(uint32_t intid);
+bool
+a04s_gpu_irq(uint32_t intid)
+{
+	if (intid < A04S_GPU_INTID_FIRST || intid > A04S_GPU_INTID_LAST) {
+		return false;
+	}
+	__atomic_add_fetch(&sched_irqs, 1u, __ATOMIC_RELAXED);
+	if (gpu_va) {
+		if ((io_rd(gpu_va, JOB_IRQ_STATUS) | io_rd(gpu_va, MMU_IRQ_STATUS) | io_rd(gpu_va, GPU_IRQ_STATUS)) == 0) {
+			__atomic_add_fetch(&sched_irq_spurious, 1u, __ATOMIC_RELAXED);
+		}
+		gpu_wr(JOB_IRQ_MASK, 0);
+		gpu_wr(MMU_IRQ_MASK, 0);
+		gpu_wr(GPU_IRQ_MASK, 0);
+	}
+	if (__atomic_add_fetch(&sched_irq_burst, 1u, __ATOMIC_RELAXED) > SCHED_IRQ_STORM &&
+	    __atomic_load_n(&sched_irq_mode, __ATOMIC_RELAXED) == 1u) {
+		for (uint32_t id = A04S_GPU_INTID_FIRST; id <= A04S_GPU_INTID_LAST; id++) {
+			(void)a04s_gic_gpu_spi(id, 0);
+		}
+		__atomic_store_n(&sched_irq_mode, 2u, __ATOMIC_RELEASE);
+	}
+	thread_wakeup((event_t)&sched_wake);
+	return true;
+}
+
+/* The GPU's interrupt sources on (the scheduler waits for its jobs) or off. With a04s_gpu_mtx held. */
+static void
+sched_irq_sources_locked(bool on)
+{
+	if (!gpu_va) {
+		return;
+	}
+	gpu_wr(JOB_IRQ_MASK, on ? SCHED_JOB_IRQS : 0);
+	gpu_wr(MMU_IRQ_MASK, on ? SCHED_MMU_IRQS : 0);
+	gpu_wr(GPU_IRQ_MASK, on ? (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT) : 0);
+}
+
+/* At the scheduler thread's start: route and enable the three SPIs, sources still masked. */
+static void
+sched_irq_setup(void)
+{
+	unsigned want = 1;
+	(void)PE_parse_boot_argn("a04sgpu_irq", &want, sizeof(want));
+	if (want == 0) {
+		kprintf("A04S GPU SCHED: polling (a04sgpu_irq=0)\n");
+		return;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	sched_irq_sources_locked(false);
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	for (uint32_t id = A04S_GPU_INTID_FIRST; id <= A04S_GPU_INTID_LAST; id++) {
+		if (!a04s_gic_gpu_spi(id, 1)) {
+			for (uint32_t k = A04S_GPU_INTID_FIRST; k <= A04S_GPU_INTID_LAST; k++) {
+				(void)a04s_gic_gpu_spi(k, 0);
+			}
+			kprintf("A04S GPU SCHED: no GIC route for INTID %u, polling\n", id);
+			return;
+		}
+	}
+	__atomic_store_n(&sched_irq_mode, 1u, __ATOMIC_RELEASE);
+	kprintf("A04S GPU SCHED: interrupts on (INTIDs %u-%u)\n", A04S_GPU_INTID_FIRST, A04S_GPU_INTID_LAST);
+}
+
+static void
+sched_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	sched_irq_setup();
+	for (;;) {
+		struct a04s_job *retire = NULL;
+		lck_mtx_lock(&a04s_gpu_mtx);
+		lck_mtx_lock(&sched_mtx);
+		__atomic_store_n(&sched_irq_burst, 0u, __ATOMIC_RELAXED);
+		if (__atomic_load_n(&sched_irq_mode, __ATOMIC_ACQUIRE) == 2u && sched_irq_logged == 0) {
+			sched_irq_logged = 1;
+			kprintf("A04S GPU SCHED: interrupt storm (%u), back to polling\n", sched_irqs);
+		}
+		sched_poll_locked(&retire);
+		sched_start_locked(&retire);
+		bool irq = __atomic_load_n(&sched_irq_mode, __ATOMIC_ACQUIRE) == 1u;
+		if (retire == NULL) {
+			if (sched_hw_busy != 0) {
+				assert_wait_timeout((event_t)&sched_wake, THREAD_UNINT, irq ? SCHED_IRQ_POLL_US : SCHED_POLL_US,
+				    NSEC_PER_USEC);
+				if (irq) {
+					sched_irq_wakes++;
+					sched_irq_sources_locked(true);       /* after the wait is set up: an interrupt now wakes us */
+				}
+			} else if (sched_q[0].head != NULL || sched_q[1].head != NULL) {
+				sched_irq_sources_locked(false);
+				assert_wait_timeout((event_t)&sched_wake, THREAD_UNINT, SCHED_IDLE_POLL_US, NSEC_PER_USEC);
+			} else {
+				sched_irq_sources_locked(false);
+				assert_wait((event_t)&sched_wake, THREAD_UNINT);
+			}
+		}
+		lck_mtx_unlock(&sched_mtx);
+		lck_mtx_unlock(&a04s_gpu_mtx);
+		if (retire != NULL) {
+			sched_retire(retire);           /* then look again at once: dependents may be ready */
+			continue;
+		}
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static bool
+sched_thread_up(void)
+{
+	if (__atomic_load_n(&sched_thread_on, __ATOMIC_ACQUIRE) == 1u) {
+		return true;
+	}
+	lck_mtx_lock(&sched_mtx);
+	if (sched_thread_on == 0) {
+		thread_t t;
+		if (kernel_thread_start(sched_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+			__atomic_store_n(&sched_thread_on, 1u, __ATOMIC_RELEASE);
+			kprintf("A04S GPU SCHED: thread started\n");
+		} else {
+			sched_thread_on = 2;
+			kprintf("A04S GPU SCHED: NO THREAD\n");
+		}
+	}
+	bool on = sched_thread_on == 1u;
+	lck_mtx_unlock(&sched_mtx);
+	return on;
+}
+
+/*
+ * Queue the chain at user GPU VA jc of address space as on slot js (0 fragment, 1 the rest), to start once every non-NULL
+ * fence in deps is signalled. retire(ctx) runs when the job has ended (no lock held), or before this
+ * returns if the job is refused. Returns the job's fence, one reference for the caller, already
+ * signalled with 0xfffffffc if refused; NULL only if even that couldn't be allocated.
+ */
+struct a04s_fence *a04s_gpu_queue(unsigned as, unsigned js, uint64_t jc, struct a04s_fence *const *deps,
+    unsigned ndeps, void (*retire)(void *ctx), void *ctx);
+struct a04s_fence *
+a04s_gpu_queue(unsigned as, unsigned js, uint64_t jc, struct a04s_fence *const *deps, unsigned ndeps,
+    void (*retire)(void *ctx), void *ctx)
+{
+	unsigned nd = 0;
+	for (unsigned i = 0; i < ndeps; i++) {
+		if (deps[i] != NULL && __atomic_load_n(&deps[i]->done, __ATOMIC_ACQUIRE) == 0) {
+			nd++;
+		}
+	}
+	struct a04s_fence *f = a04s_fence_create(false);
+	struct a04s_job *j = kalloc_type(struct a04s_job, Z_WAITOK | Z_ZERO);
+	struct a04s_fence **dv = nd != 0 ? kalloc_type(struct a04s_fence *, nd, Z_WAITOK | Z_ZERO) : NULL;
+	bool ok = f != NULL && j != NULL && (nd == 0 || dv != NULL) && js <= 1u && jc >= USER_VA_BASE &&
+	    jc < USER_VA_END && as >= 1u && as <= USER_AS_LAST && a04s_gpu_sched_on() && sched_thread_up();
+	if (!ok) {
+		if (dv != NULL) {
+			kfree_type(struct a04s_fence *, nd, dv);
+		}
+		if (j != NULL) {
+			kfree_type(struct a04s_job, j);
+		}
+		if (retire != NULL) {
+			retire(ctx);
+		}
+		lck_mtx_lock(&sched_mtx);
+		sst.refused++;
+		if (f != NULL) {
+			fence_signal_locked(f, FENCE_REFUSED, 0);
+		}
+		lck_mtx_unlock(&sched_mtx);
+		return f;
+	}
+	unsigned k = 0;
+	for (unsigned i = 0; i < ndeps && k < nd; i++) {
+		if (deps[i] != NULL && __atomic_load_n(&deps[i]->done, __ATOMIC_ACQUIRE) == 0) {
+			a04s_fence_retain(deps[i]);
+			dv[k++] = deps[i];
+		}
+	}
+	/* A dep signalled between the two passes leaves NULL entries at the end: they count as signalled. */
+	j->deps = dv;
+	j->ndeps = nd;
+	a04s_fence_retain(f);                  /* the job's; the caller keeps the other */
+	j->fence = f;
+	j->js = js;
+	j->jc = jc;
+	j->retire = retire;
+	j->ctx = ctx;
+	j->pid = proc_selfpid();
+	j->as = as;
+	__atomic_add_fetch(&uas[as].jobs, 1u, __ATOMIC_ACQ_REL);       /* v65: back in sched_retire() */
+	lck_mtx_lock(&sched_mtx);
+	if (sched_q[js].tail != NULL) {
+		sched_q[js].tail->next = j;
+	} else {
+		sched_q[js].head = j;
+	}
+	sched_q[js].tail = j;
+	sched_q[js].len++;
+	sst.queued++;
+	if (sched_q[js].len > sst.maxq) {
+		sst.maxq = sched_q[js].len;
+	}
+	thread_wakeup((event_t)&sched_wake);
+	lck_mtx_unlock(&sched_mtx);
+	return f;
+}
+
+/* Nothing queued or on the slots (for the cores-off check at the last close). With a04s_gpu_mtx. */
+static bool
+sched_idle_locked(void)
+{
+	lck_mtx_lock(&sched_mtx);
+	bool idle = sched_hw_busy == 0 && sched_q[0].head == NULL && sched_q[1].head == NULL;
+	lck_mtx_unlock(&sched_mtx);
+	return idle;
+}
+
+/* For 7c-5b's user client: bring the GPU up (the boot tests must have passed). */
+bool a04s_gpu_user_up(void);
+bool
+a04s_gpu_user_up(void)
+{
+	if (job.state[0] != 'O' || job.state[1] != 'K') {
+		return false;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	bool ok = user_up_locked();
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	return ok;
+}
+
+/*
+ * v65: the AS for a new client. The display AS for backboardd; for the others the first free AS of
+ * AS2-AS7 (no client, nothing mapped, no job), else the last one, shared. AS1 only if it is the only
+ * AS left. 0 if none. With the lock.
+ */
+static unsigned
+user_as_pick_locked(bool display)
+{
+	unsigned last = 0;
+	bool display_ok = (user_as_present & (1u << USER_AS_DISPLAY)) && !uas[USER_AS_DISPLAY].broken;
+	if (display && display_ok) {
+		return USER_AS_DISPLAY;
+	}
+	for (unsigned as = USER_AS_DISPLAY + 1u; as <= USER_AS_LAST; as++) {
+		const struct user_as *u = &uas[as];
+		if (!(user_as_present & (1u << as)) || u->broken) {
+			continue;
+		}
+		last = as;
+		if (u->clients == 0 && u->chunks == 0 && __atomic_load_n(&u->jobs, __ATOMIC_ACQUIRE) == 0) {
+			return as;
+		}
+	}
+	if (last != 0) {
+		return last;                          /* more clients than ASes: the extras share the last */
+	}
+	return display_ok ? USER_AS_DISPLAY : 0;
+}
+
+/*
+ * v50: a HeroGPU client opens; the cores come up with the first one. v65: it gets an address space
+ * (display: backboardd's), returned for every later call; 0 if the GPU or no AS is available.
+ */
+unsigned a04s_gpu_user_open(bool display);
+unsigned
+a04s_gpu_user_open(bool display)
+{
+	if (job.state[0] != 'O' || job.state[1] != 'K') {
+		return 0;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	unsigned as = user_up_locked() ? user_as_pick_locked(display) : 0;
+	if (as != 0 && uas_live_locked(as)) {
+		uas[as].clients++;
+		uas[as].opens++;
+		user_clients++;
+		user_opens++;
+	} else {
+		as = 0;
+	}
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	return as;
+}
+
+/*
+ * The cores go off once nothing uses the GPU: no client, every AS released (its buffers unmapped, its
+ * jobs ended), the scheduler idle, and the present path (sweetfb_gpu=1) not using them. The next open
+ * brings them up afresh. With a04s_gpu_mtx held.
+ */
+static void
+user_maybe_off_locked(void)
+{
+	if (user_clients != 0 || !user_ready || __atomic_load_n(&present_ready, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	for (unsigned as = 1u; as <= USER_AS_LAST; as++) {
+		if (uas[as].live && !uas[as].broken) {
+			return;
+		}
+	}
+	if (!sched_idle_locked()) {
+		return;
+	}
+	gpu_cores_off();
+	user_ready = false;
+}
+
+/* v50: a client that opened has gone. v65: its AS is released once its buffers and jobs are gone too. */
+void a04s_gpu_user_close(unsigned as);
+void
+a04s_gpu_user_close(unsigned as)
+{
+	if (as == 0 || as > USER_AS_LAST) {
+		return;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	if (uas[as].clients > 0) {
+		uas[as].clients--;
+	}
+	if (user_clients > 0) {
+		user_clients--;
+	}
+	uas_release_locked(as);
+	user_maybe_off_locked();
+	lck_mtx_unlock(&a04s_gpu_mtx);
+}
+
+/* A GPU register (GPU_ID, *_PRESENT, *_FEATURES...), for GetParam; 0 outside the block or before. */
+uint32_t a04s_gpu_reg(uint32_t off);
+uint32_t
+a04s_gpu_reg(uint32_t off)
+{
+	if (!gpu_va || !user_ready || off >= 0x1000u || (off & 3u)) {
+		return 0;
+	}
+	return io_rd(gpu_va, off);
+}
+
+static bool
+user_as_ok(unsigned as)
+{
+	return as >= 1u && as <= USER_AS_LAST;
+}
+
+uint64_t a04s_gpu_user_va_alloc(unsigned as, uint64_t bytes);
+uint64_t
+a04s_gpu_user_va_alloc(unsigned as, uint64_t bytes)
+{
+	if (!user_as_ok(as)) {
+		return 0;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	uint64_t va = user_ready && uas[as].live && !uas[as].broken ? user_va_alloc_locked(as, bytes) : 0;
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	return va;
+}
+
+bool a04s_gpu_user_map(unsigned as, uint64_t va, const uint64_t *pages, unsigned n);
+bool
+a04s_gpu_user_map(unsigned as, uint64_t va, const uint64_t *pages, unsigned n)
+{
+	if (!user_as_ok(as) || pages == NULL || n == 0) {
+		return false;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	bool ok = user_ready && !uas[as].broken && user_set_locked(as, va, pages, n);
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	return ok;
+}
+
+/* Unmap n pages at va in AS as and give the VA back; a client-less AS may then be released. */
+void a04s_gpu_user_unmap(unsigned as, uint64_t va, unsigned n);
+void
+a04s_gpu_user_unmap(unsigned as, uint64_t va, unsigned n)
+{
+	if (!user_as_ok(as)) {
+		return;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	if (user_ready) {
+		(void)user_set_locked(as, va, NULL, n);
+		user_va_free_locked(as, va, n);
+		if (uas[as].clients == 0) {
+			uas_release_locked(as);
+			user_maybe_off_locked();
+		}
+	}
+	lck_mtx_unlock(&a04s_gpu_mtx);
+}
+
+/* Run the job chain at user GPU VA jc of AS as on slot js (0 fragment, 1 the rest) and wait.
+ * 0: finished cleanly; 0xfffffffe: the thermal limit; else the slot's status or 0xffffffff. */
+uint32_t a04s_gpu_user_submit(unsigned as, unsigned js, uint64_t jc, uint64_t *us);
+uint32_t
+a04s_gpu_user_submit(unsigned as, unsigned js, uint64_t jc, uint64_t *us)
+{
+	if (!user_as_ok(as) || js > 1 || jc < USER_VA_BASE || jc >= USER_VA_END) {
+		return 0xffffffffu;
+	}
+	if (!a04s_gpu_allowed()) {
+		lck_mtx_lock(&a04s_gpu_mtx);
+		user_hot++;
+		lck_mtx_unlock(&a04s_gpu_mtx);
+		return 0xfffffffeu;
+	}
+	if (a04s_gpu_sched_on()) {
+		/* v64: through the scheduler, waiting for the job's fence (no lock held meanwhile). */
+		struct a04s_fence *f = a04s_gpu_queue(as, js, jc, NULL, 0, NULL, NULL);
+		if (f == NULL) {
+			return 0xffffffffu;
+		}
+		uint32_t status = 0xffffffffu;
+		if (a04s_fence_wait(&f, 1, true, A04S_NO_DEADLINE, NULL) == 0) {
+			status = f->status;
+			if (us != NULL) {
+				*us = f->us;
+			}
+		}
+		a04s_fence_release(f);
+		return status;
+	}
+	uint32_t fault = 0, faddr = 0, st = 0xffffffffu;
+	uint64_t t = 0;
+	lck_mtx_lock(&a04s_gpu_mtx);
+	if (user_ready && uas[as].live && !uas[as].broken) {
+		st = user_run_locked(as, js, jc, &fault, &faddr, &t);
+		uj.jobs++;
+		if (fault) {
+			uj.faults++;
+			uas[as].faults++;
+		}
+	}
+	lck_mtx_unlock(&a04s_gpu_mtx);
+	if (us != NULL) {
+		*us = t;
+	}
+	return st;
+}
+
+/* A WRITE_VALUE (ZERO) job header at the start of the self-test buffer, writing 64 bits at target. */
+static void
+utest_write_value(uint64_t target)
+{
+	gpu_zero(utest_va, 0x100);
+	*(volatile uint8_t *)(utest_va + 16) = 1 | (JOB_WRITE_VALUE << 1);     /* 64-bit descriptor, WRITE_VALUE */
+	*(volatile uint16_t *)(utest_va + 18) = 1;                              /* job index */
+	*(volatile uint64_t *)(utest_va + 32) = target;                         /* payload: address */
+	*(volatile uint64_t *)(utest_va + 40) = 3;                              /* type ZERO */
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* a04sgpu_selftest=1, from gpu_first_job() once the first job passed. */
+static void
+user_selftest(uint32_t core0)
+{
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04sgpu_selftest", &want, sizeof(want));
+	if (want != 1) {
+		return;
+	}
+	uj.state = "RUNNING";
+	uj.why = "SETUP";
+	uint64_t pages[UTEST_PAGES];
+	for (unsigned i = 0; i < UTEST_PAGES; i++) {
+		pages[i] = UTEST_PA + i * 0x1000ull;
+	}
+	lck_mtx_lock(&a04s_gpu_mtx);
+	if (sched_hw_busy != 0) {
+		uj.why = "SCHED BUSY";           /* v64: user_run_locked(1u, ) would share the slots with the scheduler */
+	}
+	if (sched_hw_busy != 0 || !user_up_locked() || !uas_live_locked(1u)) {     /* v65: AS1, as before */
+		lck_mtx_unlock(&a04s_gpu_mtx);
+		uj.state = "FAIL";
+		kprintf("A04S GPU USER FAIL %s\n", uj.why);
+		return;
+	}
+	if (!utest_va) {
+		utest_va = ml_io_map((vm_offset_t)UTEST_PA, UTEST_BYTES);
+	}
+	uint64_t va = utest_va ? user_va_alloc_locked(1u, UTEST_BYTES) : 0;
+	if (va == 0 || !user_set_locked(1u, va, pages, UTEST_PAGES)) {
+		if (va != 0) {
+			(void)user_set_locked(1u, va, NULL, UTEST_PAGES);
+			user_va_free_locked(1u, va, UTEST_PAGES);  /* v50: give the VA back, or the cores never go off */
+		}
+		lck_mtx_unlock(&a04s_gpu_mtx);
+		uj.state = "FAIL";
+		uj.why = "MAP";
+		kprintf("A04S GPU USER FAIL MAP\n");
+		return;
+	}
+	uj.l3 = uas[1].l3;
+	uint64_t us = 0;
+	uint32_t fault = 0, faddr = 0;
+
+	/* 1: in AS1, on AS1's own buffer. */
+	uj.why = "WRITE_VALUE";
+	utest_write_value(va + 0x100u);
+	volatile uint64_t *out = (volatile uint64_t *)(utest_va + 0x100);
+	*out = 0xa5a5a5a55a5a5a5aull;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uj.wv_status = user_run_locked(1u, 1, va, &fault, &faddr, &us);
+	uj.wv_us = (uint32_t)us;
+	uj.wv_output = *out;
+
+	/* 2: in AS1, aimed at AS0's private page: not mapped in AS1, so it must fault. */
+	uj.why = "ISOLATION";
+	volatile uint64_t *priv = (volatile uint64_t *)(mem_va + GPU_DATA_OFF + GPU_OUT_OFF);
+	*priv = UTEST_MARKER;
+	utest_write_value(GPU_VA + GPU_OUT_OFF);
+	uj.iso_status = user_run_locked(1u, 1, va, &uj.iso_fault, &uj.iso_addr, &us);
+	uj.iso_output = *priv;
+
+	/* 3 (v47): AS1 works again after the fault, on its own buffer. */
+	uj.why = "AS1 AFTER";
+	uj.wv2_status = 0xffffffffu;
+	if (!uj.broken) {
+		utest_write_value(va + 0x100u);
+		*out = 0xa5a5a5a55a5a5a5aull;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		uj.wv2_status = user_run_locked(1u, 1, va, &fault, &faddr, &us);
+	}
+	uj.wv2_output = *out;
+
+	/* 4: AS0 still works: 7c-4a's private clear. */
+	uj.why = "AS0 AFTER";
+	uj.as0_ok = frag_job(GPU_VA + FRAG_RT_OFF, FRAG_W, FRAG_H, FRAG_W * 4u, FRAG_COLOR, core0, &uj.as0, 0, 0,
+	    SWIZZLE_RGBA);
+
+	(void)user_set_locked(1u, va, NULL, UTEST_PAGES);
+	user_va_free_locked(1u, va, UTEST_PAGES);
+	uas_release_locked(1u);                 /* v65: give AS1 back for backboardd */
+	lck_mtx_unlock(&a04s_gpu_mtx);
+
+	bool wv_ok = uj.wv_status == 0 && uj.wv_output == 0;
+	bool iso_ok = uj.iso_status != 0 && uj.iso_fault != 0 && uj.iso_output == UTEST_MARKER;
+	bool wv2_ok = uj.wv2_status == 0 && uj.wv2_output == 0 && !uj.broken;
+	if (wv_ok && iso_ok && wv2_ok && uj.as0_ok) {
+		uj.state = "OK";
+		uj.why = "AS1 RUNS JOBS, CAN'T REACH AS0 AND RECOVERS";
+	} else {
+		uj.state = "FAIL";
+		uj.why = !wv_ok ? "WRITE_VALUE" : !iso_ok ? "ISOLATION" : !wv2_ok ? "AS1 AFTER" : "AS0 AFTER";
+	}
+	kprintf("A04S GPU USER %s %s: WV %x OUT %llx, ISO %x FAULT %x@%x PRIV %llx, STOP %x MMU %x, WV2 %x OUT %llx, AS0 %s\n",
+	    uj.state, uj.why, uj.wv_status, uj.wv_output, uj.iso_status, uj.iso_fault, uj.iso_addr, uj.iso_output,
+	    uj.stop_status, uj.mmu_after, uj.wv2_status, uj.wv2_output, uj.as0_ok ? "OK" : "FAIL");
+	if (!uj.as0_ok) {
+		kprintf("A04S GPU USER AS0 JOB: JS %x IRQ %x MMU %x GPU %x ASF %x@%x US %u\n", uj.as0.js_status, uj.as0.jirq,
+		    uj.as0.mirq, uj.as0.girq, uj.as0.as_fault, uj.as0.as_addr, uj.as0.us);
+	}
+}
+
+static void
+gpu_first_job(void)
+{
+	job.state = "RUNNING";
+	job.why = "CHECKS";
+	if (!a04s_gpu_path_ok()) {
+		gpu_skip("GPU PATH");
+		return;
+	}
+	if (!core_va || !g3d_va) {
+		gpu_skip("NO MAPPING");
+		return;
+	}
+	if (!gate_running(io_rd(g3d_va, G3D_GATE_LHS_D)) || !gate_running(io_rd(core_va, CORE_GATE_LHM_D_G3D))) {
+		gpu_skip("DATA GATE");
+		return;
+	}
+	/* The thermal monitor needs THERM_TRUST_READS seconds to trust its readings. */
+	for (unsigned waited = 0; !a04s_gpu_allowed() && waited < 10000; waited += 500) {
+		IOSleep(500);
+	}
+	if (!a04s_gpu_allowed()) {
+		gpu_skip(therm.level == LEVEL_OFF ? "THERMAL OFF" : level_names[therm.level]);
+		return;
+	}
+	job.temp = a04s_gpu_temp();
+	if (job.temp == TMU_NO_TEMP) {
+		gpu_skip("NO TEMP");
+		return;
+	}
+	if (job.temp < GPU_TEMP_MIN || job.temp > GPU_TEMP_MAX) {
+		gpu_skip("TEMP");
+		return;
+	}
+	gpu_va = ml_io_map(GPU_PA, 0x5000);
+	mem_va = ml_io_map((vm_offset_t)GPU_MEM_PA, GPU_MEM_BYTES);
+	if (!gpu_va || !mem_va) {
+		gpu_skip("NO MAPPING");
+		return;
+	}
+	job.before_status = io_rd(gpu_va, GPU_STATUS);
+	job.before_l2 = io_rd(gpu_va, L2_READY);
+	job.before_sc = io_rd(gpu_va, SHADER_READY);
+	job.before_tl = io_rd(gpu_va, TILER_READY);
+
+	job.why = "RESET";
+	gpu_wr(GPU_IRQ_MASK, 0);
+	gpu_wr(JOB_IRQ_MASK, 0);
+	gpu_wr(MMU_IRQ_MASK, 0);
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_CMD, CMD_SOFT_RESET);
+	job.reset = gpu_wait(GPU_IRQ_RAWSTAT, IRQ_RESET_DONE, IRQ_RESET_DONE, 100000) ? 1 : 0;
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_IRQ_MASK, 0);
+	gpu_wr(JOB_IRQ_MASK, 0);
+	gpu_wr(MMU_IRQ_MASK, 0);
+	if (job.reset != 1) {
+		gpu_fail("RESET");
+		return;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		job.cfg[i] = io_rd(gpu_va, GPU_CONFIG(i));
+	}
+
+	job.why = "POWER";
+	uint32_t core0 = io_rd(gpu_va, SHADER_PRESENT) & 1u;
+	if (!core0 ||
+	    !gpu_power(L2_PWRON, L2_READY, io_rd(gpu_va, L2_PRESENT), &job.l2) ||
+	    !gpu_power(SHADER_PWRON, SHADER_READY, core0, &job.sc) ||
+	    !gpu_power(TILER_PWRON, TILER_READY, io_rd(gpu_va, TILER_PRESENT), &job.tl)) {
+		gpu_cores_off();
+		gpu_fail("POWER");
+		return;
+	}
+
+	/* The clock S-Boot left, from the GPU's own cycle counter. */
+	gpu_wr(GPU_CMD, CMD_CYCLE_START);
+	delay(100);
+	uint64_t t0 = mach_absolute_time();
+	uint32_t c0 = io_rd(gpu_va, GPU_CYCLE_LO);
+	delay(20000);
+	uint32_t c1 = io_rd(gpu_va, GPU_CYCLE_LO);
+	uint64_t us = us_since(t0);
+	gpu_wr(GPU_CMD, CMD_CYCLE_STOP);
+	job.mhz = us ? (uint32_t)((uint32_t)(c1 - c0) / us) : 0;
+
+	job.why = "MMU";
+	panel_probe();
+	gpu_tables();
+	vm_offset_t hdr = mem_va + GPU_DATA_OFF;
+	*(volatile uint8_t *)(hdr + 16) = 1 | (JOB_WRITE_VALUE << 1);   /* 64-bit descriptor, WRITE_VALUE */
+	*(volatile uint16_t *)(hdr + 18) = 1;                   /* job index */
+	*(volatile uint64_t *)(hdr + 32) = GPU_VA + GPU_OUT_OFF; /* payload: address */
+	*(volatile uint64_t *)(hdr + 40) = 3;                   /* type ZERO: write 64 zero bits */
+	volatile uint64_t *out = (volatile uint64_t *)(mem_va + GPU_DATA_OFF + GPU_OUT_OFF);
+	*out = 0xa5a5a5a55a5a5a5aull;
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint64_t transtab = GPU_MEM_PA | 7u;                    /* ADRMODE_TABLE | READ_INNER */
+	gpu_wr(AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	gpu_wr(AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	gpu_wr(AS0 + AS_MEMATTR_LO, 0x888d88u);
+	gpu_wr(AS0 + AS_MEMATTR_HI, 0);
+	gpu_wr(AS0 + AS_TRANSCFG_LO, 0);                        /* ADRMODE_LEGACY */
+	gpu_wr(AS0 + AS_TRANSCFG_HI, 0);
+	gpu_wr(AS0 + AS_COMMAND, 1);                            /* UPDATE */
+	if (!gpu_wait(AS0 + AS_STATUS, 1u, 0, 100000)) {
+		gpu_cores_off();
+		gpu_fail("MMU UPDATE");
+		return;
+	}
+
+	job.why = "JOB";
+	uint32_t slot = JS(1);
+	gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(slot + JS_HEAD_NEXT_LO, (uint32_t)GPU_VA);
+	gpu_wr(slot + JS_HEAD_NEXT_HI, (uint32_t)(GPU_VA >> 32));
+	gpu_wr(slot + JS_AFFINITY_NEXT_LO, core0);
+	gpu_wr(slot + JS_AFFINITY_NEXT_HI, 0);
+	/* Thread priority 8, clean and invalidate the GPU caches at start and end, address space 0. */
+	gpu_wr(slot + JS_CONFIG_NEXT, (8u << 16) | (3u << 8) | (3u << 12));
+	uint64_t start = mach_absolute_time();
+	gpu_wr(slot + JS_COMMAND_NEXT, 1);                      /* START */
+	for (unsigned i = 0; i < 20000; i++) {
+		job.jirq = io_rd(gpu_va, JOB_IRQ_RAWSTAT);
+		job.mirq = io_rd(gpu_va, MMU_IRQ_RAWSTAT);
+		job.girq = io_rd(gpu_va, GPU_IRQ_RAWSTAT);
+		if ((job.jirq & ((1u << 1) | (1u << 17))) || job.mirq || (job.girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT))) {
+			break;
+		}
+		delay(10);
+	}
+	job.us = (uint32_t)us_since(start);
+	job.js_status = io_rd(gpu_va, slot + JS_STATUS);
+	job.head = io_rd(gpu_va, slot + JS_HEAD_LO);
+	job.as_fault = io_rd(gpu_va, AS0 + AS_FAULTSTATUS);
+	job.as_addr = io_rd(gpu_va, AS0 + AS_FAULTADDR_LO);
+	job.gpu_fault = io_rd(gpu_va, GPU_FAULT_STATUS);
+	job.gpu_faddr = io_rd(gpu_va, GPU_FAULT_ADDR);
+	job.exc = *(volatile uint32_t *)(mem_va + GPU_DATA_OFF);
+	job.output = *out;
+	if ((job.js_status & 0xffu) == JS_ACTIVE) {
+		gpu_wr(slot + JS_COMMAND, JS_HARD_STOP);
+		(void)gpu_wait(slot + JS_STATUS, 0xffu, 0, 10000);
+	}
+	gpu_wr(JOB_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(MMU_IRQ_CLEAR, 0xffffffffu);
+	gpu_wr(GPU_IRQ_CLEAR, 0xffffffffu);
+
+	bool ok = (job.jirq & (1u << 1)) && !(job.jirq & (1u << 17)) && !job.mirq &&
+	    !(job.girq & (IRQ_GPU_FAULT | IRQ_MULTIPLE_FAULT)) && job.output == 0;
+	if (ok) {
+		if (gpu_fragment_clear(core0)) {
+			if (gpu_panel_clear(core0)) {
+				IOSleep(2000);          /* the green, then the gradient */
+				gpu_shader_gradient(core0);
+				if (shade.state[0] == 'O' && shade.state[1] == 'K') {
+					IOSleep(2000);  /* the gradient, then the scaled test image */
+					if (gpu_blit_test(core0)) {
+						unsigned live = 0;
+						(void)PE_parse_boot_argn("sweetfb_gpu", &live, sizeof(live));
+						if (live == 1) {
+							gpu_affinity = core0;
+							__atomic_store_n(&present_ready, true, __ATOMIC_RELEASE);
+						}
+					}
+				} else {
+					blit.why = "NO SHADER";
+				}
+			} else {
+				shade.why = "NO PANEL CLEAR";
+			}
+		} else if (panel.blocks) {
+			panel.state = "SKIP";
+			panel.why = "NO PRIVATE CLEAR";
+		}
+	} else {
+		frag.why = "NO FIRST JOB";
+	}
+	if (ok) {
+		user_selftest(core0);
+	}
+	if (!present_ready) {
+		gpu_cores_off();        /* with sweetfb_gpu=1 and every test passed, they stay on for iOS frames */
+		user_ready = false;     /* a04s_gpu_user_up() powers them again */
+	}
+	if (ok) {
+		job.state = "OK";
+		job.why = "THE MALI-G52 RAN A JOB";
+		kprintf("A04S GPU JOB OK in %u us, %u MHz\n", job.us, job.mhz);
+	} else {
+		gpu_fail(job.jirq || job.mirq || job.girq ? "FAULT" : "TIMEOUT");
+	}
+}
+
+static void
+a04s_gpu_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	gpu_first_job();
+}
+
+/* Called by a04s_input_start() once 7c-2's checks have run. */
+void a04s_gpu_start(void);
+void
+a04s_gpu_start(void)
+{
+	top_va = ml_io_map(CMU_TOP_PA, 0x4000);
+	core_va = ml_io_map(CMU_CORE_PA, 0x4000);
+	if (a04s_gpu_path_ok()) {
+		g3d_va = ml_io_map(CMU_G3D_PA, 0x4000);
+	}
+	cpucl0_va = ml_io_map(CMU_CPUCL0_PA, 0x2000);
+	cpucl1_va = ml_io_map(CMU_CPUCL1_PA, 0x2000);
+	tmu_read();
+	unsigned thermal = 1;
+	(void)PE_parse_boot_argn("a04sthermal", &thermal, sizeof(thermal));
+	if (thermal != 0) {
+		thread_t tthread;
+		if (kernel_thread_start(a04s_therm_thread, NULL, &tthread) == KERN_SUCCESS) {
+			thread_deallocate(tthread);
+			therm.level = LEVEL_UNTRUSTED;
+		} else {
+			kprintf("A04S THERMAL NO THREAD\n");
+		}
+	}
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04sgpu", &want, sizeof(want));
+	if (want != 1) {
+		return;
+	}
+	job.state = "STARTING";
+	job.why = "THREAD";
+	thread_t thread;
+	if (kernel_thread_start(a04s_gpu_thread, NULL, &thread) != KERN_SUCCESS) {
+		gpu_fail("NO THREAD");
+		return;
+	}
+	thread_deallocate(thread);
+}
