+/* Takes no locks and touches only this table, so the heartbeat can always call it. */
+void a04s_print_faults(void);
+void
+a04s_print_faults(void)
+{
+	uint64_t total = a04s_user_aborts;
+	for (uint64_t n = total, shown = 0; n > 0 && shown < 12; n--, shown++) {
+		unsigned slot = (unsigned)((n - 1) % A04S_FAULTS);
+		kprintf("F %llu %llx %llx %x %d\n", n, a04s_faults[slot].addr, a04s_faults[slot].pc,
+		    a04s_faults[slot].esr, a04s_faults[slot].result);
+	}
+}
