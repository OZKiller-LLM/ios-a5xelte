+} gpu = { .why = "NOT TRIED" };
+static vm_offset_t cmu_cmgp_va, spi1, cmgp_pins;
+static struct {
+	int state;                              /* -1 not run, 0 the ID matched, 1 ran without a match */
+	const char *why;                        /* the step it is on, or the one that stopped it */
+	uint32_t usi_back, div_back, cfg, mode, status;
