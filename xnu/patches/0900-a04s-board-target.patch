+void
+a04s_power_start(void)
+{
+	vm_offset_t pmu = ml_io_map(PD_AUD_PA, 0x1000);
+	if (pmu) {
+		pd_aud_config = io_rd(pmu, PD_AUD_CONFIG);
+		pd_aud_status = io_rd(pmu, PD_AUD_STATUS);
+	}
+	if (pd_aud_status & 1u) {
+		vm_offset_t aud = ml_io_map(CMU_AUD_PA, 0x1000);
+		if (aud) {
+			aud_pll = io_rd(aud, AUD_PLL_CON3);
+			aud_pll_read = true;
+		}
+	}
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04samp", &want, sizeof(want));
+	if (want != 1) {
+		return;
+	}
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bus_check(&buses[1]);
+	if (buses[1].why) {
+		amp.state = "NO BUS";
+	} else if (i2c_read16(DEV_AMP, AMP_ID, &amp.id) && i2c_read16(DEV_AMP, AMP_STATUS, &amp.status)) {
+		amp.state = "OK";
+	} else {
+		amp.state = "NO CHIP";
+	}
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	kprintf("A04S AMP %s ID %04x ST %04x\n", amp.state, amp.id, amp.status);
+}
