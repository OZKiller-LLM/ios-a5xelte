+	/* The PID 1 sampler is a debugging aid, off unless a04ssample=1. */
+	unsigned int want_sampler = 0;
+	(void)PE_parse_boot_argn("a04ssample", &want_sampler, sizeof(want_sampler));
+	if (want_sampler == 1 && kernel_thread_start(a04s_sampler, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
