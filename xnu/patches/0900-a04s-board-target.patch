+		emmc_writable = want_writes == 1 && a04s_guard_self_test();
+#endif
+		a04s_step = "VOLUME";
+		int error = emmc_read_sector(A04S_USERDATA_FIRST + 2u, sector);
+		if (error) {
+			return error;
+		}
+		/* HFSX volume header. */
+		if (sector[0] != 'H' || sector[1] != 'X') {
+			return ENXIO;
+		}
+		int bmajor = bdevsw_add(-1, &emmc_bdevsw);
+		if (bmajor < 0) {
+			return ENXIO;
+		}
+		emmc_bdev = makedev(bmajor, 0);
+		devfs_make_node(emmc_bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "emmcroot0");
+		emmc_ready = true;
+		a04s_step = "MOUNT";
+	}
+	*dev = emmc_bdev;
+	return 0;
+}
