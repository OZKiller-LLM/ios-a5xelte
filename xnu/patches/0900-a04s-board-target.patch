+	    tp3.fwinfo[2], tp3.fwinfo[3], tp3.fwinfo[4], tp3.fwinfo[5], tp3.fwinfo[6], tp3.fwinfo[7]);
+	kprintf("TP4 %d %s P %u E %u INT %u/%u%s RD %u CK %u REC %u XY %u EV %u DOWN %x AT %d,%d M %x\n", tp4.state,
+	    tp4.why, tp4.polls, tp4.edges, tp4.int_low, tp4.int_high, tp4.int_works ? " OK" : "", tp4.reads,
+	    tp4.ck_bad, tp4.recovery, tp4.bad_xy, tp4.events, tp4.down, tp4.last_x, tp4.last_y, tp4.eint_mask & 0xffu);
+	kprintf("GPU PD %x %x %s\n", gpu_pd_config, gpu_pd_status, (gpu_pd_status & 1u) ? "ON" : "OFF");
+	kprintf("GPU CLK %u%u %u%u%u Q %x %x\n", gate_code(gpu.top), gate_code(gpu.core), gate_code(gpu.g3d_pclk),
