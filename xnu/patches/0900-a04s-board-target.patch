+/* pd-g3d@11861d00: configuration, then status; bit 0 is the local power state (mali gpu_pmu_status_*). */
+#define PD_G3D_PA               0x11861000u
+#define PD_G3D_CONFIG           0xd00u
+#define PD_G3D_STATUS           0xd04u
+/* The GPU's clock path (cmucal-sfr.c). CMU_G3D is inside pd-g3d: it is read only with the domain on. */
+#define CMU_TOP_PA              0x120e0000u
+#define GATE_TOP_G3D_SWITCH     0x2040u
+#define CMU_CORE_PA             0x12000000u
+#define GATE_CORE_LHS_P_G3D     0x20c0u
+#define CMU_G3D_PA              0x11400000u
+#define GATE_G3D_CMU_PCLK       0x2000u
