+/* v64: 14 SyncobjReset (signal false) and 15 SyncobjSignal (true). */
+IOReturn
+HeroGPUUserClient::syncSet(const uint8_t *in, uint32_t size, bool signal)
+{
+	struct herogpu_syncobj_array a;
+	if (size < sizeof(a)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&a, in, sizeof(a));
+	if (a.count_handles == 0 || a.count_handles > HEROGPU_MAX_SYNCOBJS || size != sizeof(a) + 4u * a.count_handles) {
+		return kIOReturnBadArgument;
+	}
+	const uint8_t *hs = in + sizeof(a);
+	for (uint32_t i = 0; i < a.count_handles; i++) {
+		if (sync(herogpu_u32(hs + 4u * i)) == NULL) {
+			return kIOReturnBadArgument;
+		}
+	}
+	for (uint32_t i = 0; i < a.count_handles; i++) {
+		struct herogpu_syncobj *so = sync(herogpu_u32(hs + 4u * i));
+		struct a04s_fence *f = NULL;
+		if (signal) {
+			f = a04s_fence_create(true);
+			if (f == NULL) {
+				return kIOReturnNoMemory;
+			}
+		}
+		a04s_fence_release(so->fence);
+		so->fence = f;
+	}
+	return kIOReturnSuccess;
+}
