+/*
+ * Galaxy A04s: the battery (fuel gauge), and read-only first looks at the speaker amp and the audio
+ * power domain.
+ *
+ * I2C: the two buses used here are Samsung's plain s3c2440-i2c controllers (live device tree):
+ *  - bus 0, i2c@13830000: the MAX1726x fuel gauge at 0x36. Pins gpp0-0/1, function 2.
+ *  - bus 3, i2c@13860000: the FourSemi FS18xx speaker amp at 0x34. Pins gpp1-0/1, function 2.
+ * The driver below only reads, with one exception (v44, v45, below): the charger's REG03 CHG_CONFIG
+ * bit and REG04 ICHG, each from a fixed set of values. A read sends the device's address and one
+ * register number, then a repeated start and the read: it never sends a data byte. Only chg_send(),
+ * inside a04s_chg_write03() and a04s_chg_write04(), does. The only GPIO writes are AFC's (v46,
+ * afc_pin(), three pins of the device tree's gpio_afc node, with a04safc=1).
+ * Each device has a fixed list of registers it may read; anything else is refused. A bus is used
+ * only if its CMU_PERI PCLK gate is running, its Q-channel can't stop the clock, both pins have the
+ * I2C function, and the controller isn't busy. The bus runs at
+ * the slowest rate the controller has (PCLK / 512 / 16), far under the 400 kHz both chips take, and
+ * its interrupt-enable bit is set only if the GIC can't deliver that interrupt (S-Boot may have left
+ * an SPI enabled, and XNU has no handler for it). Every poll is bounded.
+ *
+ * Pins (v35): v34 found S-Boot leaves gpp0-0/1 as GPIO outputs (CON 0x11, so it bit-bangs the gauge)
+ * and gpp1-0/1 at reset (inputs, 0x00). pins_to_i2c() sets just those two pins of the bank to
+ * function 2 with pull-up 3, the values in the device tree's i2c0-bus / i2c3-bus nodes, and only
+ * from those two states. Exynos 850 PERI banks have 4-bit CON and PUD fields (Linux
+ * exynos850_bank_type_off: CON +0x0, DAT +0x4, PUD +0x8). The other pins' fields are written back
+ * unchanged, the result is read back, and on a mismatch both registers get their old values again.
+ *
+ * Fuel gauge, with the boot-arg a04sfg=1 (SweetBattery polls it every 30 s; without it iOS gets
+ * SweetBattery's static 100%): Maxim ModelGauge m5 registers, as the S7's MAX77854 (herolte_battery.c).
+ * The device tree's fuelgauge,rsense = 5 (mOhm) and designcap = 0x128e (4750 at 1 mAh a bit) agree:
+ *   RepSOC 0x06 1/256 %, VCell 0x09 78.125 uV, Current 0x0A and AvgCurrent 0x0B signed 312.5 uA
+ *   (positive = charging), RepCap 0x05 and FullCapRep 0x10 1 mAh, Temp 0x08 signed 1/256 C,
+ *   Status 0x00, TTE 0x11, Cycles 0x17, DesignCap 0x18, AvgVCell 0x19, DevName 0x21.
+ * Charger, with a04sfg=1 (a04schg=0 turns it off): the Silergy SY6970 at 0x6a on the same bus
+ * (device tree sy6970@6a; Android's module is syv660_charger). Register-compatible with TI's
+ * BQ25895 (Linux bq25890_charger.c reg_fields): 8-bit registers 0x00-0x14, read one byte at a time,
+ * and only read, except REG03's CHG_CONFIG with a04schgsafe=1 (v44) and REG04's ICHG with a04schgfast=1 as well (v45). All its other settings stay as S-Boot left them. All of 0x00-0x14 once at start, then the
+ * status (0x0B), faults (0x0C, read twice: the first read returns the latched faults, the second the
+ * current ones), the ADC (0x0E, 0x11, 0x12), the input limit in use (0x13) and the ADC mode (0x02) on
+ * each poll. SweetBattery takes power-good as the cable and CHRG_STAT as charging or done; without
+ * an answer it falls back to the gauge's current (above 20 mA is charging), as on the S7.
+ *
+ * Speaker amp, with a04samp=1: its ID and status registers (0x03, 0x00; 16-bit, big-endian), once
+ * at root mount. The amp stays as S-Boot left it.
+ *
+ * Battery thermistor, with a04sadc=1: the SoC's ADC, channel 1 (v43, below the gauge's code).
+ *
+ * Audio power, always: pd-aud's configuration and status in the always-on PMU, and PLL_AUD in
+ * CMU_AUD only when pd-aud is on. Reads only; ABOX itself is not touched.
+ */
+#if defined(ARM64_BOARD_CONFIG_A04S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <mach/boolean.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern boolean_t ml_set_interrupts_enabled(boolean_t enable);
+extern void IOSleep(unsigned int milliseconds);
+
+#define GATE_MANUAL             (1u << 20)
+#define GATE_CG_VAL             (1u << 21)
+#define QCH_ENABLE              (1u << 0)
+#define QCH_CLOCK_REQ           (1u << 1)
+#define CMU_PERI_PA             0x10030000u
+#define PERI_PINS_PA            0x139b0000u     /* pinctrl@139b0000: bank CON +0x0 */
+#define GICD_PA                 0x12a01000u
+#define PIN_CON                 0x00u
+#define PIN_DAT                 0x04u
+#define PIN_PUD                 0x08u
+#define PIN_MASK                0xffu           /* pins 0 and 1, 4 bits each */
+#define PIN_FUNC_I2C            0x22u
+#define PIN_PUD_UP              0x33u           /* samsung,pin-pud = 3 */
+#define PIN_WAS_OUT             0x11u           /* as S-Boot leaves gpp0 */
+#define PIN_WAS_IN              0x00u           /* the reset value, as gpp1 */
+#define GICD_ISENABLER          0x100u
+
+/* s3c2440-i2c (Linux i2c-s3c2410.c). */
+#define IICCON                  0x00u
+#define IICSTAT                 0x04u
+#define IICDS                   0x0cu
+#define IICLC                   0x10u
+#define CON_ACKEN               (1u << 7)
+#define CON_TXDIV_512           (1u << 6)
+#define CON_IRQEN               (1u << 5)
+#define CON_IRQPEND             (1u << 4)
+#define CON_SCALE_MAX           0xfu
+#define STAT_MASTER_RX          0x80u
+#define STAT_MASTER_TX          0xc0u
+#define STAT_START              (1u << 5)       /* write: start; read: bus busy */
+#define STAT_TXRXEN             (1u << 4)
+#define STAT_ARBITR             (1u << 3)
+#define STAT_LASTBIT            (1u << 0)       /* 1: no ACK */
+#define LC_FILTER_ON            (1u << 2)
+#define I2C_WAIT_US             5000u
+
+/* pd-aud@11862080 and PLL_AUD (cmucal-sfr.c). */
+#define PD_AUD_PA               0x11862000u
+#define PD_AUD_CONFIG           0x080u
+#define PD_AUD_STATUS           0x084u
+#define CMU_AUD_PA              0x14a00000u
+#define AUD_PLL_CON3            0x10cu
+
+#define FG_ADDR                 0x36u
+#define AMP_ADDR                0x34u
+#define FG_STATUS               0x00u
+#define FG_REPCAP               0x05u
+#define FG_REPSOC               0x06u
+#define FG_TEMP                 0x08u
+#define FG_VCELL                0x09u
+#define FG_CURRENT              0x0au
+#define FG_AVGCURRENT           0x0bu
+#define FG_FULLCAPREP           0x10u
+#define FG_TTE                  0x11u
+#define FG_CYCLES               0x17u
+#define FG_DESIGNCAP            0x18u
+#define FG_AVGVCELL             0x19u
+#define FG_DEVNAME              0x21u
+#define CHG_ADDR                0x6au
+#define CHG_NREGS               0x15u           /* 0x00-0x14 */
+#define CHG_REG_IINLIM          0x00u
+#define CHG_REG_ADC             0x02u
+#define CHG_REG_CFG             0x03u
+#define CHG_REG_ICHG            0x04u
+#define CHG_REG_VREG            0x06u
+#define CHG_REG_TIMER           0x07u
+#define CHG_REG_STATUS          0x0bu
+#define CHG_REG_FAULT           0x0cu
+#define CHG_REG_BATV            0x0eu
+#define CHG_REG_VBUSV           0x11u
+#define CHG_REG_ICHGR           0x12u
+#define CHG_REG_IDPM            0x13u
+#define CHG_REG_PART            0x14u
+#define AMP_STATUS              0x00u
+#define AMP_ID                  0x03u
+#define NO_TEMP                 (-9990)         /* tenths of a degree */
+
+struct i2c_bus {
+	const char *name;
+	uint32_t pa, gate_off, qch_off, pin_bank;
+	unsigned gic_id;
+	vm_offset_t va;
+	const char *why;                        /* NULL once usable */
+	uint32_t gate, qch, pins, con0, stat0;
+	uint32_t pins_was, pud_was, dat_was, pud;
+	const char *pinset;                     /* -, ALREADY, SET, UNEXPECTED, NO READBACK */
+	bool irqen;
+	uint32_t xfers, errors;
+	const char *last_error;
+};
+
+static struct i2c_bus buses[2] = {
+	{ .name = "I2C0", .pa = 0x13830000u, .gate_off = 0x203cu, .qch_off = 0x301cu, .pin_bank = 0x020u,
+	  .gic_id = 32u + 0xc4u, .why = "NOT TRIED", .last_error = "-", .pinset = "-" },
+	{ .name = "I2C3", .pa = 0x13860000u, .gate_off = 0x2048u, .qch_off = 0x3028u, .pin_bank = 0x040u,
+	  .gic_id = 32u + 0xc7u, .why = "NOT TRIED", .last_error = "-", .pinset = "-" },
+};
+
+/* The only transfers there are: a device, its bus, its byte order, and the registers it may read. */
+static const uint8_t fg_regs[] = { FG_STATUS, FG_REPCAP, FG_REPSOC, FG_TEMP, FG_VCELL, FG_CURRENT,
+	FG_AVGCURRENT, FG_FULLCAPREP, FG_TTE, FG_CYCLES, FG_DESIGNCAP, FG_AVGVCELL, FG_DEVNAME };
+static const uint8_t amp_regs[] = { AMP_STATUS, AMP_ID };
+static const uint8_t chg_regs[CHG_NREGS] = { 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09,
+	0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14 };
+struct i2c_dev {
+	unsigned bus;
+	uint8_t addr;
+	bool big_endian;
+	unsigned width;                         /* bytes per register: 1 or 2 */
+	const uint8_t *regs;
+	unsigned nregs;
+};
+enum { DEV_FG = 0, DEV_AMP = 1, DEV_CHG = 2 };
+static const struct i2c_dev devs[3] = {
+	{ 0, FG_ADDR, false, 2, fg_regs, (unsigned)sizeof(fg_regs) },
+	{ 1, AMP_ADDR, true, 2, amp_regs, (unsigned)sizeof(amp_regs) },
+	{ 0, CHG_ADDR, false, 1, chg_regs, (unsigned)sizeof(chg_regs) },
+};
+
+static LCK_GRP_DECLARE(a04s_power_grp, "a04s_power");
+static LCK_MTX_DECLARE(a04s_i2c_mtx, &a04s_power_grp);
+static vm_offset_t peri_va, pins_va, gicd_va;
+
+static struct {
+	const char *state;                      /* OFF, NO BUS, NO CHIP, OK, ERR */
+	uint16_t devname, status, designcap, cycles, tte;
+	unsigned percent, mv, avg_mv, rem, full;
+	int ma, avg_ma, temp_dc;
+	uint32_t reads, bad;
+	bool ok;                                /* the last read worked */
+} fg = { .state = "OFF", .temp_dc = NO_TEMP };
+
+static struct {
+	const char *state;
+	uint16_t id, status;
+} amp = { .state = "OFF" };
+
+static struct {
+	const char *state;                      /* OFF, NO BUS, NO CHIP, OK, ERR */
+	uint8_t regs[CHG_NREGS];                /* the start-up dump */
+	uint8_t status, fault_latched, fault, batv, vbusv, ichgr, idpm, adc;
+	uint32_t reads, bad;
+	bool started;                           /* the start-up dump worked */
+	bool ok;                                /* the last poll worked */
+} chg = { .state = "OFF" };
+
+static uint32_t pd_aud_config, pd_aud_status, aud_pll;
+static bool aud_pll_read;
+
+static inline uint32_t
+io_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+io_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static bool
+gate_running(uint32_t gate)
+{
+	return !(gate & GATE_MANUAL) || (gate & GATE_CG_VAL);
+}
+
+static bool
+qch_may_stop(uint32_t qch)
+{
+	return (qch & QCH_ENABLE) && !(qch & QCH_CLOCK_REQ);
+}
+
+/*
+ * The one write outside the I2C controllers: the bus's two pins to the I2C function with pull-ups,
+ * pull-ups first so a line is never left floating. Called with a04s_i2c_mtx held, once per bus.
+ */
+static void
+pins_to_i2c(struct i2c_bus *b)
+{
+	uint32_t con = io_rd(pins_va, b->pin_bank + PIN_CON);
+	uint32_t pud = io_rd(pins_va, b->pin_bank + PIN_PUD);
+
+	b->pins_was = con;
+	b->pud_was = pud;
+	b->dat_was = io_rd(pins_va, b->pin_bank + PIN_DAT);
+	if ((con & PIN_MASK) == PIN_FUNC_I2C) {
+		b->pinset = "ALREADY";
+		return;
+	}
+	if ((con & PIN_MASK) != PIN_WAS_OUT && (con & PIN_MASK) != PIN_WAS_IN) {
+		b->pinset = "UNEXPECTED";
+		return;
+	}
+	io_wr(pins_va, b->pin_bank + PIN_PUD, (pud & ~PIN_MASK) | PIN_PUD_UP);
+	io_wr(pins_va, b->pin_bank + PIN_CON, (con & ~PIN_MASK) | PIN_FUNC_I2C);
+	delay(100);
+	uint32_t con2 = io_rd(pins_va, b->pin_bank + PIN_CON);
+	uint32_t pud2 = io_rd(pins_va, b->pin_bank + PIN_PUD);
+	if (con2 != ((con & ~PIN_MASK) | PIN_FUNC_I2C) || pud2 != ((pud & ~PIN_MASK) | PIN_PUD_UP)) {
+		io_wr(pins_va, b->pin_bank + PIN_CON, con);
+		io_wr(pins_va, b->pin_bank + PIN_PUD, pud);
+		b->pinset = "NO READBACK";
+		kprintf("A04S %s PINS NO READBACK CON %x->%x PUD %x->%x, put back\n", b->name, con, con2, pud, pud2);
+		return;
+	}
+	b->pinset = "SET";
+	kprintf("A04S %s PINS SET CON %x->%x PUD %x->%x DAT %x\n", b->name, con, con2, pud, pud2, b->dat_was);
+}
+
+/* Decides whether a bus can be used, and how. Its only write is pins_to_i2c(). */
+static void
+bus_check(struct i2c_bus *b)
+{
+	if (!peri_va) {
+		peri_va = ml_io_map(CMU_PERI_PA, 0x4000);
+	}
+	if (!pins_va) {
+		pins_va = ml_io_map(PERI_PINS_PA, 0x1000);
+	}
+	if (!gicd_va) {
+		gicd_va = ml_io_map(GICD_PA, 0x1000);
+	}
+	if (!peri_va || !pins_va || !gicd_va) {
+		b->why = "NO MAPPING";
+		return;
+	}
+	b->gate = io_rd(peri_va, b->gate_off);
+	b->qch = io_rd(peri_va, b->qch_off);
+	if (!gate_running(b->gate)) {
+		b->why = "GATE";
+		return;
+	}
+	if (qch_may_stop(b->qch)) {
+		b->why = "QCH";
+		return;
+	}
+	if (b->pinset[0] == '-') {
+		pins_to_i2c(b);
+	}
+	b->pins = io_rd(pins_va, b->pin_bank + PIN_CON);
+	b->pud = io_rd(pins_va, b->pin_bank + PIN_PUD);
+	if ((b->pins & PIN_MASK) != PIN_FUNC_I2C) {
+		b->why = "PINS";
+		return;
+	}
+	if (!b->va) {
+		b->va = ml_io_map(b->pa, 0x1000);
+	}
+	if (!b->va) {
+		b->why = "NO MAPPING";
+		return;
+	}
+	b->con0 = io_rd(b->va, IICCON);
+	b->stat0 = io_rd(b->va, IICSTAT);
+	if (b->stat0 & STAT_START) {
+		b->why = "BUSY";
+		return;
+	}
+	uint32_t en = io_rd(gicd_va, GICD_ISENABLER + 4u * (b->gic_id / 32u));
+	b->irqen = !(en & (1u << (b->gic_id % 32u)));
+	b->why = NULL;
+}
+
+static bool
+i2c_wait_pend(struct i2c_bus *b)
+{
+	for (unsigned us = 0; us <= I2C_WAIT_US; us += 5) {
+		if (io_rd(b->va, IICCON) & CON_IRQPEND) {
+			return true;
+		}
+		delay(5);
+	}
+	return false;
+}
+
+static void
+i2c_stop(struct i2c_bus *b, uint32_t mode, uint32_t con)
+{
+	io_wr(b->va, IICSTAT, mode | STAT_TXRXEN);
+	io_wr(b->va, IICCON, con & ~(CON_IRQPEND | CON_ACKEN));
+	for (unsigned us = 0; us <= I2C_WAIT_US && (io_rd(b->va, IICSTAT) & STAT_START); us += 5) {
+		delay(5);
+	}
+}
+
+static bool
+i2c_fail(struct i2c_bus *b, const char *what, uint32_t mode, uint32_t con)
+{
+	b->errors++;
+	b->last_error = what;
+	i2c_stop(b, mode, con);
+	return false;
+}
+
+/*
+ * One register: START, address + W, the register number, repeated START, address + R, the
+ * register's one or two bytes (the last one NACKed), STOP. Called with a04s_i2c_mtx held.
+ */
+static bool
+i2c_read16(unsigned dev_index, uint8_t reg, uint16_t *value)
+{
+	if (dev_index >= sizeof(devs) / sizeof(devs[0])) {
+		return false;
+	}
+	const struct i2c_dev *d = &devs[dev_index];
+	bool listed = false;
+	for (unsigned i = 0; i < d->nregs; i++) {
+		listed = listed || d->regs[i] == reg;
+	}
+	struct i2c_bus *b = &buses[d->bus];
+	if (!listed || b->why) {
+		return false;
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_START) {
+		b->errors++;
+		b->last_error = "BUSY";
+		return false;
+	}
+	b->xfers++;
+	uint32_t con = CON_ACKEN | CON_TXDIV_512 | CON_SCALE_MAX | (b->irqen ? CON_IRQEN : 0);
+	io_wr(b->va, IICLC, LC_FILTER_ON);
+	io_wr(b->va, IICCON, con);
+	io_wr(b->va, IICSTAT, STAT_MASTER_TX | STAT_TXRXEN);
+	io_wr(b->va, IICDS, (uint32_t)d->addr << 1);
+	delay(1);
+	io_wr(b->va, IICSTAT, STAT_MASTER_TX | STAT_TXRXEN | STAT_START);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT ADDR", STAT_MASTER_TX, con);
+	}
+	uint32_t st = io_rd(b->va, IICSTAT);
+	if (st & STAT_ARBITR) {
+		return i2c_fail(b, "ARBITRATION", STAT_MASTER_TX, con);
+	}
+	if (st & STAT_LASTBIT) {
+		return i2c_fail(b, "NACK ADDR", STAT_MASTER_TX, con);
+	}
+	io_wr(b->va, IICDS, reg);
+	delay(1);
+	io_wr(b->va, IICCON, con);                              /* clears the pending bit: send it */
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT REG", STAT_MASTER_TX, con);
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_LASTBIT) {
+		return i2c_fail(b, "NACK REG", STAT_MASTER_TX, con);
+	}
+	io_wr(b->va, IICSTAT, STAT_MASTER_RX | STAT_TXRXEN);
+	io_wr(b->va, IICDS, ((uint32_t)d->addr << 1) | 1u);
+	delay(1);
+	io_wr(b->va, IICSTAT, STAT_MASTER_RX | STAT_TXRXEN | STAT_START);
+	io_wr(b->va, IICCON, con);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT RESTART", STAT_MASTER_RX, con);
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_LASTBIT) {
+		return i2c_fail(b, "NACK READ", STAT_MASTER_RX, con);
+	}
+	if (d->width == 1) {
+		io_wr(b->va, IICCON, con & ~CON_ACKEN);         /* the only byte, NACKed */
+		if (!i2c_wait_pend(b)) {
+			return i2c_fail(b, "TIMEOUT BYTE0", STAT_MASTER_RX, con);
+		}
+		uint8_t only = (uint8_t)io_rd(b->va, IICDS);
+		i2c_stop(b, STAT_MASTER_RX, con);
+		*value = only;
+		return true;
+	}
+	io_wr(b->va, IICCON, con);                              /* first byte, ACKed */
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT BYTE0", STAT_MASTER_RX, con);
+	}
+	uint8_t b0 = (uint8_t)io_rd(b->va, IICDS);
+	io_wr(b->va, IICCON, con & ~CON_ACKEN);                 /* last byte, NACKed */
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT BYTE1", STAT_MASTER_RX, con);
+	}
+	uint8_t b1 = (uint8_t)io_rd(b->va, IICDS);
+	i2c_stop(b, STAT_MASTER_RX, con);
+	*value = d->big_endian ? (uint16_t)((b0 << 8) | b1) : (uint16_t)(b0 | (b1 << 8));
+	return true;
+}
+
+static bool
+chg_reg(uint8_t reg, uint8_t *value)
+{
+	uint16_t v = 0;
+	if (!i2c_read16(DEV_CHG, reg, &v)) {
+		return false;
+	}
+	*value = (uint8_t)v;
+	return true;
+}
+
+/* The start-up dump and the part number. Called with a04s_i2c_mtx held, once the bus is usable. */
+static void
+chg_start(void)
+{
+	unsigned want = 1;
+	(void)PE_parse_boot_argn("a04schg", &want, sizeof(want));
+	if (want != 1) {
+		chg.state = "OFF";
+		return;
+	}
+	for (unsigned r = 0; r < CHG_NREGS; r++) {
+		if (!chg_reg((uint8_t)r, &chg.regs[r])) {
+			chg.state = r == 0 ? "NO CHIP" : "ERR";
+			return;
+		}
+	}
+	chg.fault_latched = chg.regs[CHG_REG_FAULT];
+	chg.state = "OK";
+	chg.started = true;
+	chg.ok = true;
+}
+
+/* Each poll: status, faults (twice), the ADC and the input limit in use. With a04s_i2c_mtx held. */
+static void
+chg_poll(void)
+{
+	if (!chg.started) {
+		return;
+	}
+	uint8_t first = 0;
+	bool ok = chg_reg(CHG_REG_STATUS, &chg.status) && chg_reg(CHG_REG_FAULT, &first) &&
+	    chg_reg(CHG_REG_FAULT, &chg.fault) && chg_reg(CHG_REG_BATV, &chg.batv) &&
+	    chg_reg(CHG_REG_VBUSV, &chg.vbusv) && chg_reg(CHG_REG_ICHGR, &chg.ichgr) &&
+	    chg_reg(CHG_REG_IDPM, &chg.idpm) && chg_reg(CHG_REG_ADC, &chg.adc);
+	chg.reads++;
+	chg.ok = ok;
+	if (!ok) {
+		chg.bad++;
+		chg.state = "ERR";
+		return;
+	}
+	chg.fault_latched |= first;
+	chg.state = "OK";
+}
+
+/*
+ * For SweetBattery: 0 with the charger's view of the cable, or -1 without an answer.
+ * external: power good. charging: pre-charge or fast charge. done: charge termination.
+ */
+int a04s_chg_state(int *external, int *charging, int *done);
+int
+a04s_chg_state(int *external, int *charging, int *done)
+{
+	if (!chg.ok) {
+		return -1;
+	}
+	unsigned stat = (chg.status >> 3) & 3u;
+	*external = (int)((chg.status >> 2) & 1u);
+	*charging = stat == 1u || stat == 2u;
+	*done = stat == 3u;
+	return 0;
+}
+
+static bool
+fg_reg(uint8_t reg, uint16_t *value)
+{
+	return i2c_read16(DEV_FG, reg, value);
+}
+
+/* For SweetBattery (iokit/Kernel/arm/SweetBattery.cpp). 0 once the gauge has answered. */
+int a04s_fg_init(void);
+int
+a04s_fg_init(void)
+{
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04sfg", &want, sizeof(want));
+	if (want != 1) {
+		fg.state = "OFF";
+		return -1;
+	}
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bus_check(&buses[0]);
+	bool ok = false;
+	if (buses[0].why) {
+		fg.state = "NO BUS";
+	} else if (!fg_reg(FG_DEVNAME, &fg.devname) || fg.devname == 0 || fg.devname == 0xffffu) {
+		fg.state = "NO CHIP";
+	} else {
+		(void)fg_reg(FG_DESIGNCAP, &fg.designcap);
+		fg.state = "OK";
+		ok = true;
+	}
+	if (buses[0].why) {
+		chg.state = "NO BUS";
+	} else {
+		chg_start();
+	}
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	kprintf("A04S FG %s %s DEV %04x\n", fg.state, buses[0].why ? buses[0].why : buses[0].last_error, fg.devname);
+	return ok ? 0 : -1;
+}
+
+int a04s_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah);
+int
+a04s_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah)
+{
+	uint16_t soc, vcell, avgv, cur, avgc, rem, full, temp, status, cycles, tte;
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bool ok = fg_reg(FG_REPSOC, &soc) && fg_reg(FG_VCELL, &vcell) && fg_reg(FG_CURRENT, &cur) &&
+	    fg_reg(FG_REPCAP, &rem) && fg_reg(FG_FULLCAPREP, &full) && fg_reg(FG_TEMP, &temp) &&
+	    fg_reg(FG_AVGVCELL, &avgv) && fg_reg(FG_AVGCURRENT, &avgc) && fg_reg(FG_STATUS, &status) &&
+	    fg_reg(FG_CYCLES, &cycles) && fg_reg(FG_TTE, &tte);
+	chg_poll();
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	fg.reads++;
+	fg.ok = ok;
+	if (!ok) {
+		fg.bad++;
+		fg.state = "ERR";
+		return -1;
+	}
+	fg.percent = ((unsigned)soc + 128u) >> 8;
+	if (fg.percent > 100) {
+		fg.percent = 100;
+	}
+	fg.mv = (unsigned)vcell * 5u / 64u;                     /* 78.125 uV */
+	fg.avg_mv = (unsigned)avgv * 5u / 64u;
+	fg.ma = (int)(int16_t)cur * 5 / 16;                     /* 312.5 uA */
+	fg.avg_ma = (int)(int16_t)avgc * 5 / 16;
+	fg.rem = rem;
+	fg.full = full;
+	fg.temp_dc = (int)(int16_t)temp * 10 / 256;
+	fg.status = status;
+	fg.cycles = cycles;
+	fg.tte = tte;
+	fg.state = "OK";
+	*percent = fg.percent;
+	*mv = fg.mv;
+	*ma = fg.ma;
+	*rem_mah = fg.rem;
+	*full_mah = fg.full;
+	return 0;
+}
+
+/* The gauge's last temperature in tenths of a degree, or NO_TEMP (-9990). For the thermal monitor. */
+int a04s_fg_temp_dc(void);
+int
+a04s_fg_temp_dc(void)
+{
+	if (!fg.ok || fg.temp_dc < -300 || fg.temp_dc > 900) {
+		return NO_TEMP;
+	}
+	return fg.temp_dc;
+}
+
+/*
+ * The charger writes (v44, v45), with a04schgsafe=1. Two registers, each with a fixed set of values:
+ *
+ *  - REG03, CHG_CONFIG (bit 4), so charging can be stopped while the battery is too hot or too cold
+ *    and started again afterwards. In the BQ25895 register map the SY6970 follows, the chip charges
+ *    only with CHG_CONFIG = 1 and its CE pin active, so clearing the bit alone stops charging, and
+ *    the CE pin (silergy,chg_en, a GPIO) is not touched. REG03 only ever gets S-Boot's own value
+ *    (the start-up dump) or that value with CHG_CONFIG cleared.
+ *  - REG04, ICHG (bits 6-0, 64 mA a step; bit 7 EN_PUMPX kept as S-Boot set it), v45, with
+ *    a04schgfast=1 and only on a wall adapter (VBUS_STAT = DCP, power good): Samsung's wired
+ *    charging current for the battery's temperature, from the device tree (cable-info
+ *    default_charging_current 2112 mA, battery,wire_warm_current 1280, wire_cool2_current 832,
+ *    wire_cool3_current 448). REG04 only ever gets S-Boot's own value or one of those four, so
+ *    never more than 2112 mA, Android's own value for a wall adapter. A PC port (SDP) keeps S-Boot's
+ *    value: 500 mA is the USB 2.0 limit, and Android uses it too.
+ *  - REG02, HVDCP_EN (bit 3), v48, with a04shvdcp=1 (and a04schgfast=1, a04safc=1): the charger's own
+ *    HVDCP handshake, which a Samsung brick needs before it listens for AFC (Samsung's driver starts
+ *    AFC only once the SY6970 reports VBUS_STAT HVDCP). With it the chip may also ask a QC brick for
+ *    a higher voltage, and HV_TYPE (bit 2) picks 9 V (0) or 12 V (1), so REG02 is written only if
+ *    S-Boot left HV_TYPE at 0 (and HVDCP_EN, CONV_START and FORCE_DPDM at 0), and only ever gets
+ *    S-Boot's own value or that value with HVDCP_EN set: 9 V at most, Android's own maximum.
+ *    CONV_START (bit 7) is read-only and reads 1 during a conversion in continuous mode, so REG02 is
+ *    compared without it (chg_mask()).
+ *    v49: FORCE_DPDM (bit 1) as well, as Samsung's driver does: once right after HVDCP_EN, so the
+ *    chip detects the brick again at once, and again (at most CHG_DPDM_RETRIES a plug-in) when it
+ *    reports an unknown adapter (VBUS_STAT 101). The value sent is S-Boot's with HVDCP_EN and
+ *    FORCE_DPDM, nothing else, and only while HVDCP is on. FORCE_DPDM clears itself when detection
+ *    is done, so it's left out of every comparison too (chg_mask()), and a detection sets IINLIM
+ *    itself, so IINLIM isn't compared around that one write. HV_TYPE stays 0 (9 V), unlike Samsung's 1.
+ * Nothing raises the input limit, the charge voltage or anything else, turns on OTG boost (REG03
+ * bit 5), or resets the watchdog (bit 6). Writes are refused, and stay off for the rest of the boot,
+ * if:
+ *  - S-Boot's REG03 had CHG_CONFIG clear, or OTG or WD_RST set;
+ *  - a value isn't one of the allowed ones (chg_value_allowed());
+ *  - the charger's watchdog is on (REG07 bits 5-4 not 0). A write puts the chip in host mode, and
+ *    an expiring watchdog would then reset every register to its defaults, 2048 mA among them;
+ *  - the register isn't REG03, REG04 or REG02;
+ *  - the register holds a value that isn't allowed just before the write (someone else changed it);
+ *  - after the write, it doesn't read back as written, or any of IINLIM, REG03, ICHG, IPRECHG/
+ *    ITERM, VREG, REG07 and REG02 other than it differ from their values read just before it.
+ * When writes go off with REG04 raised, or HVDCP on, one write each puts S-Boot's value back first.
+ *
+ * chg_send() is the only code that sends an I2C data byte. It is built only into a04s_chg_write03(),
+ * a04s_chg_write04() and a04s_chg_write02(), which each send one fixed register number, and only
+ * a04s_chg_checked() and chgw_refuse() (S-Boot's REG04 and REG02 back) call those. They stay
+ * separate functions (noinline), so tools/check_kernel_charger.py can check them in the built kernel.
+ */
+#define CHG_CFG_CHG             (1u << 4)       /* CHG_CONFIG */
+#define CHG_CFG_OTG             (1u << 5)       /* OTG_CONFIG */
+#define CHG_CFG_WDRST           (1u << 6)       /* WD_RST */
+#define CHG_TIMER_WD_MASK       (3u << 4)       /* REG07 WATCHDOG */
+#define CHG_ICHG_MASK           0x7fu
+#define CHG_ICHG_MAX_CODE       33u             /* 2112 mA */
+#define CHG_ICHG_STEPS          4u
+#define CHG_VBUS_DCP            3u
+#define CHG_STAT_PG             (1u << 2)
+#define CHG_REG_IPRE_ITERM      0x05u
+#define CHG_KEEP_N              7u
+#define CHG_ADC_HVDCP           (1u << 3)       /* REG02 HVDCP_EN */
+#define CHG_ADC_HVTYPE          (1u << 2)       /* REG02 HV_TYPE: 0 = 9 V, 1 = 12 V */
+#define CHG_ADC_CONV_START      (1u << 7)       /* REG02, read-only in continuous mode */
+#define CHG_ADC_FORCE_DPDM      (1u << 1)       /* REG02, clears itself */
+#define CHG_DPDM_RETRIES        3u              /* v49: reruns a plug-in for an unknown adapter */
+#define CHG_VBUS_UNKNOWN        5u              /* VBUS_STAT 101 */
+
+/* Samsung's wired steps in REG04 codes: 448, 832, 1280 and 2112 mA. */
+static const uint8_t ichg_steps[CHG_ICHG_STEPS] = { 7, 13, 20, 33 };
+static const uint8_t chg_keep[CHG_KEEP_N] = { CHG_REG_IINLIM, CHG_REG_CFG, CHG_REG_ICHG, CHG_REG_IPRE_ITERM,
+	                                      CHG_REG_VREG, CHG_REG_TIMER, CHG_REG_ADC };
+
+static struct {
+	const char *why;                        /* why writes went off, or "-" */
+	uint8_t now;                            /* REG03 as last read */
+	uint8_t ichg_code;                      /* REG04's ICHG as last written, 0 before the first */
+	uint8_t vbus;                           /* VBUS_STAT at the last sample */
+	uint8_t status, reg03, reg04, reg13;    /* REG0B, REG03, REG04, REG13 as read each sample (v46) */
+	uint8_t reg02;                          /* REG02 as read each sample (v48) */
+	unsigned writes, stops, resumes, failures, ichg_changes;
+	unsigned test_phase, test_at;
+	bool stopped, disabled;
+	bool hvdcp_on, hvdcp_tried;             /* v48: REG02 HVDCP_EN written, and tried this boot */
+	bool ov_latched;                        /* v48: stopped for over-voltage; cleared on unplug */
+	unsigned dpdm_sent, dpdm_retries;       /* v49: FORCE_DPDM writes this boot, and reruns this plug-in */
+} chgw = { .why = "-" };
+
+/* START, 0x6a + W, register reg, one data byte, STOP. Built only into the two writers below. */
+static inline __attribute__((always_inline)) bool
+chg_send(uint8_t reg, uint8_t value)
+{
+	struct i2c_bus *b = &buses[0];
+	if (b->why || (io_rd(b->va, IICSTAT) & STAT_START)) {
+		return false;
+	}
+	b->xfers++;
+	uint32_t con = CON_ACKEN | CON_TXDIV_512 | CON_SCALE_MAX | (b->irqen ? CON_IRQEN : 0);
+	io_wr(b->va, IICLC, LC_FILTER_ON);
+	io_wr(b->va, IICCON, con);
+	io_wr(b->va, IICSTAT, STAT_MASTER_TX | STAT_TXRXEN);
+	io_wr(b->va, IICDS, (uint32_t)CHG_ADDR << 1);
+	delay(1);
+	io_wr(b->va, IICSTAT, STAT_MASTER_TX | STAT_TXRXEN | STAT_START);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "W TIMEOUT ADDR", STAT_MASTER_TX, con);
+	}
+	uint32_t st = io_rd(b->va, IICSTAT);
+	if (st & STAT_ARBITR) {
+		return i2c_fail(b, "W ARBITRATION", STAT_MASTER_TX, con);
+	}
+	if (st & STAT_LASTBIT) {
+		return i2c_fail(b, "W NACK ADDR", STAT_MASTER_TX, con);
+	}
+	io_wr(b->va, IICDS, reg);
+	delay(1);
+	io_wr(b->va, IICCON, con);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "W TIMEOUT REG", STAT_MASTER_TX, con);
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_LASTBIT) {
+		return i2c_fail(b, "W NACK REG", STAT_MASTER_TX, con);
+	}
+	io_wr(b->va, IICDS, value);
+	delay(1);
+	io_wr(b->va, IICCON, con);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "W TIMEOUT DATA", STAT_MASTER_TX, con);
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_LASTBIT) {
+		return i2c_fail(b, "W NACK DATA", STAT_MASTER_TX, con);
+	}
+	i2c_stop(b, STAT_MASTER_TX, con);
+	return true;
+}
+
+/* REG03 (CHG_CONFIG). With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_write03(uint8_t value)
+{
+	return chg_send(CHG_REG_CFG, value);
+}
+
+/* REG04 (ICHG). With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_write04(uint8_t value)
+{
+	return chg_send(CHG_REG_ICHG, value);
+}
+
+/* REG02 (HVDCP_EN), v48. With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_write02(uint8_t value)
+{
+	return chg_send(CHG_REG_ADC, value);
+}
+
+/* The bits of reg that are compared: all but REG02's read-only CONV_START and self-clearing FORCE_DPDM. */
+static uint8_t
+chg_mask(uint8_t reg)
+{
+	return reg == CHG_REG_ADC ? (uint8_t)~(CHG_ADC_CONV_START | CHG_ADC_FORCE_DPDM) : (uint8_t)0xffu;
+}
+
+/* Whether reg may hold value: the only values these writes can ever send. */
+static bool
+chg_value_allowed(uint8_t reg, uint8_t value)
+{
+	if (reg == CHG_REG_CFG) {
+		uint8_t orig = chg.regs[CHG_REG_CFG];
+		return value == orig || value == (uint8_t)(orig & ~CHG_CFG_CHG);
+	}
+	if (reg == CHG_REG_ICHG) {
+		uint8_t orig = chg.regs[CHG_REG_ICHG];
+		unsigned code = value & CHG_ICHG_MASK;
+		if ((value & ~CHG_ICHG_MASK) != (orig & ~CHG_ICHG_MASK) || code > CHG_ICHG_MAX_CODE) {
+			return false;
+		}
+		if (code == (orig & CHG_ICHG_MASK)) {
+			return true;
+		}
+		for (unsigned i = 0; i < CHG_ICHG_STEPS; i++) {
+			if (code == ichg_steps[i]) {
+				return true;
+			}
+		}
+	}
+	if (reg == CHG_REG_ADC) {
+		uint8_t orig = chg.regs[CHG_REG_ADC];
+		if ((orig & (CHG_ADC_HVDCP | CHG_ADC_HVTYPE | CHG_ADC_CONV_START | CHG_ADC_FORCE_DPDM)) != 0) {
+			return false;
+		}
+		return value == orig || value == (uint8_t)(orig | CHG_ADC_HVDCP) ||
+		    value == (uint8_t)(orig | CHG_ADC_HVDCP | CHG_ADC_FORCE_DPDM);
+	}
+	return false;
+}
+
+static void __attribute__((noinline))
+chgw_refuse(const char *why)
+{
+	chgw.disabled = true;
+	chgw.why = why;
+	kprintf("A04S CHGSAFE WRITES OFF: %s\n", why);
+	uint8_t orig4 = chg.regs[CHG_REG_ICHG];
+	if (chgw.ichg_code != 0 && chgw.ichg_code != (orig4 & CHG_ICHG_MASK)) {
+		bool back = a04s_chg_write04(orig4);
+		kprintf("A04S CHGSAFE ICHG BACK TO S-BOOT'S %u MA: %s\n", (orig4 & CHG_ICHG_MASK) * 64u,
+		    back ? "SENT" : "NOT SENT");
+	}
+	uint8_t orig2 = chg.regs[CHG_REG_ADC];
+	if (chgw.hvdcp_on) {
+		bool back2 = a04s_chg_write02(orig2);
+		chgw.hvdcp_on = !back2;
+		kprintf("A04S CHGSAFE REG02 BACK TO S-BOOT'S %02x (HVDCP OFF): %s\n", orig2, back2 ? "SENT" : "NOT SENT");
+	}
+}
+
+/* One allowed value into REG03, REG04 or REG02, with every check above. With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_checked(uint8_t reg, uint8_t value)
+{
+	if (chgw.disabled || !chg.started) {
+		return false;
+	}
+	if (reg != CHG_REG_CFG && reg != CHG_REG_ICHG && reg != CHG_REG_ADC) {
+		chgw_refuse("REGISTER NOT ALLOWED");
+		return false;
+	}
+	uint8_t orig = chg.regs[CHG_REG_CFG];
+	if (!(orig & CHG_CFG_CHG) || (orig & (CHG_CFG_OTG | CHG_CFG_WDRST))) {
+		chgw_refuse("START VALUE");
+		return false;
+	}
+	if (!chg_value_allowed(reg, value)) {
+		chgw_refuse("VALUE NOT ALLOWED");
+		return false;
+	}
+	uint8_t timer = 0, now = 0;
+	uint8_t before[CHG_KEEP_N] = { 0 };
+	bool read = chg_reg(CHG_REG_TIMER, &timer) && chg_reg(reg, &now);
+	for (unsigned i = 0; read && i < CHG_KEEP_N; i++) {
+		read = chg_reg(chg_keep[i], &before[i]);
+	}
+	if (!read) {
+		chgw.failures++;                /* the bus: tried again on the next sample */
+		return false;
+	}
+	now = (uint8_t)(now & chg_mask(reg));
+	if (reg == CHG_REG_CFG) {
+		chgw.now = now;
+	}
+	if (timer & CHG_TIMER_WD_MASK) {
+		chgw_refuse("WATCHDOG ON");
+		return false;
+	}
+	if (!chg_value_allowed(reg, now)) {
+		chgw_refuse("REGISTER CHANGED");
+		return false;
+	}
+	if (now == value) {
+		return true;
+	}
+	bool sent = reg == CHG_REG_CFG ? a04s_chg_write03(value) : reg == CHG_REG_ICHG ? a04s_chg_write04(value) :
+	    a04s_chg_write02(value);
+	if (!sent) {
+		chgw.failures++;
+		return false;
+	}
+	chgw.writes++;
+	uint8_t back = 0;
+	bool dpdm = reg == CHG_REG_ADC && (value & CHG_ADC_FORCE_DPDM) != 0;
+	if (!chg_reg(reg, &back) || (back & chg_mask(reg)) != (value & chg_mask(reg))) {
+		if (reg == CHG_REG_CFG) {
+			chgw.now = back;
+		}
+		chgw_refuse("READBACK");
+		return false;
+	}
+	if (reg == CHG_REG_CFG) {
+		chgw.now = back;
+	}
+	for (unsigned i = 0; i < CHG_KEEP_N; i++) {
+		uint8_t after = 0;
+		uint8_t m = chg_mask(chg_keep[i]);
+		if (dpdm && chg_keep[i] == CHG_REG_IINLIM) {
+			continue;       /* v49: a detection sets IINLIM itself */
+		}
+		if (chg_keep[i] != reg && (!chg_reg(chg_keep[i], &after) || (after & m) != (before[i] & m))) {
+			chgw_refuse("OTHER REGISTER CHANGED");
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Charging on (S-Boot's own REG03) or off (that value without CHG_CONFIG). With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_set(bool enable)
+{
+	uint8_t orig = chg.regs[CHG_REG_CFG];
+	uint8_t value = enable ? orig : (uint8_t)(orig & ~CHG_CFG_CHG);
+	return a04s_chg_checked(CHG_REG_CFG, value);
+}
+
+/* REG04 with ICHG code, S-Boot's EN_PUMPX kept. With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_ichg(unsigned code)
+{
+	uint8_t value = (uint8_t)((chg.regs[CHG_REG_ICHG] & ~CHG_ICHG_MASK) | (code & CHG_ICHG_MASK));
+	if (!a04s_chg_checked(CHG_REG_ICHG, value)) {
+		return false;
+	}
+	chgw.ichg_code = (uint8_t)(code & CHG_ICHG_MASK);
+	return true;
+}
+
+/* REG02 with HVDCP_EN on (S-Boot's value with HVDCP_EN) or off (S-Boot's value), v48. With a04s_i2c_mtx
+ * held. */
+static bool __attribute__((noinline))
+a04s_chg_hvdcp(bool on)
+{
+	uint8_t value = on ? (uint8_t)(chg.regs[CHG_REG_ADC] | CHG_ADC_HVDCP) : chg.regs[CHG_REG_ADC];
+	if (on && !chg_value_allowed(CHG_REG_ADC, value)) {
+		return false;           /* S-Boot's REG02 isn't one HVDCP may be turned on from: left alone */
+	}
+	if (!a04s_chg_checked(CHG_REG_ADC, value)) {
+		return false;
+	}
+	chgw.hvdcp_on = on;
+	return true;
+}
+
+/* REG02 with HVDCP_EN and FORCE_DPDM (S-Boot's value with both), v49: the chip detects the brick again.
+ * Only while HVDCP is on. With a04s_i2c_mtx held. */
+static bool __attribute__((noinline))
+a04s_chg_dpdm(void)
+{
+	if (!chgw.hvdcp_on) {
+		return false;
+	}
+	uint8_t value = (uint8_t)(chg.regs[CHG_REG_ADC] | CHG_ADC_HVDCP | CHG_ADC_FORCE_DPDM);
+	if (!a04s_chg_checked(CHG_REG_ADC, value)) {
+		return false;
+	}
+	chgw.dpdm_sent++;
+	return true;
+}
+
+/* Samsung's wired step for a battery temperature (tenths of a degree), as an ICHG code. */
+static unsigned
+ichg_band(int dc)
+{
+	if (dc >= 420) {
+		return 20;              /* 1280 mA from 42.0 C (wire_normal_warm_thresh) to the 50.0 C stop */
+	}
+	if (dc >= 150) {
+		return 33;              /* 2112 mA from 15.0 C (wire_cool1_normal_thresh) */
+	}
+	if (dc >= 50) {
+		return 13;              /* 832 mA from 5.0 C (wire_cool3_cool2_thresh) */
+	}
+	return 7;                       /* 448 mA from 0 C (wire_cold_cool3_thresh) */
+}
+
+/*
+ * v43, the battery thermistor through the SoC's ADC (adc@11C40000, samsung,exynos-adc-v3), with the
+ * boot-arg a04sadc=1. The device tree's battery node reads channel 1 (adc-temp) and channel 3
+ * (adc-in-bat), and its battery,temp_table_adc / temp_table_data turn channel 1's 12-bit value into
+ * tenths of a degree: 90.0 C at 284 down to -20.0 C at 3681, every 5 C. Samsung's limits for a wired
+ * charger (same node): charging stops above 50.0 C (wire_warm_overheat_thresh) and below 0 C
+ * (wire_cold_cool3_thresh), and is cut to 1280 mA above 42.0 C (wire_normal_warm_thresh).
+ *
+ * One conversion is Linux exynos_adc.c's v3 path, polled instead of taking the interrupt: CON1 soft
+ * reset then non-reset, CON2 = C_TIME(6), INT_EN = 1, the channel into CON2, START; wait for INT_ST
+ * bit 0 (at most 1 ms); the value from DAT (0x08, low 12 bits); INT_ST cleared, C_TIME and INT_EN
+ * back to 0. These are the only writes, all to the ADC's own registers. It runs only if:
+ *  - GIC SPI 0 (the ADC's line, interrupts = <0 0 4>) is disabled, so INT_EN can't reach XNU with
+ *    no handler, and
+ *  - the ADC's PCLK gate in CMU_CMGP (0x200c) isn't manually stopped. The clock unit is only read.
+ * No CHUB semaphore: the node has no samsung,cmgp-sysreg, and nothing else here uses the ADC (on
+ * Android, the audio codec's jack detection reads channels 6 and 7).
+ *
+ * The thermal thread samples it every 2 s: five conversions of channel 1, the highest and lowest
+ * dropped (battery,adc_check_count = 5), the middle three averaged; channels 0, 2 and 3 once each,
+ * for the report. A reading counts once three samples in a row are inside the table and within
+ * 3.0 C of each other, and stops counting on any sample outside it. Until then
+ * a04s_batt_temp_dc() gives the gauge's temperature instead. Charger safety is a dry run in v43:
+ * the decision is logged and reported, and the charger is not written. v44 acts on it (chg_safety()).
+ */
+#define CMU_CMGP_PA             0x11c00000u
+#define CMGP_ADC_MUX            0x1000u
+#define CMGP_ADC_DIV            0x1800u
+#define CMGP_ADC_GATE_S0        0x200cu
+#define CMGP_ADC_GATE_S1        0x2010u
+#define CMGP_ADC_DMYQCH         0x3000u
+#define CMGP_ADC_QCH_S0         0x3004u
+#define ADC_PA                  0x11c40000u
+#define ADC_CON1                0x00u
+#define ADC_CON2                0x04u
+#define ADC_DAT                 0x08u
+#define ADC_INT_EN              0x10u
+#define ADC_INT_ST              0x14u
+#define ADC_VER                 0x20u
+#define ADC_CON1_START          (1u << 0)
+#define ADC_CON1_NON_RESET      (1u << 1)
+#define ADC_CON1_SOFT_RESET     (1u << 2)
+#define ADC_CON2_C_TIME_6       (6u << 4)
+#define ADC_CON2_C_TIME_MASK    (7u << 4)
+#define ADC_CON2_ACH_MASK       0xfu
+#define ADC_VALUE_MASK          0xfffu
+#define ADC_GIC_ID              32u             /* SPI 0 */
+#define ADC_WAIT_US             1000u
+#define ADC_CH_BATT             1u
+#define ADC_SAMPLES             5u
+#define ADC_TRUST               3u
+#define ADC_STEADY_DC           30
+#define ADC_TABLE_N             23u
+#define SAFE_HOT_DC             500
+#define SAFE_WARM_DC            420
+#define SAFE_COLD_DC            0
+#define SAFE_HYST_DC            20
+
+static const uint16_t batt_table_adc[ADC_TABLE_N] = {
+	284, 340, 397, 501, 583, 678, 794, 919, 1070, 1223, 1400, 1593, 1810, 2038, 2272, 2503, 2733, 2940,
+	3134, 3310, 3458, 3582, 3681,
+};
+static const int16_t batt_table_dc[ADC_TABLE_N] = {
+	900, 850, 800, 750, 700, 650, 600, 550, 500, 450, 400, 350, 300, 250, 200, 150, 100, 50, 0, -50,
+	-100, -150, -200,
+};
+
+enum { SAFE_UNKNOWN, SAFE_OK, SAFE_WARM, SAFE_HOT, SAFE_COLD };
+static const char *const safe_names[] = { "UNKNOWN", "OK", "WARM (LIMIT 1280 MA)", "HOT", "COLD" };
+
+static vm_offset_t cmgp_va, adc_va;
+static struct {
+	const char *state;                      /* OFF, NO MAPPING, GATE, GIC, TIMEOUT, OUT OF TABLE, SETTLING, OK */
+	uint32_t mux, div, gate0, gate1, dmyqch, qch0, ver, dat;
+	unsigned raw, raw_min, raw_max, ch[4];
+	int temp_dc, last_dc;
+	unsigned steady, samples, timeouts, untrusted;
+	int safe;
+	bool trusted, checked, usable;
+	bool lost;                              /* a trusted reading went bad: charging stops */
+} adc = { .state = "OFF", .temp_dc = NO_TEMP, .last_dc = NO_TEMP, .safe = SAFE_UNKNOWN };
+
+/* Whether the ADC may be used: decided once, with reads only. */
+static bool
+adc_check(void)
+{
+	if (adc.checked) {
+		return adc.usable;
+	}
+	adc.checked = true;
+	if (!gicd_va) {
+		gicd_va = ml_io_map(GICD_PA, 0x1000);
+	}
+	cmgp_va = ml_io_map(CMU_CMGP_PA, 0x4000);
+	adc_va = ml_io_map(ADC_PA, 0x1000);
+	if (!gicd_va || !cmgp_va || !adc_va) {
+		adc.state = "NO MAPPING";
+		return false;
+	}
+	adc.mux = io_rd(cmgp_va, CMGP_ADC_MUX);
+	adc.div = io_rd(cmgp_va, CMGP_ADC_DIV);
+	adc.gate0 = io_rd(cmgp_va, CMGP_ADC_GATE_S0);
+	adc.gate1 = io_rd(cmgp_va, CMGP_ADC_GATE_S1);
+	adc.dmyqch = io_rd(cmgp_va, CMGP_ADC_DMYQCH);
+	adc.qch0 = io_rd(cmgp_va, CMGP_ADC_QCH_S0);
+	if (!gate_running(adc.gate0)) {
+		adc.state = "GATE";
+		return false;
+	}
+	uint32_t en = io_rd(gicd_va, GICD_ISENABLER + 4u * (ADC_GIC_ID / 32u));
+	if (en & (1u << (ADC_GIC_ID % 32u))) {
+		adc.state = "GIC";
+		return false;
+	}
+	adc.ver = io_rd(adc_va, ADC_VER);
+	adc.state = "SETTLING";
+	adc.usable = true;
+	return true;
+}
+
+/* One conversion of channel ch; false if it didn't finish within ADC_WAIT_US. */
+static bool
+adc_convert(unsigned ch, unsigned *value)
+{
+	io_wr(adc_va, ADC_CON1, ADC_CON1_SOFT_RESET);
+	io_wr(adc_va, ADC_CON1, ADC_CON1_NON_RESET);
+	io_wr(adc_va, ADC_CON2, ADC_CON2_C_TIME_6);
+	io_wr(adc_va, ADC_INT_EN, 1u);
+	io_wr(adc_va, ADC_CON2, (io_rd(adc_va, ADC_CON2) & ~ADC_CON2_ACH_MASK) | (ch & ADC_CON2_ACH_MASK));
+	io_wr(adc_va, ADC_CON1, io_rd(adc_va, ADC_CON1) | ADC_CON1_START);
+	bool done = false;
+	for (unsigned us = 0; us <= ADC_WAIT_US; us += 5) {
+		if (io_rd(adc_va, ADC_INT_ST) & 1u) {
+			done = true;
+			break;
+		}
+		delay(5);
+	}
+	adc.dat = io_rd(adc_va, ADC_DAT);
+	*value = adc.dat & ADC_VALUE_MASK;
+	io_wr(adc_va, ADC_INT_ST, 1u);
+	io_wr(adc_va, ADC_CON2, io_rd(adc_va, ADC_CON2) & ~ADC_CON2_C_TIME_MASK);
+	io_wr(adc_va, ADC_INT_EN, 0);
+	return done;
+}
+
+/* Channel 1's value to tenths of a degree by the device tree's table; NO_TEMP outside it. */
+static int
+adc_to_dc(unsigned raw)
+{
+	if (raw < batt_table_adc[0] || raw > batt_table_adc[ADC_TABLE_N - 1u]) {
+		return NO_TEMP;
+	}
+	for (unsigned i = 1; i < ADC_TABLE_N; i++) {
+		if (raw <= batt_table_adc[i]) {
+			int a0 = batt_table_adc[i - 1u], a1 = batt_table_adc[i];
+			int t0 = batt_table_dc[i - 1u], t1 = batt_table_dc[i];
+			return t0 + (t1 - t0) * ((int)raw - a0) / (a1 - a0);
+		}
+	}
+	return NO_TEMP;
+}
+
+static int
+safe_decide(int dc, int was)
+{
+	if (dc == NO_TEMP) {
+		return SAFE_UNKNOWN;
+	}
+	/* Leaving a state takes SAFE_HYST_DC (2.0 C) past its threshold. */
+	int hot = was == SAFE_HOT ? SAFE_HOT_DC - SAFE_HYST_DC : SAFE_HOT_DC;
+	int warm = was == SAFE_WARM || was == SAFE_HOT ? SAFE_WARM_DC - SAFE_HYST_DC : SAFE_WARM_DC;
+	int cold = was == SAFE_COLD ? SAFE_COLD_DC + SAFE_HYST_DC : SAFE_COLD_DC;
+	if (dc > hot) {
+		return SAFE_HOT;
+	}
+	if (dc < cold) {
+		return SAFE_COLD;
+	}
+	if (dc > warm) {
+		return SAFE_WARM;
+	}
+	return SAFE_OK;
+}
+
+/*
+ * v46, 15 W charging by Samsung AFC, with a04safc=1 (and a04schgsafe=1, a04schgfast=1). Written from
+ * the protocol as Samsung's A04s driver does it (drivers/muic/afc_gpio/afc_charger.c, GPL, not
+ * copied): the phone bit-bangs Samsung's AFC on the USB D- line through three GPIOs from the
+ * device tree's gpio_afc node:
+ *   - data,   GPA1-1 (pinctrl@11850000, ALIVE): driven for the phone's pulses, read for the brick's;
+ *   - switch, GPG0-0 (pinctrl@139b0000, PERI): 1 routes D- from the USB PHY to the data pin;
+ *   - hvdcp,  GPA2-2 (ALIVE): Samsung's afc_dpdm_ctrl, 1 while an AFC-capable brick is attached.
+ * These are the only GPIO writes here, and only through afc_pin(): output 0, output 1 or input, on
+ * those three pins, each pin's own CON and DAT bits only (GPA1-0, the volume-down key, shares the
+ * bank and is never touched). A pin is used only if S-Boot left it as a GPIO input or output.
+ * The switch is always put back to 0 (D- to USB) after an exchange.
+ *
+ * v46 got no answer from a Samsung brick: the brick listens for AFC only after the charger's own
+ * HVDCP handshake, which S-Boot leaves off (REG02 HVDCP_EN 0). v48 turns it on with a04shvdcp=1
+ * (a04s_chg_hvdcp(), only with S-Boot's HV_TYPE 0 = 9 V). The chip may then ask a QC brick for 9 V
+ * itself, without AFC. Every voltage asked for is 9 V at most, Android's own maximum
+ * (battery,max_input_voltage 9000 mV). Over-voltage is checked before the pins, every sample, and
+ * also turns HVDCP off.
+ *
+ * One exchange (UI 160 us, MPING 16 UI, DATA_DELAY 8 UI, SYNC UI/4), with interrupts off for each
+ * phase (at most about 7 ms): MPING; the brick's SPING (the line high again within MPING); the
+ * request byte (a sync pulse, MSB first one UI a bit, odd parity, a sync pulse, MPING), 0x46 for 9 V
+ * or 0x08 for 5 V; SPING; the brick's data; a closing MPING and SPING. Up to 3 exchanges in each of
+ * 3 rounds, VBUS read from the charger's ADC after each (REG11: 3.8-7.5 V is 5 V, 7.5-10.5 V is 9 V).
+ *
+ * When: on a wall adapter (VBUS_STAT DCP, power good) with VBUS at 5 V, a trusted battery reading
+ * and SAFE OK (under 42.0 C), at least 1.2 s after it was first seen, and once a plug-in. At 9 V,
+ * VBUS is checked every sample: above 10.5 V charging stops at once (REG03) and the brick is asked
+ * back to 5 V; below 7.5 V the brick has dropped to 5 V. Leaving SAFE OK, losing the reading,
+ * charging stopped, or writes off: the brick is asked back to 5 V (a 16 ms reset pulse, 200 ms,
+ * then 0x08). The cable gone: hvdcp and switch to 0. The ICHG steps stay as in v45 (2112 mA at
+ * most); at 9 V they need about half the input current.
+ */
+#define ALIVE_PINS_PA           0x11850000u
+#define AFC_UI_US               160u
+#define AFC_MPING_US            (AFC_UI_US * 16u)
+#define AFC_DATA_DELAY_US       (AFC_UI_US * 8u)
+#define AFC_SYNC_US             (AFC_UI_US / 4u)
+#define AFC_RESET_US            (AFC_UI_US * 100u)
+#define AFC_REQ_9V              0x46u
+#define AFC_REQ_5V              0x08u
+#define AFC_OPS                 3u
+#define AFC_ROUNDS              3u
+#define AFC_SETTLE_SAMPLES      1u              /* one 2 s sample after the plug-in: Samsung waits 1.2 s */
+#define VBUS_5V_MIN_MV          3800u
+#define VBUS_9V_MIN_MV          7500u
+#define VBUS_MAX_MV             10500u
+#define PIN_FUNC_IN             0x0u
+#define PIN_FUNC_OUT            0x1u
+
+#define AFC_PIN_DATA            0u
+#define AFC_PIN_SWITCH          1u
+#define AFC_PIN_HVDCP           2u
+#define AFC_PINS                3u
+#define PIN_LOW                 0u
+#define PIN_HIGH                1u
+#define PIN_INPUT               2u
+static const struct {
+	uint32_t pa;
+	uint32_t bank;
+	unsigned pin;
+} afc_pins[AFC_PINS] = {
+	{ ALIVE_PINS_PA, 0x020u, 1 },   /* gpa1-1, gpio_afc_data */
+	{ PERI_PINS_PA, 0x000u, 0 },    /* gpg0-0, gpio_afc_switch */
+	{ ALIVE_PINS_PA, 0x040u, 2 },   /* gpa2-2, gpio_afc_hvdcp */
+};
+
+enum { AFC_IDLE, AFC_WAIT, AFC_AT_9V, AFC_AT_5V, AFC_NO_ANSWER, AFC_OFF };
+static const char *const afc_names[] = { "IDLE", "WAITING", "9V", "5V", "NO ANSWER", "OFF" };
+static vm_offset_t afc_alive_va;
+static struct {
+	int state;
+	const char *why;
+	uint32_t con_was[AFC_PINS], dat_was[AFC_PINS];
+	unsigned seen, tries, nacks, answers, ok9, back5, over, mv, max_mv;
+	bool checked, usable;
+	bool hv_try;                            /* v49: a try made with VBUS_STAT HVDCP this plug-in */
+} afc = { .state = AFC_IDLE, .why = "-" };
+
+/* XNU's delay() takes an int; the AFC times are unsigned. */
+static inline void
+afc_us(unsigned us)
+{
+	delay((int)us);
+}
+
+static vm_offset_t
+afc_bank_va(unsigned p)
+{
+	return afc_pins[p].pa == ALIVE_PINS_PA ? afc_alive_va : pins_va;
+}
+
+/* The only GPIO writes in this file: pin p (one of the three) to output low, output high or input. */
+static void __attribute__((noinline))
+afc_pin(unsigned p, unsigned mode)
+{
+	if (p >= AFC_PINS || mode > PIN_INPUT || !afc.usable) {
+		return;
+	}
+	vm_offset_t va = afc_bank_va(p);
+	uint32_t bank = afc_pins[p].bank, shift = afc_pins[p].pin * 4u, bit = 1u << afc_pins[p].pin;
+	if (mode != PIN_INPUT) {
+		uint32_t dat = io_rd(va, bank + PIN_DAT);
+		io_wr(va, bank + PIN_DAT, mode == PIN_HIGH ? (dat | bit) : (dat & ~bit));
+	}
+	uint32_t con = io_rd(va, bank + PIN_CON);
+	uint32_t want = (con & ~(0xfu << shift)) | ((mode == PIN_INPUT ? PIN_FUNC_IN : PIN_FUNC_OUT) << shift);
+	if (want != con) {
+		io_wr(va, bank + PIN_CON, want);
+	}
+}
+
+static bool
+afc_pin_high(unsigned p)
+{
+	return (io_rd(afc_bank_va(p), afc_pins[p].bank + PIN_DAT) >> afc_pins[p].pin) & 1u;
+}
+
+/* Whether the three pins may be used: read only, once. */
+static bool
+afc_check(void)
+{
+	if (afc.checked) {
+		return afc.usable;
+	}
+	afc.checked = true;
+	if (!afc_alive_va) {
+		afc_alive_va = ml_io_map(ALIVE_PINS_PA, 0x1000);
+	}
+	if (!pins_va) {
+		pins_va = ml_io_map(PERI_PINS_PA, 0x1000);
+	}
+	if (!afc_alive_va || !pins_va) {
+		afc.why = "NO MAPPING";
+		return false;
+	}
+	for (unsigned p = 0; p < AFC_PINS; p++) {
+		vm_offset_t va = afc_bank_va(p);
+		afc.con_was[p] = (io_rd(va, afc_pins[p].bank + PIN_CON) >> (afc_pins[p].pin * 4u)) & 0xfu;
+		afc.dat_was[p] = (io_rd(va, afc_pins[p].bank + PIN_DAT) >> afc_pins[p].pin) & 1u;
+		if (afc.con_was[p] != PIN_FUNC_IN && afc.con_was[p] != PIN_FUNC_OUT) {
+			afc.why = "PIN FUNCTION";
+			return false;
+		}
+	}
+	afc.usable = true;
+	afc_pin(AFC_PIN_SWITCH, PIN_LOW);       /* D- to USB, as Samsung's probe leaves it */
+	afc_pin(AFC_PIN_DATA, PIN_LOW);
+	afc_pin(AFC_PIN_HVDCP, PIN_LOW);        /* v49: driven low too, as Samsung's probe does (afc_dpdm_ctrl(0)) */
+	return true;
+}
+
+/* VBUS in mV from the charger's ADC (REG11), or 0 without power good or an answer. Takes the I2C lock. */
+static unsigned
+afc_vbus_mv(void)
+{
+	uint8_t v = 0;
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bool ok = chg.started && chg_reg(CHG_REG_VBUSV, &v);
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	if (!ok || !(v & 0x80u)) {
+		return 0;
+	}
+	unsigned mv = 2600u + (v & 0x7fu) * 100u;
+	afc.mv = mv;
+	afc.max_mv = mv > afc.max_mv ? mv : afc.max_mv;
+	return mv;
+}
+
+static unsigned
+afc_level(unsigned mv)
+{
+	return mv > VBUS_5V_MIN_MV && mv <= VBUS_9V_MIN_MV ? 5u : mv > VBUS_9V_MIN_MV && mv < VBUS_MAX_MV ? 9u : 0u;
+}
+
+static void
+afc_mping(void)
+{
+	afc_pin(AFC_PIN_DATA, PIN_HIGH);
+	afc_us(AFC_MPING_US);
+	afc_pin(AFC_PIN_DATA, PIN_LOW);
+}
+
+/* The brick's SPING: the line high again within the MPING window, then low within DATA_DELAY. */
+static bool
+afc_sping(void)
+{
+	afc_pin(AFC_PIN_DATA, PIN_INPUT);
+	afc_us(AFC_MPING_US - 3u * AFC_UI_US);
+	if (!afc_pin_high(AFC_PIN_DATA)) {
+		return false;
+	}
+	for (unsigned t = 0; t < AFC_DATA_DELAY_US && afc_pin_high(AFC_PIN_DATA); t += AFC_UI_US) {
+		afc_us(AFC_UI_US);
+	}
+	return true;
+}
+
+static void
+afc_sync(void)
+{
+	afc_pin(AFC_PIN_DATA, PIN_HIGH);
+	afc_us(AFC_SYNC_US);
+	afc_pin(AFC_PIN_DATA, PIN_LOW);
+	afc_us(AFC_SYNC_US);
+}
+
+static void
+afc_send(uint8_t byte)
+{
+	afc_pin(AFC_PIN_DATA, PIN_LOW);
+	afc_us(AFC_UI_US);
+	afc_sync();
+	if (!(byte & 0x80u)) {
+		afc_pin(AFC_PIN_DATA, PIN_HIGH);
+		afc_us(AFC_SYNC_US);
+	}
+	unsigned ones = 0;
+	for (unsigned m = 0x80u; m != 0; m >>= 1) {
+		afc_pin(AFC_PIN_DATA, (byte & m) ? PIN_HIGH : PIN_LOW);
+		ones += (byte & m) ? 1u : 0u;
+		afc_us(AFC_UI_US);
+	}
+	afc_pin(AFC_PIN_DATA, (ones % 2u) ? PIN_LOW : PIN_HIGH);    /* odd parity */
+	afc_us(AFC_UI_US);
+	if (!(ones % 2u)) {
+		afc_pin(AFC_PIN_DATA, PIN_LOW);
+		afc_us(AFC_SYNC_US);
+	}
+	afc_sync();
+	afc_mping();
+}
+
+/* The brick's data after DATA_DELAY: read for at most MPING + 2 DATA_DELAY; true if it pulsed. */
+static bool
+afc_receive(void)
+{
+	afc_pin(AFC_PIN_DATA, PIN_INPUT);
+	afc_us(AFC_DATA_DELAY_US);
+	bool seen = false;
+	for (unsigned t = 0; t < AFC_MPING_US + 2u * AFC_DATA_DELAY_US; t += AFC_UI_US) {
+		seen = seen || afc_pin_high(AFC_PIN_DATA);
+		afc_us(AFC_UI_US);
+	}
+	return seen;
+}
+
+/* One exchange asking for request; true if the brick answered every step. Interrupts off per phase. */
+static bool __attribute__((noinline))
+afc_exchange(uint8_t request)
+{
+	boolean_t was = ml_set_interrupts_enabled(FALSE);
+	afc_mping();
+	bool ok = afc_sping();
+	(void)ml_set_interrupts_enabled(was);
+	if (!ok) {
+		afc.nacks++;
+		return false;
+	}
+	was = ml_set_interrupts_enabled(FALSE);
+	afc_send(request);
+	ok = afc_sping();
+	(void)ml_set_interrupts_enabled(was);
+	if (!ok) {
+		afc.nacks++;
+		return false;
+	}
+	was = ml_set_interrupts_enabled(FALSE);
+	bool data = afc_receive();
+	afc_mping();
+	ok = afc_sping();
+	(void)ml_set_interrupts_enabled(was);
+	afc_pin(AFC_PIN_DATA, PIN_LOW);
+	if (data) {
+		afc.answers++;
+	}
+	return ok;
+}
+
+/* Ask for 9 or 5 V and check VBUS; returns the level reached (0 unknown). The switch ends at 0. */
+static unsigned
+afc_request(unsigned volts)
+{
+	afc.tries++;
+	if (volts == 5u) {
+		afc_pin(AFC_PIN_DATA, PIN_HIGH);        /* reset */
+		afc_us(AFC_RESET_US);
+		afc_pin(AFC_PIN_DATA, PIN_LOW);
+		IOSleep(200);
+	}
+	unsigned level = afc_level(afc_vbus_mv());
+	afc_pin(AFC_PIN_SWITCH, PIN_HIGH);
+	for (unsigned round = 0; round < AFC_ROUNDS && level != volts; round++) {
+		for (unsigned op = 0; op < AFC_OPS && level != volts; op++) {
+			(void)afc_exchange((uint8_t)(volts == 9u ? AFC_REQ_9V : AFC_REQ_5V));
+			IOSleep(20);
+			level = afc_level(afc_vbus_mv());
+		}
+		IOSleep(50);
+		level = afc_level(afc_vbus_mv());
+	}
+	afc_pin(AFC_PIN_SWITCH, PIN_LOW);
+	afc_pin(AFC_PIN_DATA, PIN_LOW);
+	return level;
+}
+
+/* Every sample, from chg_safety() after the ICHG step, without the I2C lock. pg: the charger's power
+ * good. wall: power good on a wall adapter (VBUS_STAT DCP, or HVDCP should the chip report it).
+ * hv (v49): power good with VBUS_STAT HVDCP. Samsung starts AFC only then, so once the chip reports
+ * HVDCP, a try that already failed on a plain DCP this plug-in is made once more, in Samsung's order
+ * (hvdcp pin high, 1.2 s, then the 9 V request). */
+static void
+afc_sample(int safe, bool lost, bool pg, bool wall, bool hv)
+{
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04safc", &want, sizeof(want));
+	if (want != 1) {
+		afc.state = AFC_OFF;
+		afc.why = "a04safc=0";
+		return;
+	}
+	if (pg && afc_vbus_mv() >= VBUS_MAX_MV && afc.state != AFC_AT_9V) {
+		afc.over++;
+		lck_mtx_lock(&a04s_i2c_mtx);
+		bool stopped = a04s_chg_set(false);
+		bool hv_off = !chgw.hvdcp_on || a04s_chg_hvdcp(false);
+		chgw.ov_latched = true;
+		lck_mtx_unlock(&a04s_i2c_mtx);
+		if (stopped) {
+			chgw.stopped = true;
+			chgw.stops++;
+		}
+		kprintf("A04S AFC VBUS %u MV OVER %u WITHOUT A REQUEST: CHARGING %s, HVDCP %s\n", afc.mv, VBUS_MAX_MV,
+		    stopped ? "STOPPED" : "NOT STOPPED", hv_off ? "OFF" : "STILL ON");
+		afc.state = AFC_NO_ANSWER;
+		afc.why = "OVER VOLTAGE";
+		return;
+	}
+	if (!pg) {
+		chgw.ov_latched = false;
+	}
+	if (!afc_check()) {
+		afc.state = AFC_OFF;
+		return;
+	}
+	if (!pg) {
+		if (afc.state != AFC_IDLE) {
+			afc_pin(AFC_PIN_HVDCP, PIN_LOW);
+			afc_pin(AFC_PIN_SWITCH, PIN_LOW);
+			afc.state = AFC_IDLE;
+			afc.why = "UNPLUGGED";
+		}
+		afc.seen = 0;
+		afc.hv_try = false;
+		return;
+	}
+	if (hv && !afc.hv_try && afc.state == AFC_NO_ANSWER && !chgw.ov_latched) {
+		afc.state = AFC_WAIT;   /* v49: HVDCP reported after a DCP try: once more, Samsung's way */
+		afc.why = "HVDCP";
+		afc.seen = 0;
+	}
+	bool may = wall && safe == SAFE_OK && !lost && adc.trusted && !chgw.stopped && !chgw.disabled;
+	if (afc.state == AFC_AT_9V) {
+		unsigned mv = afc_vbus_mv();
+		if (mv >= VBUS_MAX_MV) {
+			afc.over++;
+			lck_mtx_lock(&a04s_i2c_mtx);
+			bool stopped = a04s_chg_set(false);
+			bool hv_off = !chgw.hvdcp_on || a04s_chg_hvdcp(false);
+			chgw.ov_latched = true;
+			lck_mtx_unlock(&a04s_i2c_mtx);
+			if (stopped) {
+				chgw.stopped = true;
+				chgw.stops++;
+			}
+			kprintf("A04S AFC VBUS %u MV OVER %u: CHARGING %s, HVDCP %s, BACK TO 5 V\n", mv, VBUS_MAX_MV,
+			    stopped ? "STOPPED" : "NOT STOPPED", hv_off ? "OFF" : "STILL ON");
+			(void)afc_request(5u);
+			afc.state = AFC_AT_5V;
+			afc.why = "OVER VOLTAGE";
+		} else if (afc_level(mv) != 9u) {
+			afc.state = AFC_AT_5V;
+			afc.why = "BRICK DROPPED 9 V";
+		} else if (!may) {
+			unsigned level = afc_request(5u);
+			afc.back5++;
+			afc.state = AFC_AT_5V;
+			afc.why = level == 5u ? "BACK TO 5 V (TEMPERATURE OR STOP)" : "5 V NOT CONFIRMED";
+			kprintf("A04S AFC BACK TO 5 V: %s, VBUS %u MV\n", afc.why, afc.mv);
+		}
+		return;
+	}
+	if (afc.state != AFC_IDLE && afc.state != AFC_WAIT) {
+		return;                 /* once a plug-in: 5 V, no answer, or off until unplugged */
+	}
+	if (!may || afc_level(afc_vbus_mv()) != 5u) {
+		afc.state = AFC_WAIT;
+		afc.why = "CONDITIONS";
+		return;
+	}
+	if (afc.seen++ < AFC_SETTLE_SAMPLES) {
+		afc.state = AFC_WAIT;
+		afc.why = "SETTLING";
+		return;
+	}
+	afc.hv_try = afc.hv_try || hv;
+	afc_pin(AFC_PIN_HVDCP, PIN_HIGH);
+	IOSleep(1200);
+	unsigned level = afc_request(9u);
+	if (level == 9u) {
+		afc.ok9++;
+		afc.state = AFC_AT_9V;
+		afc.why = "9 V";
+	} else {
+		afc_pin(AFC_PIN_HVDCP, PIN_LOW);
+		afc.state = AFC_NO_ANSWER;
+		afc.why = afc.answers ? "ANSWERED, VBUS NOT 9 V" : "NO AFC BRICK";
+	}
+	kprintf("A04S AFC %s: VBUS %u MV (MAX %u), %u NACKS, %u ANSWERS\n", afc_names[afc.state], afc.mv, afc.max_mv,
+	    afc.nacks, afc.answers);
+}
+
+/*
+ * v44: the decision acted on, with a04schgsafe=1 (without it, a dry run as in v43). Charging stops
+ * when the battery is HOT (above 50.0 C) or COLD (below 0 C), or when a trusted thermistor reading is
+ * lost (outside the table, which is above 90 C or below -20 C, an open or shorted thermistor, or the
+ * ADC timing out). It starts again only at OK or WARM with a trusted reading.
+ * a04schgtest=1 tests both writes at room temperature: once the reading is trusted, charging stops
+ * for 60 s, then starts again; a real HOT or COLD still wins.
+ *
+ * v45, with a04schgfast=1 as well: while charging and on a wall adapter (power good, VBUS_STAT DCP,
+ * or HVDCP should the chip report it at 9 V) with a trusted reading, ICHG follows Samsung's wired
+ * steps for the temperature (ichg_band()). A step down is taken at once, a step up only 2.0 C inside
+ * the new band. Anything else (a PC port, no cable, the reading not trusted or lost, charging
+ * stopped) puts S-Boot's ICHG back.
+ *
+ * v46: REG03, REG04, the status (REG0B) and the input limit status (REG13) are read every sample for
+ * the report, and AFC (afc_sample()) runs after, without the I2C lock.
+ *
+ * v48: REG02 is read too, and with a04shvdcp=1 HVDCP_EN is set once (a04s_chg_hvdcp()). Charging
+ * stopped for over-voltage doesn't start again until the cable is unplugged (ov_latched).
+ *
+ * v49: HVDCP goes on only once the AFC pins are driven low, and is followed at once by one
+ * FORCE_DPDM (a04s_chg_dpdm()). An unknown adapter (VBUS_STAT 101) gets up to CHG_DPDM_RETRIES more a
+ * plug-in, as in Samsung's driver.
+ */
+#define CHGTEST_SAMPLES         30u             /* 60 s at one sample every 2 s */
+#define ICHG_HYST_DC            20
+#define CHG_VBUS_HVDCP          4u
+
+static void
+chg_safety(int safe, bool lost)
+{
+	unsigned arm = 0, test = 0, fast = 0, hv = 0, afc_on = 0;
+	(void)PE_parse_boot_argn("a04shvdcp", &hv, sizeof(hv));
+	(void)PE_parse_boot_argn("a04safc", &afc_on, sizeof(afc_on));
+	(void)PE_parse_boot_argn("a04schgsafe", &arm, sizeof(arm));
+	(void)PE_parse_boot_argn("a04schgtest", &test, sizeof(test));
+	(void)PE_parse_boot_argn("a04schgfast", &fast, sizeof(fast));
+	if (arm != 1) {
+		return;
+	}
+	bool stop = lost || safe == SAFE_HOT || safe == SAFE_COLD;
+	bool resume = !lost && (safe == SAFE_OK || safe == SAFE_WARM);
+	const char *reason = lost ? "THERMISTOR LOST" : safe_names[safe];
+	if (test == 1 && resume) {
+		if (chgw.test_phase == 0) {
+			chgw.test_phase = 1;
+			chgw.test_at = adc.samples;
+			kprintf("A04S CHGSAFE TEST: STOP FOR 60 S AT %d\n", adc.temp_dc);
+		}
+		if (chgw.test_phase == 1) {
+			if (adc.samples - chgw.test_at < CHGTEST_SAMPLES) {
+				stop = true;
+				resume = false;
+				reason = "TEST";
+			} else {
+				chgw.test_phase = 2;
+				kprintf("A04S CHGSAFE TEST: START AGAIN AT %d\n", adc.temp_dc);
+			}
+		}
+	}
+	bool pg = false, wall = false, hvs = false;
+	/* v49: the three AFC pins are driven low (hvdcp included, as Samsung's probe does) before HVDCP
+	 * goes on, so the D+/D- path isn't left floating during the chip's detection. */
+	bool pins = fast == 1 && afc_on == 1 && afc_check();
+	lck_mtx_lock(&a04s_i2c_mtx);
+	if (stop && !chgw.stopped) {
+		if (a04s_chg_set(false)) {
+			chgw.stopped = true;
+			chgw.stops++;
+			kprintf("A04S CHGSAFE CHARGING STOPPED: %s AT %d (REG03 %02x)\n", reason, adc.temp_dc, chgw.now);
+		}
+	} else if (resume && chgw.stopped && !chgw.ov_latched) {
+		if (a04s_chg_set(true)) {
+			chgw.stopped = false;
+			chgw.resumes++;
+			kprintf("A04S CHGSAFE CHARGING ON AGAIN AT %d (REG03 %02x)\n", adc.temp_dc, chgw.now);
+		}
+	}
+	if (chg.started) {
+		uint8_t st = 0;
+		if (chg_reg(CHG_REG_STATUS, &st)) {
+			chgw.status = st;
+			chgw.vbus = (uint8_t)((st >> 5) & 7u);
+			pg = (st & CHG_STAT_PG) != 0;
+			wall = pg && (chgw.vbus == CHG_VBUS_DCP || chgw.vbus == CHG_VBUS_HVDCP);
+			hvs = pg && chgw.vbus == CHG_VBUS_HVDCP;
+			if (!pg) {
+				chgw.dpdm_retries = 0;
+			}
+		}
+		(void)chg_reg(CHG_REG_CFG, &chgw.reg03);
+		(void)chg_reg(CHG_REG_ICHG, &chgw.reg04);
+		(void)chg_reg(CHG_REG_IDPM, &chgw.reg13);
+		(void)chg_reg(CHG_REG_ADC, &chgw.reg02);
+	}
+	if (chg.started && !chgw.disabled) {
+		unsigned orig = chg.regs[CHG_REG_ICHG] & CHG_ICHG_MASK;
+		unsigned have = chgw.ichg_code ? chgw.ichg_code : orig;
+		unsigned want = orig;
+		if (fast == 1 && wall && !chgw.stopped && !lost && adc.trusted) {
+			want = ichg_band(adc.temp_dc);
+			if (want > have && (ichg_band(adc.temp_dc - ICHG_HYST_DC) != want ||
+			    ichg_band(adc.temp_dc + ICHG_HYST_DC) != want)) {
+				want = have;    /* a step up only 2.0 C inside the new band */
+			}
+		}
+		if (want != have) {
+			if (a04s_chg_ichg(want)) {
+				chgw.ichg_changes++;
+				kprintf("A04S CHGSAFE ICHG %u MA AT %d (%s)\n", want * 64u, adc.temp_dc,
+				    want == orig ? "S-BOOT'S" : "SAMSUNG'S WIRED STEP");
+			}
+		}
+	}
+	/* v48: the charger's own HVDCP handshake, once a boot, with a trusted reading at SAFE OK. It takes
+	 * effect at the next plug-in (AUTO_DPDM_EN). AFC's sample watches VBUS for over-voltage, so it
+	 * needs a04safc=1 too. */
+	if (hv == 1 && pins && chg.started && !chgw.disabled && !chgw.hvdcp_tried && !lost &&
+	    adc.trusted && safe == SAFE_OK && !chgw.stopped) {
+		chgw.hvdcp_tried = true;
+		bool on = a04s_chg_hvdcp(true);
+		bool rerun = on && a04s_chg_dpdm();     /* v49: detect again at once, as Samsung's init does */
+		(void)chg_reg(CHG_REG_ADC, &chgw.reg02);
+		kprintf("A04S CHGSAFE HVDCP %s: REG02 %02x, 9 V AT MOST, DETECTION %s\n", on ? "ON" : "NOT ON",
+		    chgw.reg02, rerun ? "RERUN" : "NOT RERUN");
+	} else if (chgw.hvdcp_on && !chgw.disabled && pg && chgw.vbus == CHG_VBUS_UNKNOWN &&
+	    chgw.dpdm_retries < CHG_DPDM_RETRIES) {
+		chgw.dpdm_retries++;                    /* v49: Samsung's "BC1.2 retry" for an unknown adapter */
+		bool rerun = a04s_chg_dpdm();
+		kprintf("A04S CHGSAFE UNKNOWN ADAPTER (STAT %02x): DETECTION %s, %u OF %u\n", chgw.status,
+		    rerun ? "RERUN" : "NOT RERUN", chgw.dpdm_retries, CHG_DPDM_RETRIES);
+	}
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	if (fast == 1) {
+		afc_sample(safe, lost, pg, wall, hvs);
+	}
+}
+
+/* From the thermal thread (bsd/dev/a04s_gpu.c), every 2 s. Only that thread touches the ADC. */
+void a04s_adc_sample(void);
+void
+a04s_adc_sample(void)
+{
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04sadc", &want, sizeof(want));
+	if (want != 1 || !adc_check()) {
+		return;
+	}
+	unsigned v[ADC_SAMPLES] = { 0 }, lo = 0, hi = 0, sum = 0;
+	for (unsigned i = 0; i < ADC_SAMPLES; i++) {
+		if (!adc_convert(ADC_CH_BATT, &v[i])) {
+			adc.timeouts++;
+			adc.state = "TIMEOUT";
+			if (adc.trusted) {
+				adc.untrusted++;
+				adc.lost = true;
+			}
+			adc.trusted = false;
+			adc.steady = 0;
+			chg_safety(SAFE_UNKNOWN, adc.lost);
+			return;
+		}
+		lo = v[i] < v[lo] ? i : lo;
+		hi = v[i] > v[hi] ? i : hi;
+		sum += v[i];
+	}
+	adc.raw_min = v[lo];
+	adc.raw_max = v[hi];
+	adc.raw = lo == hi ? v[0] : (sum - v[lo] - v[hi]) / (ADC_SAMPLES - 2u);
+	for (unsigned c = 0; c < 4; c++) {
+		if (c != ADC_CH_BATT && !adc_convert(c, &adc.ch[c])) {
+			adc.timeouts++;
+		}
+	}
+	adc.ch[ADC_CH_BATT] = adc.raw;
+	adc.samples++;
+	int dc = adc_to_dc(adc.raw);
+	if (dc == NO_TEMP) {
+		adc.state = "OUT OF TABLE";
+		if (adc.trusted) {
+			adc.untrusted++;
+			adc.lost = true;
+		}
+		adc.trusted = false;
+		adc.steady = 0;
+		adc.temp_dc = NO_TEMP;
+	} else {
+		int step = adc.last_dc == NO_TEMP ? 0 : dc - adc.last_dc;
+		adc.steady = (adc.last_dc != NO_TEMP && step <= ADC_STEADY_DC && step >= -ADC_STEADY_DC) ?
+		    adc.steady + 1u : 1u;
+		if (!adc.trusted && adc.steady >= ADC_TRUST) {
+			adc.trusted = true;
+			adc.lost = false;
+			kprintf("A04S BATTERY TEMP %s%d.%d C FROM THE THERMISTOR (ADC %u)\n", dc < 0 ? "-" : "",
+			    (dc < 0 ? -dc : dc) / 10, (dc < 0 ? -dc : dc) % 10, adc.raw);
+		}
+		adc.state = adc.trusted ? "OK" : "SETTLING";
+		adc.temp_dc = dc;
+	}
+	adc.last_dc = dc;
+	int safe = safe_decide(adc.trusted ? adc.temp_dc : NO_TEMP, adc.safe);
+	if (safe != adc.safe) {
+		kprintf("A04S CHGSAFE %s AT %d\n", safe_names[safe], adc.temp_dc);
+		adc.safe = safe;
+	}
+	chg_safety(safe, adc.lost);
+}
+
+/* The battery temperature in tenths of a degree, or NO_TEMP: the thermistor once it is trusted,
+ * else the gauge's. For the thermal monitor and SweetBattery. */
+int a04s_batt_temp_dc(void);
+int
+a04s_batt_temp_dc(void)
+{
+	if (adc.trusted && adc.temp_dc != NO_TEMP) {
+		return adc.temp_dc;
+	}
+	return a04s_fg_temp_dc();
+}
