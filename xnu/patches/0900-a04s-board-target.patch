index 76d70b9..552e163 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1049,6 +1049,49 @@ sweet_sample_task(const char *name, int pid, task_t task)
 	task_unlock(task);
 }
 
+#if defined(ARM64_BOARD_CONFIG_A04S)
+void a04s_sample_task(task_t task);
+
+void
+a04s_sample_task(task_t task)
+{
+	thread_t thread;
+
+	if (!task_lock_try(task)) {
+		kprintf("PID1 TASK LOCKED\n");
+		return;
+	}
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+
+		kprintf("T ST %x EV %llx U %u M %u\n", thread->state, (uint64_t)thread->wait_event,
+		    thread->syscalls_unix, thread->syscalls_mach);
+		kprintf("CONT %llx\n", (uint64_t)VM_KERNEL_UNSLIDE((vm_offset_t)thread->continuation));
+		if (ss != NULL && is_saved_state64(ss)) {
+			kprintf("UPC %llx\n", (uint64_t)get_saved_state_pc(ss));
+			kprintf("ULR %llx\n", (uint64_t)get_saved_state_lr(ss));
+		}
+		if (thread->kernel_stack != 0) {
+			arm_kernel_saved_state_t *state = (arm_kernel_saved_state_t *)thread->machine.kstackptr;
+			uint64_t low = thread->kernel_stack, high = low + kernel_stack_size;
+			uint64_t fp = state->fp;
+
+			kprintf("K %llx\n", (uint64_t)VM_KERNEL_UNSLIDE((vm_offset_t)state->lr));
+			for (int i = 0; i < 12 && fp >= low && fp + 16 <= high && (fp & 7) == 0; i++) {
+				const uint64_t *frame = (const uint64_t *)fp;
+
+				kprintf("K %llx\n", (uint64_t)VM_KERNEL_UNSLIDE((vm_offset_t)frame[1]));
+				if (frame[0] <= fp) {
+					break;
+				}
+				fp = frame[0];
+			}
+		}
+	}
+	task_unlock(task);
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
+
 #endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_A5XELTE */
 
