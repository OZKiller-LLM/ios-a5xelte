index 0000000..b1d0e2c
--- /dev/null
+++ b/bsd/dev/a04s_acpm.c
@@ -0,0 +1,618 @@
+/*
+ * Galaxy A04s: ACPM, the mailbox protocol of the APM core, to the S2MPU12 PMIC and the
+ * AUD3004X codec on the same bus. A write there can change a supply voltage, so this file
+ * builds reads, and single-register writes that a04s_acpm_guard.h allows: the codec's capture
+ * path, and nothing on the PMIC. tools/check_acpm_source.py refuses anything else, and
+ * tools/check_kernel_acpm.py checks the guard's table in the built kernel.
+ * The protocol follows Samsung's drivers/soc/samsung/acpm (acpm_ipc.c, acpm_mfd.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_A04S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <stdbool.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include "a04s_acpm_guard.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t mach_absolute_time(void);
+
+#define ACPM_MBOX_PA           0x11900000u     /* acpm_ipc reg 0 */
+#define ACPM_MBOX_SIZE          0x1000u
+#define ACPM_SRAM_PA            0x02039000u     /* acpm_ipc reg 1 */
+#define ACPM_SRAM_SIZE          0x30000u
+#define ACPM_INITDATA           0x7000u         /* acpm_ipc initdata-base */
+#define ACPM_MFD_CHANNEL        2u              /* s2mpu12mfd acpm-ipc-channel */
+#define ACPM_TICKS_PER_MS       26000u
+#define ACPM_TIMEOUT_MS         50u
+
+/* Mailbox registers: INTGR0 rings the APM, INTSR1/INTCR1 are its replies to the AP. */
+#define INTGR0                  0x0008u
+#define INTCR1                  0x0020u
+#define INTSR1                  0x0028u
+
+/* struct acpm_framework, fw_header/framework.h: the two fields used. */
+#define FW_IPC_CHANNELS         0x08u
+#define FW_IPC_AP_MAX           0x18u
+/* struct ipc_channel: id, field, owner, type, struct channel_info, ap_poll. */
+#define CH_SIZE                 0x48u
+#define CH_ID                   0x00u
+#define CH_IN_REAR              0x10u           /* channel_info.rx_*: what the APM receives */
+#define CH_IN_FRONT             0x14u
+#define CH_IN_BASE              0x18u
+#define CH_OUT_REAR             0x28u           /* channel_info.tx_*: its replies */
+#define CH_OUT_FRONT            0x2cu
+#define CH_OUT_BASE             0x30u
+#define CH_Q_LEN                0x34u
+#define CH_Q_ELEM_SIZE          0x38u
+#define CH_AP_POLL              0x44u
+
+/* cmd[0]: register, bus address, bus channel, sequence. cmd[1]: function, then the reply. */
+#define ACPM_SEQ_SHIFT          16
+#define ACPM_FUNC_READ          0u              /* acpm_mfd.h FUNC_READ */
+#define ACPM_FUNC_WRITE         1u              /* acpm_mfd.h FUNC_WRITE: built in acpm_write() alone */
+#define ACPM_DEST(word)         (((word) >> 8) & 0xffu)
+#define ACPM_RETURN(word)       (((word) >> 24) & 0xffu)
+
+struct a04s_acpm_queue {
+	uint32_t rear, front, base;
+};
+
+static vm_offset_t acpm_mbox, acpm_sram;
+static uint32_t acpm_id, acpm_len, acpm_elem, acpm_seq;
+static struct a04s_acpm_queue acpm_in, acpm_out;
+static int acpm_error = -1;
+static bool acpm_ready;                         /* the channel was found: reads can go */
+
+/* Shown by the heartbeat: the PMIC's revision, codec registers, and the guarded write test. */
+static uint8_t acpm_pmic_rev, acpm_mic_bias, acpm_mic_gain;
+static uint8_t acpm_codec[4], acpm_otp[4], acpm_set_back, acpm_ldo33, acpm_ldo34;
+/* pd-aud@11862080 in the always-on PMU: readable whether the audio block is powered or not. */
+#define PD_AUD_PA               0x11862000u
+#define PD_AUD_CONFIG           0x080u
+#define PD_AUD_STATUS           0x084u
+static uint32_t pd_aud_config, pd_aud_status;
+static bool acpm_guard_ok, acpm_writes_ok;
+static int acpm_write_test = -1;
+static uint32_t acpm_refused;
+static uint8_t acpm_status1[2];                 /* S2MPU12_PMIC_STATUS1 read on bus 0x00, then 0x01 */
+static int acpm_status1_err = -1;
+
+static inline uint32_t
+sram_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(acpm_sram + off);
+}
+
+static inline void
+sram_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(acpm_sram + off) = value;
+}
+
+static inline uint32_t
+mbox_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(acpm_mbox + off);
+}
+
+static inline void
+mbox_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(acpm_mbox + off) = value;
+}
+
+static int
+acpm_setup(void)
+{
+	acpm_mbox = ml_io_map(ACPM_MBOX_PA, ACPM_MBOX_SIZE);
+	acpm_sram = ml_io_map(ACPM_SRAM_PA, ACPM_SRAM_SIZE);
+	if (!acpm_mbox || !acpm_sram) {
+		return ENOMEM;
+	}
+	uint32_t table = sram_rd(ACPM_INITDATA + FW_IPC_CHANNELS);
+	uint32_t count = sram_rd(ACPM_INITDATA + FW_IPC_AP_MAX);
+	if (count == 0 || count > 32 || table == 0 || table + count * CH_SIZE > ACPM_SRAM_SIZE) {
+		return ENXIO;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t ch = table + i * CH_SIZE;
+		if (sram_rd(ch + CH_ID) != ACPM_MFD_CHANNEL) {
+			continue;
+		}
+		/* Samsung's driver polls this channel; an interrupt channel would need a handler. */
+		if (!sram_rd(ch + CH_AP_POLL)) {
+			return ENOTSUP;
+		}
+		acpm_id = ACPM_MFD_CHANNEL;
+		acpm_len = sram_rd(ch + CH_Q_LEN);
+		acpm_elem = sram_rd(ch + CH_Q_ELEM_SIZE);
+		acpm_in = (struct a04s_acpm_queue){ sram_rd(ch + CH_IN_REAR), sram_rd(ch + CH_IN_FRONT), sram_rd(ch + CH_IN_BASE) };
+		acpm_out = (struct a04s_acpm_queue){ sram_rd(ch + CH_OUT_REAR), sram_rd(ch + CH_OUT_FRONT), sram_rd(ch + CH_OUT_BASE) };
+		if (acpm_len < 2 || acpm_len > 64 || acpm_elem < 16 || acpm_elem > 64 ||
+		    acpm_in.base + acpm_len * acpm_elem > ACPM_SRAM_SIZE ||
+		    acpm_out.base + acpm_len * acpm_elem > ACPM_SRAM_SIZE ||
+		    acpm_in.front >= ACPM_SRAM_SIZE || acpm_in.rear >= ACPM_SRAM_SIZE ||
+		    acpm_out.front >= ACPM_SRAM_SIZE || acpm_out.rear >= ACPM_SRAM_SIZE) {
+			return ENXIO;
+		}
+		return 0;
+	}
+	return ENOENT;
+}
+
+static bool
+acpm_timed_out(uint64_t start)
+{
+	return mach_absolute_time() - start > (uint64_t)ACPM_TICKS_PER_MS * ACPM_TIMEOUT_MS;
+}
+
+/* Queue one command, ring the APM, and wait for the reply with the same sequence number. */
+static int __attribute__((noinline))
+acpm_transfer(uint32_t cmd[4])
+{
+	uint32_t front = sram_rd(acpm_in.front), next = (front + 1) % acpm_len;
+	uint64_t start = mach_absolute_time();
+	while (next == sram_rd(acpm_in.rear)) {
+		if (acpm_timed_out(start)) {
+			return EBUSY;
+		}
+	}
+	if (++acpm_seq == 64) {
+		acpm_seq = 1;
+	}
+	cmd[0] |= acpm_seq << ACPM_SEQ_SHIFT;
+	for (uint32_t w = 0; w < acpm_elem / 4; w++) {
+		sram_wr(acpm_in.base + front * acpm_elem + w * 4, w < 4 ? cmd[w] : 0);
+	}
+	sram_wr(acpm_in.front, next);
+	mbox_wr(INTGR0, (1u << acpm_id) << 16);
+
+	start = mach_absolute_time();
+	for (;;) {
+		if (mbox_rd(INTSR1) & (1u << acpm_id)) {
+			uint32_t rear = sram_rd(acpm_out.rear), last = sram_rd(acpm_out.front);
+			for (uint32_t i = rear; i != last; i = (i + 1) % acpm_len) {
+				uint32_t at = acpm_out.base + i * acpm_elem;
+				if (((sram_rd(at) >> ACPM_SEQ_SHIFT) & 0x3fu) != acpm_seq) {
+					continue;
+				}
+				for (uint32_t w = 0; w < 4; w++) {
+					cmd[w] = sram_rd(at + w * 4);
+				}
+				/* As Samsung's driver: the oldest reply moves into the slot taken. */
+				if (i != rear) {
+					for (uint32_t w = 0; w < acpm_elem / 4; w++) {
+						sram_wr(at + w * 4, sram_rd(acpm_out.base + rear * acpm_elem + w * 4));
+					}
+				}
+				rear = (rear + 1) % acpm_len;
+				sram_wr(acpm_out.rear, rear);
+				if (rear == sram_rd(acpm_out.front)) {
+					mbox_wr(INTCR1, 1u << acpm_id);
+				}
+				return 0;
+			}
+		}
+		if (acpm_timed_out(start)) {
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* One register from a device on the PMIC's bus. */
+static int __attribute__((noinline))
+acpm_read(uint32_t bus_addr, uint32_t reg, uint8_t *value)
+{
+	uint32_t cmd[4] = { 0 };
+	cmd[0] = (reg & 0xffu) | ((bus_addr & 0xfu) << 8);
+	cmd[1] = ACPM_FUNC_READ;
+	int error = acpm_transfer(cmd);
+	if (error) {
+		return error;
+	}
+	if (ACPM_RETURN(cmd[1])) {
+		return EIO;
+	}
+	*value = (uint8_t)ACPM_DEST(cmd[1]);
+	return 0;
+}
+
+/* One codec register, if a04s_acpm_guard.h allows it. The only write this file builds. */
+static int __attribute__((noinline))
+acpm_write(uint32_t bus_addr, uint32_t reg, uint8_t value)
+{
+	if (!acpm_writes_ok || !a04s_acpm_write_allowed(bus_addr, reg)) {
+		acpm_refused++;
+		return EPERM;
+	}
+	uint32_t cmd[4] = { 0 };
+	cmd[0] = (reg & 0xffu) | ((bus_addr & 0xfu) << 8);
+	cmd[1] = ACPM_FUNC_WRITE | ((uint32_t)value << 8);
+	/* The APM takes the bus address and register from cmd[0] alone: check what it holds. */
+	if (!a04s_acpm_write_allowed((cmd[0] >> 8) & 0xfu, cmd[0] & 0xffu)) {
+		acpm_refused++;
+		return EPERM;
+	}
+	int error = acpm_transfer(cmd);
+	if (error) {
+		return error;
+	}
+	return ACPM_RETURN(cmd[1]) ? EIO : 0;
+}
+
+/*
+ * v55: one write to the codec's supplies, if a04s_acpm_guard.h's supply table allows that exact
+ * {bus, register, value}. Checked on the arguments, and again on the command built. The only other
+ * function that sends a write.
+ */
+static int __attribute__((noinline))
+acpm_supply_write(uint32_t bus_addr, uint32_t reg, uint8_t value)
+{
+	if (!acpm_writes_ok || !a04s_supply_write_allowed(bus_addr, reg, value)) {
+		acpm_refused++;
+		return EPERM;
+	}
+	uint32_t cmd[4] = { 0 };
+	cmd[0] = (reg & 0xffu) | ((bus_addr & 0xfu) << 8);
+	cmd[1] = ACPM_FUNC_WRITE | ((uint32_t)value << 8);
+	if (!a04s_supply_write_allowed((cmd[0] >> 8) & 0xfu, cmd[0] & 0xffu, (cmd[1] >> 8) & 0xffu)) {
+		acpm_refused++;
+		return EPERM;
+	}
+	int error = acpm_transfer(cmd);
+	if (error) {
+		return error;
+	}
+	return ACPM_RETURN(cmd[1]) ? EIO : 0;
+}
+
+/*
+ * v55 (the owner's decision, 2026-11-07): the codec's supplies on, as Samsung's s2mpu12 regulator
+ * driver does at every Android boot (regulator-always-on). Called from a04s_audclk.c before the
+ * key thread starts. Only when both read voltage code 0x2c, as Android leaves them; each gets its
+ * enable bits set once, the voltage bits kept, and is read back. Never off, never another voltage.
+ */
+int a04s_acpm_codec_supplies_on(uint8_t before[2], uint8_t after[2]);
+int
+a04s_acpm_codec_supplies_on(uint8_t before[2], uint8_t after[2])
+{
+	static const uint8_t regs[2] = { 0x4B, 0x4C };         /* S2MPU12_PMIC_L33CTRL, L34CTRL */
+	if (!acpm_ready || !acpm_writes_ok || !a04s_supply_guard_self_test()) {
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		int error = acpm_read(0x01, regs[i], &before[i]);
+		if (error) {
+			return error;
+		}
+		after[i] = before[i];
+		if ((before[i] & 0x3Fu) != 0x2Cu) {
+			return EDOM;                  /* not the voltage Android runs it at: neither is touched */
+		}
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		if ((before[i] & 0xC0u) != 0xC0u) {
+			int error = acpm_supply_write(0x01, regs[i], (uint8_t)((before[i] & 0x3Fu) | 0xC0u));
+			if (error) {
+				return error;
+			}
+		}
+		int error = acpm_read(0x01, regs[i], &after[i]);
+		if (error) {
+			return error;
+		}
+		if (after[i] != 0xECu) {
+			return EIO;
+		}
+	}
+	return 0;
+}
+
+/*
+ * v56: the codec seen again after its supplies come on, reads only. The two supplies live, the
+ * OTP current trims (zero while unpowered, nonzero on a powered, calibrated part), RESETB0 (0x14),
+ * DCTR_CM (0xD0), and the four digital registers the probe read before the switch-on.
+ */
+int a04s_acpm_codec_snapshot(uint8_t out[12]);
+int
+a04s_acpm_codec_snapshot(uint8_t out[12])
+{
+	static const uint8_t regs[12][2] = {
+		{ 0x01, 0x4B }, { 0x01, 0x4C }, { 0x03, 0xA2 }, { 0x03, 0xA3 }, { 0x03, 0xA4 }, { 0x03, 0xA6 },
+		{ 0x07, 0x14 }, { 0x07, 0xD0 }, { 0x07, 0x16 }, { 0x07, 0x20 }, { 0x07, 0x34 }, { 0x07, 0x37 },
+	};
+	if (!acpm_ready) {
+		return ENXIO;
+	}
+	for (unsigned i = 0; i < 12; i++) {
+		int error = acpm_read(regs[i][0], regs[i][1], &out[i]);
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+/*
+ * v57: the write test on one allowed codec register: read, the value ^ 0x5a written and read back,
+ * the old value put back. 0: stored and restored; ENODEV: written, not stored.
+ */
+static int
+codec_test_reg(uint32_t bus_addr, uint32_t reg)
+{
+	uint8_t was = 0, back = 0, again = 0;
+	int error = acpm_read(bus_addr, reg, &was);
+	if (error) {
+		return error;
+	}
+	uint8_t probe = was ^ 0x5au;
+	error = acpm_write(bus_addr, reg, probe);
+	if (!error) {
+		error = acpm_read(bus_addr, reg, &back);
+	}
+	int restore = acpm_write(bus_addr, reg, was);
+	if (!restore) {
+		restore = acpm_read(bus_addr, reg, &again);
+	}
+	if (!restore && again != was) {
+		restore = EIO;
+	}
+	if (!error && back != probe) {
+		error = ENODEV;
+	}
+	if (!error && restore) {
+		error = 100 + restore;
+	}
+	return error;
+}
+
+/* v57: bits ORed into one allowed codec register, then read back. Only ever sets bits. */
+static int
+codec_set_bits(uint32_t bus_addr, uint32_t reg, uint8_t bits, uint8_t *before, uint8_t *after)
+{
+	int error = acpm_read(bus_addr, reg, before);
+	if (!error && (*before & bits) != bits) {
+		error = acpm_write(bus_addr, reg, (uint8_t)(*before | bits));
+	}
+	if (!error) {
+		error = acpm_read(bus_addr, reg, after);
+	}
+	return error;
+}
+
+/*
+ * v57: the codec made ready to capture, as Android's aud3004x.c does in the ADC's PRE_PMU and in
+ * capture_hw_params(): CLKGATE0 SEQ|ADC|COM on (0x25), CLKGATE2 ADC_CIC_CGL|CGR on (0x06), then
+ * RESETB0 CORE_RESETB|RSTB_ADC|ADC_RESETB released (0x2A, active-low resets) and 1 ms
+ * (AUD3004X_RESETB_TIME_USEC). First the write test on IF_FORM1 (0x20), outside the ADC block;
+ * after, the write test on AD_VOLL (0x34) again. Every write goes through acpm_write() and the codec
+ * allow-list; regs[] holds CLKGATE0, CLKGATE2 and RESETB0, each before and after.
+ */
+int a04s_acpm_codec_capture_ready(uint8_t regs[6], int *test_if, int *test_adc);
+int
+a04s_acpm_codec_capture_ready(uint8_t regs[6], int *test_if, int *test_adc)
+{
+	if (!acpm_ready || !acpm_writes_ok) {
+		return ENXIO;
+	}
+	*test_if = codec_test_reg(0x07, 0x20);                             /* AUD3004X_20_IF_FORM1 */
+	int error = codec_set_bits(0x07, 0x10, 0x25, &regs[0], &regs[1]);  /* CLKGATE0: SEQ, ADC, COM */
+	if (!error) {
+		error = codec_set_bits(0x07, 0x12, 0x06, &regs[2], &regs[3]);    /* CLKGATE2: ADC_CIC_CGL, CGR */
+	}
+	if (!error) {
+		error = codec_set_bits(0x07, 0x14, 0x2A, &regs[4], &regs[5]);    /* RESETB0: CORE, RSTB_ADC, ADC */
+	}
+	if (error) {
+		return error;
+	}
+	delay(1000);
+	*test_adc = codec_test_reg(0x07, 0x34);                            /* AUD3004X_34_AD_VOLL */
+	return 0;
+}
+
+/*
+ * v58: registers lo..hi of one bus address read into out[lo..hi], reads only (the codec dump in
+ * a04s_audclk.c). A failed read stops and returns its error.
+ */
+int a04s_acpm_read_range(uint32_t bus_addr, uint32_t lo, uint32_t hi, uint8_t out[256]);
+int
+a04s_acpm_read_range(uint32_t bus_addr, uint32_t lo, uint32_t hi, uint8_t out[256])
+{
+	if (!acpm_ready) {
+		return ENXIO;
+	}
+	if (bus_addr > 0xFu || hi > 0xFFu || lo > hi) {
+		return EINVAL;
+	}
+	for (uint32_t reg = lo; reg <= hi; reg++) {
+		int error = acpm_read(bus_addr, reg, &out[reg]);
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
+}
+
+/*
+ * v59 (the owner's decision, 2026-11-08): the codec's digital core clocked, as aud3004x.c's
+ * register_initialize() does first: DCTR_CM (0xD0) bit 0, PDB_JD_CLK_EN, cleared, 20 ms
+ * (AUD3004X_PDB_CLK_MSEC), set, 20 ms. Only that bit changes; the others are kept. d0[] holds the
+ * register before, after the clear and after the set. Through acpm_write() and its allow-list.
+ */
+int a04s_acpm_codec_clk_pulse(uint8_t d0[3]);
+int
+a04s_acpm_codec_clk_pulse(uint8_t d0[3])
+{
+	if (!acpm_ready || !acpm_writes_ok) {
+		return ENXIO;
+	}
+	int error = acpm_read(0x07, 0xD0, &d0[0]);
+	if (!error) {
+		error = acpm_write(0x07, 0xD0, (uint8_t)(d0[0] & ~0x01u));
+	}
+	if (!error) {
+		error = acpm_read(0x07, 0xD0, &d0[1]);
+	}
+	if (error) {
+		return error;
+	}
+	delay(20000);
+	error = acpm_write(0x07, 0xD0, (uint8_t)(d0[1] | 0x01u));
+	if (!error) {
+		delay(20000);
+		error = acpm_read(0x07, 0xD0, &d0[2]);
+	}
+	return error;
+}
+
+/* The registers Samsung's own drivers read first: s2mpu12-core.c, then aud3004x.c. */
+void a04s_acpm_probe(void);
+void
+a04s_acpm_probe(void)
+{
+	acpm_guard_ok = a04s_acpm_guard_self_test();
+	int want_writes = 0;
+	(void)PE_parse_boot_argn("acpmwrite", &want_writes, sizeof(want_writes));
+	acpm_error = acpm_setup();
+	acpm_ready = !acpm_error;
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x00, 0x04, &acpm_pmic_rev);     /* S2MPU12_PMIC_CHIPID */
+	}
+	/* Stage 7b: STATUS1 from both pages, so the first boot shows which one holds PWRON. */
+	if (acpm_ready) {
+		acpm_status1_err = acpm_read(0x00, 0x0C, &acpm_status1[0]);
+		if (!acpm_status1_err) {
+			acpm_status1_err = acpm_read(0x01, 0x0C, &acpm_status1[1]);
+		}
+	}
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x08, 0x10, &acpm_mic_bias);     /* AUD3004X_110_PD_REF */
+	}
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x08, 0x34, &acpm_mic_gain);     /* AUD3004X_134_VOL_AD1 */
+	}
+	/* Digital-block settings Android left: not all zero means the codec itself answers. */
+	static const uint8_t codec_regs[4] = { 0x16, 0x20, 0x34, 0x37 };
+	for (unsigned i = 0; i < 4 && !acpm_error; i++) {
+		acpm_error = acpm_read(0x07, codec_regs[i], &acpm_codec[i]);
+	}
+	/* The codec's supplies, vdd_aldo1 and vdd_aldo2: enable bits 7:6, voltage 5:0. Reads only. */
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x01, 0x4B, &acpm_ldo33);        /* S2MPU12_PMIC_L33CTRL */
+	}
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x01, 0x4C, &acpm_ldo34);        /* S2MPU12_PMIC_L34CTRL */
+	}
+	vm_offset_t pmu = ml_io_map(PD_AUD_PA, 0x1000);
+	if (pmu) {
+		pd_aud_config = *(volatile uint32_t *)(pmu + PD_AUD_CONFIG);
+		pd_aud_status = *(volatile uint32_t *)(pmu + PD_AUD_STATUS);
+	}
+	/* Factory current-reference trims in the codec's OTP block: zero on a calibrated part is unlikely. */
+	static const uint8_t otp_regs[4] = { 0xA2, 0xA3, 0xA4, 0xA6 };  /* AUD3004X_2A2..2A6_CTRL_IREF */
+	for (unsigned i = 0; i < 4 && !acpm_error; i++) {
+		acpm_error = acpm_read(0x03, otp_regs[i], &acpm_otp[i]);
+	}
+	/*
+	 * The write test: AUD3004X_34_AD_VOLL, the digital volume of an ADC that is off, set to a
+	 * value it doesn't hold and read back, then its own value put back. A register that stores
+	 * what is written gives the new value; nothing behind the address gives the old one.
+	 */
+	acpm_writes_ok = !acpm_error && want_writes == 1 && acpm_guard_ok;
+	if (acpm_writes_ok) {
+		uint8_t again = 0, probe = acpm_codec[2] ^ 0x5au;
+		acpm_write_test = acpm_write(0x07, 0x34, probe);
+		if (!acpm_write_test) {
+			acpm_write_test = acpm_read(0x07, 0x34, &acpm_set_back);
+		}
+		int restore = acpm_write(0x07, 0x34, acpm_codec[2]);
+		if (!restore) {
+			restore = acpm_read(0x07, 0x34, &again);
+		}
+		if (!restore && again != acpm_codec[2]) {
+			restore = EIO;
+		}
+		if (!acpm_write_test && acpm_set_back != probe) {
+			acpm_write_test = ENODEV;           /* written, not stored */
+		}
+		if (!acpm_write_test && restore) {
+			acpm_write_test = 100 + restore;    /* stored, not put back */
+		}
+	}
+}
+
+/*
+ * Stage 7b: the side key. S2MPU12_PMIC_STATUS1 (0x0C) bit 0 is PWRON, the key's level. It is on the
+ * PMIC page, bus address 0x01: s2mpu12-key.c reads it through s2mpu12->pmic (I2C_ADDR_PMIC). v20
+ * read page 0x00, which stays 00. A status register: reading it clears nothing, unlike INT1. Only the key thread calls this, and a04s_input.c starts that after
+ * a04s_acpm_probe() returns, so two transfers never overlap on the channel.
+ */
+int a04s_acpm_power_key(uint8_t *status1);
+int
+a04s_acpm_power_key(uint8_t *status1)
+{
+	if (!acpm_ready) {
+		return ENXIO;
+	}
+	return acpm_read(0x01, 0x0C, status1);
+}
+
+/*
+ * v54, audio A2: the same write test as a04s_acpm_probe()'s, run again by a04s_audclk.c before and
+ * after it lets the codec's clock through. Called from a04s_input_start() before the key thread
+ * starts, so no other ACPM transfer overlaps. 0: stored and put back; ENODEV: written, not stored.
+ */
+int a04s_acpm_codec_retest(void);
+int
+a04s_acpm_codec_retest(void)
+{
+	if (!acpm_ready || !acpm_writes_ok) {
+		return ENXIO;
+	}
+	uint8_t was = 0, back = 0, again = 0;
+	int error = acpm_read(0x07, 0x34, &was);
+	if (error) {
+		return error;
+	}
+	uint8_t probe = was ^ 0x5au;
+	error = acpm_write(0x07, 0x34, probe);
+	if (!error) {
+		error = acpm_read(0x07, 0x34, &back);
+	}
+	int restore = acpm_write(0x07, 0x34, was);
+	if (!restore) {
+		restore = acpm_read(0x07, 0x34, &again);
+	}
+	if (!restore && again != was) {
+		restore = EIO;
+	}
+	if (!error && back != probe) {
+		error = ENODEV;
+	}
+	if (!error && restore) {
+		error = 100 + restore;
+	}
+	return error;
+}
+
+void a04s_acpm_report(void);
+void
+a04s_acpm_report(void)
+{
+	kprintf("ACPM ERR %d PMIC %02x MIC %02x %02x\n", acpm_error, acpm_pmic_rev, acpm_mic_bias, acpm_mic_gain);
+	kprintf("CODEC %02x %02x %02x %02x GUARD %s WR %s TEST %d REF %u\n", acpm_codec[0], acpm_codec[1],
+	    acpm_codec[2], acpm_codec[3], acpm_guard_ok ? "OK" : "FAILED", acpm_writes_ok ? "ON" : "OFF",
+	    acpm_write_test, acpm_refused);
+	kprintf("OTP %02x %02x %02x %02x SET %02x BACK %02x\n", acpm_otp[0], acpm_otp[1], acpm_otp[2], acpm_otp[3],
+	    (uint8_t)(acpm_codec[2] ^ 0x5au), acpm_set_back);
+	kprintf("LDO33 %02x LDO34 %02x PDAUD %x %x\n", acpm_ldo33, acpm_ldo34, pd_aud_config, pd_aud_status);
+	kprintf("STATUS1 %d %02x %02x\n", acpm_status1_err, acpm_status1[0], acpm_status1[1]);
+	extern void a04s_audclk_report(void);  /* v54: bsd/dev/a04s_audclk.c */
+	a04s_audclk_report();
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
diff --git a/bsd/dev/a04s_acpm_guard.h b/bsd/dev/a04s_acpm_guard.h
new file mode 100644
index 0000000..3a0607f
--- /dev/null
+++ b/bsd/dev/a04s_acpm_guard.h
@@ -0,0 +1,82 @@
+/*
+ * Galaxy A04s: the only registers a kernel may write over ACPM. The same bus carries the
+ * S2MPU12 PMIC's regulators: its top and PMIC pages (bus addresses 0x00 and 0x01) set supply
+ * voltages, and none of them is here, nor its RTC (0x02), the codec's OTP fuses (0x03) or its
+ * trims (0x0F). Only the AUD3004X's capture path, on its digital (0x07) and analog (0x08)
+ * blocks. One bit per register, so tools/check_kernel_acpm.py can read the table out of a
+ * built kernel and check every bit. Generated with the port patch; edit the list there.
+ * The caller provides uint32_t and bool.
+ */
+#ifndef A04S_ACPM_GUARD_H
+#define A04S_ACPM_GUARD_H
+
+/*
+ * [bus address][register / 32], bit register % 32. Volatile, so every check reads the table:
+ * constant, the compiler worked out each check at build time and left none in the kernel.
+ */
+const volatile uint32_t a04s_acpm_writable[16][8] __attribute__((used)) = {
+	/* 0x07: 10 CLKGATE0, 11 CLKGATE1, 12 CLKGATE2, 14 RESETB0, 16 CLK_MODE_SEL, 18 PWAUTO_AD, 1E CHOP1, 1F CHOP2, 20 IF_FORM1, 21 IF_FORM2, 22 IF_FORM3, 23 IF_FORM4, 24 IF_FORM5, 29 IF_FORM6, 30 ADC1, 31 ADC2, 32 ADC3, 33 ADC4, 34 AD_VOLL, 35 AD_VOLR, 37 AD_HPF, C5 ACTR_MCB3, C6 ACTR_MCB4, D0 DCTR_CM (v59) */
+	[0x07] = { 0xc1570000u, 0x00bf021fu, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00010060u, 0x00000000u },
+	/* 0x08: 02 CLK3_COD, 06 DSM_AD, 07 LPF_AD, 10 PD_REF, 11 PD_AD1, 12 PD_AD2, 13 PD_AD3, 17 CTRL_REF, 30 MIX_AD1, 34 VOL_AD1, 35 VOL_AD2, 36 VOL_AD3 */
+	[0x08] = { 0x008f00c4u, 0x00710000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u },
+};
+
+static inline bool
+a04s_acpm_write_allowed(uint32_t bus, uint32_t reg)
+{
+	return bus < 16 && reg < 256 && ((a04s_acpm_writable[bus][reg / 32] >> (reg % 32)) & 1u);
+}
+
+/* Every register on the PMIC, RTC, OTP and trim pages refused, and the test write allowed. */
+static inline bool
+a04s_acpm_guard_self_test(void)
+{
+	static const uint32_t refused_buses[] = { 0x00, 0x01, 0x02, 0x03, 0x0F };
+	for (unsigned i = 0; i < sizeof(refused_buses) / sizeof(refused_buses[0]); i++) {
+		for (uint32_t reg = 0; reg < 256; reg++) {
+			if (a04s_acpm_write_allowed(refused_buses[i], reg)) {
+				return false;
+			}
+		}
+	}
+	return a04s_acpm_write_allowed(0x07, 0x34) && !a04s_acpm_write_allowed(0x08, 0x50) &&
+	       !a04s_acpm_write_allowed(0x17, 0x34) && !a04s_acpm_write_allowed(0x07, 0x100);
+}
+
+/*
+ * v55 (the owner's decision, 2026-11-07): the codec's two supplies, switched on as Samsung's
+ * s2mpu12 regulator driver does at every Android boot (regulator-always-on, mode 3, the voltage
+ * left as it is). These are the only PMIC writes there are: the PMIC page (bus 0x01), L33CTRL
+ * 0x4B ("vdd_aldo1") and L34CTRL 0x4C ("vdd_aldo2"), value 0xEC: enable bits 7:6 = 11 and voltage
+ * code 0x2c, 1.80 V on LDO33 (700 mV + 25 mV steps) and 2.90 V on LDO34 (1800 mV + 25 mV steps),
+ * both inside the device tree's ranges. {bus, register, value}; tools/check_kernel_acpm.py reads
+ * this table out of the built kernel and refuses any other entry.
+ */
+const volatile uint32_t a04s_acpm_supply[2][3] __attribute__((used)) = {
+	{ 0x01u, 0x4bu, 0xecu },
+	{ 0x01u, 0x4cu, 0xecu },
+};
+
+static inline bool
+a04s_supply_write_allowed(uint32_t bus, uint32_t reg, uint32_t value)
+{
+	for (unsigned i = 0; i < 2; i++) {
+		if (a04s_acpm_supply[i][0] == bus && a04s_acpm_supply[i][1] == reg && a04s_acpm_supply[i][2] == value) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Both entries allowed; their neighbours, other values and other pages refused. */
+static inline bool
+a04s_supply_guard_self_test(void)
+{
+	return a04s_supply_write_allowed(0x01, 0x4b, 0xec) && a04s_supply_write_allowed(0x01, 0x4c, 0xec) &&
+	       !a04s_supply_write_allowed(0x01, 0x4b, 0x2c) && !a04s_supply_write_allowed(0x01, 0x4b, 0xed) &&
+	       !a04s_supply_write_allowed(0x01, 0x4c, 0xff) && !a04s_supply_write_allowed(0x01, 0x4a, 0xec) &&
+	       !a04s_supply_write_allowed(0x01, 0x4d, 0xec) && !a04s_supply_write_allowed(0x00, 0x4b, 0xec) &&
+	       !a04s_supply_write_allowed(0x07, 0x34, 0xec);
+}
+
+#endif /* A04S_ACPM_GUARD_H */
diff --git a/bsd/dev/a04s_audclk.c b/bsd/dev/a04s_audclk.c
new file mode 100644
index 0000000..41a3b18
--- /dev/null
+++ b/bsd/dev/a04s_audclk.c
@@ -0,0 +1,346 @@
+/*
+ * Galaxy A04s, audio route A2 (v54): the AUD3004X codec's master clock.
+ *
+ * The codec's digital block stored nothing written to it (v18's AD_VOLL test): it gets no master
+ * clock. In Samsung's clock tree for the Exynos 850 (drivers/soc/samsung/cal-if/exynos3830,
+ * cmucal-node.c) that clock is PLL_AUD -> DIV_CLK_AUD_AUDIF (CMU_AUD+0x1804) -> CLK_AUD_MCLK
+ * (+0x1800) -> the gate GOUT_BLK_AUD_UID_DFTMUX_AUD_IPCLKPORT_AUD_CODEC_MCLK (+0x206c). ABOX itself
+ * is not on that path, so none of ABOX's registers are touched. pd-aud is already on at boot (v33:
+ * "AUD PD 1 1 ON", PLL_AUD a0770300 enabled and locked), so no power-domain SMC is needed.
+ *
+ * With boot-arg a04saudclk=1, and only when pd-aud is on and PLL_AUD is enabled and locked:
+ *   1. ABOX's pads leave retention: PMU+0x20a0 bit 11 (abox.c ABOX_PAD_NORMAL for EXYNOS3830, as
+ *      abox_pad_retention(false) sets it);
+ *   2. the codec's clock is let through its gate as ra.c's ra_set_gate() does: with MANUAL (bit 20)
+ *      set, CG_VAL (bit 21) = 1; without it, ENABLE_AUTOMATIC_CLKGATING (bit 28) = 0.
+ * Those are the only register writes in this file, in pad_normal() and codec_mclk_on();
+ * tools/check_audclk_source.py refuses any other. Dividers, muxes and the PLL are only read; the
+ * PMIC is never reached from here (the codec's supplies are on ACPM, read-only, a04s_acpm.c).
+ * The codec write test (a04s_acpm_codec_retest(): AD_VOLL written, read back, restored) runs before
+ * and after. It runs from a04s_input_start() before the key thread starts, so nothing else uses
+ * ACPM meanwhile. The heartbeat line is "AUD CLK".
+ *
+ * v55: A2 found the clock and pads already on, and the codec's supplies off (LDO33/LDO34 enable
+ * bits 00). With boot-arg a04scodecpwr=1 (the owner's decision, 2026-11-07),
+ * a04s_acpm_codec_supplies_on() switches them on as Android's s2mpu12 driver does, then the write
+ * test runs again 5 ms later. The PMIC write itself lives in a04s_acpm.c, behind its own guard.
+ *
+ * v56: v55 switched the supplies on (read back 0xEC 0xEC) and the codec still stored nothing. Android
+ * does two more things first (aud3004x.c, abox.c): it waits AUD3004X_PDB_CLK_MSEC (20 ms) before
+ * the first codec access, and aud3004x_enable() calls abox_enable_mclk(true), which sets
+ * ABOX_QCHANNEL_DISABLE (ABOX SFR 0x14a50000 + 0x38) bit 2, ABOX_BCLK_UAIF0, so the codec's bit
+ * clock isn't Q-channel gated. Now the wait is 20 ms, then a04s_acpm_codec_snapshot() reads the
+ * codec again (reads only). With boot-arg a04sabox=1, abox_mclk_on() sets that one bit: the third
+ * and last register write in this file, and only when ABOX's bus clock gate (CMU_AUD+0x2048) isn't
+ * forced off, so the access can't stall the bus. The codec write test runs again 20 ms later.
+ * Heartbeat lines "AUD SNAP" and "AUD ABOX".
+ *
+ * v57: v56 found the codec powered and answering reads (DCTR_CM 0x02, its default) with RESETB0
+ * 0x00: core, ADC and DAC held in reset, so the AD_VOLL test can't pass. With the boot-arg
+ * "a04scodecrdy" set to 1, a04s_acpm_codec_capture_ready() does what Android does before capture: the
+ * codec's own ADC clocks on, its core and ADC out of reset, with a write test on IF_FORM1 before and
+ * on AD_VOLL after. Codec registers only, through a04s_acpm.c's allow-list; nothing here writes.
+ * Heartbeat line "AUD READY".
+ *
+ * v58: v57's writes were all accepted and none kept, and only DCTR_CM has ever read non-zero. With
+ * the boot-arg "a04scodecdump" set to 1, codec_dump() reads the codec's digital (0x07) and analog
+ * (0x08) pages, the registers aud3004x.c marks readable, before and after the supplies come on,
+ * plus the PMIC's LDO controls (0x01, 0x40-0x4F) as a control. Reads only. The first two
+ * heartbeats print it as "AUD DUMP" lines; 0xEE marks a register not read.
+ *
+ * v59: v58's dump showed the codec answering (IRQ masks 0xFF, its ACTR block 0xC0-0xFC set) and
+ * its digital core 0x10-0xBF all zero. With the boot-arg "a04scodecclk" set to 1, right after the
+ * supplies come on, a04s_acpm_codec_clk_pulse() does register_initialize()'s first step: DCTR_CM
+ * bit 0 (PDB_JD_CLK_EN) cleared, 20 ms, set, 20 ms. The AFTER dump and the v57 tests then show
+ * whether the core came alive. Heartbeat line "AUD CLKEN".
+ */
+#if defined(ARM64_BOARD_CONFIG_A04S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern int a04s_acpm_codec_retest(void);        /* a04s_acpm.c */
+extern int a04s_acpm_codec_supplies_on(uint8_t before[2], uint8_t after[2]);   /* a04s_acpm.c, v55 */
+extern int a04s_acpm_codec_snapshot(uint8_t out[12]);                           /* a04s_acpm.c, v56 */
+extern int a04s_acpm_codec_capture_ready(uint8_t regs[6], int *test_if, int *test_adc);  /* v57 */
+extern int a04s_acpm_read_range(uint32_t bus_addr, uint32_t lo, uint32_t hi, uint8_t out[256]);  /* v58 */
+extern int a04s_acpm_codec_clk_pulse(uint8_t d0[3]);                            /* a04s_acpm.c, v59 */
+static int clken_rc = -1;
+static uint8_t clken_d0[3];
+
+#define PMU_PA                  0x11860000u
+#define PMU_PD_AUD_STATUS       0x2084u
+#define PMU_ABOX_PAD            0x20a0u         /* ABOX_PAD_NORMAL, CONFIG_SOC_EXYNOS3830 */
+#define ABOX_PAD_NORMAL_BIT     11u
+#define CMU_AUD_PA              0x14a00000u
+#define AUD_PLL_CON3            0x010cu
+#define AUD_DIV_MCLK            0x1800u         /* CLK_CON_DIV_CLK_AUD_MCLK, ratio bits 1:0 */
+#define AUD_DIV_AUDIF           0x1804u         /* CLK_CON_DIV_DIV_CLK_AUD_AUDIF, ratio bits 8:0 */
+#define AUD_GATE_CODEC_MCLK     0x206cu
+#define GATE_AUTO_BIT           28u             /* ENABLE_AUTOMATIC_CLKGATING */
+#define GATE_CG_VAL_BIT         21u
+#define GATE_MANUAL_BIT         20u
+#define PLL_ENABLE              (1u << 31)
+#define PLL_STABLE              (1u << 29)
+#define AUD_GATE_BCLK_UAIF0     0x2004u         /* CLK_BLK_AUD_UID_ABOX_IPCLKPORT_BCLK_UAIF0, read only */
+#define AUD_GATE_ABOX_ACLK      0x2048u         /* GOUT_BLK_AUD_UID_ABOX_IPCLKPORT_ACLK, read only */
+#define AUD_QCH_ABOX_ACLK       0x3010u         /* QCH_CON_ABOX_QCH_ACLK, read only */
+#define AUD_QCH_ABOX_BCLK0      0x3014u         /* QCH_CON_ABOX_QCH_BCLK0, read only */
+#define ABOX_SFR_PA             0x14a50000u     /* abox@14a50000 "sfr", exynos3830.dts */
+#define ABOX_QCHANNEL_DISABLE   0x0038u         /* abox_soc_2.h */
+#define QCH_BCLK_UAIF0_BIT      2u              /* abox.h enum qchannel: ABOX_BCLK_UAIF0 */
+#define CODEC_SETTLE_US         20000u          /* aud3004x.h AUD3004X_PDB_CLK_MSEC */
+
+static struct {
+	const char *state;
+	uint32_t pd, pll, div_audif, div_mclk;
+	uint32_t pad_before, pad_after, gate_before, gate_after;
+	int test_before, test_after;
+	int supply_rc;
+	uint8_t supply_before[2], supply_after[2];
+	int snap_rc;
+	uint8_t snap[12];
+	const char *abox;
+	uint32_t aclk, uaif0, qch_aclk, qch_bclk0, qdis_before, qdis_after;
+	int test_abox;
+	const char *ready_state;
+	int ready_rc, test_if, test_adc;
+	uint8_t ready[6];
+} aud = { .state = "NOT RUN", .test_before = -1, .test_after = -1, .supply_rc = -1, .snap_rc = -1,
+	    .abox = "NOT RUN", .test_abox = -1, .ready_state = "NOT RUN", .ready_rc = -1, .test_if = -1,
+	    .test_adc = -1 };
+
+static inline uint32_t
+aud_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+/* Write 1 of 2: ABOX's pads out of retention. */
+static void __attribute__((noinline))
+pad_normal(vm_offset_t pmu)
+{
+	volatile uint32_t *r = (volatile uint32_t *)(pmu + PMU_ABOX_PAD);
+	*r = *r | (1u << ABOX_PAD_NORMAL_BIT);
+}
+
+/* Write 2 of 2: the codec's clock through its gate, as ra_set_gate(clk, 1). */
+static void __attribute__((noinline))
+codec_mclk_on(vm_offset_t cmu)
+{
+	volatile uint32_t *r = (volatile uint32_t *)(cmu + AUD_GATE_CODEC_MCLK);
+	uint32_t v = *r;
+	if (v & (1u << GATE_MANUAL_BIT)) {
+		*r = v | (1u << GATE_CG_VAL_BIT);
+	} else {
+		*r = v & ~(1u << GATE_AUTO_BIT);
+	}
+}
+
+/* Write 3 of 3 (v56): ABOX's UAIF0 bit clock out of Q-channel gating, as abox_enable_mclk(true). */
+static void __attribute__((noinline))
+abox_mclk_on(vm_offset_t abox)
+{
+	volatile uint32_t *r = (volatile uint32_t *)(abox + ABOX_QCHANNEL_DISABLE);
+	*r = *r | (1u << QCH_BCLK_UAIF0_BIT);
+}
+
+/* v56: the ABOX clock gates, read; with a04sabox=1 the UAIF0 bit clock on, then the write test. */
+static void
+abox_step(vm_offset_t cmu)
+{
+	aud.aclk = aud_rd(cmu, AUD_GATE_ABOX_ACLK);
+	aud.uaif0 = aud_rd(cmu, AUD_GATE_BCLK_UAIF0);
+	aud.qch_aclk = aud_rd(cmu, AUD_QCH_ABOX_ACLK);
+	aud.qch_bclk0 = aud_rd(cmu, AUD_QCH_ABOX_BCLK0);
+	int want = 0;
+	(void)PE_parse_boot_argn("a04sabox", &want, sizeof(want));
+	if (want != 1) {
+		aud.abox = "READ ONLY";
+		return;
+	}
+	if ((aud.aclk & (1u << GATE_MANUAL_BIT)) && !(aud.aclk & (1u << GATE_CG_VAL_BIT))) {
+		aud.abox = "ACLK OFF";          /* ABOX's registers wouldn't answer: not touched */
+		return;
+	}
+	vm_offset_t abox = ml_io_map(ABOX_SFR_PA, 0x1000);
+	if (!abox) {
+		aud.abox = "NO MAP";
+		return;
+	}
+	aud.qdis_before = aud.qdis_after = aud_rd(abox, ABOX_QCHANNEL_DISABLE);
+	abox_mclk_on(abox);
+	aud.qdis_after = aud_rd(abox, ABOX_QCHANNEL_DISABLE);
+	delay(CODEC_SETTLE_US);
+	aud.test_abox = a04s_acpm_codec_retest();
+	aud.abox = aud.test_abox == 0 ? "CODEC ANSWERS" : "BCLK ON, CODEC SILENT";
+}
+
+/* v57: with a04scodecrdy=1, the codec made ready to capture as Android does (a04s_acpm.c). */
+static void
+codec_step(void)
+{
+	int want = 0;
+	(void)PE_parse_boot_argn("a04scodecrdy", &want, sizeof(want));
+	if (want != 1) {
+		aud.ready_state = "READ ONLY";
+		return;
+	}
+	aud.ready_rc = a04s_acpm_codec_capture_ready(aud.ready, &aud.test_if, &aud.test_adc);
+	aud.ready_state = aud.ready_rc ? "FAILED" : aud.test_adc == 0 ? "CODEC ANSWERS" :
+	    aud.test_if == 0 ? "IF STORES, ADC SILENT" : "CODEC SILENT";
+}
+
+/* v58: the readable ranges of aud3004x.c's digital and analog regmaps, and the PMIC control. */
+static const struct {
+	uint8_t bus, lo, hi, page;
+} dump_ranges[] = {
+	{ 0x07, 0x08, 0x29, 0 }, { 0x07, 0x2F, 0x4E, 0 }, { 0x07, 0x50, 0x86, 0 }, { 0x07, 0x88, 0x8E, 0 },
+	{ 0x07, 0x90, 0x9E, 0 }, { 0x07, 0xA0, 0xFC, 0 },
+	{ 0x08, 0x00, 0x1F, 1 }, { 0x08, 0x30, 0x38, 1 }, { 0x08, 0x50, 0x62, 1 }, { 0x08, 0x70, 0x8C, 1 },
+	{ 0x08, 0x90, 0xA3, 1 },
+	{ 0x01, 0x40, 0x4F, 2 },
+};
+static const uint8_t dump_bus[3] = { 0x07, 0x08, 0x01 };
+static uint8_t dump[2][3][256];
+static int dump_rc[2] = { -1, -1 };
+
+static void
+codec_dump(int which)
+{
+	for (unsigned p = 0; p < 3; p++) {
+		for (unsigned i = 0; i < 256; i++) {
+			dump[which][p][i] = 0xEE;
+		}
+	}
+	dump_rc[which] = 0;
+	for (unsigned i = 0; i < sizeof(dump_ranges) / sizeof(dump_ranges[0]); i++) {
+		int rc = a04s_acpm_read_range(dump_ranges[i].bus, dump_ranges[i].lo, dump_ranges[i].hi,
+		    dump[which][dump_ranges[i].page]);
+		if (rc) {
+			dump_rc[which] = rc;
+			return;
+		}
+	}
+}
+
+void a04s_audclk_start(void);
+void
+a04s_audclk_start(void)
+{
+	vm_offset_t pmu = ml_io_map(PMU_PA, 0x4000);
+	if (!pmu) {
+		aud.state = "NO PMU";
+		return;
+	}
+	aud.pd = aud_rd(pmu, PMU_PD_AUD_STATUS);
+	aud.pad_before = aud.pad_after = aud_rd(pmu, PMU_ABOX_PAD);
+	if (!(aud.pd & 1u)) {
+		aud.state = "PD OFF";           /* CMU_AUD can't be read while pd-aud is off */
+		return;
+	}
+	vm_offset_t cmu = ml_io_map(CMU_AUD_PA, 0x4000);
+	if (!cmu) {
+		aud.state = "NO CMU";
+		return;
+	}
+	aud.pll = aud_rd(cmu, AUD_PLL_CON3);
+	aud.div_audif = aud_rd(cmu, AUD_DIV_AUDIF);
+	aud.div_mclk = aud_rd(cmu, AUD_DIV_MCLK);
+	aud.gate_before = aud.gate_after = aud_rd(cmu, AUD_GATE_CODEC_MCLK);
+	aud.test_before = a04s_acpm_codec_retest();
+	int power = 0;
+	(void)PE_parse_boot_argn("a04scodecpwr", &power, sizeof(power));
+	int want_dump = 0;
+	(void)PE_parse_boot_argn("a04scodecdump", &want_dump, sizeof(want_dump));
+	if (want_dump == 1) {
+		codec_dump(0);
+	}
+	if (power == 1) {
+		aud.supply_rc = a04s_acpm_codec_supplies_on(aud.supply_before, aud.supply_after);
+		delay(CODEC_SETTLE_US);        /* v56: Android's 20 ms before the first codec access (v55: 5 ms) */
+		int want_clk = 0;
+		(void)PE_parse_boot_argn("a04scodecclk", &want_clk, sizeof(want_clk));
+		if (want_clk == 1) {
+			clken_rc = a04s_acpm_codec_clk_pulse(clken_d0);     /* v59 */
+		}
+		aud.snap_rc = a04s_acpm_codec_snapshot(aud.snap);
+		if (want_dump == 1) {
+			codec_dump(1);
+		}
+		aud.test_after = a04s_acpm_codec_retest();
+		aud.state = aud.supply_rc ? "SUPPLIES REFUSED" : aud.test_after == 0 ? "SUPPLIES ON, CODEC ANSWERS" :
+		    "SUPPLIES ON, CODEC SILENT";
+	}
+	abox_step(cmu);
+	codec_step();
+	int want = 0;
+	(void)PE_parse_boot_argn("a04saudclk", &want, sizeof(want));
+	if (want != 1) {
+		if (power != 1) {
+			aud.state = "READ ONLY";
+		}
+		return;
+	}
+	if ((aud.pll & (PLL_ENABLE | PLL_STABLE)) != (PLL_ENABLE | PLL_STABLE)) {
+		aud.state = "PLL NOT LOCKED";
+		return;
+	}
+	pad_normal(pmu);
+	codec_mclk_on(cmu);
+	aud.pad_after = aud_rd(pmu, PMU_ABOX_PAD);
+	aud.gate_after = aud_rd(cmu, AUD_GATE_CODEC_MCLK);
+	delay(1000);                            /* let the codec see a few thousand clock edges */
+	aud.test_after = a04s_acpm_codec_retest();
+	aud.state = aud.test_after == 0 ? "CODEC ANSWERS" : "CLOCK ON, CODEC SILENT";
+}
+
+void a04s_audclk_report(void);
+void
+a04s_audclk_report(void)
+{
+	kprintf("AUD CLK %s PD %x PLL %08x AUDIF %x MCLKDIV %x PAD %x>%x GATE %x>%x TEST %d>%d "
+	    "SUPPLY %d %02x %02x>%02x %02x\n",
+	    aud.state, aud.pd, aud.pll, aud.div_audif, aud.div_mclk, aud.pad_before, aud.pad_after,
+	    aud.gate_before, aud.gate_after, aud.test_before, aud.test_after, aud.supply_rc,
+	    aud.supply_before[0], aud.supply_before[1], aud.supply_after[0], aud.supply_after[1]);
+	kprintf("AUD SNAP %d LDO %02x %02x OTP %02x %02x %02x %02x RESETB0 %02x DCTR %02x REGS %02x %02x %02x %02x\n",
+	    aud.snap_rc, aud.snap[0], aud.snap[1], aud.snap[2], aud.snap[3], aud.snap[4], aud.snap[5],
+	    aud.snap[6], aud.snap[7], aud.snap[8], aud.snap[9], aud.snap[10], aud.snap[11]);
+	kprintf("AUD ABOX %s ACLK %x UAIF0 %x QCH %x %x QDIS %x>%x TEST %d\n", aud.abox, aud.aclk, aud.uaif0,
+	    aud.qch_aclk, aud.qch_bclk0, aud.qdis_before, aud.qdis_after, aud.test_abox);
+	kprintf("AUD READY %s rc %d IF %d CLKGATE0 %02x>%02x CLKGATE2 %02x>%02x RESETB0 %02x>%02x ADC %d\n",
+	    aud.ready_state, aud.ready_rc, aud.test_if, aud.ready[0], aud.ready[1], aud.ready[2], aud.ready[3],
+	    aud.ready[4], aud.ready[5], aud.test_adc);
+	kprintf("AUD CLKEN rc %d D0 %02x>%02x>%02x\n", clken_rc, clken_d0[0], clken_d0[1], clken_d0[2]);
+	static int dumps_printed;
+	if (dumps_printed >= 2 || dump_rc[0] < 0) {
+		return;
+	}
+	dumps_printed++;
+	for (int w = 0; w < 2; w++) {
+		kprintf("AUD DUMP %s rc %d\n", w ? "AFTER" : "BEFORE", dump_rc[w]);
+		if (dump_rc[w] < 0) {
+			continue;                     /* not taken (no supply switch-on this boot) */
+		}
+		for (unsigned p = 0; p < 3; p++) {
+			for (unsigned row = 0; row < 256; row += 16) {
+				const uint8_t *b = &dump[w][p][row];
+				bool any = false;
+				for (unsigned i = 0; i < 16; i++) {
+					any = any || b[i] != 0xEE;
+				}
+				if (any) {
+					kprintf("AUD DUMP %c %02x %02x: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x "
+					    "%02x %02x %02x %02x\n", w ? 'A' : 'B', dump_bus[p], row, b[0], b[1], b[2], b[3], b[4], b[5],
+					    b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+				}
+			}
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
diff --git a/bsd/dev/a04s_emmc_guard.h b/bsd/dev/a04s_emmc_guard.h
new file mode 100644
index 0000000..61653da
--- /dev/null
+++ b/bsd/dev/a04s_emmc_guard.h
@@ -0,0 +1,40 @@
+/*
+ * Galaxy A04s: the only eMMC sectors a kernel may ever write. The IMEI and key partitions
+ * all sit below userdata, and the card's own write protection does not cover efs.
+ * The caller provides uint64_t and bool.
+ */
+#ifndef A04S_EMMC_GUARD_H
+#define A04S_EMMC_GUARD_H
+
+#define A04S_USERDATA_FIRST   16599040ull
+#define A04S_USERDATA_SECTORS 227672064ull
+
+static inline bool
+a04s_write_allowed(uint64_t lba, uint64_t sectors)
+{
+	uint64_t end = A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS;
+	return sectors != 0 && lba >= A04S_USERDATA_FIRST && lba < end && sectors <= end - lba;
+}
+
+/* efs, sec_efs, cpefs, keystorage, keyrefuge and keydata, as this phone's table has them. */
+static inline bool
+a04s_guard_self_test(void)
+{
+	static const uint64_t protected_ranges[][2] = {
+		{ 8192, 40960 }, { 49152, 40960 }, { 98304, 16384 },
+		{ 245760, 1024 }, { 619520, 32768 }, { 652288, 32768 },
+	};
+	for (unsigned i = 0; i < sizeof(protected_ranges) / sizeof(protected_ranges[0]); i++) {
+		uint64_t first = protected_ranges[i][0], count = protected_ranges[i][1];
+		if (a04s_write_allowed(first, 1) || a04s_write_allowed(first + count - 1, 1) ||
+		    a04s_write_allowed(first, count)) {
+			return false;
+		}
+	}
+	return !a04s_write_allowed(A04S_USERDATA_FIRST - 1, 1) &&
+	       a04s_write_allowed(A04S_USERDATA_FIRST, 1) &&
+	       a04s_write_allowed(A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS - 1, 1) &&
+	       !a04s_write_allowed(A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS, 1);
+}
+
+#endif /* A04S_EMMC_GUARD_H */
diff --git a/bsd/dev/a04s_gpu.c b/bsd/dev/a04s_gpu.c
new file mode 100644
index 0000000..ba423df
--- /dev/null
+++ b/bsd/dev/a04s_gpu.c
@@ -0,0 +1,3400 @@
+/*
+ * Galaxy A04s, stage 7c-3: the temperatures that will limit the GPU, and the Mali-G52's first job.
+ *
+ * Always, reads only (on the heartbeat):
+ *  - The TMU at 0x10070000 (exynos3830-tmu in the live device tree; register map from Samsung's
+ *    exynos_tmu_v2.c, EXYNOS9810/3830 block). LITTLE0 is sensor 1, LITTLE1 sensor 2, G3D sensor 3.
+ *    Each sensor's factory trim is TRIMINFO(n) at 4 * n (error1 bits 0-8, error2 bits 9-17), the
+ *    calibration type is TRIMINFO(0) bit 23, and the current codes are packed 9 bits apart from
+ *    CURRENT_TEMP1_0 (0x40: sensors 0, 1) and CURRENT_TEMP4_2 (0x44: sensors 2, 3, 4). One-point
+ *    trimming: temp = code - error1 + 25 (the DT's first_point_trim). Samsung's 850 kernel asks the
+ *    ACPM firmware for the temperature instead, so the raw registers are printed too: if the
+ *    packing is wrong, the codes show it. Read only behind CMU_PERI's BUSIF_TMU gate.
+ *  - PLL_G3D and the G3D muxes and dividers (cmucal-sfr.c), only if a04s_input.c's 7c-2 checks
+ *    passed (pd-g3d on, every gate on the way running, no Q-channel able to stop the clock).
+ *
+ * With the boot-arg a04sgpu=1 only, once, at root mount:
+ *  - It stops unless the 7c-2 checks passed, the ID is a Mali-G52 (0x7212), the GPU's data path to
+ *    DRAM is clocked (CMU_G3D LHS_AXI_D, CMU_CORE LHM_AXI_D_G3D), and the G3D sensor reads 5-75 C.
+ *  - GPU interrupts stay masked (everything is polled, and every poll is bounded). Soft reset, then
+ *    L2, shader core 0 and the tiler are powered, as Panfrost does. The clock and voltage stay as
+ *    S-Boot left them; the GPU's cycle counter measures the clock over 20 ms.
+ *  - One address space in Mali-LPAE (legacy) mode, as Panfrost runs Bifrost: TRANSTAB = tables | 7,
+ *    MEMATTR 0x888d88, TRANSCFG 0. The page tables map only GPU_DATA_PAGES pages of a private 64 KiB
+ *    block at 0xbc000000: above XNU's RAM (dram-base 0x92000000 + 0x2a000000), below the end of the
+ *    first RAM window (0xbc900000), which Android uses as plain RAM. The GPU can reach no other
+ *    memory, so nothing it does can touch XNU, the eMMC driver's buffers or any partition.
+ *  - One WRITE_VALUE job (type ZERO) on JS1, the S7's first job (herolte_gpu.c, Panfrost v7 layout:
+ *    the job header and Write Value payload are the same as Midgard's). Pass: the job completes
+ *    with no MMU or GPU fault and the 64-bit output, preset to a pattern, reads 0.
+ *  - 7c-4a (v37; a04sfrag=0 skips it): after that job, one FRAGMENT job on JS0 clears a 64x64
+ *    RGBA8 render target in the same private pages, and every pixel is read back. Bifrost (v7)
+ *    layout from Mesa 25.0.7 (genxml/v7.xml, pan_desc.c, pan_samples.c, pan_jm.c): the fragment
+ *    payload has the bounds in 16x16 tiles and the framebuffer pointer tagged MFBD with one render
+ *    target; the framebuffer is Parameters (64 B: sample locations, size, bounds, tile size,
+ *    allocation, Z format, tiler) and 64 B of padding, then the 64 B render target. A clear-only
+ *    batch has no tiler context in Panfrost (tiler pointer 0), and the sample-locations table is
+ *    Mesa's single-sampled entry (one sample and the origin at 128,128 in 1/256 pixel). Pass: done
+ *    with no fault, and 4096 of 4096 pixels hold the clear colour. Passed on the phone (v37).
+ *  - 7c-4b (v38; a04spanel=0 skips it): the same clear on the panel. S-Boot's scan-out buffer
+ *    (bootloader_fb: 720x1600 XRGB8888 at 0xfa000000, 0xd00000 bytes reserved) is mapped into the
+ *    GPU as three 2 MiB blocks (Mali-LPAE leaves are type 1 at every level, as Panfrost's
+ *    io-pgtable writes them), from the board's A5XELTE_FB_* values (pexpert/arm64/A5XELTE.h), the
+ *    ones SweetFramebuffer scans out of. The boot leaves PE_current_console empty on this phone
+ *    (v38 read 0), as on the A5. The panel is
+ *    cleared green for PANEL_HOLD_MS, with SweetFramebuffer's copies held off meanwhile
+ *    (sweet_fb_hold_until, as on the S7), and every pixel is read back through an uncached mapping.
+ *    That 6 MiB of display memory is the only memory outside the private block the GPU can reach.
+ *    Passed on the phone (v39): 1152000 of 1152000 pixels in 1.6 ms.
+ *  - 7c-4c (v40; a04sshader=0 skips it): the first shader. Mesa 25.0.7 compiled "gradient" for GPU
+ *    0x7212 offline (gpu/a04s/shaderc, CI run 42016363899, gradient.bin SHA-256 4f19e7a9...4abe,
+ *    checked against the bytes below when they were copied in):
+ *    colour = (x / 720, y / 1600, 0.5, 1) from the preloaded pixel position. It runs as the panel's
+ *    pre-frame shader (Framebuffer Parameters: Pre Frame 0 = ALWAYS, Frame Shader DCDs), as
+ *    Panfrost's preload does on v7 (pan_fb_preload.c): a Draw with the renderer state, a viewport,
+ *    a thread storage descriptor and a full-panel rectangle; the renderer state with the shader,
+ *    32 registers a thread, the fragment-position and coverage preloads, early pixel kill; one
+ *    fixed-function blend for render target 0 (opaque, source only, RGBA8_TB memory format, F32
+ *    registers). The tiles are cleared black first. Every pixel is checked against the expected
+ *    gradient, 2 steps either way per channel. Passed on the phone (v40): 1152000 of 1152000.
+ *  - 7c-4d (v41; a04sblit=0 skips it): the scaler. Mesa's "blit" shader (gradient's CI run,
+ *    blit.bin SHA-256 295d8314...4a79) is Panfrost's 2D preload: the compiler moved its texture
+ *    fetch into the hardware's message preload (VAR_TEX, varying 0, texture 0, LOD 0), so the renderer
+ *    state carries that descriptor and the code is one BLEND. The Draw adds a texture (v7 Texture
+ *    and Surface With Stride: 2D, linear, B8G8R8A8 = RGBA8_UNORM with BGRA order), a bilinear
+ *    sampler with unnormalised coordinates and clamp to edge, and varying 0: an R32G32B32 float
+ *    attribute over a 4-vertex buffer of source coordinates (plus the empty buffer Bifrost needs to
+ *    end prefetching), as pan_fb_preload.c does, except that the varying holds the source corners
+ *    while the position holds the panel's, so the GPU scales. The render target swaps R and B
+ *    (swizzle B, G, R, A) so the BGRA source lands as BGRA on the panel.
+ *    Boot test: a 64x64 four-colour image in the private pages, scaled to the whole panel, each
+ *    quadrant's inner part checked. Then, with sweetfb_gpu=1, SweetFramebuffer gives full-screen iOS
+ *    frames to a04s_gpu_present_*: the surface's pages are mapped into one of two 8 MiB GPU slots
+ *    (level-3 tables in the private block's second 64 KiB), the frame is scaled to the panel, and
+ *    any fault turns the GPU path off for the rest of the boot, so the CPU copy takes over.
+ *    v41 on the phone: the blit job completed with no fault but left every pixel at the clear
+ *    colour. The compiler's info (shaderc, CI run 42033097275) has wait_6 = wait_7 = 1 for both
+ *    shaders, which pan_shader_prepare_bifrost_rsd() copies into Renderer Properties bits 30-31;
+ *    v41 left them 0. v42 sets them, clears under the blit in magenta (so "did not run" and "sampled
+ *    black" differ), and runs the test in five variants (as above; nearest filtering; RGBA order;
+ *    normalised coordinates; the gradient's code in the blit's Draw), printing each one's samples.
+ *    The first variant whose four quadrants all match is used for the full check and the live path.
+ *  - The cores are powered off again. iOS keeps drawing on the CPU.
+ */
+#if defined(ARM64_BOARD_CONFIG_A04S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+#include <kern/sched_prim.h>
+#include <sys/errno.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void IOSleep(unsigned int milliseconds);
+extern bool a04s_gpu_path_ok(void);
+extern int a04s_batt_temp_dc(void);        /* bsd/dev/a04s_power.c: thermistor, else gauge */
+extern void a04s_adc_sample(void);
+
+/*
+ * Thermal monitor (a04sthermal, on unless it is 0): the three TMU sensors once a second. Readings
+ * count only after THERM_TRUST_READS in a row are sane (all three 10-80 C, within 25 C of each
+ * other), so a wrong decoding can't drive anything. Levels by the hottest sensor: NORMAL, WARM from
+ * 65 C, HOT from 80 C, CRITICAL from 95 C. GPU work runs only at NORMAL with trusted readings, and
+ * every level change and a battery at 50 C or more gets a line. A battery at 50 C or more also
+ * counts as HOT, so GPU work stops, until it is below 47 C (v43: the thermistor on the SoC's ADC
+ * once its readings are trusted, else the gauge). Nothing here changes a clock or a
+ * voltage: the CPU clusters' PLLs are read for the report only, and the CPUs stay at S-Boot's
+ * clock. The TMU's own trip (115 C in the device tree, if S-Boot armed it: CTL bit 12) is what
+ * protects the chip past that.
+ */
+#define THERM_WARM              65
+#define THERM_HOT               80
+#define THERM_CRITICAL          95
+#define THERM_TRUST_READS       3
+#define BATT_HOT_DC             500
+#define CMU_CPUCL0_PA           0x10900000u
+#define CMU_CPUCL1_PA           0x10800000u
+#define CPU_PLL_CON3            0x10cu
+#define CPUCL0_MUX_PLL          0x100cu
+#define CPUCL1_MUX_PLL          0x1000u
+enum { LEVEL_OFF, LEVEL_UNTRUSTED, LEVEL_NORMAL, LEVEL_WARM, LEVEL_HOT, LEVEL_CRITICAL };
+static const char *const level_names[] = { "OFF", "UNTRUSTED", "NORMAL", "WARM", "HOT", "CRITICAL" };
+
+#define GATE_MANUAL             (1u << 20)
+#define GATE_CG_VAL             (1u << 21)
+#define GATE_AUTO               (1u << 28)
+#define QCH_ENABLE              (1u << 0)
+#define QCH_CLOCK_REQ           (1u << 1)
+
+/* TMU and its bus clock (CMU_PERI). */
+#define CMU_PERI_PA             0x10030000u
