+/*
+ * v64: BOs live on the heap with a count: the client's handle holds one, and each queued job that
+ * lists the BO holds one until it ends, so a BO a job still uses stays GPU-mapped after FreeBO or the
+ * client's exit. The last reference unmaps and frees it (from the scheduler thread, no lock held).
+ */
+static struct herogpu_bo *
+herogpu_bo_new(void)
+{
+	struct herogpu_bo *bo = IOMallocType(struct herogpu_bo);
+	if (bo != NULL) {
+		bzero(bo, sizeof(*bo));
+		bo->refs = 1;
+	}
+	return bo;
+}
+
+static void
+herogpu_bo_put(struct herogpu_bo *bo)
+{
+	if (bo != NULL && __atomic_sub_fetch(&bo->refs, 1u, __ATOMIC_ACQ_REL) == 0) {
+		herogpu_bo_free(bo);
+		IOFreeType(bo, struct herogpu_bo);
+	}
+}
+
+#if defined(ARM64_BOARD_CONFIG_A04S)
+/*
+ * v64 (7c-7a): the Panfrost-shaped selectors on top of a04s_gpu.c's scheduler (port/7c-7-design.md).
+ * Structure inputs are the Linux structs of Mesa 25.0.7's panfrost_drm.h and drm.h with their arrays
+ * inline after the header, in this order; no pointer field is followed, and the size must be exact.
+ * Over 4096 bytes IOKit passes the input as a descriptor, which is read the same way. Outputs are
+ * scalars. Timeouts are RELATIVE nanoseconds (INT64_MAX forever, 0 a single look).
+ *
+ *    8 PanSubmit      drm_panfrost_submit + u32 bo_handles[] + u32 in_syncs[]   queues, returns at once
+ *    9 PanWaitBO      drm_panfrost_wait_bo                      kIOReturnTimeout if not idle in time
+ *   10 PanMadvise     drm_panfrost_madvise                      -> [retained = 1]
+ *   11 SyncobjCreate  drm_syncobj_create (flags: SIGNALED)      -> [handle]
+ *   12 SyncobjDestroy drm_syncobj_destroy
+ *   13 SyncobjWait    drm_syncobj_wait + u32 handles[]          -> [first_signaled]
+ *   14 SyncobjReset   drm_syncobj_array + u32 handles[]
+ *   15 SyncobjSignal  drm_syncobj_array + u32 handles[]
+ *
+ * A submit holds every BO it lists until the job ends, and also waits for the previous job that listed
+ * any of them (Linux panfrost's implicit sync, every BO a writer); WAIT_BO waits for that last job.
+ * PANFROST_JD_REQ_FS picks JS0, else JS1. A syncobj with no fence: as an in_sync it is ignored; a wait
+ * on it fails unless WAIT_FOR_SUBMIT (or WAIT_AVAILABLE), which waits for a submit to give it one.
+ * At most 4096 BOs and 32 in_syncs a submit, 4096 syncobjs a client; larger calls are refused, never
+ * cut. a04sgpu_sched=0 refuses 8-15.
+ */
+#define HEROGPU_MAX_SUBMIT_BOS  4096u          /* v65: was 1024 */
+#define HEROGPU_MAX_IN_SYNCS    32u
+#define HEROGPU_MAX_SYNCOBJS    4096u
+#define HEROGPU_MAX_STRUCT      (64u * 1024u)
+#define HEROGPU_REQ_FS          (1u << 0)       /* PANFROST_JD_REQ_FS */
+#define HEROGPU_SYNC_SIGNALED   (1u << 0)       /* DRM_SYNCOBJ_CREATE_SIGNALED */
+#define HEROGPU_WAIT_ALL        (1u << 0)       /* DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL */
+#define HEROGPU_WAIT_FOR_SUBMIT (1u << 1)       /* ..._WAIT_FOR_SUBMIT */
+#define HEROGPU_WAIT_AVAILABLE  (1u << 2)       /* ..._WAIT_AVAILABLE */
+#define HEROGPU_WAIT_DEADLINE   (1u << 3)       /* ..._WAIT_DEADLINE: a hint, ignored */
+#define HEROGPU_SUBMIT_SLICE_NS 2000000LL       /* waiting for a submit: look again every 2 ms */
+
+struct herogpu_pan_submit {
+	uint64_t jc;
+	uint64_t in_syncs;              /* ignored: the handles follow inline */
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;            /* ignored */
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+};
+struct herogpu_pan_wait_bo {
+	uint32_t handle;
+	uint32_t pad;
+	int64_t timeout_ns;
+};
+struct herogpu_pan_madvise {
+	uint32_t handle;
+	uint32_t madv;
+	uint32_t retained;
+};
+struct herogpu_syncobj_create {
+	uint32_t handle;
+	uint32_t flags;
+};
+struct herogpu_syncobj_destroy {
+	uint32_t handle;
+	uint32_t pad;
+};
+struct herogpu_syncobj_wait {
+	uint64_t handles;               /* ignored */
+	int64_t timeout_nsec;
+	uint32_t count_handles;
+	uint32_t flags;
+	uint32_t first_signaled;
+	uint32_t pad;
+	uint64_t deadline_nsec;         /* ignored */
+};
+struct herogpu_syncobj_array {
+	uint64_t handles;               /* ignored */
+	uint32_t count_handles;
+	uint32_t pad;
+};
+static_assert(sizeof(struct herogpu_pan_submit) == 40, "drm_panfrost_submit");
+static_assert(sizeof(struct herogpu_pan_wait_bo) == 16, "drm_panfrost_wait_bo");
+static_assert(sizeof(struct herogpu_pan_madvise) == 12, "drm_panfrost_madvise");
+static_assert(sizeof(struct herogpu_syncobj_create) == 8, "drm_syncobj_create");
+static_assert(sizeof(struct herogpu_syncobj_destroy) == 8, "drm_syncobj_destroy");
+static_assert(sizeof(struct herogpu_syncobj_wait) == 40, "drm_syncobj_wait");
+static_assert(sizeof(struct herogpu_syncobj_array) == 16, "drm_syncobj_array");
+
+struct herogpu_syncobj {
+	struct a04s_fence *fence;       /* NULL: none yet (or reset) */
+	uint32_t used;
+	uint32_t pad;
+};
+
+/* What a queued job holds: its BOs. */
+struct herogpu_job_ctx {
+	struct herogpu_bo **bos;
+	uint32_t n;
+	uint32_t pad;
+};
+
+static void
+herogpu_job_retire(void *arg)
+{
+	struct herogpu_job_ctx *ctx = (struct herogpu_job_ctx *)arg;
+	for (uint32_t i = 0; i < ctx->n; i++) {
+		herogpu_bo_put(ctx->bos[i]);
+	}
+	if (ctx->bos != NULL) {
+		IODelete(ctx->bos, struct herogpu_bo *, ctx->n);
+	}
+	IOFreeType(ctx, struct herogpu_job_ctx);
+}
+
+static IOReturn
+herogpu_wait_ret(int err)
+{
+	return err == 0 ? kIOReturnSuccess : err == ETIMEDOUT ? kIOReturnTimeout : kIOReturnAborted;
+}
+
+static inline uint32_t
+herogpu_u32(const uint8_t *p)
+{
+	uint32_t v;
+	memcpy(&v, p, sizeof(v));
+	return v;
+}
+
+/*
+ * The structure input, inline or (over 4096 bytes) by descriptor. *owned: a copy to free with
+ * IOFreeData(*owned, *size). NULL if missing or larger than HEROGPU_MAX_STRUCT.
+ */
+static const uint8_t *
+herogpu_struct_in(IOExternalMethodArguments *args, uint32_t *size, void **owned)
+{
+	*owned = NULL;
+	*size = 0;
+	if (args->structureInputDescriptor != NULL) {
+		IOMemoryDescriptor *md = args->structureInputDescriptor;
+		IOByteCount len = md->getLength();
+		if (len == 0 || len > HEROGPU_MAX_STRUCT) {
+			return NULL;
+		}
+		void *buf = IOMallocData(len);
+		if (buf == NULL) {
+			return NULL;
+		}
+		IOByteCount got = 0;
+		if (md->prepare() == kIOReturnSuccess) {
+			got = md->readBytes(0, buf, len);
+			md->complete();
+		}
+		if (got != len) {
+			IOFreeData(buf, len);
+			return NULL;
+		}
+		*owned = buf;
+		*size = (uint32_t)len;
+		return (const uint8_t *)buf;
+	}
+	if (args->structureInput == NULL || args->structureInputSize == 0 ||
+	    args->structureInputSize > HEROGPU_MAX_STRUCT) {
+		return NULL;
+	}
+	*size = args->structureInputSize;
+	return (const uint8_t *)args->structureInput;
+}
