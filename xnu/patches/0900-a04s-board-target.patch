+static inline uint32_t
+io_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static bool
+gate_running(uint32_t gate)
+{
+	return !(gate & GATE_MANUAL) || (gate & GATE_CG_VAL);
+}
+
+/* A gate as one digit: 4 automatic gating, 2 CG_VAL, 1 MANUAL. 1 alone is a stopped clock. */
+static unsigned
+gate_code(uint32_t gate)
+{
+	return ((gate & GATE_AUTO) ? 4u : 0u) | ((gate & GATE_CG_VAL) ? 2u : 0u) | ((gate & GATE_MANUAL) ? 1u : 0u);
+}
+
+/*
+ * Raw levels, a bit a key, 1 high. The PMIC is asked only when read_pmic is set; otherwise, and when
+ * it can't be read, the side key keeps its last level. One CPU, and an ACPM read that times out
+ * spins for 50 ms, so after KEY_PMIC_FAILS failures in a row the side key stops being read.
+ */
+static uint32_t
+key_levels(uint32_t last, bool read_pmic)
+{
+	static unsigned fails_in_a_row;
+	uint32_t levels = last & (1u << KEY_POWER);
+	if (io_rd(alive_pins, GPA0 + PIN_DAT) & (1u << 7)) {
+		levels |= 1u << KEY_VOLUP;
+	}
+	if (io_rd(alive_pins, GPA1 + PIN_DAT) & 1u) {
+		levels |= 1u << KEY_VOLDOWN;
+	}
+	if (!read_pmic || fails_in_a_row >= KEY_PMIC_FAILS) {
+		return levels;
+	}
+	uint8_t status1 = 0;
+	int error = a04s_acpm_power_key(&status1);
+	if (error) {
+		key_errors++;
+		key_last_error = error;
+		if (++fails_in_a_row == KEY_PMIC_FAILS) {
+			kprintf("A04S KEY POWER STOPPED, ACPM ERROR %d\n", error);
+		}
+		return levels;
+	}
+	fails_in_a_row = 0;
+	key_status1 = status1;
+	levels &= ~(1u << KEY_POWER);
+	if (status1 & 1u) {
+		levels |= 1u << KEY_POWER;
+	}
+	return levels;
+}
+
+static void
+a04s_keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t levels = key_levels(0, true);
+	unsigned flips[KEY_COUNT] = { 0 }, window = 0, polls = 0;
+	key_idle = levels;
+	kprintf("A04S KEYS IDLE %x S1 %02x ERR %u\n", key_idle, key_status1, key_errors);
+	for (;;) {
+		IOSleep(KEY_POLL_MS);
+		if (++window == KEY_FLAP_WINDOW) {
+			window = 0;
+			for (int key = 0; key < KEY_COUNT; key++) {
+				flips[key] = 0;
+			}
+		}
+		uint32_t now = key_levels(levels, ++polls % KEY_PMIC_EVERY == 0);
+		key_raw = now;
+		key_polls = polls;
+		if (now != levels) {
+			levels = now;                   /* one sample: wait for a second the same */
+			continue;
+		}
+		uint32_t down = (levels ^ key_idle) & ~key_dropped;
+		uint32_t changed = down ^ key_down;
+		for (int key = 0; key < KEY_COUNT; key++) {
+			uint32_t bit = 1u << key;
+			if (!(changed & bit)) {
+				continue;
+			}
+			bool pressed = (down & bit) != 0;
+			if (++flips[key] > KEY_FLAP_LIMIT) {
+				key_dropped |= bit;
+				down &= ~bit;
+				if (key_down & bit) {
+					sweet_hid_key(key, 0);
+				}
+				kprintf("A04S KEY %s DROPPED, %u CHANGES IN 1 S\n", key_names[key], flips[key]);
+				continue;
+			}
+			sweet_hid_key(key, pressed);
+			if (key_events++ < KEY_LINES) {
+				kprintf("A04S KEY %s %s\n", key_names[key], pressed ? "DOWN" : "UP");
+			}
+		}
+		key_down = down;
+	}
+}
+
+static inline void
+io_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+}
+
+/* A Q-channel that lets the hardware stop the clock: enabled, with no clock request held. */
+static bool
+qch_may_stop(uint32_t qch)
+{
+	return (qch & QCH_ENABLE) && !(qch & QCH_CLOCK_REQ);
+}
+
+/* Stage 7c-3 (a04s_gpu.c): 7c-2's checks passed and the ID is a Mali-G52's. */
+bool a04s_gpu_path_ok(void);
+bool
+a04s_gpu_path_ok(void)
+{
+	return gpu.why == NULL && (gpu.id >> 16) == 0x7212u;
+}
+
+/* Stage 7c-2: the Mali's ID, if every check on the way passes. */
+static void
+a04s_gpu_probe(void)
+{
+	if (!(gpu_pd_status & 1u)) {
+		gpu.why = "PD OFF";
+		return;
+	}
+	vm_offset_t top = ml_io_map(CMU_TOP_PA, 0x4000);
+	vm_offset_t core = ml_io_map(CMU_CORE_PA, 0x4000);
+	vm_offset_t g3d = ml_io_map(CMU_G3D_PA, 0x4000);
+	if (!top || !core || !g3d) {
+		gpu.why = "NO MAPPING";
+		return;
+	}
+	gpu.top = io_rd(top, GATE_TOP_G3D_SWITCH);
+	gpu.core = io_rd(core, GATE_CORE_LHS_P_G3D);
+	if (!gate_running(gpu.top) || !gate_running(gpu.core)) {
+		gpu.why = "BUS GATE";
+		return;
+	}
+	gpu.g3d_pclk = io_rd(g3d, GATE_G3D_CMU_PCLK);
+	gpu.g3d_gpu = io_rd(g3d, GATE_G3D_GPU);
+	gpu.g3d_lhm = io_rd(g3d, GATE_G3D_LHM_P);
+	gpu.qch_gpu = io_rd(g3d, QCH_G3D_GPU);
+	gpu.qch_lhm = io_rd(g3d, QCH_G3D_LHM_P);
+	if (!gate_running(gpu.g3d_gpu) || !gate_running(gpu.g3d_lhm)) {
+		gpu.why = "G3D GATE";
+		return;
+	}
+	if (qch_may_stop(gpu.qch_gpu) || qch_may_stop(gpu.qch_lhm)) {
+		gpu.why = "QCH";
+		return;
+	}
+	vm_offset_t regs = ml_io_map(GPU_PA, 0x1000);
+	if (!regs) {
+		gpu.why = "NO MAPPING";
+		return;
+	}
+	gpu.id = io_rd(regs, GPU_ID);
+	gpu.l2_features = io_rd(regs, GPU_L2_FEATURES);
+	gpu.status = io_rd(regs, GPU_STATUS);
+	gpu.shaders = io_rd(regs, GPU_SHADER_PRESENT);
+	gpu.l2 = io_rd(regs, GPU_L2_PRESENT);
+	gpu.why = NULL;
+}
+
+/* Stage 7a-1 and 7c-1: what the bootloader left, read once. */
+static void
+a04s_touch_gpu_probe(vm_offset_t cmu_peri, vm_offset_t cmu_cmgp)
+{
+	tp.gate[1] = io_rd(cmu_peri, GATE_GPIO_PERI);
+	tp.gate[2] = io_rd(cmu_cmgp, GATE_GPIO_CMGP);
+	tp.gate[3] = io_rd(cmu_cmgp, GATE_SYSREG_CMGP);
+	tp.gate[4] = io_rd(cmu_cmgp, GATE_USI0_IPCLK);
+	tp.gate[5] = io_rd(cmu_cmgp, GATE_USI0_PCLK);
+	tp.qch = io_rd(cmu_cmgp, QCH_USI_CMGP0);
+	tp.mux = io_rd(cmu_cmgp, MUX_USI_CMGP0);
+	tp.div = io_rd(cmu_cmgp, DIV_USI_CMGP0);
+
+	int id1 = -1, id2 = -1, id3 = -1;
+	if (alive_pins) {
+		tp.gpa0_con = io_rd(alive_pins, GPA0 + PIN_CON);
+		tp.gpa0_dat = io_rd(alive_pins, GPA0 + PIN_DAT);
+		tp.gpa3_con = io_rd(alive_pins, GPA3 + PIN_CON);
+		tp.gpa3_dat = io_rd(alive_pins, GPA3 + PIN_DAT);
+		id3 = (tp.gpa0_dat >> 2) & 1;
+	}
+	if (gate_running(tp.gate[1])) {
+		vm_offset_t peri = ml_io_map(PERI_PINS_PA, 0x1000);
+		if (peri) {
+			id1 = (io_rd(peri, GPG1 + PIN_DAT) >> 7) & 1;
+			id2 = io_rd(peri, GPG2 + PIN_DAT) & 1;
+		}
+	}
+	if (id1 >= 0 && id2 >= 0 && id3 >= 0) {
+		tp.panel_id = (id3 << 2) | (id2 << 1) | id1;   /* nvt_parse_dt's fw_sel_idx */
+	}
+	if (gate_running(tp.gate[2])) {
+		vm_offset_t cmgp = ml_io_map(CMGP_PINS_PA, 0x1000);
+		for (uint32_t pin = 0; cmgp && pin < 4; pin++) {
+			tp.gpm_con |= (io_rd(cmgp, pin * 0x20u + PIN_CON) & 0xfu) << (pin * 4);
+			tp.gpm_dat |= (io_rd(cmgp, pin * 0x20u + PIN_DAT) & 1u) << pin;
+		}
+	}
+	if (gate_running(tp.gate[3])) {
+		vm_offset_t usi = ml_io_map(USI_MODE_PA, 0x1000);
+		if (usi) {
+			tp.usi_mode = io_rd(usi, 0);
+		}
+	}
+	if (gate_running(tp.gate[4]) && gate_running(tp.gate[5]) && tp.usi_mode == USI_MODE_SPI) {
+		vm_offset_t spi = ml_io_map(SPI1_PA, 0x1000);
+		if (spi) {
+			tp.spi_cfg = io_rd(spi, SPI_CH_CFG);
+			tp.spi_mode = io_rd(spi, SPI_MODE_CFG);
+			tp.spi_status = io_rd(spi, SPI_STATUS);
+			tp.usi_con = io_rd(spi, SPI_USI_CON);
+			tp.spi_read = true;
+		}
+	}
+
+	vm_offset_t pmu = ml_io_map(PD_G3D_PA, 0x1000);
+	if (pmu) {
+		gpu_pd_config = io_rd(pmu, PD_G3D_CONFIG);
+		gpu_pd_status = io_rd(pmu, PD_G3D_STATUS);
+	}
+	a04s_gpu_probe();
+}
+
+/* One CMGP pin, GPM0-3 only: pull, drive, then function, as pinctrl applies a state. */
+static void
+gpm_set(uint32_t pin, uint32_t func, uint32_t pud, uint32_t drv)
+{
+	if (pin > GPM_CS) {
+		return;
+	}
+	uint32_t bank = pin * 0x20u;
+	io_wr(cmgp_pins, bank + PIN_PUD, (io_rd(cmgp_pins, bank + PIN_PUD) & ~0xfu) | pud);
+	io_wr(cmgp_pins, bank + PIN_DRV, (io_rd(cmgp_pins, bank + PIN_DRV) & ~0xfu) | drv);
+	io_wr(cmgp_pins, bank + PIN_CON, (io_rd(cmgp_pins, bank + PIN_CON) & ~0xfu) | func);
+}
+
+static void
+spi_cs(uint32_t high)
+{
+	uint32_t bank = GPM_CS * 0x20u;
+	io_wr(cmgp_pins, bank + PIN_DAT, (io_rd(cmgp_pins, bank + PIN_DAT) & ~1u) | (high & 1u));
+}
+
+/* flush_fifo() in spi-s3c64xx.c. */
+static void
+spi_flush(void)
+{
+	uint32_t cfg = io_rd(spi1, SPI_CH_CFG) & ~(CH_RXCH_ON | CH_TXCH_ON);
+	io_wr(spi1, SPI_CH_CFG, cfg);
+	io_wr(spi1, SPI_PACKET_CNT, 0);
+	io_wr(spi1, SPI_CH_CFG, (cfg | CH_SW_RST) & ~CH_HS_EN);
+	for (int i = 0; i < 1000 && TX_FIFO_LVL(io_rd(spi1, SPI_STATUS)); i++) {
+	}
+	for (int i = 0; i < 1000 && RX_FIFO_LVL(io_rd(spi1, SPI_STATUS)); i++) {
+		(void)*(volatile uint8_t *)(spi1 + SPI_RX_DATA);
+	}
+	io_wr(spi1, SPI_CH_CFG, io_rd(spi1, SPI_CH_CFG) & ~CH_SW_RST);
+}
+
+/*
+ * One polled transfer with the chip selected: len bytes out and len in, as enable_datapath() and
+ * wait_for_xfer() do without DMA. 0, or ETIMEDOUT after about 20 ms with too few bytes back.
+ * The controller shifts only while SLAVE_SEL's SIG_INACT is clear, so, as enable_cs() does in
+ * manual chip-select mode, it is cleared after the FIFO is loaded and set again once the bytes are
+ * back. v22 left it set: its 3 bytes stayed in the TX FIFO (ST c0) and every transfer timed out.
+ */
+static int
+spi_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	if (len == 0 || len > SPI_XFER_MAX) {
+		return EINVAL;
+	}
+	spi_cs(0);
+	spi_flush();
+	uint32_t cfg = (io_rd(spi1, SPI_CH_CFG) & ~CH_TXCH_ON) | CH_RXCH_ON;
+	io_wr(spi1, SPI_PACKET_CNT, io_rd(spi1, SPI_PACKET_CNT) & ~PACKET_CNT_EN);
+	io_wr(spi1, SPI_PACKET_CNT, len);
+	io_wr(spi1, SPI_PACKET_CNT, len | PACKET_CNT_EN);
+	uint32_t mode = io_rd(spi1, SPI_MODE_CFG) & ~(MODE_4BURST | MODE_TXDMA_ON | MODE_RXDMA_ON);
+	io_wr(spi1, SPI_MODE_CFG, mode);
+	for (uint32_t i = 0; i < len; i++) {
+		*(volatile uint8_t *)(spi1 + SPI_TX_DATA) = tx[i];
+	}
+	io_wr(spi1, SPI_CH_CFG, cfg | CH_TXCH_ON);
+	io_wr(spi1, SPI_SLAVE_SEL, 0);
+	int error = ETIMEDOUT;
+	for (int wait = 0; wait < 20 && error; wait++) {
+		for (int i = 0; i < 2000; i++) {
+			if (RX_FIFO_LVL(io_rd(spi1, SPI_STATUS)) >= len) {
+				error = 0;
+				break;
+			}
+		}
+		if (error) {
+			IOSleep(1);
+		}
+	}
+	if (!error) {
+		for (uint32_t i = 0; i < len; i++) {
+			uint8_t byte = *(volatile uint8_t *)(spi1 + SPI_RX_DATA);
+			if (rx) {
+				rx[i] = byte;
+			}
+		}
+	} else {
+		tp2.timeouts++;
+	}
+	tp2.xfers++;
+	tp2.status = io_rd(spi1, SPI_STATUS);
+	io_wr(spi1, SPI_SLAVE_SEL, SLAVE_SIG_INACT);
+	spi_flush();
+	spi_cs(1);
+	return error;
+}
+
+/* nvt_set_page() and nvt_write_addr(): CTP_SPI_WRITE sets bit 7 of the first byte. */
+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t cmd[3] = { 0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+	return spi_xfer(cmd, NULL, 3);
+}
+
+static int
+nvt_write_addr(uint32_t addr, uint8_t data)
+{
+	int error = nvt_set_page(addr);
+	if (error) {
+		return error;
+	}
+	uint8_t cmd[2] = { (uint8_t)((addr & 0x7fu) | 0x80u), data };
+	return spi_xfer(cmd, NULL, 2);
+}
+
+/*
+ * nvt_ts_check_chip_ver_trim(): reset into the boot loader, then read 7 bytes at the trim address
+ * (an address byte, a dummy, then ID 0-5). NT36525 is the table entry with ID 3-5 = 25 65 03.
+ */
+static bool
+nvt_read_trim(uint32_t addr)
+{
+	tp2.addr = addr;
+	for (int retry = 0; retry < NVT_TRIES; retry++) {
+		tp2.tries++;
+		(void)nvt_write_addr(NVT_SWRST_N8, 0x69);
+		IOSleep(50);
+		(void)nvt_write_addr(NVT_SPI_RD_FAST, 0x00);
+		uint8_t tx[8] = { (uint8_t)(addr & 0x7fu) }, rx[8] = { 0 };
+		if (!nvt_set_page(addr) && !spi_xfer(tx, rx, 8)) {
+			for (int i = 0; i < 6; i++) {
+				tp2.id[i] = rx[2 + i];
+			}
+			if (rx[5] == 0x25 && rx[6] == 0x65 && rx[7] == 0x03) {
+				return true;
+			}
+		}
+		IOSleep(10);
+	}
+	return false;
+}
+
+/* CTP_SPI_READ at an address whose page is set: the address byte, a dummy, then n bytes. */
+static int
+nvt_read_here(uint32_t addr, uint8_t *out, uint32_t n)
+{
+	uint8_t tx[SPI_XFER_MAX] = { (uint8_t)(addr & 0x7fu) }, rx[SPI_XFER_MAX];
+	if (n + 2 > SPI_XFER_MAX) {
+		return EINVAL;
+	}
+	int error = spi_xfer(tx, rx, n + 2);
+	for (uint32_t i = 0; !error && i < n; i++) {
+		out[i] = rx[2 + i];
+	}
+	return error;
+}
+
+/* CTP_SPI_WRITE at an address whose page is set. */
+static int
+nvt_write_here(uint32_t addr, const uint8_t *data, uint32_t n)
+{
+	uint8_t tx[SPI_XFER_MAX];
+	if (n + 1 > SPI_XFER_MAX) {
+		return EINVAL;
+	}
+	tx[0] = (uint8_t)((addr & 0x7fu) | 0x80u);
+	for (uint32_t i = 0; i < n; i++) {
+		tx[1 + i] = data[i];
+	}
+	return spi_xfer(tx, NULL, n + 1);
+}
+
+static uint32_t
+le32(const uint8_t *b)
+{
+	return b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+}
+
+/*
+ * nvt_get_fw_need_write_size(), the FW_VER check and nvt_bin_header_parser() for hw_crc, on the
+ * payload's copy. Any range outside the file fails the whole firmware.
+ */
+static const char *
+fw_check(const uint8_t *fw, uint32_t size)
+{
+	if (size != FW_SIZE) {
+		return "SIZE";
+	}
+	SHA256_CTX ctx;
+	uint8_t digest[SHA256_DIGEST_LENGTH];
+	SHA256_Init(&ctx);
+	SHA256_Update(&ctx, fw, size);
+	SHA256_Final(digest, &ctx);
+	for (int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
+		if (digest[i] != fw_sha256[i]) {
+			return "SHA256";
+		}
+	}
+	if (fw[FW_NEED_WRITE - 3] != 'N' || fw[FW_NEED_WRITE - 2] != 'V' || fw[FW_NEED_WRITE - 1] != 'T') {
+		return "END FLAG";
+	}
+	if (((fw[FW_NEED_WRITE - 4096] + fw[FW_NEED_WRITE - 4096 + 1]) & 0xffu) != 0xffu) {
+		return "FW VER";
+	}
+	uint32_t end = le32(fw), info = 0;
+	for (uint32_t pos = 0x30; pos < end; pos += 0x10) {
+		info++;
+	}
+	uint32_t ovly = (fw[0x28] & 0x10) ? (fw[0x28] & 0x0fu) : 0;
+	uint32_t parts = 2 + info + ovly;
+	if (parts > FW_MAX_PARTS || 0x30 + 0x10 * info > size) {
+		return "HEADER";
+	}
+	for (uint32_t i = 0; i < parts; i++) {
+		struct fw_part *pt = &fw_parts[i];
+		uint32_t pos;
+		if (i < 2) {
+			pt->bin = le32(fw + i * 12);
+			pt->sram = le32(fw + 4 + i * 12);
+			pt->size = le32(fw + 8 + i * 12);
+			pt->crc = le32(fw + 0x18 + i * 4);
+			continue;
+		}
+		pos = (i < 2 + info) ? 0x30 + 0x10 * (i - 2) : fw_parts[1].bin + 0x10 * (i - 2 - info);
+		if (pos + 16 > size) {
+			return "HEADER";
+		}
+		pt->sram = le32(fw + pos);
+		pt->size = le32(fw + pos + 4);
+		pt->bin = le32(fw + pos + 8);
+		pt->crc = le32(fw + pos + 12);
+	}
+	for (uint32_t i = 0; i < parts; i++) {
+		/* nvt_write_firmware() writes size + 1 bytes of every partition that has a size. */
+		if (fw_parts[i].size && (uint64_t)fw_parts[i].bin + fw_parts[i].size + 1 > size) {
+			return "RANGE";
+		}
+	}
+	tp3.parts = parts;
+	return NULL;
+}
+
+/* nvt_write_sram(), in FW_CHUNK pieces: a page set, then the bytes at that address. */
+static int
+fw_write_sram(const uint8_t *fw, uint32_t sram, uint32_t bin, uint32_t size)
+{
+	while (size) {
+		uint32_t n = size < FW_CHUNK ? size : FW_CHUNK;
+		int error = nvt_set_page(sram);
+		if (!error) {
+			error = nvt_write_here(sram, fw + bin, n);
+		}
+		if (error) {
+			return error;
+		}
+		tp3.sent += n;
+		sram += n;
+		bin += n;
+		size -= n;
+	}
+	return 0;
+}
+
+/* nvt_set_bld_crc_bank() for hw_crc 1: destination, 2 length bytes, golden CRC, all on one page. */
+static int
+fw_crc_bank(uint32_t des, uint32_t sram, uint32_t len_addr, uint32_t size, uint32_t g_addr, uint32_t crc)
+{
+	uint8_t d[3] = { (uint8_t)sram, (uint8_t)(sram >> 8), (uint8_t)(sram >> 16) };
+	uint8_t l[2] = { (uint8_t)size, (uint8_t)(size >> 8) };
+	uint8_t c[4] = { (uint8_t)crc, (uint8_t)(crc >> 8), (uint8_t)(crc >> 16), (uint8_t)(crc >> 24) };
+	int error = nvt_set_page(des);
+	if (!error) {
+		error = nvt_write_here(des, d, 3);
+	}
+	if (!error) {
+		error = nvt_write_here(len_addr, l, 2);
+	}
+	if (!error) {
+		error = nvt_write_here(g_addr, c, 4);
+	}
+	return error;
+}
+
+static uint32_t
+fw_read_word(uint32_t addr)
+{
+	uint8_t b[4] = { 0 };
+	if (nvt_set_page(addr) || nvt_read_here(addr, b, 4)) {
+		return 0xffffffffu;
+	}
+	return le32(b);
+}
+
+/* nvt_read_bld_hw_crc(): the boot loader's CRC flags and the golden and computed CRCs. */
+static void
+fw_read_crc(void)
+{
+	uint8_t flag = 0xff;
+	if (!nvt_set_page(NVT_BLD_ILM_DLM_CRC)) {
+		(void)nvt_read_here(NVT_BLD_ILM_DLM_CRC, &flag, 1);
+	}
+	tp3.crc_flag = flag;
+	tp3.g_ilm = fw_read_word(NVT_G_ILM_CRC);
+	tp3.r_ilm = fw_read_word(NVT_R_ILM_CRC);
+	tp3.g_dlm = fw_read_word(NVT_G_DLM_CRC);
+	tp3.r_dlm = fw_read_word(NVT_R_DLM_CRC);
+}
+
+/* One nvt_download_firmware_hw_crc() pass. 0 once the firmware reports a reset state. */
+static int
+fw_download_once(const uint8_t *fw)
+{
+	tp3.why = "BLD RESET";
+	(void)nvt_write_addr(NVT_SWRST_N8, 0x69);
+	IOSleep(50);
+	(void)nvt_write_addr(NVT_SPI_RD_FAST, 0x00);
+
+	tp3.why = "SRAM";
+	tp3.sent = 0;
+	for (uint32_t i = 0; i < tp3.parts; i++) {
+		if (fw_parts[i].size && fw_write_sram(fw, fw_parts[i].sram, fw_parts[i].bin, fw_parts[i].size + 1)) {
+			return EIO;
+		}
+	}
+
+	tp3.why = "CRC SET";
+	if (fw_crc_bank(NVT_ILM_DES, fw_parts[0].sram, NVT_ILM_LENGTH, fw_parts[0].size, NVT_G_ILM_CRC,
+	    fw_parts[0].crc) ||
+	    fw_crc_bank(NVT_DLM_DES, fw_parts[1].sram, NVT_DLM_LENGTH, fw_parts[1].size, NVT_G_DLM_CRC,
+	    fw_parts[1].crc)) {
+		return EIO;
+	}
+	/* nvt_bld_crc_enable(): set bit 7 of BLD_CRC_EN. */
+	uint8_t en = 0;
+	if (nvt_set_page(NVT_BLD_CRC_EN) || nvt_read_here(NVT_BLD_CRC_EN, &en, 1)) {
+		return EIO;
+	}
+	en |= 0x80;
+	if (nvt_write_here(NVT_BLD_CRC_EN, &en, 1)) {
+		return EIO;
+	}
+	/* nvt_fw_crc_enable(): clear the reset state, then host command 0xAE. */
+	uint8_t zero = 0x00, cmd = 0xae;
+	if (nvt_set_page(NVT_EVENT_BUF | EV_RESET_COMPLETE) ||
+	    nvt_write_here(NVT_EVENT_BUF | EV_RESET_COMPLETE, &zero, 1) ||
+	    nvt_set_page(NVT_EVENT_BUF | EV_HOST_CMD) ||
+	    nvt_write_here(NVT_EVENT_BUF | EV_HOST_CMD, &cmd, 1)) {
+		return EIO;
+	}
+	/* nvt_boot_ready(), hw_crc: BOOT_RDY = 1, then 5 ms. */
+	tp3.why = "BOOT RDY";
+	if (nvt_write_addr(NVT_BOOT_RDY, 1)) {
+		return EIO;
+	}
+	IOSleep(5);
+
+	/* nvt_check_fw_reset_state(RESET_STATE_INIT): 11 reads, 10 ms apart. */
+	tp3.why = "RESET STATE";
+	if (nvt_set_page(NVT_EVENT_BUF | EV_RESET_COMPLETE)) {
+		return EIO;
+	}
+	for (int i = 0; i <= 10; i++) {
+		uint8_t st[5] = { 0 };
+		if (!nvt_read_here(NVT_EVENT_BUF | EV_RESET_COMPLETE, st, 5)) {
+			tp3.reset_state = st[0];
+			if (st[0] >= RESET_STATE_INIT && st[0] <= RESET_STATE_MAX) {
+				return 0;
+			}
+		}
+		IOSleep(10);
+	}
+	return ETIMEDOUT;
+}
+
+/* One point-data frame, buf[0] being Samsung's point_data[1]: two reads, then the checksum. */
+static int
+touch_read_frame(uint8_t *buf)
+{
+	if (nvt_read_here(NVT_EVENT_BUF, buf, TOUCH_PART1) ||
+	    nvt_read_here(NVT_EVENT_BUF + TOUCH_PART1, buf + TOUCH_PART1, TOUCH_CK_LEN - TOUCH_PART1)) {
+		return EIO;
+	}
+	uint8_t sum = 0;
+	for (int i = 0; i < TOUCH_CK_LEN - 1; i++) {
+		sum += buf[i];
+	}
+	uint8_t want = (uint8_t)(~sum + 1);
+	if (want != buf[TOUCH_CK_LEN - 1]) {
+		if (tp4.ck_bad < TOUCH_BAD_LINES) {
+			kprintf("A04S TOUCH BAD %02x/%02x %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x\n",
+			    want, buf[TOUCH_CK_LEN - 1], buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6],
+			    buf[7], buf[58], buf[59], buf[60], buf[61], buf[62], buf[63], buf[64]);
+		}
+		return EBADMSG;
+	}
+	return 0;
+}
+
+static void
+touch_release_all(int *fx, int *fy)
+{
+	for (int f = 0; f < TOUCH_SLOTS; f++) {
+		if (tp4.down & (1u << f)) {
+			sweet_hid_touch(f, 0, fx[f], fy[f]);
+		}
+	}
+	tp4.down = 0;
+}
+
+/* nvt_ts_touch_report(): slots with an id 1-10 and an enter, move or glove status are down. */
+static void
+touch_report(const uint8_t *buf, int *fx, int *fy)
+{
+	uint32_t now = 0;
+	for (int i = 0; i < TOUCH_SLOTS; i++) {
+		const uint8_t *e = buf + 6 * i;
+		int id = e[0] >> 3, status = e[0] & 7;
+		if (id < 1 || id > TOUCH_SLOTS) {
+			continue;
+		}
+		if (status != FINGER_ENTER && status != FINGER_MOVING && status != GLOVE_TOUCH) {
+			continue;
+		}
+		int x = (e[1] << 4) | (e[3] >> 4), y = (e[2] << 4) | (e[3] & 0xf);
+		if (x > tp4.max_x || y > tp4.max_y) {
+			tp4.bad_xy++;
+			continue;
+		}
+		int f = id - 1;
+		now |= 1u << f;
+		if (!(tp4.down & (1u << f)) && tp4.events < TOUCH_LINES) {
+			kprintf("A04S TOUCH %d DOWN %d,%d\n", f, x, y);
+		}
+		if (!(tp4.down & (1u << f))) {
+			tp4.events++;
+		}
+		fx[f] = x;
+		fy[f] = y;
+		tp4.last_x = x;
+		tp4.last_y = y;
+		sweet_hid_touch(f, 1, x, y);
+	}
+	for (int f = 0; f < TOUCH_SLOTS; f++) {
+		if ((tp4.down & (1u << f)) && !(now & (1u << f))) {
+			if (tp4.events < TOUCH_LINES) {
+				kprintf("A04S TOUCH %d UP %d,%d\n", f, fx[f], fy[f]);
+			}
+			tp4.events++;
+			sweet_hid_touch(f, 0, fx[f], fy[f]);
+		}
+	}
+	tp4.down = now;
+}
+
+/* Stage 7a-4: poll the interrupt pin and hand finished frames to SweetHIDTouch. Never returns. */
+static void
+a04s_touch_events(void)
+{
+	int want = 0;
+	(void)PE_parse_boot_argn("tptouch", &want, sizeof(want));
+	if (!want) {
+		tp4.why = "OFF";
+		return;
+	}
+	if (!alive_pins) {
+		tp4.why = "NO PINS";
+		return;
+	}
+	/* nvt_get_fw_info(): abs_x_max and abs_y_max, else the panel. */
+	tp4.max_x = (uint16_t)((tp3.fwinfo[4] << 8) | tp3.fwinfo[5]);
+	tp4.max_y = (uint16_t)((tp3.fwinfo[6] << 8) | tp3.fwinfo[7]);
+	if (tp4.max_x == 0 || tp4.max_x > 4095 || tp4.max_y == 0 || tp4.max_y > 4095) {
+		tp4.max_x = 720;
+		tp4.max_y = 1600;
+	}
+	if (nvt_set_page(NVT_EVENT_BUF)) {
+		tp4.why = "PAGE";
+		return;
+	}
+	/*
+	 * nt36523_tsp_int_active: GPA0-0 function 0xf, no pull; the irq-gpio flags ask for the falling
+	 * edge. Mask first, so the edge can only ever latch, then clear anything already latched.
+	 */
+	io_wr(alive_pins, ALIVE_EINT_MASK, io_rd(alive_pins, ALIVE_EINT_MASK) | 1u);
+	io_wr(alive_pins, ALIVE_EINT_CON, (io_rd(alive_pins, ALIVE_EINT_CON) & ~0xfu) | EINT_EDGE_FALLING);
+	io_wr(alive_pins, GPA0 + PIN_PUD, io_rd(alive_pins, GPA0 + PIN_PUD) & ~0xfu);
+	io_wr(alive_pins, GPA0 + PIN_CON, (io_rd(alive_pins, GPA0 + PIN_CON) & ~0xfu) | PIN_FUNC_EINT);
+	io_wr(alive_pins, ALIVE_EINT_PEND, 1u);
+	tp4.eint_mask = io_rd(alive_pins, ALIVE_EINT_MASK);
+	tp4.state = 0;
+	tp4.why = "POLLING";
+	kprintf("A04S 7A4 START MAX %u,%u\n", tp4.max_x, tp4.max_y);
+	int fx[TOUCH_SLOTS] = { 0 }, fy[TOUCH_SLOTS] = { 0 };
+	uint8_t buf[TOUCH_CK_LEN];
+	uint32_t fails = 0, raw_lines = 0;
+	for (;;) {
+		IOSleep(TOUCH_POLL_MS);
+		tp4.polls++;
+		bool edge = (io_rd(alive_pins, ALIVE_EINT_PEND) & 1u) != 0;
+		if (edge) {
+			io_wr(alive_pins, ALIVE_EINT_PEND, 1u);         /* write 1 to clear */
+			tp4.edges++;
+			tp4.int_works = true;
+		}
+		bool low = !(io_rd(alive_pins, GPA0 + PIN_DAT) & 1u);
+		if (low) {
+			tp4.int_low++;
+		} else {
+			tp4.int_high++;
+		}
+		if (!edge && !low && (tp4.int_works || tp4.polls % TOUCH_BLIND_EVERY)) {
+			continue;
+		}
+		tp4.reads++;
+		int error = touch_read_frame(buf);
+		if (error) {
+			if (error == EBADMSG) {
+				tp4.ck_bad++;
+			}
+			if (++fails == TOUCH_FAIL_RELEASE) {
+				touch_release_all(fx, fy);
+			}
+			continue;
+		}
+		fails = 0;
+		bool pattern = true;
+		for (int i = 0; i < 6; i++) {
+			pattern = pattern && buf[i] == 0x77;
+		}
+		if (pattern) {
+			tp4.recovery++;                 /* nvt_fw_recovery(): a handshake, not touches */
+			continue;
+		}
+		if (raw_lines < TOUCH_RAW_LINES && (buf[0] >> 3) != 0) {
+			raw_lines++;
+			kprintf("A04S TOUCH RAW %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x\n",
+			    buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6], buf[7], buf[8], buf[9],
+			    buf[10], buf[11]);
+		}
+		touch_report(buf, fx, fy);
+	}
+}
+
+/* Stage 7a-3, after the trim ID matched: find, check, then load the firmware. */
+static void
+a04s_touch_fw(void)
+{
+	int want = 0;
+	(void)PE_parse_boot_argn("tpfw", &want, sizeof(want));
+	if (!want) {
+		tp3.why = "OFF";
+		return;
+	}
+	DTEntry map;
+	void const *prop = NULL;
+	unsigned int prop_size = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &map) != kSuccess ||
+	    SecureDTGetProperty(map, "TouchFirmware", &prop, &prop_size) != kSuccess ||
+	    prop_size != 2 * sizeof(uint64_t)) {
+		tp3.why = "NOT IN PAYLOAD";
+		return;
+	}
+	const uint64_t *where = prop;
+	if (where[0] == 0 || where[1] != FW_SIZE) {
+		tp3.why = "SIZE";
+		return;
+	}
+	const uint8_t *fw = (const uint8_t *)ml_static_ptovirt((vm_offset_t)where[0]);
+	if (!fw) {
+		tp3.why = "NO MAPPING";
+		return;
+	}
+	tp3.why = fw_check(fw, (uint32_t)where[1]);
+	if (tp3.why) {
+		tp3.state = 1;
+		return;
+	}
+	kprintf("A04S 7A3 START PARTS %u\n", tp3.parts);
+	uint64_t start = mach_absolute_time(), ns = 0;
+	int error = EIO;
+	for (tp3.tries = 1; tp3.tries <= FW_TRIES; tp3.tries++) {
+		error = fw_download_once(fw);
+		if (!error) {
+			break;
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+	tp3.ms = (uint32_t)(ns / 1000000u);
+	fw_read_crc();
+	if (!error && !nvt_set_page(NVT_EVENT_BUF | EV_FWINFO)) {
+		(void)nvt_read_here(NVT_EVENT_BUF | EV_FWINFO, tp3.fwinfo, sizeof(tp3.fwinfo));
+	}
+	tp3.state = error ? 1 : 0;
+	if (!error) {
+		tp3.why = "RUNNING";
+	}
+	kprintf("A04S 7A3 %s RST %02x MS %u SENT %u TO %u\n", tp3.why, tp3.reset_state, tp3.ms, tp3.sent,
+	    tp2.timeouts);
+}
+
+static void
+a04s_touch_spi_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	kprintf("A04S 7A2 START\n");
+	tp2.why = "USI";
+	vm_offset_t usi = ml_io_map(USI_MODE_PA, 0x1000);
+	spi1 = ml_io_map(SPI1_PA, 0x1000);
+	cmgp_pins = ml_io_map(CMGP_PINS_PA, 0x1000);
+	if (!usi || !spi1 || !cmgp_pins) {
+		tp2.why = "NO MAPPING";
+		return;
+	}
+	io_wr(usi, 0, USI_MODE_SPI);
+	tp2.usi_back = io_rd(usi, 0);
+	if (tp2.usi_back != USI_MODE_SPI) {
+		return;
+	}
+
+	tp2.why = "DIV";
+	uint32_t div = io_rd(cmu_cmgp_va, DIV_USI_CMGP0);
+	io_wr(cmu_cmgp_va, DIV_USI_CMGP0, (div & ~DIV_RATIO_MASK) | DIV_RATIO_SLOWEST);
+	for (int wait = 0; wait < 10 && (io_rd(cmu_cmgp_va, DIV_USI_CMGP0) & DIV_BUSY); wait++) {
+		IOSleep(1);
+	}
+	tp2.div_back = io_rd(cmu_cmgp_va, DIV_USI_CMGP0);
+	if ((tp2.div_back & DIV_BUSY) || (tp2.div_back & DIV_RATIO_MASK) != DIV_RATIO_SLOWEST) {
+		return;
+	}
+
+	/* exynos_usi_init(), s3c64xx_spi_hwinit(), then s3c64xx_spi_config() for mode 0, 8 bits. */
+	tp2.why = "SPI";
+	io_wr(spi1, SPI_USI_CON, 0);
+	io_wr(spi1, SPI_SLAVE_SEL, SLAVE_SIG_INACT);
+	io_wr(spi1, SPI_INT_EN, 0);
+	io_wr(spi1, SPI_MODE_CFG, 0);
+	io_wr(spi1, SPI_PACKET_CNT, 0);
+	io_wr(spi1, SPI_PENDING_CLR, PND_CLEAR_ALL);
+	io_wr(spi1, SPI_PENDING_CLR, 0);
+	io_wr(spi1, SPI_SWAP_CFG, 0);
+	io_wr(spi1, SPI_MODE_CFG, (io_rd(spi1, SPI_MODE_CFG) & ~(MODE_4BURST | MODE_TRAILCNT)) | MODE_TRAILCNT);
+	spi_flush();
+	io_wr(spi1, SPI_CH_CFG, io_rd(spi1, SPI_CH_CFG) & ~(CH_SLAVE | CH_CPOL | CH_CPHA));
+	io_wr(spi1, SPI_MODE_CFG, io_rd(spi1, SPI_MODE_CFG) & ~(MODE_BUS_TSZ_MASK | MODE_CH_TSZ_MASK));
+	io_wr(spi1, SPI_SWAP_CFG, 0);
+	io_wr(spi1, SPI_FB_CLK, 0);                     /* samsung,spi-feedback-delay = <0> */
+	tp2.cfg = io_rd(spi1, SPI_CH_CFG);
+	tp2.mode = io_rd(spi1, SPI_MODE_CFG);
+
+	/* spi1-cs then spi1-bus: chip select high before it becomes an output. */
+	tp2.why = "PINS";
+	spi_cs(1);
+	gpm_set(GPM_CS, 1, 0, 0);
+	for (uint32_t pin = 0; pin < GPM_CS; pin++) {
+		gpm_set(pin, 2, 0, 0);
+	}
+
+	/* nvt_ts_probe(): engineering reset, 10 ms, then the trim ID at the new address, then the old. */
+	tp2.why = "ENG RESET";
+	(void)nvt_write_addr(NVT_ENG_RST, 0x5a);
+	IOSleep(11);
+	tp2.why = "TRIM";
+	tp2.match = nvt_read_trim(NVT_TRIM) || nvt_read_trim(NVT_TRIM_OLD);
+	tp2.state = tp2.match ? 0 : 1;
+	tp2.why = tp2.match ? "DONE" : "NO ID";
+	kprintf("A04S 7A2 %s ID %02x %02x %02x %02x %02x %02x XF %u TO %u\n", tp2.why, tp2.id[0], tp2.id[1],
+	    tp2.id[2], tp2.id[3], tp2.id[4], tp2.id[5], tp2.xfers, tp2.timeouts);
+	if (tp2.match && tp2.id[0] == 0x0c) {
+		a04s_touch_fw();
+	} else {
+		tp3.why = "NO 0C ID";
+	}
+	if (tp3.state == 0) {
+		a04s_touch_events();
+	} else {
+		tp4.why = "NO FIRMWARE";
+	}
+}
+
+/*
+ * 7a-2 runs only with tpspi=1, and only if the bootloader left the path as v20 and v21 saw it: the
+ * CMGP clocks running, USI_CMGP0 unset or already SPI, GPM0-3 still inputs, and the CSOT panel.
+ */
+static void
+a04s_touch_spi_start(void)
+{
+	int want = 0;
+	(void)PE_parse_boot_argn("tpspi", &want, sizeof(want));
+	if (!want) {
+		tp2.why = "OFF";
+		return;
+	}
+	for (int i = 2; i < 6; i++) {
+		if (!gate_running(tp.gate[i])) {
+			tp2.why = "GATE";
+			return;
+		}
+	}
+	if (qch_may_stop(tp.qch)) {
+		tp2.why = "QCH";
+		return;
+	}
+	if (tp.usi_mode != 0 && tp.usi_mode != USI_MODE_SPI) {
+		tp2.why = "USI IN USE";
+		return;
+	}
+	if (tp.gpm_con != 0) {
+		tp2.why = "PINS IN USE";
+		return;
+	}
+	if (tp.panel_id != 6) {
+		tp2.why = "PANEL";
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(a04s_touch_spi_thread, NULL, &thread) != KERN_SUCCESS) {
+		tp2.why = "NO THREAD";
+		return;
+	}
+	thread_deallocate(thread);
+	tp2.why = "STARTED";
+}
+
+/* After a04s_acpm_probe(): the key thread is the only ACPM user from here on. */
+void a04s_input_start(void);
+void
+a04s_input_start(void)
+{
+	vm_offset_t cmu_apm = ml_io_map(CMU_APM_PA, 0x4000);
+	vm_offset_t cmu_peri = ml_io_map(CMU_PERI_PA, 0x4000);
+	vm_offset_t cmu_cmgp = ml_io_map(CMU_CMGP_PA, 0x4000);
+	if (!cmu_apm || !cmu_peri || !cmu_cmgp) {
+		keys_state = ENOMEM;
+		kprintf("A04S 7 NO CMU MAPPING\n");
+		return;
+	}
+	tp.gate[0] = io_rd(cmu_apm, GATE_GPIO_ALIVE);
+	if (gate_running(tp.gate[0])) {
+		alive_pins = ml_io_map(ALIVE_PINS_PA, 0x1000);
+	}
+	a04s_touch_gpu_probe(cmu_peri, cmu_cmgp);
+	kprintf("A04S 7 PROBED\n");
+	extern void a04s_gpu_start(void);
+	a04s_gpu_start();
+	extern void a04s_power_start(void);
+	a04s_power_start();
+	cmu_cmgp_va = cmu_cmgp;
+	a04s_touch_spi_start();
+	if (!alive_pins) {
+		keys_state = gate_running(tp.gate[0]) ? ENOMEM : ENXIO;
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(a04s_keys_thread, NULL, &thread) != KERN_SUCCESS) {
+		keys_state = ENOMEM;
+		return;
+	}
+	thread_deallocate(thread);
+	keys_state = 0;
+}
+
+static const char *
+panel_firmware(int id)
+{
+	/* novatek,fw_name in the live device tree, by fw_sel_idx. */
+	switch (id) {
+	case 2: case 6: return "CSOT";
+	case 3: return "DTC";
+	case 4: return "TIANMA";
+	default: return "NONE";
+	}
+}
+
+void a04s_input_report(void);
+void
+a04s_input_report(void)
+{
+	uint32_t down = key_down;
+	kprintf("KEYS %d %c%c%c EV %u ER %u/%d S1 %02x RAW %x P %u\n", keys_state,
+	    (down & 1u) ? 'P' : '-', (down & 2u) ? 'U' : '-', (down & 4u) ? 'D' : '-',
+	    key_events, key_errors, key_last_error, key_status1, key_raw, key_polls);
+	kprintf("KEYCFG IDLE %x DROP %x CON %x %x\n", key_idle, key_dropped,
+	    tp.gpa0_con, alive_pins ? io_rd(alive_pins, GPA1 + PIN_CON) : 0);
+	kprintf("TP USI %x GT %u%u%u%u%u%u Q %x M %x D %x\n", tp.usi_mode,
+	    gate_code(tp.gate[0]), gate_code(tp.gate[1]), gate_code(tp.gate[2]),
+	    gate_code(tp.gate[3]), gate_code(tp.gate[4]), gate_code(tp.gate[5]), tp.qch, tp.mux, tp.div);
+	kprintf("TP SPI %d %x %x %x UC %x\n", tp.spi_read, tp.spi_cfg, tp.spi_mode, tp.spi_status, tp.usi_con);
+	kprintf("TP PIN %04x D %x INT %x/%u RST %x/%u\n", tp.gpm_con, tp.gpm_dat,
+	    tp.gpa0_con & 0xfu, tp.gpa0_dat & 1u, tp.gpa3_con & 0xfu, tp.gpa3_dat & 1u);
+	kprintf("TP ID %d FW %s\n", tp.panel_id, panel_firmware(tp.panel_id));
+	kprintf("TP2 %d %s USI %x DIV %x CFG %x MODE %x ST %x XF %u TO %u\n", tp2.state, tp2.why,
+	    tp2.usi_back, tp2.div_back, tp2.cfg, tp2.mode, tp2.status, tp2.xfers, tp2.timeouts);
+	kprintf("TP2 ID %02x %02x %02x %02x %02x %02x AT %x TRY %d %s\n", tp2.id[0], tp2.id[1], tp2.id[2],
+	    tp2.id[3], tp2.id[4], tp2.id[5], tp2.addr, tp2.tries, tp2.match ? "NT36525" : "NO MATCH");
+	kprintf("TP3 %d %s TRY %d PARTS %u SENT %u MS %u RST %02x\n", tp3.state, tp3.why, tp3.tries, tp3.parts,
+	    tp3.sent, tp3.ms, tp3.reset_state);
+	kprintf("TP3 CRC %02x ILM %08x/%08x DLM %08x/%08x FW %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    tp3.crc_flag, tp3.g_ilm, tp3.r_ilm, tp3.g_dlm, tp3.r_dlm, tp3.fwinfo[0], tp3.fwinfo[1],
+	    tp3.fwinfo[2], tp3.fwinfo[3], tp3.fwinfo[4], tp3.fwinfo[5], tp3.fwinfo[6], tp3.fwinfo[7]);
+	kprintf("TP4 %d %s P %u E %u INT %u/%u%s RD %u CK %u REC %u XY %u EV %u DOWN %x AT %d,%d M %x\n", tp4.state,
+	    tp4.why, tp4.polls, tp4.edges, tp4.int_low, tp4.int_high, tp4.int_works ? " OK" : "", tp4.reads,
+	    tp4.ck_bad, tp4.recovery, tp4.bad_xy, tp4.events, tp4.down, tp4.last_x, tp4.last_y, tp4.eint_mask & 0xffu);
+	kprintf("GPU PD %x %x %s\n", gpu_pd_config, gpu_pd_status, (gpu_pd_status & 1u) ? "ON" : "OFF");
+	kprintf("GPU CLK %u%u %u%u%u Q %x %x\n", gate_code(gpu.top), gate_code(gpu.core), gate_code(gpu.g3d_pclk),
+	    gate_code(gpu.g3d_gpu), gate_code(gpu.g3d_lhm), gpu.qch_gpu, gpu.qch_lhm);
+	if (gpu.why) {
+		kprintf("GPU ID SKIPPED %s\n", gpu.why);
+	} else {
+		kprintf("GPU ID %08x L2F %x ST %x SC %x L2 %x\n", gpu.id, gpu.l2_features, gpu.status,
+		    gpu.shaders, gpu.l2);
+	}
+	extern void a04s_gpu_report(void);
+	a04s_gpu_report();
+	extern void a04s_power_report(void);
+	a04s_power_report();
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
diff --git a/bsd/dev/a04s_power.c b/bsd/dev/a04s_power.c
new file mode 100644
index 0000000..b23a13c
--- /dev/null
+++ b/bsd/dev/a04s_power.c
@@ -0,0 +1,538 @@
+/*
+ * Galaxy A04s: the battery (fuel gauge), and read-only first looks at the speaker amp and the audio
+ * power domain.
+ *
+ * I2C: the two buses used here are Samsung's plain s3c2440-i2c controllers (live device tree):
+ *  - bus 0, i2c@13830000: the MAX1726x fuel gauge at 0x36. Pins gpp0-0/1, function 2.
+ *  - bus 3, i2c@13860000: the FourSemi FS18xx speaker amp at 0x34. Pins gpp1-0/1, function 2.
+ * The driver below can only read. A transfer sends the device's address and one register number,
+ * then a repeated start and the read: no data byte is ever sent, and there is no write function.
+ * Each device has a fixed list of registers it may read; anything else is refused. A bus is used
+ * only if its CMU_PERI PCLK gate is running, its Q-channel can't stop the clock, both pins have the
+ * I2C function, and the controller isn't busy. The bus runs at
+ * the slowest rate the controller has (PCLK / 512 / 16), far under the 400 kHz both chips take, and
+ * its interrupt-enable bit is set only if the GIC can't deliver that interrupt (S-Boot may have left
+ * an SPI enabled, and XNU has no handler for it). Every poll is bounded.
+ *
+ * Pins (v35): v34 found S-Boot leaves gpp0-0/1 as GPIO outputs (CON 0x11, so it bit-bangs the gauge)
+ * and gpp1-0/1 at reset (inputs, 0x00). pins_to_i2c() sets just those two pins of the bank to
+ * function 2 with pull-up 3, the values in the device tree's i2c0-bus / i2c3-bus nodes, and only
+ * from those two states. Exynos 850 PERI banks have 4-bit CON and PUD fields (Linux
+ * exynos850_bank_type_off: CON +0x0, DAT +0x4, PUD +0x8). The other pins' fields are written back
+ * unchanged, the result is read back, and on a mismatch both registers get their old values again.
+ *
+ * Fuel gauge, with the boot-arg a04sfg=1 (SweetBattery polls it every 30 s; without it iOS gets
+ * SweetBattery's static 100%): Maxim ModelGauge m5 registers, as the S7's MAX77854 (herolte_battery.c).
+ * The device tree's fuelgauge,rsense = 5 (mOhm) and designcap = 0x128e (4750 at 1 mAh a bit) agree:
+ *   RepSOC 0x06 1/256 %, VCell 0x09 78.125 uV, Current 0x0A and AvgCurrent 0x0B signed 312.5 uA
+ *   (positive = charging), RepCap 0x05 and FullCapRep 0x10 1 mAh, Temp 0x08 signed 1/256 C,
+ *   Status 0x00, TTE 0x11, Cycles 0x17, DesignCap 0x18, AvgVCell 0x19, DevName 0x21.
+ * There is no charger driver (the SYV660 keeps S-Boot's settings): a charge current above 20 mA
+ * is what marks a cable, as on the S7.
+ *
+ * Speaker amp, with a04samp=1: its ID and status registers (0x03, 0x00; 16-bit, big-endian), once
+ * at root mount. The amp stays as S-Boot left it.
+ *
+ * Audio power, always: pd-aud's configuration and status in the always-on PMU, and PLL_AUD in
+ * CMU_AUD only when pd-aud is on. Reads only; ABOX itself is not touched.
+ */
+#if defined(ARM64_BOARD_CONFIG_A04S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define GATE_MANUAL             (1u << 20)
+#define GATE_CG_VAL             (1u << 21)
+#define QCH_ENABLE              (1u << 0)
+#define QCH_CLOCK_REQ           (1u << 1)
+#define CMU_PERI_PA             0x10030000u
+#define PERI_PINS_PA            0x139b0000u     /* pinctrl@139b0000: bank CON +0x0 */
+#define GICD_PA                 0x12a01000u
+#define PIN_CON                 0x00u
+#define PIN_DAT                 0x04u
+#define PIN_PUD                 0x08u
+#define PIN_MASK                0xffu           /* pins 0 and 1, 4 bits each */
+#define PIN_FUNC_I2C            0x22u
+#define PIN_PUD_UP              0x33u           /* samsung,pin-pud = 3 */
+#define PIN_WAS_OUT             0x11u           /* as S-Boot leaves gpp0 */
+#define PIN_WAS_IN              0x00u           /* the reset value, as gpp1 */
+#define GICD_ISENABLER          0x100u
+
+/* s3c2440-i2c (Linux i2c-s3c2410.c). */
+#define IICCON                  0x00u
+#define IICSTAT                 0x04u
+#define IICDS                   0x0cu
+#define IICLC                   0x10u
+#define CON_ACKEN               (1u << 7)
+#define CON_TXDIV_512           (1u << 6)
+#define CON_IRQEN               (1u << 5)
+#define CON_IRQPEND             (1u << 4)
+#define CON_SCALE_MAX           0xfu
+#define STAT_MASTER_RX          0x80u
+#define STAT_MASTER_TX          0xc0u
+#define STAT_START              (1u << 5)       /* write: start; read: bus busy */
+#define STAT_TXRXEN             (1u << 4)
+#define STAT_ARBITR             (1u << 3)
+#define STAT_LASTBIT            (1u << 0)       /* 1: no ACK */
+#define LC_FILTER_ON            (1u << 2)
+#define I2C_WAIT_US             5000u
+
+/* pd-aud@11862080 and PLL_AUD (cmucal-sfr.c). */
+#define PD_AUD_PA               0x11862000u
+#define PD_AUD_CONFIG           0x080u
+#define PD_AUD_STATUS           0x084u
+#define CMU_AUD_PA              0x14a00000u
+#define AUD_PLL_CON3            0x10cu
+
+#define FG_ADDR                 0x36u
+#define AMP_ADDR                0x34u
+#define FG_STATUS               0x00u
+#define FG_REPCAP               0x05u
+#define FG_REPSOC               0x06u
+#define FG_TEMP                 0x08u
+#define FG_VCELL                0x09u
+#define FG_CURRENT              0x0au
+#define FG_AVGCURRENT           0x0bu
+#define FG_FULLCAPREP           0x10u
+#define FG_TTE                  0x11u
+#define FG_CYCLES               0x17u
+#define FG_DESIGNCAP            0x18u
+#define FG_AVGVCELL             0x19u
+#define FG_DEVNAME              0x21u
+#define AMP_STATUS              0x00u
+#define AMP_ID                  0x03u
+#define NO_TEMP                 (-9990)         /* tenths of a degree */
+
+struct i2c_bus {
+	const char *name;
+	uint32_t pa, gate_off, qch_off, pin_bank;
+	unsigned gic_id;
+	vm_offset_t va;
+	const char *why;                        /* NULL once usable */
+	uint32_t gate, qch, pins, con0, stat0;
+	uint32_t pins_was, pud_was, dat_was, pud;
+	const char *pinset;                     /* -, ALREADY, SET, UNEXPECTED, NO READBACK */
+	bool irqen;
+	uint32_t xfers, errors;
+	const char *last_error;
+};
+
+static struct i2c_bus buses[2] = {
+	{ .name = "I2C0", .pa = 0x13830000u, .gate_off = 0x203cu, .qch_off = 0x301cu, .pin_bank = 0x020u,
+	  .gic_id = 32u + 0xc4u, .why = "NOT TRIED", .last_error = "-", .pinset = "-" },
+	{ .name = "I2C3", .pa = 0x13860000u, .gate_off = 0x2048u, .qch_off = 0x3028u, .pin_bank = 0x040u,
+	  .gic_id = 32u + 0xc7u, .why = "NOT TRIED", .last_error = "-", .pinset = "-" },
+};
+
+/* The only transfers there are: a device, its bus, its byte order, and the registers it may read. */
+static const uint8_t fg_regs[] = { FG_STATUS, FG_REPCAP, FG_REPSOC, FG_TEMP, FG_VCELL, FG_CURRENT,
+	FG_AVGCURRENT, FG_FULLCAPREP, FG_TTE, FG_CYCLES, FG_DESIGNCAP, FG_AVGVCELL, FG_DEVNAME };
+static const uint8_t amp_regs[] = { AMP_STATUS, AMP_ID };
+struct i2c_dev {
+	unsigned bus;
+	uint8_t addr;
+	bool big_endian;
+	const uint8_t *regs;
+	unsigned nregs;
+};
+enum { DEV_FG = 0, DEV_AMP = 1 };
+static const struct i2c_dev devs[2] = {
+	{ 0, FG_ADDR, false, fg_regs, (unsigned)sizeof(fg_regs) },
+	{ 1, AMP_ADDR, true, amp_regs, (unsigned)sizeof(amp_regs) },
+};
+
+static LCK_GRP_DECLARE(a04s_power_grp, "a04s_power");
+static LCK_MTX_DECLARE(a04s_i2c_mtx, &a04s_power_grp);
+static vm_offset_t peri_va, pins_va, gicd_va;
+
+static struct {
+	const char *state;                      /* OFF, NO BUS, NO CHIP, OK, ERR */
+	uint16_t devname, status, designcap, cycles, tte;
+	unsigned percent, mv, avg_mv, rem, full;
+	int ma, avg_ma, temp_dc;
+	uint32_t reads, bad;
+	bool ok;                                /* the last read worked */
+} fg = { .state = "OFF", .temp_dc = NO_TEMP };
+
+static struct {
+	const char *state;
+	uint16_t id, status;
+} amp = { .state = "OFF" };
+
+static uint32_t pd_aud_config, pd_aud_status, aud_pll;
+static bool aud_pll_read;
+
+static inline uint32_t
+io_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+io_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static bool
+gate_running(uint32_t gate)
+{
+	return !(gate & GATE_MANUAL) || (gate & GATE_CG_VAL);
+}
+
+static bool
+qch_may_stop(uint32_t qch)
+{
+	return (qch & QCH_ENABLE) && !(qch & QCH_CLOCK_REQ);
+}
+
+/*
+ * The one write outside the I2C controllers: the bus's two pins to the I2C function with pull-ups,
+ * pull-ups first so a line is never left floating. Called with a04s_i2c_mtx held, once per bus.
+ */
+static void
+pins_to_i2c(struct i2c_bus *b)
+{
+	uint32_t con = io_rd(pins_va, b->pin_bank + PIN_CON);
+	uint32_t pud = io_rd(pins_va, b->pin_bank + PIN_PUD);
+
+	b->pins_was = con;
+	b->pud_was = pud;
+	b->dat_was = io_rd(pins_va, b->pin_bank + PIN_DAT);
+	if ((con & PIN_MASK) == PIN_FUNC_I2C) {
+		b->pinset = "ALREADY";
+		return;
+	}
+	if ((con & PIN_MASK) != PIN_WAS_OUT && (con & PIN_MASK) != PIN_WAS_IN) {
+		b->pinset = "UNEXPECTED";
+		return;
+	}
+	io_wr(pins_va, b->pin_bank + PIN_PUD, (pud & ~PIN_MASK) | PIN_PUD_UP);
+	io_wr(pins_va, b->pin_bank + PIN_CON, (con & ~PIN_MASK) | PIN_FUNC_I2C);
+	delay(100);
+	uint32_t con2 = io_rd(pins_va, b->pin_bank + PIN_CON);
+	uint32_t pud2 = io_rd(pins_va, b->pin_bank + PIN_PUD);
+	if (con2 != ((con & ~PIN_MASK) | PIN_FUNC_I2C) || pud2 != ((pud & ~PIN_MASK) | PIN_PUD_UP)) {
+		io_wr(pins_va, b->pin_bank + PIN_CON, con);
+		io_wr(pins_va, b->pin_bank + PIN_PUD, pud);
+		b->pinset = "NO READBACK";
+		kprintf("A04S %s PINS NO READBACK CON %x->%x PUD %x->%x, put back\n", b->name, con, con2, pud, pud2);
+		return;
+	}
+	b->pinset = "SET";
+	kprintf("A04S %s PINS SET CON %x->%x PUD %x->%x DAT %x\n", b->name, con, con2, pud, pud2, b->dat_was);
+}
+
+/* Decides whether a bus can be used, and how. Its only write is pins_to_i2c(). */
+static void
+bus_check(struct i2c_bus *b)
+{
+	if (!peri_va) {
+		peri_va = ml_io_map(CMU_PERI_PA, 0x4000);
+	}
+	if (!pins_va) {
+		pins_va = ml_io_map(PERI_PINS_PA, 0x1000);
+	}
+	if (!gicd_va) {
+		gicd_va = ml_io_map(GICD_PA, 0x1000);
+	}
+	if (!peri_va || !pins_va || !gicd_va) {
+		b->why = "NO MAPPING";
+		return;
+	}
+	b->gate = io_rd(peri_va, b->gate_off);
+	b->qch = io_rd(peri_va, b->qch_off);
+	if (!gate_running(b->gate)) {
+		b->why = "GATE";
+		return;
+	}
+	if (qch_may_stop(b->qch)) {
+		b->why = "QCH";
+		return;
+	}
+	if (b->pinset[0] == '-') {
+		pins_to_i2c(b);
+	}
+	b->pins = io_rd(pins_va, b->pin_bank + PIN_CON);
+	b->pud = io_rd(pins_va, b->pin_bank + PIN_PUD);
+	if ((b->pins & PIN_MASK) != PIN_FUNC_I2C) {
+		b->why = "PINS";
+		return;
+	}
+	if (!b->va) {
+		b->va = ml_io_map(b->pa, 0x1000);
+	}
+	if (!b->va) {
+		b->why = "NO MAPPING";
+		return;
+	}
+	b->con0 = io_rd(b->va, IICCON);
+	b->stat0 = io_rd(b->va, IICSTAT);
+	if (b->stat0 & STAT_START) {
+		b->why = "BUSY";
+		return;
+	}
+	uint32_t en = io_rd(gicd_va, GICD_ISENABLER + 4u * (b->gic_id / 32u));
+	b->irqen = !(en & (1u << (b->gic_id % 32u)));
+	b->why = NULL;
+}
+
+static bool
+i2c_wait_pend(struct i2c_bus *b)
+{
+	for (unsigned us = 0; us <= I2C_WAIT_US; us += 5) {
+		if (io_rd(b->va, IICCON) & CON_IRQPEND) {
+			return true;
+		}
+		delay(5);
+	}
+	return false;
+}
+
+static void
+i2c_stop(struct i2c_bus *b, uint32_t mode, uint32_t con)
+{
+	io_wr(b->va, IICSTAT, mode | STAT_TXRXEN);
+	io_wr(b->va, IICCON, con & ~(CON_IRQPEND | CON_ACKEN));
+	for (unsigned us = 0; us <= I2C_WAIT_US && (io_rd(b->va, IICSTAT) & STAT_START); us += 5) {
+		delay(5);
+	}
+}
+
+static bool
+i2c_fail(struct i2c_bus *b, const char *what, uint32_t mode, uint32_t con)
+{
+	b->errors++;
+	b->last_error = what;
+	i2c_stop(b, mode, con);
+	return false;
+}
+
+/*
+ * One 16-bit register: START, address + W, the register number, repeated START, address + R, two
+ * bytes (ACK, then NACK), STOP. Called with a04s_i2c_mtx held.
+ */
+static bool
+i2c_read16(unsigned dev_index, uint8_t reg, uint16_t *value)
+{
+	if (dev_index >= sizeof(devs) / sizeof(devs[0])) {
+		return false;
+	}
+	const struct i2c_dev *d = &devs[dev_index];
+	bool listed = false;
+	for (unsigned i = 0; i < d->nregs; i++) {
+		listed = listed || d->regs[i] == reg;
+	}
+	struct i2c_bus *b = &buses[d->bus];
+	if (!listed || b->why) {
+		return false;
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_START) {
+		b->errors++;
+		b->last_error = "BUSY";
+		return false;
+	}
+	b->xfers++;
+	uint32_t con = CON_ACKEN | CON_TXDIV_512 | CON_SCALE_MAX | (b->irqen ? CON_IRQEN : 0);
+	io_wr(b->va, IICLC, LC_FILTER_ON);
+	io_wr(b->va, IICCON, con);
+	io_wr(b->va, IICSTAT, STAT_MASTER_TX | STAT_TXRXEN);
+	io_wr(b->va, IICDS, (uint32_t)d->addr << 1);
+	delay(1);
+	io_wr(b->va, IICSTAT, STAT_MASTER_TX | STAT_TXRXEN | STAT_START);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT ADDR", STAT_MASTER_TX, con);
+	}
+	uint32_t st = io_rd(b->va, IICSTAT);
+	if (st & STAT_ARBITR) {
+		return i2c_fail(b, "ARBITRATION", STAT_MASTER_TX, con);
+	}
+	if (st & STAT_LASTBIT) {
+		return i2c_fail(b, "NACK ADDR", STAT_MASTER_TX, con);
+	}
+	io_wr(b->va, IICDS, reg);
+	delay(1);
+	io_wr(b->va, IICCON, con);                              /* clears the pending bit: send it */
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT REG", STAT_MASTER_TX, con);
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_LASTBIT) {
+		return i2c_fail(b, "NACK REG", STAT_MASTER_TX, con);
+	}
+	io_wr(b->va, IICSTAT, STAT_MASTER_RX | STAT_TXRXEN);
+	io_wr(b->va, IICDS, ((uint32_t)d->addr << 1) | 1u);
+	delay(1);
+	io_wr(b->va, IICSTAT, STAT_MASTER_RX | STAT_TXRXEN | STAT_START);
+	io_wr(b->va, IICCON, con);
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT RESTART", STAT_MASTER_RX, con);
+	}
+	if (io_rd(b->va, IICSTAT) & STAT_LASTBIT) {
+		return i2c_fail(b, "NACK READ", STAT_MASTER_RX, con);
+	}
+	io_wr(b->va, IICCON, con);                              /* first byte, ACKed */
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT BYTE0", STAT_MASTER_RX, con);
+	}
+	uint8_t b0 = (uint8_t)io_rd(b->va, IICDS);
+	io_wr(b->va, IICCON, con & ~CON_ACKEN);                 /* last byte, NACKed */
+	if (!i2c_wait_pend(b)) {
+		return i2c_fail(b, "TIMEOUT BYTE1", STAT_MASTER_RX, con);
+	}
+	uint8_t b1 = (uint8_t)io_rd(b->va, IICDS);
+	i2c_stop(b, STAT_MASTER_RX, con);
+	*value = d->big_endian ? (uint16_t)((b0 << 8) | b1) : (uint16_t)(b0 | (b1 << 8));
+	return true;
+}
+
+static bool
+fg_reg(uint8_t reg, uint16_t *value)
+{
+	return i2c_read16(DEV_FG, reg, value);
+}
+
+/* For SweetBattery (iokit/Kernel/arm/SweetBattery.cpp). 0 once the gauge has answered. */
+int a04s_fg_init(void);
+int
+a04s_fg_init(void)
+{
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04sfg", &want, sizeof(want));
+	if (want != 1) {
+		fg.state = "OFF";
+		return -1;
+	}
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bus_check(&buses[0]);
+	bool ok = false;
+	if (buses[0].why) {
+		fg.state = "NO BUS";
+	} else if (!fg_reg(FG_DEVNAME, &fg.devname) || fg.devname == 0 || fg.devname == 0xffffu) {
+		fg.state = "NO CHIP";
+	} else {
+		(void)fg_reg(FG_DESIGNCAP, &fg.designcap);
+		fg.state = "OK";
+		ok = true;
+	}
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	kprintf("A04S FG %s %s DEV %04x\n", fg.state, buses[0].why ? buses[0].why : buses[0].last_error, fg.devname);
+	return ok ? 0 : -1;
+}
+
+int a04s_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah);
+int
+a04s_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah)
+{
+	uint16_t soc, vcell, avgv, cur, avgc, rem, full, temp, status, cycles, tte;
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bool ok = fg_reg(FG_REPSOC, &soc) && fg_reg(FG_VCELL, &vcell) && fg_reg(FG_CURRENT, &cur) &&
+	    fg_reg(FG_REPCAP, &rem) && fg_reg(FG_FULLCAPREP, &full) && fg_reg(FG_TEMP, &temp) &&
+	    fg_reg(FG_AVGVCELL, &avgv) && fg_reg(FG_AVGCURRENT, &avgc) && fg_reg(FG_STATUS, &status) &&
+	    fg_reg(FG_CYCLES, &cycles) && fg_reg(FG_TTE, &tte);
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	fg.reads++;
+	fg.ok = ok;
+	if (!ok) {
+		fg.bad++;
+		fg.state = "ERR";
+		return -1;
+	}
+	fg.percent = ((unsigned)soc + 128u) >> 8;
+	if (fg.percent > 100) {
+		fg.percent = 100;
+	}
+	fg.mv = (unsigned)vcell * 5u / 64u;                     /* 78.125 uV */
+	fg.avg_mv = (unsigned)avgv * 5u / 64u;
+	fg.ma = (int)(int16_t)cur * 5 / 16;                     /* 312.5 uA */
+	fg.avg_ma = (int)(int16_t)avgc * 5 / 16;
+	fg.rem = rem;
+	fg.full = full;
+	fg.temp_dc = (int)(int16_t)temp * 10 / 256;
+	fg.status = status;
+	fg.cycles = cycles;
+	fg.tte = tte;
+	fg.state = "OK";
+	*percent = fg.percent;
+	*mv = fg.mv;
+	*ma = fg.ma;
+	*rem_mah = fg.rem;
+	*full_mah = fg.full;
+	return 0;
+}
+
+/* The gauge's last temperature in tenths of a degree, or NO_TEMP (-9990). For the thermal monitor. */
+int a04s_fg_temp_dc(void);
+int
+a04s_fg_temp_dc(void)
+{
+	if (!fg.ok || fg.temp_dc < -300 || fg.temp_dc > 900) {
+		return NO_TEMP;
+	}
+	return fg.temp_dc;
+}
+
+/* Called from a04s_input_start() at root mount. */
+void a04s_power_start(void);
+void
+a04s_power_start(void)
+{
+	vm_offset_t pmu = ml_io_map(PD_AUD_PA, 0x1000);
+	if (pmu) {
+		pd_aud_config = io_rd(pmu, PD_AUD_CONFIG);
+		pd_aud_status = io_rd(pmu, PD_AUD_STATUS);
+	}
+	if (pd_aud_status & 1u) {
+		vm_offset_t aud = ml_io_map(CMU_AUD_PA, 0x1000);
+		if (aud) {
+			aud_pll = io_rd(aud, AUD_PLL_CON3);
+			aud_pll_read = true;
+		}
+	}
+	unsigned want = 0;
+	(void)PE_parse_boot_argn("a04samp", &want, sizeof(want));
+	if (want != 1) {
+		return;
+	}
+	lck_mtx_lock(&a04s_i2c_mtx);
+	bus_check(&buses[1]);
+	if (buses[1].why) {
+		amp.state = "NO BUS";
+	} else if (i2c_read16(DEV_AMP, AMP_ID, &amp.id) && i2c_read16(DEV_AMP, AMP_STATUS, &amp.status)) {
+		amp.state = "OK";
+	} else {
+		amp.state = "NO CHIP";
+	}
+	lck_mtx_unlock(&a04s_i2c_mtx);
+	kprintf("A04S AMP %s ID %04x ST %04x\n", amp.state, amp.id, amp.status);
+}
+
+void a04s_power_report(void);
+void
+a04s_power_report(void)
+{
+	for (unsigned i = 0; i < 2; i++) {
+		struct i2c_bus *b = &buses[i];
+		kprintf("%s %s G %x Q %x PIN %x PUD %x (WAS %x/%x DAT %x %s) CON %x ST %x IRQ %d XF %u ERR %u %s\n",
+		    b->name, b->why ? b->why : "OK", b->gate, b->qch, b->pins & PIN_MASK, b->pud & PIN_MASK,
+		    b->pins_was & PIN_MASK, b->pud_was & PIN_MASK, b->dat_was & 3u, b->pinset, b->con0, b->stat0,
+		    b->irqen ? 1 : 0, b->xfers, b->errors, b->last_error);
+	}
+	kprintf("FG %s DEV %04x %u%% %u MV (AVG %u) %d MA (AVG %d) CAP %u/%u DES %u T %d.%d ST %04x CYC %u TTE %u N %u/%u\n",
+	    fg.state, fg.devname, fg.percent, fg.mv, fg.avg_mv, fg.ma, fg.avg_ma, fg.rem, fg.full, fg.designcap,
+	    fg.temp_dc / 10, (fg.temp_dc < 0 ? -fg.temp_dc : fg.temp_dc) % 10, fg.status, fg.cycles, fg.tte,
+	    fg.reads, fg.bad);
+	kprintf("AUD PD %x %x %s PLL %s%08x AMP %s ID %04x ST %04x\n", pd_aud_config, pd_aud_status,
+	    (pd_aud_status & 1u) ? "ON" : "OFF", aud_pll_read ? "" : "NOT READ ", aud_pll, amp.state, amp.id,
+	    amp.status);
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
