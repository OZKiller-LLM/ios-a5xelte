+#if defined(ARM64_BOARD_CONFIG_A04S)
+/* v64: 8 PanSubmit. With fLock held. */
+IOReturn
+HeroGPUUserClient::panSubmit(const uint8_t *in, uint32_t size)
+{
+	struct herogpu_pan_submit s;
+	if (size < sizeof(s)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&s, in, sizeof(s));
+	if (s.bo_handle_count > HEROGPU_MAX_SUBMIT_BOS || s.in_sync_count > HEROGPU_MAX_IN_SYNCS ||
+	    size != sizeof(s) + 4u * (s.bo_handle_count + s.in_sync_count)) {
+		return kIOReturnBadArgument;
+	}
+	const uint8_t *bh = in + sizeof(s), *ih = bh + 4u * s.bo_handle_count;
+	for (uint32_t i = 0; i < s.bo_handle_count; i++) {
+		if (bo(herogpu_u32(bh + 4u * i)) == NULL) {
+			return kIOReturnBadArgument;
+		}
+	}
+	for (uint32_t i = 0; i < s.in_sync_count; i++) {
+		if (sync(herogpu_u32(ih + 4u * i)) == NULL) {
+			return kIOReturnBadArgument;
+		}
+	}
+	if (s.out_sync != 0 && sync(s.out_sync) == NULL) {
+		return kIOReturnBadArgument;
+	}
+	uint32_t nd = s.in_sync_count + s.bo_handle_count;
+	struct a04s_fence **deps = nd != 0 ? IONewZero(struct a04s_fence *, nd) : NULL;
+	struct herogpu_bo **bos = s.bo_handle_count != 0 ? IONewZero(struct herogpu_bo *, s.bo_handle_count) : NULL;
+	struct herogpu_job_ctx *ctx = IOMallocType(struct herogpu_job_ctx);
+	if ((nd != 0 && deps == NULL) || (s.bo_handle_count != 0 && bos == NULL) || ctx == NULL) {
+		if (deps != NULL) {
+			IODelete(deps, struct a04s_fence *, nd);
+		}
+		if (bos != NULL) {
+			IODelete(bos, struct herogpu_bo *, s.bo_handle_count);
+		}
+		if (ctx != NULL) {
+			IOFreeType(ctx, struct herogpu_job_ctx);
+		}
+		return kIOReturnNoMemory;
+	}
+	uint32_t k = 0;
+	for (uint32_t i = 0; i < s.in_sync_count; i++) {
+		deps[k++] = sync(herogpu_u32(ih + 4u * i))->fence;       /* NULL (no fence yet) is skipped */
+	}
+	for (uint32_t i = 0; i < s.bo_handle_count; i++) {
+		struct herogpu_bo *b = bo(herogpu_u32(bh + 4u * i));
+		deps[k++] = b->last;                                       /* implicit sync */
+		__atomic_add_fetch(&b->refs, 1u, __ATOMIC_RELAXED);        /* the job's */
+		bos[i] = b;
+	}
+	ctx->bos = bos;
+	ctx->n = s.bo_handle_count;
+	/* a04s_gpu_queue() takes its own references on deps before it returns (we hold fLock meanwhile). */
+	struct a04s_fence *f = a04s_gpu_queue(fAS, (s.requirements & HEROGPU_REQ_FS) ? 0 : 1, s.jc, deps, nd,
+	    herogpu_job_retire, ctx);
+	if (deps != NULL) {
+		IODelete(deps, struct a04s_fence *, nd);
+	}
+	if (f == NULL) {
+		return kIOReturnNoMemory;                     /* ctx was retired */
+	}
+	for (uint32_t i = 0; i < s.bo_handle_count; i++) {
+		struct herogpu_bo *b = bo(herogpu_u32(bh + 4u * i));
+		if (b->last != f) {
+			a04s_fence_retain(f);
+			a04s_fence_release(b->last);
+			b->last = f;
+		}
+	}
+	if (s.out_sync != 0) {
+		struct herogpu_syncobj *so = sync(s.out_sync);
+		a04s_fence_retain(f);
+		a04s_fence_release(so->fence);
+		so->fence = f;
+	}
+	a04s_fence_release(f);
+	return kIOReturnSuccess;
+}
+
+/* v64: 9 PanWaitBO. Drops fLock while waiting. */
+IOReturn
+HeroGPUUserClient::panWaitBO(const uint8_t *in, uint32_t size)
+{
+	struct herogpu_pan_wait_bo w;
+	if (size != sizeof(w)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&w, in, sizeof(w));
+	struct herogpu_bo *b = bo(w.handle);
+	if (b == NULL) {
+		return kIOReturnBadArgument;
+	}
+	struct a04s_fence *f = b->last;
+	if (f == NULL) {
+		return kIOReturnSuccess;
+	}
+	a04s_fence_retain(f);
+	uint64_t deadline = a04s_gpu_deadline(w.timeout_ns);
+	IOLockUnlock(fLock);
+	int err = a04s_fence_wait(&f, 1, true, deadline, NULL);
+	IOLockLock(fLock);
+	a04s_fence_release(f);
+	return herogpu_wait_ret(err);
+}
+
+/* v64: 10 PanMadvise. Nothing is ever purged here: retained is always 1. */
+IOReturn
+HeroGPUUserClient::panMadvise(const uint8_t *in, uint32_t size)
+{
+	struct herogpu_pan_madvise m;
+	if (size != sizeof(m)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&m, in, sizeof(m));
+	return bo(m.handle) != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+}
+
+/* v64: 11 SyncobjCreate. */
+IOReturn
+HeroGPUUserClient::syncCreate(const uint8_t *in, uint32_t size, uint64_t *handle)
+{
+	struct herogpu_syncobj_create c;
+	if (size != sizeof(c)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&c, in, sizeof(c));
+	if (c.flags & ~HEROGPU_SYNC_SIGNALED) {
+		return kIOReturnBadArgument;
+	}
+	if (fSync == NULL) {
+		fSync = IONewZero(struct herogpu_syncobj, HEROGPU_MAX_SYNCOBJS);
+		if (fSync == NULL) {
+			return kIOReturnNoMemory;
+		}
+	}
+	unsigned i = 0;
+	while (i < HEROGPU_MAX_SYNCOBJS && fSync[i].used) {
+		i++;
+	}
+	if (i == HEROGPU_MAX_SYNCOBJS) {
+		return kIOReturnNoResources;
+	}
+	struct a04s_fence *f = NULL;
+	if (c.flags & HEROGPU_SYNC_SIGNALED) {
+		f = a04s_fence_create(true);
+		if (f == NULL) {
+			return kIOReturnNoMemory;
+		}
+	}
+	fSync[i].fence = f;
+	fSync[i].used = 1;
+	*handle = i + 1;
+	return kIOReturnSuccess;
+}
+
+/* v64: 12 SyncobjDestroy. */
+IOReturn
+HeroGPUUserClient::syncDestroy(const uint8_t *in, uint32_t size)
+{
+	struct herogpu_syncobj_destroy d;
+	if (size != sizeof(d)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&d, in, sizeof(d));
+	struct herogpu_syncobj *so = sync(d.handle);
+	if (so == NULL) {
+		return kIOReturnBadArgument;
+	}
+	a04s_fence_release(so->fence);
+	so->fence = NULL;
+	so->used = 0;
+	return kIOReturnSuccess;
+}
+
+/*
+ * v64: 13 SyncobjWait. Drops fLock while waiting. With WAIT_FOR_SUBMIT (or WAIT_AVAILABLE) a syncobj
+ * with no fence yet is waited for: the handles are looked at again every 2 ms.
+ */
+IOReturn
+HeroGPUUserClient::syncWait(const uint8_t *in, uint32_t size, uint64_t *first)
+{
+	struct herogpu_syncobj_wait w;
+	if (size < sizeof(w)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&w, in, sizeof(w));
+	if (w.count_handles == 0 || w.count_handles > HEROGPU_MAX_SYNCOBJS ||
+	    size != sizeof(w) + 4u * w.count_handles ||
+	    (w.flags & ~(HEROGPU_WAIT_ALL | HEROGPU_WAIT_FOR_SUBMIT | HEROGPU_WAIT_AVAILABLE | HEROGPU_WAIT_DEADLINE))) {
+		return kIOReturnBadArgument;
+	}
+	const uint8_t *hs = in + sizeof(w);
+	uint32_t n = w.count_handles;
+	bool all = (w.flags & HEROGPU_WAIT_ALL) != 0;
+	bool forSubmit = (w.flags & (HEROGPU_WAIT_FOR_SUBMIT | HEROGPU_WAIT_AVAILABLE)) != 0;
+	struct a04s_fence **fs = IONewZero(struct a04s_fence *, n);
+	if (fs == NULL) {
+		return kIOReturnNoMemory;
+	}
+	uint64_t deadline = a04s_gpu_deadline(w.timeout_nsec);
+	IOReturn ret = kIOReturnSuccess;
+	for (;;) {
+		bool missing = false;
+		for (uint32_t i = 0; i < n; i++) {
+			struct herogpu_syncobj *so = sync(herogpu_u32(hs + 4u * i));
+			if (so == NULL) {
+				ret = kIOReturnBadArgument;    /* bad, or destroyed while we waited */
+				break;
+			}
+			fs[i] = so->fence;
+			a04s_fence_retain(fs[i]);
+			if (fs[i] == NULL) {
+				missing = true;
+			}
+		}
+		if (ret == kIOReturnSuccess && missing && !forSubmit) {
+			ret = kIOReturnBadArgument;            /* Linux: -EINVAL without WAIT_FOR_SUBMIT */
+		}
+		int err = ETIMEDOUT;
+		uint64_t until = deadline;
+		unsigned firstIdx = 0;
+		if (ret == kIOReturnSuccess) {
+			if (missing) {
+				uint64_t slice = a04s_gpu_deadline(HEROGPU_SUBMIT_SLICE_NS);
+				if (slice < until) {
+					until = slice;
+				}
+			}
+			IOLockUnlock(fLock);
+			err = a04s_fence_wait(fs, n, all, until, &firstIdx);
+			IOLockLock(fLock);
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			a04s_fence_release(fs[i]);
+			fs[i] = NULL;
+		}
+		if (ret != kIOReturnSuccess) {
+			break;
+		}
+		if (err == 0) {
+			*first = firstIdx;
+			break;
+		}
+		if (err != ETIMEDOUT || until == deadline) {
+			ret = herogpu_wait_ret(err);
+			break;
+		}
+		/* the 2 ms look-again for WAIT_FOR_SUBMIT: go round */
+	}
+	IODelete(fs, struct a04s_fence *, n);
+	return ret;
+}
