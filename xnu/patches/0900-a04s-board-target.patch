+#if defined(A04S)
+/* Stage 8 trace: A5XELTE_MARKER_PA + 0x80, 32 bytes per logical CPU (osfmk/arm64/start.s). */
+extern "C" {
+volatile uint64_t *a04s_smp_trace;
+}
+
+static void
+a04s_smp_trace_print(unsigned int cpu)
+{
+	if (a04s_smp_trace == NULL || cpu >= 8) {
+		return;
+	}
+	volatile uint64_t *t = a04s_smp_trace + cpu * 4;
+	IOLog(CPU_PORT_NAME " CPU: cpu=%u trace step %llx EL %llu mpidr %llx sctlr %llx\n", cpu,
+	    t[0], t[1] >> 2, t[2], t[3]);
+}
+
+/* Stage 8 diagnostics (v29). v28: CPU1 took PSCI CPU_ON (rc 0) and ran none of
+ * sweet_secondary_entry (trace step 0, nothing written). Read-only apart from a cache clean of
+ * the entry code. Shown: the firmware's view (PSCI AFFINITY_INFO: 0 on, 1 off, 2 on pending),
+ * the always-on PMU's view of the core (pmu@11860000, CPU_INFORM at 0x860 and the per-CPU
+ * block at 0x1000 + 0x400 * cluster + 0x80 * core, as in mainline's exynos850-pmu.c), and
+ * whether DRAM holds the entry code that a core with its MMU and caches off fetches. */
+#define A04S_PMU_PA             0x11860000UL
+#define A04S_PMU_SIZE           0x2000UL
+#define A04S_PMU_INFORM(c)      (0x0860 + ((c) & 7) * 4)
+#define A04S_PMU_CPU(c)         (0x1000 + (((c) >> 2) & 1) * 0x400 + ((c) & 3) * 0x80)
+#define A04S_PSCI_VERSION       0x84000000ULL
+#define A04S_PSCI_FEATURES      0x8400000AULL
+#define A04S_PSCI_CPU_ON        0xC4000003ULL
+#define A04S_PSCI_AFFINITY_INFO 0xC4000004ULL
+static volatile uint32_t *a04s_pmu;
+
+/* SMCCC 1.0: x0 is the signed 32-bit PSCI result; do not assume x1-x17 survive. */
+static int64_t
+a04s_psci(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int64_t)(int32_t)(uint32_t)x0;
+}
+
+static int64_t
+a04s_affinity(uint32_t mpidr)
+{
+	return a04s_psci(A04S_PSCI_AFFINITY_INFO, mpidr, 0, 0);
+}
+
+static volatile uint32_t *
+a04s_pmu_cpu(unsigned int c)
+{
+	if (a04s_pmu == NULL) {
+		a04s_pmu = (volatile uint32_t *)ml_io_map(A04S_PMU_PA, A04S_PMU_SIZE);
+	}
+	return a04s_pmu == NULL ? NULL : a04s_pmu + A04S_PMU_CPU(c) / 4;
+}
+
+static void
+a04s_pmu_print(const char *when, unsigned int c)
+{
+	volatile uint32_t *r = a04s_pmu_cpu(c);
+	if (r == NULL) {
+		IOLog(CPU_PORT_NAME " CPU: %s cpu=%u PMU not mapped\n", when, c);
+		return;
+	}
+	IOLog(CPU_PORT_NAME " CPU: %s cpu=%u PMU %x %x %x %x int %x inf %x\n", when, c,
+	    r[0], r[1], r[2], r[3], r[0x44 / 4], a04s_pmu[A04S_PMU_INFORM(c) / 4]);
+}
+
+static void
+a04s_pre_cpu_on(unsigned int c, uint32_t mpidr, vm_offset_t entry_pa)
+{
+	IOLog(CPU_PORT_NAME " CPU: PSCI ver %llx CPU_ON feat %lld aff(0x%x) %lld\n",
+	    (unsigned long long)a04s_psci(A04S_PSCI_VERSION, 0, 0, 0),
+	    a04s_psci(A04S_PSCI_FEATURES, A04S_PSCI_CPU_ON, 0, 0), mpidr, a04s_affinity(mpidr));
+	a04s_pmu_print("before", 0);
+	a04s_pmu_print("before", c);
+	/* Last, so the lines above are on screen if this alias of kernel text is refused. */
+	const volatile uint32_t *k = (const volatile uint32_t *)(uintptr_t)&sweet_secondary_entry;
+	vm_offset_t page = ml_io_map(entry_pa & ~(vm_offset_t)PAGE_MASK, PAGE_SIZE);
+	if (page == 0) {
+		IOLog(CPU_PORT_NAME " CPU: entry DRAM alias not mapped\n");
+		return;
+	}
+	volatile uint32_t *d = (volatile uint32_t *)(page + (entry_pa & PAGE_MASK));
+	uint32_t d0 = d[0], d1 = d[1];
+	for (uintptr_t a = (uintptr_t)k & ~(uintptr_t)63; a < (uintptr_t)k + 0x400; a += 64) {
+		__asm__ volatile("dc cvac, %0" : : "r"(a) : "memory");
+	}
+	__builtin_arm_dsb(DSB_SY);
+	IOLog(CPU_PORT_NAME " CPU: entry %08x %08x DRAM %08x %08x cleaned %08x %08x\n",
+	    k[0], k[1], d0, d1, d[0], d[1]);
+}
+
+/* Called about every millisecond while the boot CPU waits; prints only changes. */
+static void
+a04s_watch(unsigned int c, uint32_t mpidr)
+{
+	static unsigned int ticks, lines;
+	static int64_t last_aff = -100;
+	static uint32_t last_st = 0xdeadbeefu;
+	static uint64_t last_step = ~0ULL;
+	if (c == 0 || ++ticks % 200 != 0 || lines >= 6) {
+		return;
+	}
+	volatile uint32_t *r = a04s_pmu_cpu(c);
+	int64_t aff = a04s_affinity(mpidr);
+	uint32_t st = r == NULL ? 0xffffffffu : r[1];
+	uint64_t step = a04s_smp_trace == NULL ? 0 : a04s_smp_trace[c * 4];
+	if (aff == last_aff && st == last_st && step == last_step) {
+		return;
+	}
+	last_aff = aff;
+	last_st = st;
+	last_step = step;
+	lines++;
+	IOLog(CPU_PORT_NAME " CPU: wait tick %u cpu=%u aff %lld PMU st %x step %llx\n", ticks, c,
+	    aff, st, step);
