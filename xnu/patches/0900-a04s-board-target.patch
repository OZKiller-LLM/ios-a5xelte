diff --git a/bsd/dev/a04s_acpm.c b/bsd/dev/a04s_acpm.c
new file mode 100644
index 0000000..e9ac908
--- /dev/null
+++ b/bsd/dev/a04s_acpm.c
@@ -0,0 +1,323 @@
+/*
+ * Galaxy A04s: ACPM, the mailbox protocol of the APM core, to the S2MPU12 PMIC and the
+ * AUD3004X codec on the same bus. A write there can change a supply voltage, so this file
+ * builds reads, and single-register writes that a04s_acpm_guard.h allows: the codec's capture
+ * path, and nothing on the PMIC. tools/check_acpm_source.py refuses anything else, and
+ * tools/check_kernel_acpm.py checks the guard's table in the built kernel.
+ * The protocol follows Samsung's drivers/soc/samsung/acpm (acpm_ipc.c, acpm_mfd.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_A04S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <stdbool.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include "a04s_acpm_guard.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t mach_absolute_time(void);
+
+#define ACPM_MBOX_PA           0x11900000u     /* acpm_ipc reg 0 */
+#define ACPM_MBOX_SIZE          0x1000u
+#define ACPM_SRAM_PA            0x02039000u     /* acpm_ipc reg 1 */
+#define ACPM_SRAM_SIZE          0x30000u
+#define ACPM_INITDATA           0x7000u         /* acpm_ipc initdata-base */
+#define ACPM_MFD_CHANNEL        2u              /* s2mpu12mfd acpm-ipc-channel */
+#define ACPM_TICKS_PER_MS       26000u
+#define ACPM_TIMEOUT_MS         50u
+
+/* Mailbox registers: INTGR0 rings the APM, INTSR1/INTCR1 are its replies to the AP. */
+#define INTGR0                  0x0008u
+#define INTCR1                  0x0020u
+#define INTSR1                  0x0028u
+
+/* struct acpm_framework, fw_header/framework.h: the two fields used. */
+#define FW_IPC_CHANNELS         0x08u
+#define FW_IPC_AP_MAX           0x18u
+/* struct ipc_channel: id, field, owner, type, struct channel_info, ap_poll. */
+#define CH_SIZE                 0x48u
+#define CH_ID                   0x00u
+#define CH_IN_REAR              0x10u           /* channel_info.rx_*: what the APM receives */
+#define CH_IN_FRONT             0x14u
+#define CH_IN_BASE              0x18u
+#define CH_OUT_REAR             0x28u           /* channel_info.tx_*: its replies */
+#define CH_OUT_FRONT            0x2cu
+#define CH_OUT_BASE             0x30u
+#define CH_Q_LEN                0x34u
+#define CH_Q_ELEM_SIZE          0x38u
+#define CH_AP_POLL              0x44u
+
+/* cmd[0]: register, bus address, bus channel, sequence. cmd[1]: function, then the reply. */
+#define ACPM_SEQ_SHIFT          16
+#define ACPM_FUNC_READ          0u              /* acpm_mfd.h FUNC_READ */
+#define ACPM_FUNC_WRITE         1u              /* acpm_mfd.h FUNC_WRITE: built in acpm_write() alone */
+#define ACPM_DEST(word)         (((word) >> 8) & 0xffu)
+#define ACPM_RETURN(word)       (((word) >> 24) & 0xffu)
+
+struct a04s_acpm_queue {
+	uint32_t rear, front, base;
+};
+
+static vm_offset_t acpm_mbox, acpm_sram;
+static uint32_t acpm_id, acpm_len, acpm_elem, acpm_seq;
+static struct a04s_acpm_queue acpm_in, acpm_out;
+static int acpm_error = -1;
+
+/* Shown by the heartbeat: the PMIC's revision, codec registers, and the guarded write test. */
+static uint8_t acpm_pmic_rev, acpm_mic_bias, acpm_mic_gain;
+static uint8_t acpm_codec[4], acpm_otp[4], acpm_set_back, acpm_ldo33, acpm_ldo34;
+/* pd-aud@11862080 in the always-on PMU: readable whether the audio block is powered or not. */
+#define PD_AUD_PA               0x11862000u
+#define PD_AUD_CONFIG           0x080u
+#define PD_AUD_STATUS           0x084u
+static uint32_t pd_aud_config, pd_aud_status;
+static bool acpm_guard_ok, acpm_writes_ok;
+static int acpm_write_test = -1;
+static uint32_t acpm_refused;
+
+static inline uint32_t
+sram_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(acpm_sram + off);
+}
+
+static inline void
+sram_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(acpm_sram + off) = value;
+}
+
+static inline uint32_t
+mbox_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(acpm_mbox + off);
+}
+
+static inline void
+mbox_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(acpm_mbox + off) = value;
+}
+
+static int
+acpm_setup(void)
+{
+	acpm_mbox = ml_io_map(ACPM_MBOX_PA, ACPM_MBOX_SIZE);
+	acpm_sram = ml_io_map(ACPM_SRAM_PA, ACPM_SRAM_SIZE);
+	if (!acpm_mbox || !acpm_sram) {
+		return ENOMEM;
+	}
+	uint32_t table = sram_rd(ACPM_INITDATA + FW_IPC_CHANNELS);
+	uint32_t count = sram_rd(ACPM_INITDATA + FW_IPC_AP_MAX);
+	if (count == 0 || count > 32 || table == 0 || table + count * CH_SIZE > ACPM_SRAM_SIZE) {
+		return ENXIO;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t ch = table + i * CH_SIZE;
+		if (sram_rd(ch + CH_ID) != ACPM_MFD_CHANNEL) {
+			continue;
+		}
+		/* Samsung's driver polls this channel; an interrupt channel would need a handler. */
+		if (!sram_rd(ch + CH_AP_POLL)) {
+			return ENOTSUP;
+		}
+		acpm_id = ACPM_MFD_CHANNEL;
+		acpm_len = sram_rd(ch + CH_Q_LEN);
+		acpm_elem = sram_rd(ch + CH_Q_ELEM_SIZE);
+		acpm_in = (struct a04s_acpm_queue){ sram_rd(ch + CH_IN_REAR), sram_rd(ch + CH_IN_FRONT), sram_rd(ch + CH_IN_BASE) };
+		acpm_out = (struct a04s_acpm_queue){ sram_rd(ch + CH_OUT_REAR), sram_rd(ch + CH_OUT_FRONT), sram_rd(ch + CH_OUT_BASE) };
+		if (acpm_len < 2 || acpm_len > 64 || acpm_elem < 16 || acpm_elem > 64 ||
+		    acpm_in.base + acpm_len * acpm_elem > ACPM_SRAM_SIZE ||
+		    acpm_out.base + acpm_len * acpm_elem > ACPM_SRAM_SIZE ||
+		    acpm_in.front >= ACPM_SRAM_SIZE || acpm_in.rear >= ACPM_SRAM_SIZE ||
+		    acpm_out.front >= ACPM_SRAM_SIZE || acpm_out.rear >= ACPM_SRAM_SIZE) {
+			return ENXIO;
+		}
+		return 0;
+	}
+	return ENOENT;
+}
+
+static bool
+acpm_timed_out(uint64_t start)
+{
+	return mach_absolute_time() - start > (uint64_t)ACPM_TICKS_PER_MS * ACPM_TIMEOUT_MS;
+}
+
+/* Queue one command, ring the APM, and wait for the reply with the same sequence number. */
+static int __attribute__((noinline))
+acpm_transfer(uint32_t cmd[4])
+{
+	uint32_t front = sram_rd(acpm_in.front), next = (front + 1) % acpm_len;
+	uint64_t start = mach_absolute_time();
+	while (next == sram_rd(acpm_in.rear)) {
+		if (acpm_timed_out(start)) {
+			return EBUSY;
+		}
+	}
+	if (++acpm_seq == 64) {
+		acpm_seq = 1;
+	}
+	cmd[0] |= acpm_seq << ACPM_SEQ_SHIFT;
+	for (uint32_t w = 0; w < acpm_elem / 4; w++) {
+		sram_wr(acpm_in.base + front * acpm_elem + w * 4, w < 4 ? cmd[w] : 0);
+	}
+	sram_wr(acpm_in.front, next);
+	mbox_wr(INTGR0, (1u << acpm_id) << 16);
+
+	start = mach_absolute_time();
+	for (;;) {
+		if (mbox_rd(INTSR1) & (1u << acpm_id)) {
+			uint32_t rear = sram_rd(acpm_out.rear), last = sram_rd(acpm_out.front);
+			for (uint32_t i = rear; i != last; i = (i + 1) % acpm_len) {
+				uint32_t at = acpm_out.base + i * acpm_elem;
+				if (((sram_rd(at) >> ACPM_SEQ_SHIFT) & 0x3fu) != acpm_seq) {
+					continue;
+				}
+				for (uint32_t w = 0; w < 4; w++) {
+					cmd[w] = sram_rd(at + w * 4);
+				}
+				/* As Samsung's driver: the oldest reply moves into the slot taken. */
+				if (i != rear) {
+					for (uint32_t w = 0; w < acpm_elem / 4; w++) {
+						sram_wr(at + w * 4, sram_rd(acpm_out.base + rear * acpm_elem + w * 4));
+					}
+				}
+				rear = (rear + 1) % acpm_len;
+				sram_wr(acpm_out.rear, rear);
+				if (rear == sram_rd(acpm_out.front)) {
+					mbox_wr(INTCR1, 1u << acpm_id);
+				}
+				return 0;
+			}
+		}
+		if (acpm_timed_out(start)) {
+			return ETIMEDOUT;
+		}
+	}
+}
+
+/* One register from a device on the PMIC's bus. */
+static int __attribute__((noinline))
+acpm_read(uint32_t bus_addr, uint32_t reg, uint8_t *value)
+{
+	uint32_t cmd[4] = { 0 };
+	cmd[0] = (reg & 0xffu) | ((bus_addr & 0xfu) << 8);
+	cmd[1] = ACPM_FUNC_READ;
+	int error = acpm_transfer(cmd);
+	if (error) {
+		return error;
+	}
+	if (ACPM_RETURN(cmd[1])) {
+		return EIO;
+	}
+	*value = (uint8_t)ACPM_DEST(cmd[1]);
+	return 0;
+}
+
+/* One codec register, if a04s_acpm_guard.h allows it. The only write this file builds. */
+static int __attribute__((noinline))
+acpm_write(uint32_t bus_addr, uint32_t reg, uint8_t value)
+{
+	if (!acpm_writes_ok || !a04s_acpm_write_allowed(bus_addr, reg)) {
+		acpm_refused++;
+		return EPERM;
+	}
+	uint32_t cmd[4] = { 0 };
+	cmd[0] = (reg & 0xffu) | ((bus_addr & 0xfu) << 8);
+	cmd[1] = ACPM_FUNC_WRITE | ((uint32_t)value << 8);
+	/* The APM takes the bus address and register from cmd[0] alone: check what it holds. */
+	if (!a04s_acpm_write_allowed((cmd[0] >> 8) & 0xfu, cmd[0] & 0xffu)) {
+		acpm_refused++;
+		return EPERM;
+	}
+	int error = acpm_transfer(cmd);
+	if (error) {
+		return error;
+	}
+	return ACPM_RETURN(cmd[1]) ? EIO : 0;
+}
+
+/* The registers Samsung's own drivers read first: s2mpu12-core.c, then aud3004x.c. */
+void a04s_acpm_probe(void);
+void
+a04s_acpm_probe(void)
+{
+	acpm_guard_ok = a04s_acpm_guard_self_test();
+	int want_writes = 0;
+	(void)PE_parse_boot_argn("acpmwrite", &want_writes, sizeof(want_writes));
+	acpm_error = acpm_setup();
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x00, 0x04, &acpm_pmic_rev);     /* S2MPU12_PMIC_CHIPID */
+	}
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x08, 0x10, &acpm_mic_bias);     /* AUD3004X_110_PD_REF */
+	}
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x08, 0x34, &acpm_mic_gain);     /* AUD3004X_134_VOL_AD1 */
+	}
+	/* Digital-block settings Android left: not all zero means the codec itself answers. */
+	static const uint8_t codec_regs[4] = { 0x16, 0x20, 0x34, 0x37 };
+	for (unsigned i = 0; i < 4 && !acpm_error; i++) {
+		acpm_error = acpm_read(0x07, codec_regs[i], &acpm_codec[i]);
+	}
+	/* The codec's supplies, vdd_aldo1 and vdd_aldo2: enable bits 7:6, voltage 5:0. Reads only. */
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x01, 0x4B, &acpm_ldo33);        /* S2MPU12_PMIC_L33CTRL */
+	}
+	if (!acpm_error) {
+		acpm_error = acpm_read(0x01, 0x4C, &acpm_ldo34);        /* S2MPU12_PMIC_L34CTRL */
+	}
+	vm_offset_t pmu = ml_io_map(PD_AUD_PA, 0x1000);
+	if (pmu) {
+		pd_aud_config = *(volatile uint32_t *)(pmu + PD_AUD_CONFIG);
+		pd_aud_status = *(volatile uint32_t *)(pmu + PD_AUD_STATUS);
+	}
+	/* Factory current-reference trims in the codec's OTP block: zero on a calibrated part is unlikely. */
+	static const uint8_t otp_regs[4] = { 0xA2, 0xA3, 0xA4, 0xA6 };  /* AUD3004X_2A2..2A6_CTRL_IREF */
+	for (unsigned i = 0; i < 4 && !acpm_error; i++) {
+		acpm_error = acpm_read(0x03, otp_regs[i], &acpm_otp[i]);
+	}
+	/*
+	 * The write test: AUD3004X_34_AD_VOLL, the digital volume of an ADC that is off, set to a
+	 * value it doesn't hold and read back, then its own value put back. A register that stores
+	 * what is written gives the new value; nothing behind the address gives the old one.
+	 */
+	acpm_writes_ok = !acpm_error && want_writes == 1 && acpm_guard_ok;
+	if (acpm_writes_ok) {
+		uint8_t again = 0, probe = acpm_codec[2] ^ 0x5au;
+		acpm_write_test = acpm_write(0x07, 0x34, probe);
+		if (!acpm_write_test) {
+			acpm_write_test = acpm_read(0x07, 0x34, &acpm_set_back);
+		}
+		int restore = acpm_write(0x07, 0x34, acpm_codec[2]);
+		if (!restore) {
+			restore = acpm_read(0x07, 0x34, &again);
+		}
+		if (!restore && again != acpm_codec[2]) {
+			restore = EIO;
+		}
+		if (!acpm_write_test && acpm_set_back != probe) {
+			acpm_write_test = ENODEV;           /* written, not stored */
+		}
+		if (!acpm_write_test && restore) {
+			acpm_write_test = 100 + restore;    /* stored, not put back */
+		}
+	}
+}
+
+void a04s_acpm_report(void);
+void
+a04s_acpm_report(void)
+{
+	kprintf("ACPM ERR %d PMIC %02x MIC %02x %02x\n", acpm_error, acpm_pmic_rev, acpm_mic_bias, acpm_mic_gain);
+	kprintf("CODEC %02x %02x %02x %02x GUARD %s WR %s TEST %d REF %u\n", acpm_codec[0], acpm_codec[1],
+	    acpm_codec[2], acpm_codec[3], acpm_guard_ok ? "OK" : "FAILED", acpm_writes_ok ? "ON" : "OFF",
+	    acpm_write_test, acpm_refused);
+	kprintf("OTP %02x %02x %02x %02x SET %02x BACK %02x\n", acpm_otp[0], acpm_otp[1], acpm_otp[2], acpm_otp[3],
+	    (uint8_t)(acpm_codec[2] ^ 0x5au), acpm_set_back);
+	kprintf("LDO33 %02x LDO34 %02x PDAUD %x %x\n", acpm_ldo33, acpm_ldo34, pd_aud_config, pd_aud_status);
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
diff --git a/bsd/dev/a04s_acpm_guard.h b/bsd/dev/a04s_acpm_guard.h
new file mode 100644
index 0000000..b5308db
--- /dev/null
+++ b/bsd/dev/a04s_acpm_guard.h
@@ -0,0 +1,46 @@
+/*
+ * Galaxy A04s: the only registers a kernel may write over ACPM. The same bus carries the
+ * S2MPU12 PMIC's regulators: its top and PMIC pages (bus addresses 0x00 and 0x01) set supply
+ * voltages, and none of them is here, nor its RTC (0x02), the codec's OTP fuses (0x03) or its
+ * trims (0x0F). Only the AUD3004X's capture path, on its digital (0x07) and analog (0x08)
+ * blocks. One bit per register, so tools/check_kernel_acpm.py can read the table out of a
+ * built kernel and check every bit. Generated with the port patch; edit the list there.
+ * The caller provides uint32_t and bool.
+ */
+#ifndef A04S_ACPM_GUARD_H
+#define A04S_ACPM_GUARD_H
+
+/*
+ * [bus address][register / 32], bit register % 32. Volatile, so every check reads the table:
+ * constant, the compiler worked out each check at build time and left none in the kernel.
+ */
+const volatile uint32_t a04s_acpm_writable[16][8] __attribute__((used)) = {
+	/* 0x07: 10 CLKGATE0, 11 CLKGATE1, 12 CLKGATE2, 14 RESETB0, 16 CLK_MODE_SEL, 18 PWAUTO_AD, 1E CHOP1, 1F CHOP2, 20 IF_FORM1, 21 IF_FORM2, 22 IF_FORM3, 23 IF_FORM4, 24 IF_FORM5, 29 IF_FORM6, 30 ADC1, 31 ADC2, 32 ADC3, 33 ADC4, 34 AD_VOLL, 35 AD_VOLR, 37 AD_HPF, C5 ACTR_MCB3, C6 ACTR_MCB4 */
+	[0x07] = { 0xc1570000u, 0x00bf021fu, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000060u, 0x00000000u },
+	/* 0x08: 02 CLK3_COD, 06 DSM_AD, 07 LPF_AD, 10 PD_REF, 11 PD_AD1, 12 PD_AD2, 13 PD_AD3, 17 CTRL_REF, 30 MIX_AD1, 34 VOL_AD1, 35 VOL_AD2, 36 VOL_AD3 */
+	[0x08] = { 0x008f00c4u, 0x00710000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u, 0x00000000u },
+};
+
+static inline bool
+a04s_acpm_write_allowed(uint32_t bus, uint32_t reg)
+{
+	return bus < 16 && reg < 256 && ((a04s_acpm_writable[bus][reg / 32] >> (reg % 32)) & 1u);
+}
+
+/* Every register on the PMIC, RTC, OTP and trim pages refused, and the test write allowed. */
+static inline bool
+a04s_acpm_guard_self_test(void)
+{
+	static const uint32_t refused_buses[] = { 0x00, 0x01, 0x02, 0x03, 0x0F };
+	for (unsigned i = 0; i < sizeof(refused_buses) / sizeof(refused_buses[0]); i++) {
+		for (uint32_t reg = 0; reg < 256; reg++) {
+			if (a04s_acpm_write_allowed(refused_buses[i], reg)) {
+				return false;
+			}
+		}
+	}
+	return a04s_acpm_write_allowed(0x07, 0x34) && !a04s_acpm_write_allowed(0x08, 0x50) &&
+	       !a04s_acpm_write_allowed(0x17, 0x34) && !a04s_acpm_write_allowed(0x07, 0x100);
+}
+
+#endif /* A04S_ACPM_GUARD_H */
diff --git a/bsd/dev/a04s_emmc_guard.h b/bsd/dev/a04s_emmc_guard.h
new file mode 100644
index 0000000..61653da
--- /dev/null
+++ b/bsd/dev/a04s_emmc_guard.h
@@ -0,0 +1,40 @@
+/*
+ * Galaxy A04s: the only eMMC sectors a kernel may ever write. The IMEI and key partitions
+ * all sit below userdata, and the card's own write protection does not cover efs.
+ * The caller provides uint64_t and bool.
+ */
+#ifndef A04S_EMMC_GUARD_H
+#define A04S_EMMC_GUARD_H
+
+#define A04S_USERDATA_FIRST   16599040ull
+#define A04S_USERDATA_SECTORS 227672064ull
+
+static inline bool
+a04s_write_allowed(uint64_t lba, uint64_t sectors)
+{
+	uint64_t end = A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS;
+	return sectors != 0 && lba >= A04S_USERDATA_FIRST && lba < end && sectors <= end - lba;
+}
+
+/* efs, sec_efs, cpefs, keystorage, keyrefuge and keydata, as this phone's table has them. */
+static inline bool
+a04s_guard_self_test(void)
+{
+	static const uint64_t protected_ranges[][2] = {
+		{ 8192, 40960 }, { 49152, 40960 }, { 98304, 16384 },
+		{ 245760, 1024 }, { 619520, 32768 }, { 652288, 32768 },
+	};
+	for (unsigned i = 0; i < sizeof(protected_ranges) / sizeof(protected_ranges[0]); i++) {
+		uint64_t first = protected_ranges[i][0], count = protected_ranges[i][1];
+		if (a04s_write_allowed(first, 1) || a04s_write_allowed(first + count - 1, 1) ||
+		    a04s_write_allowed(first, count)) {
+			return false;
+		}
+	}
+	return !a04s_write_allowed(A04S_USERDATA_FIRST - 1, 1) &&
+	       a04s_write_allowed(A04S_USERDATA_FIRST, 1) &&
+	       a04s_write_allowed(A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS - 1, 1) &&
+	       !a04s_write_allowed(A04S_USERDATA_FIRST + A04S_USERDATA_SECTORS, 1);
+}
+
+#endif /* A04S_EMMC_GUARD_H */
