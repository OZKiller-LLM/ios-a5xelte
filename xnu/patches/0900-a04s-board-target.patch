diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 76d70b9..9c3a4b9 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1049,6 +1049,65 @@ sweet_sample_task(const char *name, int pid, task_t task)
 	task_unlock(task);
 }
 
+#if defined(ARM64_BOARD_CONFIG_A04S)
+void a04s_sample_task(task_t task);
+
+void
+a04s_sample_task(task_t task)
+{
+	thread_t thread;
+
+	if (!task_lock_try(task)) {
+		kprintf("PID1 TASK LOCKED\n");
+		return;
+	}
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+
+		kprintf("T ST %x EV %llx U %u M %u\n", thread->state, (uint64_t)thread->wait_event,
+		    thread->syscalls_unix, thread->syscalls_mach);
+		kprintf("CONT %llx\n", (uint64_t)VM_KERNEL_UNSLIDE((vm_offset_t)thread->continuation));
+		if (ss != NULL && is_saved_state64(ss)) {
+			kprintf("UPC %llx\n", (uint64_t)get_saved_state_pc(ss));
+			kprintf("ULR %llx\n", (uint64_t)get_saved_state_lr(ss));
+		}
+		uint64_t frames[13];
+		int nframes = 0;
+		spl_t s = splsched();
+
+		/* A kernel stack is walked only for a thread that is waiting, under its lock, so it can't
+		 * be given up meanwhile: v31 with 8 CPUs panicked reading the saved state of a thread that
+		 * had just dropped its stack on another CPU (kstackptr NULL, fault at 0x50, state->fp).
+		 * The frames are printed after the lock is released. */
+		thread_lock(thread);
+		vm_offset_t low = thread->kernel_stack;
+		vm_offset_t kstack = thread->machine.kstackptr;
+		if ((thread->state & (TH_WAIT | TH_RUN)) == TH_WAIT && low != 0 && kstack >= low &&
+		    kstack + sizeof(arm_kernel_saved_state_t) <= low + kernel_stack_size) {
+			const arm_kernel_saved_state_t *state = (const arm_kernel_saved_state_t *)kstack;
+			uint64_t high = low + kernel_stack_size, fp = state->fp;
+
+			frames[nframes++] = state->lr;
+			for (int i = 0; i < 12 && fp >= low && fp + 16 <= high && (fp & 7) == 0; i++) {
+				const uint64_t *frame = (const uint64_t *)fp;
+
+				frames[nframes++] = frame[1];
+				if (frame[0] <= fp) {
+					break;
+				}
+				fp = frame[0];
+			}
+		}
+		thread_unlock(thread);
+		splx(s);
+		for (int i = 0; i < nframes; i++) {
+			kprintf("K %llx\n", (uint64_t)VM_KERNEL_UNSLIDE((vm_offset_t)frames[i]));
+		}
+	}
+	task_unlock(task);
+}
+#endif /* ARM64_BOARD_CONFIG_A04S */
+
 #endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_A5XELTE */
 
 kern_return_t
diff --git a/osfmk/kern/zalloc.c b/osfmk/kern/zalloc.c
index 25438c9..d478b02 100644
--- a/osfmk/kern/zalloc.c
+++ b/osfmk/kern/zalloc.c
@@ -10910,3 +10910,34 @@ zone_alloc_replenish_test(__unused int64_t in, int64_t *out)
 SYSCTL_TEST_REGISTER(zone_alloc_replenish_test, zone_alloc_replenish_test);
 
 #endif /* DEBUG || DEVELOPMENT */
+
+/*
+ * A04s (v63; harmless on other boards, as zalloc.c doesn't see the board macro): the eight zones holding the most wired pages, for the heartbeat's leak hunt
+ * (bsd/dev/a04s_gpu.c). Reads only; no lock, the counts are a snapshot.
+ */
+void a04s_zone_top(void);
+void
+a04s_zone_top(void)
+{
+	zone_t top[8] = { NULL };
+	uint32_t wired[8] = { 0 };
+	zone_foreach(z) {
+		uint32_t w = os_atomic_load(&z->z_wired_cur, relaxed);
+		for (int k = 0; k < 8; k++) {
+			if (top[k] == NULL || w > wired[k]) {
+				for (int m = 7; m > k; m--) {
+					top[m] = top[m - 1];
+					wired[m] = wired[m - 1];
+				}
+				top[k] = z;
+				wired[k] = w;
+				break;
+			}
+		}
+	}
+	kprintf("ZONETOP");
+	for (int k = 0; k < 8 && top[k] != NULL; k++) {
+		kprintf(" %s%s %u", zone_heap_name(top[k]), top[k]->z_name ? top[k]->z_name : "?", wired[k]);
+	}
+	kprintf("\n");
+}
